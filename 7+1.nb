        RowBox[{"-", "3"}], " ", "w1"}], "-", 
       RowBox[{"36", " ", "w2"}], "-", 
       RowBox[{"360", " ", "w3"}], "-", "\[CapitalLambda]"}], ",", 
      RowBox[{
       RowBox[{"5", " ", "w1"}], "+", 
       RowBox[{"28", " ", "w2"}], "+", 
       RowBox[{"216", " ", "w3"}], "-", "\[CapitalLambda]"}], ",", 
      RowBox[{
       RowBox[{"3", " ", "w1"}], "+", 
       RowBox[{"12", " ", "w2"}], "+", 
       RowBox[{"72", " ", "w3"}], "-", "\[CapitalLambda]"}]}], "}"}]}], ",", 
   RowBox[{"\<\"alpha_2, alpha_3 for Lambda = 0, qH = -1\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", 
        RowBox[{"2", " ", 
         SuperscriptBox[
          InterpretationBox[
           StyleBox["H",
            ShowAutoStyles->False,
            AutoSpacing->False],
           $CellContext`H,
           Editable->False], "2"]}]]}], ",", 
      FractionBox["1", 
       RowBox[{"24", " ", 
        SuperscriptBox[
         InterpretationBox[
          StyleBox["H",
           ShowAutoStyles->False,
           AutoSpacing->False],
          $CellContext`H,
          Editable->False], "4"]}]]}], "}"}]}]}], "}"}]], "Output",
 CellChangeTimes->{4.0021312882639847`*^9},
 CellLabel->
  "Out[614]=",ExpressionUUID->"c2ec3c15-452c-5e41-9437-80b89dc99b42"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
13. Generalized frame matrices, the canonical spin connection, and the \
covariant Dirac equation of dirac16complex\
\>", "Section",ExpressionUUID->"58578ffe-c414-1e45-85f4-ad25f24df9f5"],

Cell["\<\
A frame field (vielbein) e^A_\[Mu](X) is a square root of the metric, g_\[Mu]\
\[Nu] = \[Eta]17_AB e^A_\[Mu] e^B_\[Nu], with \[Eta]17 = diag(+1, \[Minus]1, \
\[Ellipsis], \[Minus]1) simply the squares of the octonion basis (e[0]\.b2 = \
+1 for the time direction, e[i]\.b2 = \[Minus]1 for the seven space \
directions); its inverse is e_A^\[Mu] (code ei[[\[Mu]+1, A+1]]). The \
GENERALIZED FRAME MATRICES are the position-dependent real 16\[Times]16 \
matrices\
\>", "Text",ExpressionUUID->"6b74dcdb-0831-1445-b1b1-2de0d78876f5"],

Cell["\<\
      \[CapitalGamma]_\[Mu](X) = e^A_\[Mu](X) \[CapitalGamma]17[A],    \
\[CapitalGamma]^\[Mu](X) = e_A^\[Mu](X) \[CapitalGamma]17up[A],    \
\[CapitalGamma]_\[Mu] \[CapitalGamma]_\[Nu] + \[CapitalGamma]_\[Nu] \
\[CapitalGamma]_\[Mu] = 2 g_\[Mu]\[Nu](X) ID16.\
\>", "Text",ExpressionUUID->"d280b9ec-eb7e-6b4e-a66a-d0c8eb59a535"],

Cell["\<\
The CANONICAL (Levi-Civita) SPIN CONNECTION is \[Omega]_\[Mu]^A_B = e^A_\[Nu] \
(\[PartialD]_\[Mu] e_B^\[Nu] + {\[Nu] \[Mu]\[Lambda]} e_B^\[Lambda]), \
antisymmetric when its first frame index is lowered, \[Omega]_\[Mu]AB = \
\[Minus]\[Omega]_\[Mu]BA; on 16-component spinors it acts through\
\>", "Text",ExpressionUUID->"2069cd54-5ac1-7d41-bbe3-1c80c4a52d21"],

Cell["\<\
      \[CapitalOmega]_\[Mu] = (1/4) \[Omega]_\[Mu]AB \[CapitalGamma]17up[A] \
\[CapitalGamma]17up[B],   D_\[Mu] \[Psi] = \[PartialD]_\[Mu] \[Psi] + \
\[CapitalOmega]_\[Mu] \[Psi],   D_\[Mu] \[Psi]bar = \[PartialD]_\[Mu] \
\[Psi]bar \[Minus] \[Psi]bar \[CapitalOmega]_\[Mu]   (\[Psi]bar = \[Psi]\
\[Dagger] \[CapitalGamma]17[0]).\
\>", "Text",ExpressionUUID->"a72830d9-f26a-154c-a52b-df88bc27bd36"],

Cell["\<\
The TOTAL covariant derivative acts on every index of an object: Christoffel \
symbols on coordinate indices, \[Omega] on frame indices, and the commutator \
with \[CapitalOmega] on the two spinor indices of a 16\[Times]16 matrix. The \
canonical spin connection is the one for which the total covariant derivative \
of the frame field and of the frame matrices vanishes:\
\>", "Text",ExpressionUUID->"6d719d3b-0796-4a4b-8270-a7cc1238cf58"],

Cell["\<\
      D_\[Mu] e^A_\[Nu] = \[PartialD]_\[Mu] e^A_\[Nu] \[Minus] {\[Lambda] \
\[Mu]\[Nu]} e^A_\[Lambda] + \[Omega]_\[Mu]^A_B e^B_\[Nu] = 0   (vielbein \
postulate),\
\>", "Text",ExpressionUUID->"9310d032-6cf3-8a4f-a303-d34c979f25eb"],

Cell["\<\
      \[Del]_\[Mu] \[CapitalGamma]_\[Nu] = \[PartialD]_\[Mu] \[CapitalGamma]_\
\[Nu] \[Minus] {\[Lambda] \[Mu]\[Nu]} \[CapitalGamma]_\[Lambda] + [\
\[CapitalOmega]_\[Mu], \[CapitalGamma]_\[Nu]] = 0,     \[Omega]_\[Mu]^A_B \
\[CapitalGamma]17up[B] + [\[CapitalOmega]_\[Mu], \[CapitalGamma]17up[A]] = 0.\
\>", "Text",ExpressionUUID->"c69a7f3c-435c-224e-adf9-3e5323d1bda2"],

Cell["\<\
Its curvature F_\[Mu]\[Nu] = \[PartialD]_\[Mu]\[CapitalOmega]_\[Nu] \[Minus] \
\[PartialD]_\[Nu]\[CapitalOmega]_\[Mu] + [\[CapitalOmega]_\[Mu], \
\[CapitalOmega]_\[Nu]] = [D_\[Mu], D_\[Nu]] is the Riemann tensor in spinor \
form, F_\[Mu]\[Nu] = (1/4) R_AB\[Mu]\[Nu] \[CapitalGamma]17up[A] \
\[CapitalGamma]17up[B] with R_AB\[Mu]\[Nu] = \[Eta]17_AC e^C_\[Rho] R^\[Rho]_\
\[Sigma]\[Mu]\[Nu] e_B^\[Sigma]; it satisfies the Bianchi identity D_[\
\[Lambda] F_\[Mu]\[Nu]] = 0, and (1/2) \[CapitalGamma]^\[Mu] \[CapitalGamma]^\
\[Nu] F_\[Mu]\[Nu] = \[Minus](R/4) ID16, the term of the Lichnerowicz formula \
(\[CapitalGamma]^\[Mu] D_\[Mu])\.b2 = g^\[Mu]\[Nu] \[Del]_\[Mu] D_\[Nu] \
\[Minus] R/4.\
\>", "Text",ExpressionUUID->"1b5f36d1-7cc4-744b-a75e-cdbcf3add29f"],

Cell["\<\
The covariant Dirac equation of dirac16complex and its Lagrangian density are\
\>", "Text",ExpressionUUID->"a01bbce8-2f70-ed47-a942-c07524bced7a"],

Cell["\<\
      (i \[CapitalGamma]^\[Mu](X) D_\[Mu] \[Minus] m) \[Psi] = 0,      \
\[Sqrt]|g| \[Psi]bar (i \[CapitalGamma]^\[Mu] D_\[Mu] \[Minus] m) \[Psi],\
\>", "Text",ExpressionUUID->"61706880-0b21-284f-8a39-14e3b45421dc"],

Cell["\<\
the spin connection \[CapitalOmega]_\[Mu] being the coupling of gravity to \
the field. The current J^\[Mu] = \[Psi]bar \[CapitalGamma]^\[Mu] \[Psi] is \
conserved, \[PartialD]_\[Mu](\[Sqrt]|g| J^\[Mu]) = 0, because \[PartialD]_\
\[Mu](\[Sqrt]|g| \[Psi]bar \[CapitalGamma]^\[Mu] \[Psi]) = \[Sqrt]|g| [(D_\
\[Mu]\[Psi]bar) \[CapitalGamma]^\[Mu] \[Psi] + \[Psi]bar \
\[CapitalGamma]^\[Mu] D_\[Mu] \[Psi]] and the Dirac equation and its adjoint \
make the bracket vanish. All of this is checked below for four metrics: the \
cosmological one (section 13.2), the pp-wave (not diagonal) and the \
inhomogeneous metric of section 11.3 (section 13.3), and a static metric with \
a radial coordinate (section 13.5).\
\>", "Text",ExpressionUUID->"4ec49e6e-f34b-4b45-ac10-6a01871e0fa4"],

Cell[CellGroupData[{

Cell["13.1 The frame data of a metric", "Subsection",ExpressionUUID->"38a7d9f4-3481-f54b-95c0-828132757585"],

Cell["\<\
frameData[cv_Association, e_, simp_: Simplify] := Module[{g = cv[\"g\"], chr \
= cv[\"chr\"], ei, gam, gamU, om, omL, Om, F},
  ei = simp[Inverse[e]];
  gam = Table[Sum[e[[A + 1, m]] \[CapitalGamma]17[A], {A, 0, 7}], {m, 8}];
  gamU = Table[Sum[ei[[m, A + 1]] \[CapitalGamma]17up[A], {A, 0, 7}], {m, 8}];
  om = Table[simp[Sum[e[[A, n]] (D[ei[[n, B]], X[[m]]] + Sum[chr[[n, m, l]] \
ei[[l, B]], {l, 8}]), {n, 8}]], {m, 8}, {A, 8}, {B, 8}];
  omL = Table[\[Eta]17.om[[m]], {m, 8}];
  Om = Table[simp[(Zero16 + Sum[If[omL[[m, A + 1, B + 1]] === 0, 0, omL[[m, A \
+ 1, B + 1]] \[CapitalGamma]17up[A].\[CapitalGamma]17up[B]], {A, 0, 7}, {B, \
0, 7}])/4], {m, 8}];   (* Zero16 + ...: a 16x16 matrix even when every term \
vanishes *)
  F = Table[simp[D[Om[[n]], X[[m]]] - D[Om[[m]], X[[n]]] + Om[[m]].Om[[n]] - \
Om[[n]].Om[[m]]], {m, 8}, {n, 8}];
  <|\"e\" -> e, \"ei\" -> ei, \"Gam\" -> gam, \"GamUp\" -> gamU, \"om\" -> \
om, \"omL\" -> omL, \"Om\" -> Om, \"F\" -> F|>];
frameChecks[name_String, cv_Association, fd_Association, simp_: Simplify] := \
Module[{g = cv[\"g\"], chr = cv[\"chr\"], e = fd[\"e\"], ei = fd[\"ei\"],
   gam = fd[\"Gam\"], gamU = fd[\"GamUp\"], om = fd[\"om\"], omL = \
fd[\"omL\"], Om = fd[\"Om\"], F = fd[\"F\"], z16 = ConstantArray[0, {16, \
16}], rABmn},
  check[name <> \": eta17 e e == g and {Gamma_mu, Gamma_nu} == 2 g_mu nu ID16 \
(generalized frame matrices, real)\",
   simp[Transpose[e].\[Eta]17.e - g] == ConstantArray[0, {8, 8}] &&
    And @@ Flatten[Table[simp[gam[[m]].gam[[n]] + gam[[n]].gam[[m]] - 2 g[[m, \
n]] ID16] == z16, {m, 8}, {n, m, 8}]] && FreeQ[gam, Complex]];
  check[name <> \": canonical spin connection antisymmetric, omega_mu AB == \
-omega_mu BA\", And @@ Table[simp[omL[[m]] + Transpose[omL[[m]]]] == \
ConstantArray[0, {8, 8}], {m, 8}]];
  check[name <> \": vielbein postulate d_mu e^A_nu - {l mu nu} e^A_l + \
omega_mu^A_B e^B_nu == 0\",
   And @@ Flatten[Table[simp[D[e[[A, n]], X[[m]]] - Sum[chr[[l, m, n]] e[[A, \
l]], {l, 8}] + Sum[om[[m, A, B]] e[[B, n]], {B, 8}]] === 0, {m, 8}, {n, 8}, \
{A, 8}]]];
  check[name <> \": TOTAL covariant derivative of the frame matrices \
vanishes, d_mu Gamma_nu - {l mu nu} Gamma_l + [Omega_mu, Gamma_nu] == 0\",
   And @@ Flatten[Table[simp[D[gam[[n]], X[[m]]] - Sum[chr[[l, m, n]] \
gam[[l]], {l, 8}] + Om[[m]].gam[[n]] - gam[[n]].Om[[m]]] == z16, {m, 8}, {n, \
8}]]];
  check[name <> \": constant frame matrices are covariantly constant, \
omega_mu^A_B Gamma17up[B] + [Omega_mu, Gamma17up[A]] == 0\",
   And @@ Flatten[Table[simp[Sum[om[[m, A + 1, B + 1]] \
\[CapitalGamma]17up[B], {B, 0, 7}] + Om[[m]].\[CapitalGamma]17up[A] - \
\[CapitalGamma]17up[A].Om[[m]]] == z16, {m, 8}, {A, 0, 7}]]];
  check[name <> \": Omega_mu real and \
Gamma17[0].Transpose[Omega_mu].Gamma17[0] == -Omega_mu (so D_mu psibar = d_mu \
psibar - psibar Omega_mu)\",
   FreeQ[Om, Complex] && And @@ \
Table[simp[\[CapitalGamma]17[0].Transpose[Om[[m]]].\[CapitalGamma]17[0] + \
Om[[m]]] == z16, {m, 8}]];
  rABmn[m_, n_] := Table[simp[Sum[\[Eta]17[[A, A]] e[[A, r]] cv[\"riem\"][[r, \
s, m, n]] ei[[s, B]], {r, 8}, {s, 8}]], {A, 8}, {B, 8}];
  check[name <> \": spin curvature F_mu nu == (1/4) R_AB mu nu \
Gamma17up[A].Gamma17up[B]\",
   And @@ Flatten[Table[With[{rr = rABmn[m, n]}, simp[F[[m, n]] - Sum[rr[[A + \
1, B + 1]] \[CapitalGamma]17up[A].\[CapitalGamma]17up[B], {A, 0, 7}, {B, 0, \
7}]/4] == z16], {m, 8}, {n, m + 1, 8}]]];
  check[name <> \": Bianchi identity d_l F_mn + [Omega_l, F_mn] + cyclic == 0\
\",
   And @@ Flatten[Table[simp[Sum[D[F[[t[[2]], t[[3]]]], X[[t[[1]]]]] + \
Om[[t[[1]]]].F[[t[[2]], t[[3]]]] - F[[t[[2]], t[[3]]]].Om[[t[[1]]]],
          {t, {{l, m, n}, {m, n, l}, {n, l, m}}}]] == z16, {l, 8}, {m, l + 1, \
8}, {n, m + 1, 8}]]];
  check[name <> \": (1/2) Gamma^mu Gamma^nu F_mu nu == -(R/4) ID16\", \
simp[Sum[gamU[[m]].gamU[[n]].F[[m, n]], {m, 8}, {n, 8}]/2 + cv[\"R\"] ID16/4] \
== z16];
  ];\
\>", "Input",
 CellLabel->
  "In[615]:=",ExpressionUUID->"c84bf936-8f71-f743-b013-dc74b540c516"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
13.2 The cosmological metric: frame, spin connection, Dirac equation\
\>", "Subsection",ExpressionUUID->"b46b84f4-ad06-fd4d-951b-58445766228b"],

Cell[TextData[{
 "Frame e^0 = dx0, e^i = a dx^i (i = 1, 2, 3), e^k = b dx^k (k = 4 \
\[Ellipsis] 7). The spin connection is \[CapitalOmega]_0 = 0, \
\[CapitalOmega]_i = (a\[Prime]/2) \[CapitalGamma]17[i].\[CapitalGamma]17[0], \
\[CapitalOmega]_k = (b\[Prime]/2) \[CapitalGamma]17[k].\[CapitalGamma]17[0], \
NOT zero whenever the universe expands, and \[CapitalGamma]^\[Mu] \
\[CapitalOmega]_\[Mu] = (3Ha/2 + 2Hb) \[CapitalGamma]17[0]. The rescaled \
field \[Chi] = (a\.b3b\:2074)^(1/2) \[Psi] obeys an equation without \
connection; for a plane wave \[Chi] = e^{i(",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "c5ca4070-9fec-2e4c-87f6-6c59a47398af"],
 "\[CenterDot]",
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "d50b06de-7802-a042-bad9-6df175be225f"],
 " + ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "70f4410d-5402-5c48-bfea-b5be04dac814"],
 "\[CenterDot]",
 Cell[BoxData[
  FormBox[
   OverscriptBox["y", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "7e6e81b7-7235-2341-b145-25d27e1c05ca"],
 ")} c(x0) (",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "ddd1654c-da93-3b4b-83dc-f5fbb5564391"],
 " = (p1, p2, p3), ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "2a3e123e-7582-7442-ab00-1c887bf67ce6"],
 " = (q4, \[Ellipsis], q7), ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "4ae280cc-89c1-374d-bd6f-e1676c0a467d"],
 " = (x1, x2, x3), ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["y", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "68293ec1-390a-a341-9c4a-f0e6050b1943"],
 " = (x4, \[Ellipsis], x7)) the Dirac equation becomes the \
Schr\[ODoubleDot]dinger-type equation"
}], "Text",ExpressionUUID->"62003fb7-3bce-ca4b-b57c-e39e9db45e47"],

Cell[TextData[{
 "      i dc/dx0 = h(x0) c,     h(x0) = \[Alpha]D\[CenterDot](",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "8a28ed9f-867b-5f4c-ac8f-799e8a933267"],
 "/a, ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "9a0afc05-ff54-424c-816c-b21a3706cce5"],
 "/b) + \[Beta]D m = \[CapitalSigma]_i \[Alpha]D[i] p_i/a + \[CapitalSigma]_k \
\[Alpha]D[k] q_k/b + \[Beta]D m,"
}], "Text",ExpressionUUID->"6a896383-0b79-344e-bb23-096829bc2d33"],

Cell[TextData[{
 "the flat-space Hamiltonian matrix of section 7.3 with the physical \
(redshifted) momenta ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "105ad294-9d41-d048-98a7-759b67ab657a"],
 "/a and ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "7fa8e094-8052-1c48-902a-7fb4bd949154"],
 "/b."
}], "Text",ExpressionUUID->"0f37bb2a-ce5c-9549-bb93-c3922f962d31"],

Cell[CellGroupData[{

Cell["\<\
eCos = DiagonalMatrix[{1, a3[x0], a3[x0], a3[x0], b4[x0], b4[x0], b4[x0], \
b4[x0]}];
fdCos = frameData[cvCos, eCos];
frameChecks[\"cosmological metric\", cvCos, fdCos];
check[\"cosmological metric: Omega_0 == 0, Omega_i == (a'/2) \
Gamma17[i].Gamma17[0], Omega_k == (b'/2) Gamma17[k].Gamma17[0]\",
  fdCos[\"Om\"][[1]] == ConstantArray[0, {16, 16}] && And @@ \
Table[Simplify[fdCos[\"Om\"][[i + 1]] - a3'[x0]/2 \[CapitalGamma]17[i].\
\[CapitalGamma]17[0]] == ConstantArray[0, {16, 16}], {i, 1, 3}] &&
  And @@ Table[Simplify[fdCos[\"Om\"][[k + 1]] - b4'[x0]/2 \
\[CapitalGamma]17[k].\[CapitalGamma]17[0]] == ConstantArray[0, {16, 16}], {k, \
4, 7}]]
check[\"cosmological metric: Gamma^mu Omega_mu == (3a'/(2a) + 2b'/b) \
Gamma17[0]\",
  Simplify[Sum[fdCos[\"GamUp\"][[m]].fdCos[\"Om\"][[m]], {m, 8}] - (3 \
a3'[x0]/(2 a3[x0]) + 2 b4'[x0]/b4[x0]) \[CapitalGamma]17[0]] == \
ConstantArray[0, {16, 16}]]\
\>", "Input",
 CellLabel->
  "In[617]:=",ExpressionUUID->"2e288b7e-a54d-c04f-a045-66c7ad453b6d"],

Cell[BoxData[
 RowBox[{"\<\"cosmological metric: Omega_0 == 0, Omega_i == (a'/2) \
Gamma17[i].Gamma17[0], Omega_k == (b'/2) Gamma17[k].Gamma17[0]\"\>", "\[Rule]",
   "True"}]], "Output",
 CellChangeTimes->{4.0021312887994347`*^9},
 CellLabel->
  "Out[620]=",ExpressionUUID->"715c6b60-5122-fa49-bf6f-45174a2a1e00"],

Cell[BoxData[
 RowBox[{"\<\"cosmological metric: Gamma^mu Omega_mu == (3a'/(2a) + 2b'/b) \
Gamma17[0]\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021312888093853`*^9},
 CellLabel->
  "Out[621]=",ExpressionUUID->"1123f8ee-8dc4-de47-b975-4a19f4c5b17d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
psiF = Table[fpsi[j][x0, x1, x5], {j, 16}]; psibF = Table[hpsi[j][x0, x1, \
x5], {j, 16}];
DpsiCos = Table[D[psiF, X[[m]]] + fdCos[\"Om\"][[m]].psiF, {m, 8}];
DpsibCos = Table[D[psibF, X[[m]]] - psibF.fdCos[\"Om\"][[m]], {m, 8}];
sqgCos = a3[x0]^3 b4[x0]^4;
check[\"current identity: d_mu(sqrt|g| psibar Gamma^mu psi) == sqrt|g| [(D_mu \
psibar) Gamma^mu psi + psibar Gamma^mu D_mu psi] (psi, psibar arbitrary)\",
  Together[Sum[D[sqgCos psibF.fdCos[\"GamUp\"][[m]].psiF, X[[m]]], {m, 8}] - \
sqgCos Sum[DpsibCos[[m]].fdCos[\"GamUp\"][[m]].psiF + \
psibF.fdCos[\"GamUp\"][[m]].DpsiCos[[m]], {m, 8}]] === 0]
DslCos[f_] := Sum[fdCos[\"GamUp\"][[m]].(D[f, X[[m]]] + \
fdCos[\"Om\"][[m]].f), {m, 8}];
boxCos = Sum[cvCos[\"ginv\"][[m, m]] (D[DpsiCos[[m]], X[[m]]] + \
fdCos[\"Om\"][[m]].DpsiCos[[m]] - Sum[cvCos[\"chr\"][[l, m, m]] DpsiCos[[l]], \
{l, 8}]), {m, 8}];
check[\"Lichnerowicz formula: (Gamma^mu D_mu)^2 psi == (g^mu nu nabla_mu D_nu \
- R/4) psi\", Together[DslCos[DslCos[psiF]] - boxCos + cvCos[\"R\"] psiF/4] \
=== ConstantArray[0, 16]]
chiF = Table[cchi[j][x0, x1, x5], {j, 16}];
check[\"rescaling psi = (a^3 b^4)^(-1/2) chi removes the spin connection: \
Gamma^mu D_mu psi == (a^3 b^4)^(-1/2) Gamma^mu d_mu chi\",
  Simplify[DslCos[chiF/Sqrt[sqgCos]] - Sum[fdCos[\"GamUp\"][[m]].D[chiF, \
X[[m]]], {m, 8}]/Sqrt[sqgCos]] === ConstantArray[0, 16]]
cModes = Table[cm[j][x0], {j, 16}];
hCos = Sum[\[Alpha]D[i] pmom[i]/a3[x0], {i, 1, 3}] + Sum[\[Alpha]D[k] \
qmom[k]/b4[x0], {k, 4, 7}] + \[Beta]D mD;
phaseCos = Exp[I (Sum[pmom[i] X[[i + 1]], {i, 1, 3}] + Sum[qmom[k] X[[k + \
1]], {k, 4, 7}])];
check[\"mode equation: Gamma17[0].(i Gamma^mu D_mu - m) psi == (a^3 \
b^4)^(-1/2) e^{i(p.x+q.y)} (i dc/dx0 - h(x0) c) for psi = (a^3 b^4)^(-1/2) \
e^{i(p.x+q.y)} c(x0)\",
  Simplify[\[CapitalGamma]17[0].(I DslCos[phaseCos cModes/Sqrt[sqgCos]] - mD \
phaseCos cModes/Sqrt[sqgCos]) Sqrt[sqgCos]/phaseCos - (I D[cModes, x0] - \
hCos.cModes)] === ConstantArray[0, 16]]\
\>", "Input",
 CellLabel->
  "In[622]:=",ExpressionUUID->"4028a31b-5f6f-9440-a5c1-24769bf1c464"],

Cell[BoxData[
 RowBox[{"\<\"current identity: d_mu(sqrt|g| psibar Gamma^mu psi) == sqrt|g| \
[(D_mu psibar) Gamma^mu psi + psibar Gamma^mu D_mu psi] (psi, psibar \
arbitrary)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.00213128885392*^9},
 CellLabel->
  "Out[626]=",ExpressionUUID->"db94931c-121a-954c-bfce-aa7704bb6208"],

Cell[BoxData[
 RowBox[{"\<\"Lichnerowicz formula: (Gamma^mu D_mu)^2 psi == (g^mu nu \
nabla_mu D_nu - R/4) psi\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021312889112625`*^9},
 CellLabel->
  "Out[629]=",ExpressionUUID->"3836e71e-612b-e345-a924-937d27827c6a"],

Cell[BoxData[
 RowBox[{"\<\"rescaling psi = (a^3 b^4)^(-1/2) chi removes the spin \
connection: Gamma^mu D_mu psi == (a^3 b^4)^(-1/2) Gamma^mu d_mu chi\"\>", "\[Rule]",
   "True"}]], "Output",
 CellChangeTimes->{4.0021312889318295`*^9},
 CellLabel->
  "Out[631]=",ExpressionUUID->"7fa15a78-f465-cc4d-a6c4-7957f05b62c6"],

Cell[BoxData[
 RowBox[{"\<\"mode equation: Gamma17[0].(i Gamma^mu D_mu - m) psi == (a^3 \
b^4)^(-1/2) e^{i(p.x+q.y)} (i dc/dx0 - h(x0) c) for psi = (a^3 b^4)^(-1/2) \
e^{i(p.x+q.y)} c(x0)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021312891342735`*^9},
 CellLabel->
  "Out[635]=",ExpressionUUID->"55d8a53d-0c9b-8b41-a3e3-c552663cdf65"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
13.3 The pp-wave and the inhomogeneous metric: frames that are not diagonal \
and not homogeneous\
\>", "Subsection",ExpressionUUID->"869a3ea6-c7f7-9b45-8a0c-e4ed633717a7"],

Cell["\<\
pp-wave frame (arbitrary profile fPP): e^0 = (1 + fPP/2) dx0 \[Minus] (fPP/2) \
dx1, e^1 = (fPP/2) dx0 + (1 \[Minus] fPP/2) dx1, e^A = dx^A otherwise. \
Inhomogeneous frame (section 11.3): e^0 = nP dx0, e^i = aP dx^i, e^k = bP \
dx^k; its identities are checked exactly at x0 = 1/2, x4 = 1/3 (the \
derivatives are taken symbolically first). Every identity of section 13.1 \
holds for both.\
\>", "Text",ExpressionUUID->"5ba16cd1-9a03-7e40-bba6-8d1bb874375c"],

Cell["\<\
ePP = IdentityMatrix[8]; ePP[[1, 1]] = 1 + fPP[x0 - x1, x2, x3]/2; ePP[[1, \
2]] = -fPP[x0 - x1, x2, x3]/2;
ePP[[2, 1]] = fPP[x0 - x1, x2, x3]/2; ePP[[2, 2]] = 1 - fPP[x0 - x1, x2, x3]/2;
fdPP = frameData[cvPP, ePP, Together];
frameChecks[\"pp-wave\", cvPP, fdPP, Together];
ePoly = DiagonalMatrix[{nP, aP, aP, aP, bP, bP, bP, bP}];
fdPoly = frameData[cvPoly, ePoly, Identity];
frameChecks[\"inhomogeneous metric (exact at (x0, x4) = (1/2, 1/3))\", \
cvPoly, fdPoly, (Together[# /. ptP] &)];\
\>", "Input",
 CellLabel->
  "In[636]:=",ExpressionUUID->"0ee7d893-49aa-9a4f-9a7e-28aaf2936430"]
}, Open  ]],

Cell[CellGroupData[{

Cell["13.4 Conformal weight 7/2 of the massless field", "Subsection",ExpressionUUID->"6a4b4c82-cd99-cf4f-8b4f-e434053a2864"],

Cell["\<\
For a conformally flat metric g = C(x0)\.b2 \[Eta]17 (x0 is then conformal \
time) the massless covariant Dirac operator satisfies \[CapitalGamma]^\[Mu] \
D_\[Mu] (C^(\[Minus]7/2) f) = C^(\[Minus]9/2) \[CapitalGamma]17up[A] \
\[PartialD]_A f for every f: a massless dirac16complex in a conformally flat \
7+1 spacetime is a rescaled flat-space solution, and no pairs are created. \
(The cosmological metric is conformally flat only when a = b.)\
\>", "Text",ExpressionUUID->"61d9074b-74d2-6d4e-8fc0-d4ed4a9475e0"],

Cell[CellGroupData[{

Cell["\<\
gConf = cConf[x0]^2 \[Eta]17;
cvConf = curvature[gConf];
fdConf = frameData[cvConf, cConf[x0] IdentityMatrix[8]];
kF = Table[kflat[j][x0, x1, x5], {j, 16}];
check[\"conformal weight 7/2: Gamma^mu D_mu (C^(-7/2) f) == C^(-9/2) \
Gamma17up[A] d_A f for g = C(x0)^2 eta17\",
  Simplify[Sum[fdConf[\"GamUp\"][[m]].(D[cConf[x0]^(-7/2) kF, X[[m]]] + \
fdConf[\"Om\"][[m]].(cConf[x0]^(-7/2) kF)), {m, 8}] -
     cConf[x0]^(-9/2) Sum[\[CapitalGamma]17up[A].D[kF, X[[A + 1]]], {A, 0, \
7}]] === ConstantArray[0, 16]]\
\>", "Input",
 CellLabel->
  "In[643]:=",ExpressionUUID->"5e0c2a53-1e77-9749-a88c-d067297613aa"],

Cell[BoxData[
 RowBox[{"\<\"conformal weight 7/2: Gamma^mu D_mu (C^(-7/2) f) == C^(-9/2) \
Gamma17up[A] d_A f for g = C(x0)^2 eta17\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021312936340218`*^9},
 CellLabel->
  "Out[647]=",ExpressionUUID->"4e9e6564-868e-a140-afcc-549b0e7512bb"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
13.5 Cartan\[CloseCurlyQuote]s first structure equation, a static metric with \
a radial coordinate, and the coupling to a gauge field\
\>", "Subsection",ExpressionUUID->"56b72d7d-9bde-e440-87bd-a389c9a9ed86"],

Cell[TextData[{
 StyleBox["Differential forms. ",
  FontWeight->"Bold"],
 "With the frame one-forms e^A = e^A_\[Mu] dx^\[Mu] and the connection \
one-forms \[Omega]^A_B = \[Omega]_\[Mu]^A_B dx^\[Mu], the vielbein postulate \
of section 13 antisymmetrized in \[Mu] and \[Nu] is CARTAN\[CloseCurlyQuote]S \
FIRST STRUCTURE EQUATION (no torsion):"
}], "Text",ExpressionUUID->"94f1f819-2673-b649-a5a7-f05235e3f52e"],

Cell["\<\
      de^A + \[Omega]^A_B \[Wedge] e^B = 0,   i.e.   \[PartialD]_\[Mu] e^A_\
\[Nu] \[Minus] \[PartialD]_\[Nu] e^A_\[Mu] + \[Omega]_\[Mu]^A_B e^B_\[Nu] \
\[Minus] \[Omega]_\[Nu]^A_B e^B_\[Mu] = 0   (the Christoffel terms cancel).\
\>", "Text",ExpressionUUID->"454dddcd-3c12-4445-a38e-b3832684df06"],

Cell["\<\
It determines the canonical spin connection from the frame alone. Write de^A \
= (1/2) C^A_BC e^B \[Wedge] e^C with the STRUCTURE COEFFICIENTS C^A_BC = e_B^\
\[Mu] e_C^\[Nu] (\[PartialD]_\[Mu] e^A_\[Nu] \[Minus] \[PartialD]_\[Nu] e^A_\
\[Mu]) = \[Minus]C^A_CB, lower the first index with \[Eta]17 (C_ABC = \
\[Eta]17_AD C^D_BC), and write the connection with a frame form index, \
\[Omega]_C,AB = e_C^\[Mu] \[Omega]_\[Mu]AB. Then\
\>", "Text",ExpressionUUID->"26c83ec5-1038-c340-9a8a-50581e75d0b8"],

Cell["      \[Omega]_C,AB = \[Minus](1/2) (C_ACB + C_BAC \[Minus] C_CBA),", \
"Text",ExpressionUUID->"73b5573f-7ec0-5941-aaf9-2f07bc4dcda3"],

Cell["\<\
which is antisymmetric in A, B and is the unique solution of the structure \
equation with \[Omega]_C,AB = \[Minus]\[Omega]_C,BA. The code computes both \
sides for all four frames of this section.\
\>", "Text",ExpressionUUID->"0f504dbc-9f0e-8049-8d7e-3b915bbefb22"],

Cell[TextData[{
 StyleBox["A static metric with a radial coordinate. ",
  FontWeight->"Bold"],
 "Let r = x1 (r > 0) and let f(r), h(r) be arbitrary positive functions (code \
fR[x1], hR[x1]):"
}], "Text",ExpressionUUID->"bacd49fe-dd03-784b-a4f8-f3d935f8f4e8"],

Cell["\<\
      ds\.b2 = f(r) dx0\.b2 \[Minus] h(r) dr\.b2 \[Minus] r\.b2 (dx2\.b2 + \
dx3\.b2 + dx4\.b2 + dx5\.b2 + dx6\.b2 + dx7\.b2),   e^0 = \[Sqrt]f dx0,  e^1 \
= \[Sqrt]h dr,  e^k = r dx^k (k = 2 \[Ellipsis] 7).\
\>", "Text",ExpressionUUID->"17dd82e6-972f-be4c-bd29-b41e0c193c84"],

Cell["\<\
(The six directions x2 \[Ellipsis] x7 are flat directions scaled by r; this \
is the 7+1 form of a static \"planar\" metric, NOT a spherically symmetric \
one.) Cartan\[CloseCurlyQuote]s equation gives de^0 = (f\[Prime]/(2\[Sqrt]f)) \
dr \[Wedge] dx0 = \[Minus]\[Omega]^0_1 \[Wedge] e^1 and de^k = dr \[Wedge] \
dx^k = \[Minus]\[Omega]^k_1 \[Wedge] e^1, hence \[Omega]^0_1 = (f\[Prime]/(2\
\[Sqrt](fh))) dx0 and \[Omega]^k_1 = (1/\[Sqrt]h) dx^k, and the spinor \
connection is\
\>", "Text",ExpressionUUID->"c3545cb1-d57c-f545-b079-442adc1bf4d0"],

Cell["\<\
      \[CapitalOmega]_0 = (f\[Prime]/(4\[Sqrt]f \[Sqrt]h)) \
\[CapitalGamma]17[1].\[CapitalGamma]17[0],   \[CapitalOmega]_1 = 0,   \
\[CapitalOmega]_k = (1/(2\[Sqrt]h)) \[CapitalGamma]17[1].\[CapitalGamma]17[k] \
  (k = 2 \[Ellipsis] 7),\
\>", "Text",ExpressionUUID->"54b403ee-902b-de4b-b819-eafa4c5dbce6"],

Cell["\<\
      \[CapitalGamma]^\[Mu] \[CapitalOmega]_\[Mu] = (1/\[Sqrt]h) \
(f\[Prime]/(4f) + 3/r) \[CapitalGamma]17up[1]     (the 3/r = 6 \[Times] \
1/(2r) comes from the six scaled directions).\
\>", "Text",ExpressionUUID->"40c7bfa3-3753-4449-85a6-6de3414f0132"],

Cell["\<\
The covariant Dirac operator is therefore i\[CapitalGamma]^\[Mu]D_\[Mu] \
\[Minus] m = i \[CapitalGamma]17up[0] \[PartialD]0/\[Sqrt]f + i \
\[CapitalGamma]17up[1] (\[PartialD]_r + f\[Prime]/(4f) + 3/r)/\[Sqrt]h + \
\[CapitalSigma]_k i \[CapitalGamma]17up[k] \[PartialD]_k/r \[Minus] m, and \
the rescaling \[Psi] = f^(\[Minus]1/4) r^(\[Minus]3) \[Chi] removes the \
connection: \[CapitalGamma]^\[Mu] D_\[Mu] \[Psi] = f^(\[Minus]1/4) \
r^(\[Minus]3) \[CapitalGamma]^\[Mu] \[PartialD]_\[Mu] \[Chi].\
\>", "Text",ExpressionUUID->"3d50553f-7757-1c4c-8a54-0fe52149d55c"],

Cell[TextData[{
 StyleBox["Coupling to a gauge field. ",
  FontWeight->"Bold"],
 "An abelian gauge field A_\[Mu](X) with charge q enters through the \
gauge-covariant derivative D_\[Mu] \[Psi] = \[PartialD]_\[Mu] \[Psi] + \
\[CapitalOmega]_\[Mu] \[Psi] \[Minus] i q A_\[Mu] \[Psi] (and D_\[Mu] \
\[Psi]bar = \[PartialD]_\[Mu] \[Psi]bar \[Minus] \[Psi]bar \[CapitalOmega]_\
\[Mu] + i q A_\[Mu] \[Psi]bar). Under \[Psi] \[RightArrow] e^{i q \[Alpha]} \
\[Psi], A_\[Mu] \[RightArrow] A_\[Mu] + \[PartialD]_\[Mu] \[Alpha] \
(\[Alpha](X) arbitrary) the Dirac operator is covariant, \
\[CapitalGamma]^\[Mu] D\[Prime]_\[Mu] (e^{iq\[Alpha]} \[Psi]) = \
e^{iq\[Alpha]} \[CapitalGamma]^\[Mu] D_\[Mu] \[Psi], and the current identity \
of section 13 still holds, so the electric current q \[Psi]bar \
\[CapitalGamma]^\[Mu] \[Psi] is conserved. The checks use the cosmological \
frame with arbitrary A_\[Mu](x0, x1, x5), \[Alpha](x0, x1, x5)."
}], "Text",ExpressionUUID->"c30380af-ddc8-0b4e-992c-6cff8863f6f9"],

Cell[CellGroupData[{

Cell["\<\
cartanEq[fd_, simp_] := And @@ Flatten[Table[simp[D[fd[\"e\"][[A, n]], \
X[[m]]] - D[fd[\"e\"][[A, m]], X[[n]]] +
        Sum[fd[\"om\"][[m, A, B]] fd[\"e\"][[B, n]] - fd[\"om\"][[n, A, B]] \
fd[\"e\"][[B, m]], {B, 8}]] === 0, {A, 8}, {m, 8}, {n, m + 1, 8}]];
structureC[fd_, simp_] := Table[simp[Sum[fd[\"ei\"][[m, B]] fd[\"ei\"][[n, \
cc]] (D[fd[\"e\"][[A, n]], X[[m]]] - D[fd[\"e\"][[A, m]], X[[n]]]), {m, 8}, \
{n, 8}]],
   {A, 8}, {B, 8}, {cc, 8}];                                   (* \
structureC[[A+1, B+1, C+1]] = C^A_BC *)
omegaFrame[fd_, simp_] := Table[simp[Sum[fd[\"ei\"][[m, cc]] fd[\"omL\"][[m, \
A, B]], {m, 8}]], {cc, 8}, {A, 8}, {B, 8}];   (* [[C+1, A+1, B+1]] = \
omega_C,AB *)
structureFormula[fd_, simp_] := Module[{cu = structureC[fd, simp], cl, w = \
omegaFrame[fd, simp]},
   cl = Table[\[Eta]17[[A, A]] cu[[A, B, cc]], {A, 8}, {B, 8}, {cc, 8}];
   And @@ Flatten[Table[simp[w[[cc, A, B]] + (cl[[A, cc, B]] + cl[[B, A, cc]] \
- cl[[cc, B, A]])/2] === 0, {cc, 8}, {A, 8}, {B, 8}]]];
check[\"Cartan's first structure equation de^A + omega^A_B ^ e^B == 0 (no \
torsion): cosmological, pp-wave and inhomogeneous frames\",
  cartanEq[fdCos, Simplify] && cartanEq[fdPP, Together] && cartanEq[fdPoly, \
(Together[# /. ptP] &)]]
check[\"structure coefficients: omega_C,AB == -(1/2)(C_ACB + C_BAC - C_CBA) \
with C^A_BC = e_B^mu e_C^nu (d_mu e^A_nu - d_nu e^A_mu): cosmological and \
inhomogeneous frames\",
  structureFormula[fdCos, Simplify] && structureFormula[fdPoly, (Together[# \
/. ptP] &)]]\
\>", "Input",
 CellLabel->
  "In[648]:=",ExpressionUUID->"2f534d25-6633-4945-84c3-d10fc9776a2f"],

Cell[BoxData[
 RowBox[{"\<\"Cartan's first structure equation de^A + omega^A_B ^ e^B == 0 \
(no torsion): cosmological, pp-wave and inhomogeneous frames\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0021312936494255`*^9},
 CellLabel->
  "Out[652]=",ExpressionUUID->"35c327e1-75a4-114f-bd62-a276a59c180e"],

Cell[BoxData[
 RowBox[{"\<\"structure coefficients: omega_C,AB == -(1/2)(C_ACB + C_BAC - \
C_CBA) with C^A_BC = e_B^mu e_C^nu (d_mu e^A_nu - d_nu e^A_mu): cosmological \
and inhomogeneous frames\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021312946592083`*^9},
 CellLabel->
  "Out[653]=",ExpressionUUID->"c087f0c7-5230-4e49-8172-0ba49ed881a2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
simpR = Simplify[#, fR[x1] > 0 && hR[x1] > 0 && x1 > 0] &;
gRad = DiagonalMatrix[{fR[x1], -hR[x1], -x1^2, -x1^2, -x1^2, -x1^2, -x1^2, \
-x1^2}];
cvRad = curvature[gRad, simpR];
eRad = DiagonalMatrix[{Sqrt[fR[x1]], Sqrt[hR[x1]], x1, x1, x1, x1, x1, x1}];
fdRad = frameData[cvRad, eRad, simpR];
frameChecks[\"static radial metric\", cvRad, fdRad, simpR];
check[\"static radial metric: Cartan's first structure equation and \
omega_C,AB == -(1/2)(C_ACB + C_BAC - C_CBA)\", cartanEq[fdRad, simpR] && \
structureFormula[fdRad, simpR]]
check[\"static radial metric: Omega_0 == (f'/(4 Sqrt[f] Sqrt[h])) \
Gamma17[1].Gamma17[0], Omega_1 == 0, Omega_k == (1/(2 Sqrt[h])) \
Gamma17[1].Gamma17[k] (k = 2..7)\",
  simpR[fdRad[\"Om\"][[1]] - fR'[x1]/(4 Sqrt[fR[x1]] Sqrt[hR[x1]]) \
\[CapitalGamma]17[1].\[CapitalGamma]17[0]] == Zero16 && fdRad[\"Om\"][[2]] == \
Zero16 &&
  And @@ Table[simpR[fdRad[\"Om\"][[k + 1]] - 1/(2 Sqrt[hR[x1]]) \
\[CapitalGamma]17[1].\[CapitalGamma]17[k]] == Zero16, {k, 2, 7}]]
check[\"static radial metric: Gamma^mu Omega_mu == (1/Sqrt[h]) (f'/(4 f) + \
3/r) Gamma17up[1]\",
  simpR[Sum[fdRad[\"GamUp\"][[m]].fdRad[\"Om\"][[m]], {m, 8}] - (fR'[x1]/(4 \
fR[x1]) + 3/x1)/Sqrt[hR[x1]] \[CapitalGamma]17up[1]] == Zero16]
DslRad[f_] := Sum[fdRad[\"GamUp\"][[m]].(D[f, X[[m]]] + \
fdRad[\"Om\"][[m]].f), {m, 8}];
chiR = Table[rchi[j][x0, x1, x5], {j, 16}];
check[\"static radial metric: psi = f^(-1/4) r^(-3) chi removes the spin \
connection, Gamma^mu D_mu psi == f^(-1/4) r^(-3) Gamma^mu d_mu chi\",
  simpR[DslRad[fR[x1]^(-1/4) x1^-3 chiR] - fR[x1]^(-1/4) x1^-3 \
Sum[fdRad[\"GamUp\"][[m]].D[chiR, X[[m]]], {m, 8}]] === ConstantArray[0, 16]]
{\"Gamma^mu Omega_mu (static radial metric), coefficient of Gamma17up[1]\" -> \
simpR[(Sum[fdRad[\"GamUp\"][[m]].fdRad[\"Om\"][[m]], {m, \
8}].\[CapitalGamma]17up[1])[[1, 1]]],
 \"Ricci scalar R (static radial metric)\" -> cvRad[\"R\"]}\
\>", "Input",
 CellLabel->
  "In[654]:=",ExpressionUUID->"cfeebd0a-e017-744c-a3a3-15c13055ac07"],

Cell[BoxData[
 RowBox[{"\<\"static radial metric: Cartan's first structure equation and \
omega_C,AB == -(1/2)(C_ACB + C_BAC - C_CBA)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0021312979338837`*^9},
 CellLabel->
  "Out[660]=",ExpressionUUID->"cf56a91b-775f-994a-9138-38afb79d92a4"],

Cell[BoxData[
 RowBox[{"\<\"static radial metric: Omega_0 == (f'/(4 Sqrt[f] Sqrt[h])) \
Gamma17[1].Gamma17[0], Omega_1 == 0, Omega_k == (1/(2 Sqrt[h])) \
Gamma17[1].Gamma17[k] (k = 2..7)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021312979437695`*^9},
 CellLabel->
  "Out[661]=",ExpressionUUID->"041a41f6-b980-ea4d-b7b7-b0929c5f843a"],

Cell[BoxData[
 RowBox[{"\<\"static radial metric: Gamma^mu Omega_mu == (1/Sqrt[h]) (f'/(4 \
f) + 3/r) Gamma17up[1]\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021312979489784`*^9},
 CellLabel->
  "Out[662]=",ExpressionUUID->"e5a11f8f-752e-1f43-a0fe-c987a3ad03a0"],

Cell[BoxData[
 RowBox[{"\<\"static radial metric: psi = f^(-1/4) r^(-3) chi removes the \
spin connection, Gamma^mu D_mu psi == f^(-1/4) r^(-3) Gamma^mu d_mu chi\"\>", 
  "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002131297974039*^9},
 CellLabel->
  "Out[665]=",ExpressionUUID->"ad49b57a-87b2-b04c-ae25-6659a264fa44"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Gamma^mu Omega_mu (static radial metric), coefficient of \
Gamma17up[1]\"\>", "\[Rule]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       RowBox[{"12", " ", 
        RowBox[{"fR", "[", "x1", "]"}]}], "+", 
       RowBox[{"x1", " ", 
        RowBox[{
         SuperscriptBox["fR", "\[Prime]",
          MultilineFunction->None], "[", "x1", "]"}]}]}], 
      RowBox[{"4", " ", "x1", " ", 
       RowBox[{"fR", "[", "x1", "]"}], " ", 
       SqrtBox[
        RowBox[{"hR", "[", "x1", "]"}]]}]]}]}], ",", 
   RowBox[{"\<\"Ricci scalar R (static radial metric)\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["x1", "2"]}], " ", 
        RowBox[{"hR", "[", "x1", "]"}], " ", 
        SuperscriptBox[
         RowBox[{
          SuperscriptBox["fR", "\[Prime]",
           MultilineFunction->None], "[", "x1", "]"}], "2"]}], "+", 
       RowBox[{"12", " ", 
        SuperscriptBox[
         RowBox[{"fR", "[", "x1", "]"}], "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"5", " ", 
           RowBox[{"hR", "[", "x1", "]"}]}], "-", 
          RowBox[{"x1", " ", 
           RowBox[{
            SuperscriptBox["hR", "\[Prime]",
             MultilineFunction->None], "[", "x1", "]"}]}]}], ")"}]}], "+", 
       RowBox[{"x1", " ", 
        RowBox[{"fR", "[", "x1", "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "x1"}], " ", 
           RowBox[{
            SuperscriptBox["fR", "\[Prime]",
             MultilineFunction->None], "[", "x1", "]"}], " ", 
           RowBox[{
            SuperscriptBox["hR", "\[Prime]",
             MultilineFunction->None], "[", "x1", "]"}]}], "+", 
          RowBox[{"2", " ", 
           RowBox[{"hR", "[", "x1", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"6", " ", 
              RowBox[{
               SuperscriptBox["fR", "\[Prime]",
                MultilineFunction->None], "[", "x1", "]"}]}], "+", 
             RowBox[{"x1", " ", 
              RowBox[{
               SuperscriptBox["fR", "\[Prime]\[Prime]",
                MultilineFunction->None], "[", "x1", "]"}]}]}], ")"}]}]}], 
         ")"}]}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", 
       SuperscriptBox["x1", "2"], " ", 
       SuperscriptBox[
        RowBox[{"fR", "[", "x1", "]"}], "2"], " ", 
       SuperscriptBox[
        RowBox[{"hR", "[", "x1", "]"}], "2"]}], ")"}]}]}]}], "}"}]], "Output",
 CellChangeTimes->{4.0021312979849854`*^9},
 CellLabel->
  "Out[666]=",ExpressionUUID->"6d56dabc-5cdb-4843-abec-278c948f6115"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
AG = Table[aGauge[m][x0, x1, x5], {m, 8}]; alphaG = alGauge[x0, x1, x5];
DslA[f_, av_] := Sum[fdCos[\"GamUp\"][[m]].(D[f, X[[m]]] + \
fdCos[\"Om\"][[m]].f - I qG av[[m]] f), {m, 8}];
check[\"U(1) gauge covariance: Gamma^mu (D_mu - i q A'_mu)(e^{i q alpha} psi) \
== e^{i q alpha} Gamma^mu (D_mu - i q A_mu) psi with A'_mu = A_mu + d_mu \
alpha\",
  Together[Expand[Exp[-I qG alphaG] DslA[Exp[I qG alphaG] psiF, AG + \
Table[D[alphaG, X[[m]]], {m, 8}]] - DslA[psiF, AG]]] === ConstantArray[0, 16]]
DpsiA = Table[DpsiCos[[m]] - I qG AG[[m]] psiF, {m, 8}]; DpsibA = \
Table[DpsibCos[[m]] + I qG AG[[m]] psibF, {m, 8}];
check[\"current identity with the gauge field: d_mu(sqrt|g| psibar Gamma^mu \
psi) == sqrt|g| [(D_mu psibar) Gamma^mu psi + psibar Gamma^mu D_mu psi], D \
including -i q A_mu\",
  Together[Sum[D[sqgCos psibF.fdCos[\"GamUp\"][[m]].psiF, X[[m]]], {m, 8}] - \
sqgCos Sum[DpsibA[[m]].fdCos[\"GamUp\"][[m]].psiF + \
psibF.fdCos[\"GamUp\"][[m]].DpsiA[[m]], {m, 8}]] === 0]\
\>", "Input",
 CellLabel->
  "In[667]:=",ExpressionUUID->"b418fade-9350-ff4d-af13-19fb60261583"],

Cell[BoxData[
 RowBox[{"\<\"U(1) gauge covariance: Gamma^mu (D_mu - i q A'_mu)(e^{i q \
alpha} psi) == e^{i q alpha} Gamma^mu (D_mu - i q A_mu) psi with A'_mu = A_mu \
+ d_mu alpha\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002131298043831*^9},
 CellLabel->
  "Out[669]=",ExpressionUUID->"f3c366c8-1b39-d341-8ec8-b5fc22ee961f"],

Cell[BoxData[
 RowBox[{"\<\"current identity with the gauge field: d_mu(sqrt|g| psibar \
Gamma^mu psi) == sqrt|g| [(D_mu psibar) Gamma^mu psi + psibar Gamma^mu D_mu \
psi], D including -i q A_mu\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002131298094267*^9},
 CellLabel->
  "Out[671]=",ExpressionUUID->"773da72c-e720-e741-a0d7-4968b99b5811"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
14. The three epochs: primordial (near x0 = 0), modern, far future\
\>", "Section",ExpressionUUID->"31e41fae-72b2-f445-9fd0-de30945c14b9"],

Cell["\<\
For the cosmological metric with a homogeneous source T^\[Mu]_\[Nu] = diag(\
\[Epsilon], \[Minus]pa, \[Minus]pa, \[Minus]pa, \[Minus]pb, \[Minus]pb, \
\[Minus]pb, \[Minus]pb) (energy density \[Epsilon], pressure pa along \
ordinary space and pb along the auxiliary space) the Einstein\[Dash]Lovelock \
equations of section 12 are three ordinary differential equations,\
\>", "Text",ExpressionUUID->"a04c9003-f773-414e-8f32-9d5cb686aa48"],

Cell["\<\
      \[CapitalSigma]_k \[Alpha]_k E^(k)0_0 = \[Kappa] \[Epsilon],    \
\[CapitalSigma]_k \[Alpha]_k E^(k)1_1 = \[Minus]\[Kappa] pa,    \
\[CapitalSigma]_k \[Alpha]_k E^(k)4_4 = \[Minus]\[Kappa] pb,\
\>", "Text",ExpressionUUID->"7dfa6882-f690-7849-8feb-3ef0f81ac456"],

Cell["\<\
with the closed forms of section 12.6, and the conservation law \[Epsilon]\
\[Prime] + 3Ha (\[Epsilon] + pa) + 4Hb (\[Epsilon] + pb) = 0 follows from \
them. The three epochs of this notebook are exact solutions or limits of \
these equations.\
\>", "Text",ExpressionUUID->"76fb275a-1f9e-a04c-92c7-4c5110e34c89"],

Cell[CellGroupData[{

Cell["14.1 Primordial epoch near x0 = 0: Kasner solutions", "Subsection",ExpressionUUID->"3afff1ac-e5b8-1d40-9021-55b8d2c0acd0"],

Cell["\<\
Near x0 = 0 a power law a = x0^p, b = x0^q is the natural ansatz. Every term \
of E^(k) then scales as x0^(\[Minus]2k), so for x0 \[RightArrow] 0 the \
highest Lovelock order with a non-zero coupling dominates (the cubic one if \
\[Alpha]_3 \[NotEqual] 0), and matter with \[Epsilon] growing more slowly \
than x0^(\[Minus]2k) can be neglected. The vacuum solutions of each order \
separately are:\
\>", "Text",ExpressionUUID->"c429ddc4-18a0-bd47-9b13-ab9c7fe2883e"],

Cell["\<\
Einstein (k = 1): 3p + 4q = 1 and 3p\.b2 + 4q\.b2 = 1, i.e. p = (1 \
\[PlusMinus] 2\[Sqrt]2)/7, q = (2 \[MinusPlus] 3\[Sqrt]2)/14. On the branch p \
= 0.547, q = \[Minus]0.160 ordinary space expands while the auxiliary space \
contracts: dynamical compactification of x4 \[Ellipsis] x7.\
\>", "Item",ExpressionUUID->"91e507cd-cdfb-334b-9b23-e6e02d75e400"],

Cell["\<\
Gauss\[Dash]Bonnet (k = 2): 3p + 4q = 3 and a cubic equation for p with three \
real roots.\
\>", "Item",ExpressionUUID->"b4a1d319-c18f-2a49-8dc8-743ed33bf346"],

Cell[CellGroupData[{

Cell["\<\
Cubic Lovelock (k = 3): the non-degenerate solution (p, q) = (\[Minus]15/7, \
20/7) with 3p + 4q = 5, and the degenerate families q = 0 (static auxiliary \
space) and p = 0, for which E^(3) vanishes identically.\
\>", "Item",ExpressionUUID->"3238186c-bc6d-3e4b-8d88-23d4014bb8a9"],

Cell[CellGroupData[{

Cell["\<\
(* a = x0^pK, b = x0^qK: Ha = pK/x0, Hb = qK/x0, Ha' = -pK/x0^2, Hb' = \
-qK/x0^2 in the closed forms of section 12.6 *)
EKas = Table[Factor[Expand[x0^(2 k) toH[ECos[[k + 1, c, c]]] /. {Ha -> pK/x0, \
Hb -> qK/x0, dHa -> -pK/x0^2, dHb -> -qK/x0^2}]], {k, 1, 3}, {c, {1, 2, 5}}];
gKas = DiagonalMatrix[{1, -x0^(2 pK), -x0^(2 pK), -x0^(2 pK), -x0^(2 qK), \
-x0^(2 qK), -x0^(2 qK), -x0^(2 qK)}];
check[\"Kasner metric: the Einstein tensor computed directly from the metric \
equals the closed form (x0^2 G^mu_mu, mu = 0, 1, 4)\",
  Simplify[x0^2 Diagonal[curvature[gKas, PowerExpand[Together[#]] \
&][\"G\"]][[{1, 2, 5}]] - EKas[[1]]] === {0, 0, 0}]
check[\"Einstein Kasner: (p, q) = ((1+2Sqrt[2])/7, (2-3Sqrt[2])/14) and \
((1-2Sqrt[2])/7, (2+3Sqrt[2])/14) solve E^(1) == 0\",
  And @@ Flatten[Table[Simplify[EKas[[1]] /. {pK -> s[[1]], qK -> s[[2]]}] == \
{0, 0, 0}, {s, {{(1 + 2 Sqrt[2])/7, (2 - 3 Sqrt[2])/14}, {(1 - 2 Sqrt[2])/7, \
(2 + 3 Sqrt[2])/14}}}]]]
gbCubic = Expand[64 (4 pK^3 + 18 pK^2 qK + 12 pK qK^2 + qK^3) /. qK -> (3 - 3 \
pK)/4];
gbRoots = Sort[pK /. NSolve[gbCubic == 0, pK, Reals, WorkingPrecision -> 30]];
check[\"Gauss-Bonnet Kasner: 3 real roots of the cubic; (p, (3-3p)/4) solve \
E^(2) == 0\",
  Length[gbRoots] == 3 && And @@ Table[Max[Abs[N[EKas[[2]] /. {pK -> r, qK -> \
(3 - 3 r)/4}, 25]]] < 10^-18, {r, gbRoots}]]
check[\"cubic Lovelock Kasner: (p, q) = (-15/7, 20/7) solves E^(3) == 0; \
E^(3) == 0 identically for q = 0 and for p = 0\",
  Simplify[EKas[[3]] /. {pK -> -15/7, qK -> 20/7}] == {0, 0, 0} && \
Simplify[EKas[[3]] /. qK -> 0] == {0, 0, 0} && Simplify[EKas[[3]] /. pK -> 0] \
== {0, 0, 0}]
{\"x0^2 E^(1) (00, 11, 44)\" -> EKas[[1]], \"Gauss-Bonnet cubic\" -> gbCubic, \
\"Gauss-Bonnet Kasner p\" -> N[gbRoots, 15], \"Einstein Kasner p, q\" -> \
N[{(1 + 2 Sqrt[2])/7, (2 - 3 Sqrt[2])/14}, 15]}\
\>", "Input",
 CellLabel->
  "In[672]:=",ExpressionUUID->"ff97f6db-216a-4b4f-b1c9-d6ede4894d9d"],

Cell[BoxData[
 RowBox[{"\<\"Kasner metric: the Einstein tensor computed directly from the \
metric equals the closed form (x0^2 G^mu_mu, mu = 0, 1, 4)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0021312984242687`*^9},
 CellLabel->
  "Out[675]=",ExpressionUUID->"544c8a30-73d5-8e4c-8216-ee91661e1646"],

Cell[BoxData[
 RowBox[{"\<\"Einstein Kasner: (p, q) = ((1+2Sqrt[2])/7, (2-3Sqrt[2])/14) and \
((1-2Sqrt[2])/7, (2+3Sqrt[2])/14) solve E^(1) == 0\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002131298439129*^9},
 CellLabel->
  "Out[676]=",ExpressionUUID->"44e8441c-7845-a14a-b405-8c96335c83b8"],

Cell[BoxData[
 RowBox[{"\<\"Gauss-Bonnet Kasner: 3 real roots of the cubic; (p, (3-3p)/4) \
solve E^(2) == 0\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002131298451338*^9},
 CellLabel->
  "Out[679]=",ExpressionUUID->"46c13dd7-f1f4-384b-a8a6-81398a07985a"],

Cell[BoxData[
 RowBox[{"\<\"cubic Lovelock Kasner: (p, q) = (-15/7, 20/7) solves E^(3) == \
0; E^(3) == 0 identically for q = 0 and for p = 0\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0021312984530067`*^9},
 CellLabel->
  "Out[680]=",ExpressionUUID->"9036c175-5c92-6949-8abe-4fad63ade188"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"x0^2 E^(1) (00, 11, 44)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"3", " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["pK", "2"], "+", 
         RowBox[{"4", " ", "pK", " ", "qK"}], "+", 
         RowBox[{"2", " ", 
          SuperscriptBox["qK", "2"]}]}], ")"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", "pK"}], "+", 
       RowBox[{"3", " ", 
        SuperscriptBox["pK", "2"]}], "-", 
       RowBox[{"4", " ", "qK"}], "+", 
       RowBox[{"8", " ", "pK", " ", "qK"}], "+", 
       RowBox[{"10", " ", 
        SuperscriptBox["qK", "2"]}]}], ",", 
      RowBox[{"3", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "pK"}], "+", 
         RowBox[{"2", " ", 
          SuperscriptBox["pK", "2"]}], "-", "qK", "+", 
         RowBox[{"3", " ", "pK", " ", "qK"}], "+", 
         RowBox[{"2", " ", 
          SuperscriptBox["qK", "2"]}]}], ")"}]}]}], "}"}]}], ",", 
   RowBox[{"\<\"Gauss-Bonnet cubic\"\>", "\[Rule]", 
    RowBox[{"27", "+", 
     RowBox[{"351", " ", "pK"}], "+", 
     RowBox[{"81", " ", 
      SuperscriptBox["pK", "2"]}], "-", 
     RowBox[{"203", " ", 
      SuperscriptBox["pK", "3"]}]}]}], ",", 
   RowBox[{"\<\"Gauss-Bonnet Kasner p\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.08350178761210574242397629473091052463`15."}], ",", 
