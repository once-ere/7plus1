       Scaled[0.02]}, {
       Scaled[0.05], 
       Scaled[0.05]}}, Ticks -> {Automatic, Automatic}], 
   FormBox[
    FormBox[
     TemplateBox[{
      "\"g = 6/5 g_c (broken)\"", "\"g = g_c\"", 
       "\"g = 4/5 g_c (symmetric)\""}, "LineLegend", 
