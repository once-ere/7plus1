Cell[CellGroupData[{

Cell["\<\
check[\"\[Tau]O[A] (A = 1..7): real, antisymmetric, \[Tau]O[A].\[Tau]O[A] == \
-ID8\",
  And @@ Table[SubsetQ[{-1, 0, 1}, Union[Flatten[\[Tau]O[A]]]] && Transpose[\
\[Tau]O[A]] == -\[Tau]O[A] && \[Tau]O[A].\[Tau]O[A] == -ID8, {A, 1, 7}]]
check[\"\[Tau]O[A] anticommute: \[Tau]O[A].\[Tau]O[B] == \
-\[Tau]O[B].\[Tau]O[A] (A != B, A,B = 1..7)\",
  And @@ Flatten[Table[If[A != B, \[Tau]O[A].\[Tau]O[B] == \
-\[Tau]O[B].\[Tau]O[A], True], {A, 1, 7}, {B, 1, 7}]]]
check[\"mirror of 4+4: (\[Tau]O[A].\[Tau]Obar[B] + \
\[Tau]O[B].\[Tau]Obar[A])/2 == gO[[A+1,B+1]] ID8\",
  And @@ Flatten[Table[(\[Tau]O[A].\[Tau]Obar[B] + \
\[Tau]O[B].\[Tau]Obar[A])/2 == gO[[A + 1, B + 1]] ID8, {A, 0, 7}, {B, 0, 7}]]]
check[\"mirror of 4+4: (\[Tau]Obar[A].\[Tau]O[B] + \
\[Tau]Obar[B].\[Tau]O[A])/2 == gO[[A+1,B+1]] ID8\",
  And @@ Flatten[Table[(\[Tau]Obar[A].\[Tau]O[B] + \
\[Tau]Obar[B].\[Tau]O[A])/2 == gO[[A + 1, B + 1]] ID8, {A, 0, 7}, {B, 0, 7}]]]
check[\"mirror of 4+4: \[Tau]O[1].\[Tau]O[2]...\[Tau]O[7] == ID8\", Dot @@ \
Table[\[Tau]O[A], {A, 1, 7}] == ID8]
check[\"mirror of 4+4: \[Tau]Obar[A] == gO.Transpose[\[Tau]O[A]].gO, as \
\[Tau]bar[A] == \[Sigma].Transpose[\[Tau][A]].\[Sigma]\",
  And @@ Table[\[Tau]Obar[A] == gO.Transpose[\[Tau]O[A]].gO, {A, 0, 7}]]
check[\"\[Tau]O[4..7] are products of three split \[Tau]: \[Tau]O[4] == \
\[Tau][5].\[Tau][6].\[Tau][7], \[Tau]O[5] == -\[Tau][4].\[Tau][6].\[Tau][7], \
\[Tau]O[6] == \[Tau][4].\[Tau][5].\[Tau][7], \[Tau]O[7] == \
-\[Tau][4].\[Tau][5].\[Tau][6]\",
  \[Tau]O[4] == \[Tau][5].\[Tau][6].\[Tau][7] && \[Tau]O[5] == -\[Tau][4].\
\[Tau][6].\[Tau][7] && \[Tau]O[6] == \[Tau][4].\[Tau][5].\[Tau][7] && \
\[Tau]O[7] == -\[Tau][4].\[Tau][5].\[Tau][6]]\
\>", "Input",
 CellLabel->"In[80]:=",ExpressionUUID->"2982e838-956b-4d42-af9a-da2958d700f1"],

Cell[BoxData[
 RowBox[{"\<\"\[Tau]O[A] (A = 1..7): real, antisymmetric, \
\[Tau]O[A].\[Tau]O[A] == -ID8\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020404792696285`*^9},
 CellLabel->"Out[80]=",ExpressionUUID->"a5414ad2-ec9d-be49-849a-d9ce48898c54"],

Cell[BoxData[
 RowBox[{"\<\"\[Tau]O[A] anticommute: \[Tau]O[A].\[Tau]O[B] == -\[Tau]O[B].\
\[Tau]O[A] (A != B, A,B = 1..7)\"\>", "\[Rule]", "True"}]], "Output",
