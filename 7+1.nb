   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellChangeTimes->{4.0020509108401375`*^9},
 CellLabel->"Out[59]=",ExpressionUUID->"d1e22836-249e-344a-b6e6-db5b16bb4574"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
(* the table exactly as printed by 4+4.nb (Out[325]) *)
gridx44From4p4nb = {{x, eA[1], eA[2], eA[3], eA[4], eA[5], eA[6], eA[7], \
eA[8]},
   {eA[1], eA[1], eA[2], eA[3], eA[4], eA[5], eA[6], eA[7], eA[8]},
   {eA[2], eA[2], -eA[1], -eA[4], eA[3], -eA[6], eA[5], eA[8], -eA[7]},
   {eA[3], eA[3], eA[4], -eA[1], -eA[2], -eA[7], -eA[8], eA[5], eA[6]},
   {eA[4], eA[4], -eA[3], eA[2], -eA[1], -eA[8], eA[7], -eA[6], eA[5]},
   {eA[5], eA[5], eA[6], eA[7], eA[8], eA[1], eA[2], eA[3], eA[4]},
   {eA[6], eA[6], -eA[5], eA[8], -eA[7], -eA[2], eA[1], -eA[4], eA[3]},
   {eA[7], eA[7], -eA[8], -eA[5], eA[6], -eA[3], eA[4], eA[1], -eA[2]},
   {eA[8], eA[8], eA[7], -eA[6], -eA[5], -eA[4], -eA[3], eA[2], eA[1]}};
check[\"4+4: gridx44 is identical to the split-octonion table printed by \
4+4.nb\", First[gridx44] === gridx44From4p4nb]\
\>", "Input",
 CellLabel->"In[60]:=",ExpressionUUID->"dc71b770-b051-374a-9944-5e3161c5439b"],

Cell[BoxData[
 RowBox[{"\<\"4+4: gridx44 is identical to the split-octonion table printed \
by 4+4.nb\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020509108401375`*^9},
 CellLabel->"Out[62]=",ExpressionUUID->"7a31740f-335e-044c-ace1-0c32d7c1daa8"]
}, Open  ]],

Cell["\<\
For later use: the split product in 0-based form. LS[A] is the left \
multiplication by eA[A+1]; a split octonion is the coefficient list {x0, \
\[Ellipsis], x7} of x0 eA[1] + \[Ellipsis] + x7 eA[8].\
\>", "Text",ExpressionUUID->"a7fb0557-d623-6044-89af-871456bb63f3"],

Cell[CellGroupData[{

Cell["\<\
LS[A_] := LS[A] = FullSimplify[gAB44[[A + 1, A + 1]] \
E44[hUSE].\[Tau][A].E44inv[hUSE]];
sMul[xx_List, yy_List] := Sum[xx[[A + 1]] LS[A], {A, 0, 7}].yy;
sConj[xx_List] := Join[{xx[[1]]}, -Rest[xx]];
sNorm2[xx_List] := xx.gAB44.xx;
check[\"4+4: LS[A] are signed permutation matrices (constants 0, \
\[PlusMinus]1)\",
  And @@ Table[MatrixQ[LS[A], IntegerQ] && LS[A].Transpose[LS[A]] == ID8, {A, \
0, 7}]]\
\>", "Input",
 CellLabel->"In[63]:=",ExpressionUUID->"b4b2b95f-aa1c-a946-951c-99d715713a6e"],

Cell[BoxData[
 RowBox[{"\<\"4+4: LS[A] are signed permutation matrices (constants 0, \
\[PlusMinus]1)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020509108647194`*^9},
 CellLabel->"Out[67]=",ExpressionUUID->"81964fbd-f33c-fe46-b995-1c2fa7c4b9de"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
2.4 Split octonions: composition algebra, but not a division algebra\
\>", "Subsection",ExpressionUUID->"3096adab-f0ec-e447-bc86-f0033dca0b30"],

Cell[CellGroupData[{

Cell["\<\
xs = Array[a, 8, 0]; ys = Array[b, 8, 0]; zs = Array[c, 8, 0];
check[\"split: eA[1] is the identity; eA[2..4]^2 == -eA[1]; eA[5..8]^2 == \
+eA[1]\",
  And @@ Table[sMul[UnitVector[8, 1], UnitVector[8, k]] == UnitVector[8, k] \
&& sMul[UnitVector[8, k], UnitVector[8, 1]] == UnitVector[8, k], {k, 1, 8}] &&
  And @@ Table[sMul[UnitVector[8, k], UnitVector[8, k]] == -UnitVector[8, 1], \
{k, 2, 4}] &&
  And @@ Table[sMul[UnitVector[8, k], UnitVector[8, k]] == UnitVector[8, 1], \
{k, 5, 8}]]
check[\"split: x x\:0304 == N(x) eA[1] with N = \[Eta]4488 (symbolic)\", \
Expand[sMul[xs, sConj[xs]] - sNorm2[xs] UnitVector[8, 1]] === zero8]
check[\"split: N(xy) == N(x) N(y) (symbolic)\", Expand[sNorm2[sMul[xs, ys]] - \
sNorm2[xs] sNorm2[ys]] === 0]
check[\"split: alternative x(xy) == (xx)y and (yx)x == y(xx) (symbolic)\",
  Expand[sMul[xs, sMul[xs, ys]] - sMul[sMul[xs, xs], ys]] === zero8 && \
Expand[sMul[sMul[ys, xs], xs] - sMul[ys, sMul[xs, xs]]] === zero8]
zeroDivisor = sMul[UnitVector[8, 1] + UnitVector[8, 5], UnitVector[8, 1] - \
UnitVector[8, 5]]
check[\"split: (eA[1] + eA[5])(eA[1] - eA[5]) == 0 with both factors nonzero: \
NOT a division algebra\", zeroDivisor == zero8]\
\>", "Input",
 CellLabel->"In[68]:=",ExpressionUUID->"56618ce0-4a02-bc47-ac2a-8140eca431b8"],

Cell[BoxData[
 RowBox[{"\<\"split: eA[1] is the identity; eA[2..4]^2 == -eA[1]; eA[5..8]^2 \
== +eA[1]\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020509108657207`*^9},
 CellLabel->"Out[69]=",ExpressionUUID->"a1190ed9-2321-7d4f-a302-c4c482060ed4"],

Cell[BoxData[
 RowBox[{"\<\"split: x x\:0304 == N(x) eA[1] with N = \[Eta]4488 (symbolic)\"\
\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020509108657207`*^9},
 CellLabel->"Out[70]=",ExpressionUUID->"4d1c561f-1379-1a46-bff5-acac8aef313f"],

Cell[BoxData[
 RowBox[{"\<\"split: N(xy) == N(x) N(y) (symbolic)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002050910885233*^9},
 CellLabel->"Out[71]=",ExpressionUUID->"a582c44f-640d-604f-a6d9-c679a9f1d15c"],

Cell[BoxData[
 RowBox[{"\<\"split: alternative x(xy) == (xx)y and (yx)x == y(xx) (symbolic)\
\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002050910888239*^9},
 CellLabel->"Out[72]=",ExpressionUUID->"36925497-d091-6945-b706-d2c6407e1cff"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}],
   "}"}]], "Output",
 CellChangeTimes->{4.0020509108903427`*^9},
 CellLabel->"Out[73]=",ExpressionUUID->"86a55d46-6e93-1644-a22a-be1022a8a626"],

Cell[BoxData[
 RowBox[{"\<\"split: (eA[1] + eA[5])(eA[1] - eA[5]) == 0 with both factors \
nonzero: NOT a division algebra\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020509108903427`*^9},
 CellLabel->"Out[74]=",ExpressionUUID->"40f892e7-4f4d-174f-a225-935d3e164671"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
3. The octonions: a real realization mirroring the split octonions\
\>", "Section",ExpressionUUID->"a338d46d-e8bf-fe41-99be-7d72c35cb71b"],

Cell[CellGroupData[{

Cell["3.1 From the split matrices \[Tau] to the octonionic matrices \[Tau]O", \
"Subsection",ExpressionUUID->"a698acbd-9eb5-7449-92db-bcfb6a77cdbd"],

Cell["\<\
The split matrices \[Tau][1], \[Tau][2], \[Tau][3] already square to \
\[Minus]ID8, but \[Tau][4], \[Ellipsis], \[Tau][7] square to +ID8, whereas \
all seven imaginary octonion units must square to \[Minus]1. The 4+4 matrix \
\[Sigma] = \[Tau][1].\[Tau][2].\[Tau][3] = \[Tau][4].\[Tau][5].\[Tau][6].\
\[Tau][7] commutes with \[Tau][1..3], anticommutes with \[Tau][4..7] and \
squares to +ID8. Multiplying the four split matrices by \[Sigma] therefore \
turns them into matrices that square to \[Minus]ID8, without disturbing \
\[Tau][1..3] or any anticommutation relation:\
\>", "Text",ExpressionUUID->"4d0ffb0b-eda6-4e40-82cf-d5eb90da7e94"],

Cell["\<\
      (\[Tau][k].\[Sigma]).(\[Tau][k].\[Sigma]) = \
\[Minus]\[Tau][k].\[Tau][k].\[Sigma].\[Sigma] = \[Minus]ID8   (k = 4, \
\[Ellipsis], 7).\
\>", "Text",ExpressionUUID->"db9d5b1b-6c62-0340-8f14-46d088d17158"],

Cell["\<\
Over the complex numbers one would multiply \[Tau][k] by i; the real matrix \
\[Sigma] is the real substitute for that factor i. Definition (all entries 0, \
\[PlusMinus]1):\
\>", "Text",ExpressionUUID->"80662005-dd4a-2d47-aef7-54b3d12c9019"],

Cell["\<\
      \[Tau]O[0] = ID8,   \[Tau]O[A] = \[Tau][A] (A = 1, 2, 3),   \[Tau]O[A] \
= \[Tau][A].\[Sigma] (A = 4, \[Ellipsis], 7),   \[Tau]Obar[A] = Transpose[\
\[Tau]O[A]].\
\>", "Text",ExpressionUUID->"39e2b4d2-6f76-5343-8819-b08e0410c988"],

Cell[CellGroupData[{

Cell["\<\
\[Tau]O[0] = ID8;
Do[\[Tau]O[A] = \[Tau][A], {A, 1, 3}];
Do[\[Tau]O[A] = \[Tau][A].\[Sigma], {A, 4, 7}];
Do[\[Tau]Obar[A] = Transpose[\[Tau]O[A]], {A, 0, 7}];
Grid[Partition[Table[Column[{Style[\"\[Tau]O[\" <> ToString[A] <> \"]\", \
Bold], MatrixForm[\[Tau]O[A]]}, Alignment -> Center], {A, 0, 7}], 4], \
Spacings -> {2, 2}]\
\>", "Input",
 CellLabel->"In[75]:=",ExpressionUUID->"0a477964-1e93-e049-8e57-85a493b8d1fd"],

