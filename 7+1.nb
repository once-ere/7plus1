Cell["allChecksPassed = AllTrue[Values[checks], TrueQ]", "Input",
 CellLabel->
  "In[286]:=",ExpressionUUID->"0934e5eb-1cfb-d049-8794-b187da225476"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{4.002049474348608*^9},
 CellLabel->
