Cell[CellGroupData[{

Cell["15.3 The covariant nonlinear field equation", "Subsection",ExpressionUUID->"4c44111c-5d28-d84c-acd4-f054fc146dad"],

Cell["\<\
In a gravitational field the self-coupled field obeys, with the covariant \
derivative D_\[Mu] = \[PartialD]_\[Mu] + \[CapitalOmega]_\[Mu] of section 13 \
and L = \[Sqrt]|g| [\[Psi]bar (i \[CapitalGamma]^\[Mu] D_\[Mu] \[Minus] m) \
\[Psi] + L_self],\
\>", "Text",ExpressionUUID->"c7fc7088-4bb2-7f4a-ae7a-b27eedec821d"],

Cell["\<\
      (i \[CapitalGamma]^\[Mu](X) D_\[Mu] \[Minus] m) \[Psi] = \
\[CapitalSigma]_{r=0}^{8} g_r \[CapitalSigma]_{|K|=r} (\[Psi]bar \
\[CapitalTheta]_K \[Psi]) \[CapitalTheta]^K \[Psi].\
\>", "Text",ExpressionUUID->"5951a78f-1c93-3142-b550-0180b65a30b6"],

Cell["\<\
The bilinears are Grassmann-even, so the left derivative with respect to \
\[Psi]bar_a acts on them as on commuting variables; the check differentiates \
L_self with symbolic \[Psi]bar, a random Gaussian-integer \[Psi] and random \
integer couplings.\
\>", "Text",ExpressionUUID->"9074a76a-58e9-a945-bf52-5d3fb4e55382"],

Cell[CellGroupData[{

Cell["\<\
pbS = Array[pbar, 16]; psN = rndSpinor[]; gN9 = RandomInteger[{-5, 5}, 9];
LselfS = -Sum[gN9[[rk[K] + 1]]/2 \[Eta]K[K] (pbS.\[CapitalTheta]up[K].psN)^2, \
{K, mIdx}];
check[\"nonlinear field equation: dL_self/d psibar_a == -Sum_r g_r Sum_K \
(psibar Theta_K psi) (Theta^K psi)_a\",
  Expand[D[LselfS, {pbS}] + Sum[gN9[[rk[K] + 1]] \
(pbS.\[CapitalTheta]dn[K].psN) \[CapitalTheta]up[K].psN, {K, mIdx}]] === \
ConstantArray[0, 16]]\
\>", "Input",
 CellLabel->
  "In[744]:=",ExpressionUUID->"dc17962b-cb6c-794e-9273-ce22bfbf1fa3"],

Cell[BoxData[
 RowBox[{"\<\"nonlinear field equation: dL_self/d psibar_a == -Sum_r g_r \
Sum_K (psibar Theta_K psi) (Theta^K psi)_a\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0021471992252865`*^9},
 CellLabel->
  "Out[746]=",ExpressionUUID->"25de2775-43db-b44d-8cee-57e46cd089df"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["15.4 Chirality in a gravitational field", "Subsection",ExpressionUUID->"5328e761-3c0a-3440-b4f2-4a4f4d9c3295"],

Cell["\<\
\[Chi]17 commutes with every generator (1/4)[\[CapitalGamma]17up[A], \
\[CapitalGamma]17up[B]], hence with every spin connection \[CapitalOmega]_\
\[Mu]: gravity does not mix the chiral halves. In the cosmological spacetime, \
with \[Psi] = E_L \[Phi]_L + E_R \[Phi]_R (section 7.10) and (\[Tau]O\
\[CenterDot]\[PartialD])_(a,b) = (1/a) \[CapitalSigma]_{i=1..3} \[Tau]O[i] \
\[PartialD]_i + (1/b) \[CapitalSigma]_{k=4..7} \[Tau]O[k] \[PartialD]_k, the \
two coupled 8-component equations of section 7.11 become\
\>", "Text",ExpressionUUID->"e1d24105-19f0-294e-b5d6-41532923f345"],

Cell["\<\
      (i \[PartialD]_0 + i (3Ha/2 + 2Hb) + \
(\[Tau]O\[CenterDot]\[PartialD])_(a,b)) \[Phi]_L = m \[Phi]_R,      (i \
\[PartialD]_0 + i (3Ha/2 + 2Hb) \[Minus] \
(\[Tau]O\[CenterDot]\[PartialD])_(a,b)) \[Phi]_R = m \[Phi]_L.\
\>", "Text",ExpressionUUID->"d8e3376d-77e1-ef49-823d-b12eb0267e1a"],

Cell[CellGroupData[{

Cell["\<\
check[\"chi17 commutes with every generator (Gamma17up[A].Gamma17up[B] - \
Gamma17up[B].Gamma17up[A])/4, hence with every Omega_mu\",
  And @@ Flatten[Table[\[Chi]17.(\[CapitalGamma]17up[A].\[CapitalGamma]17up[B]\
 - \[CapitalGamma]17up[B].\[CapitalGamma]17up[A]) ==
       (\[CapitalGamma]17up[A].\[CapitalGamma]17up[B] - \
\[CapitalGamma]17up[B].\[CapitalGamma]17up[A]).\[Chi]17, {A, 0, 7}, {B, A + \
1, 7}]]]
phiLc = Table[lc[j][x0, x1, x5], {j, 8}]; phiRc = Table[rc[j][x0, x1, x5], \
{j, 8}];
psiLR = EL.phiLc + ER.phiRc;
dirLR = I Sum[fdCos[\"GamUp\"][[m]].(D[psiLR, X[[m]]] + \
fdCos[\"Om\"][[m]].psiLR), {m, 8}] - mD psiLR;
hubC = 3 a3'[x0]/(2 a3[x0]) + 2 b4'[x0]/b4[x0];
tauDab[f_] := Sum[\[Tau]O[i].D[f, X[[i + 1]]], {i, 1, 3}]/a3[x0] + \
Sum[\[Tau]O[k].D[f, X[[k + 1]]], {k, 4, 7}]/b4[x0];
check[\"curved chiral equations: E_L^dag.Gamma17[0].(i Gamma^mu D_mu - m) psi \
== (i d0 + i(3Ha/2 + 2Hb) + tauO.d) phi_L - m phi_R, and the same for E_R \
with -tauO.d\",
  Simplify[ConjugateTranspose[EL].\[CapitalGamma]17[0].dirLR - (I D[phiLc, \
x0] + I hubC phiLc + tauDab[phiLc] - mD phiRc)] === ConstantArray[0, 8] &&
  Simplify[ConjugateTranspose[ER].\[CapitalGamma]17[0].dirLR - (I D[phiRc, \
x0] + I hubC phiRc - tauDab[phiRc] - mD phiLc)] === ConstantArray[0, 8]]\
\>", "Input",
 CellLabel->
  "In[747]:=",ExpressionUUID->"7cb7f02f-26da-8146-ac8b-f7fdb9553640"],

Cell[BoxData[
 RowBox[{"\<\"chi17 commutes with every generator (Gamma17up[A].Gamma17up[B] \
- Gamma17up[B].Gamma17up[A])/4, hence with every Omega_mu\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002147199248207*^9},
 CellLabel->
  "Out[747]=",ExpressionUUID->"d1da56bf-7e7c-ed40-b7fe-d29e72ec20c7"],

Cell[BoxData[
 RowBox[{"\<\"curved chiral equations: E_L^dag.Gamma17[0].(i Gamma^mu D_mu - \
m) psi == (i d0 + i(3Ha/2 + 2Hb) + tauO.d) phi_L - m phi_R, and the same for \
E_R with -tauO.d\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021471992908497`*^9},
 CellLabel->
  "Out[753]=",ExpressionUUID->"6f090bd5-733e-2340-9c4f-2fe80d778339"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
16. The Kohn\[Dash]Sham theory of dirac16complex in gravitational fields\
\>", "Section",ExpressionUUID->"392c8a7a-7168-a14e-a6f2-36d2c416f0fb"],

Cell["\<\
Hohenberg\[Dash]Kohn and Kohn\[Dash]Sham in a gravitational field. For a \
STATIC metric the energy of the self-coupled field is a functional of its \
densities, which are defined with the frame matrices and integrated with \
\[Sqrt]|g| d\:2077x; the ground state minimizes it, and the Kohn\[Dash]Sham \
orbitals \[Phi]_n solve the covariant Dirac equation with the mean fields,\
\>", "Text",ExpressionUUID->"c8435158-5c52-5749-b18c-6ef2cde436c0"],

Cell["\<\
      (i \[CapitalGamma]^\[Mu](X) D_\[Mu] \[Minus] m \[Minus] \
\[CapitalSigma](X)) \[Phi]_n = 0,      \[CapitalSigma] = \[CapitalSigma]_{r} \
g_r \[CapitalSigma]_{|K|=r} [tr(\[CapitalTheta]_K R) \[CapitalTheta]^K \
\[Minus] \[CapitalTheta]^K R \[CapitalTheta]_K],      R = \[CapitalSigma]_n \
occupied \[Phi]_n \[Phi]bar_n,\
\>", "Text",ExpressionUUID->"2cd7fe9c-f073-8a4f-9eae-ca345e544bd8"],

Cell[TextData[{
 "(direct minus exchange; with the Fierz matrix the exchange part is again of \
the direct form with G = (1 \[Minus] Transpose[F]) g). For a TIME-DEPENDENT \
metric (cosmology) the same equations with the time-dependent density matrix \
R(X) are the time-dependent Kohn\[Dash]Sham equations; their adiabatic limit \
\[LongDash] every orbital follows the instantaneous positive-energy \
eigenstate \[LongDash] holds when the expansion rates are small compared with \
the orbital energies (section 14.3 measures the departures). For homogeneous, \
spin-saturated matter in the cosmological spacetime the orbitals are the \
modes of section 13.2 with the comoving momenta k = (",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "96b59d93-38f6-4c41-b24d-a1e3e3b51275"],
 ", ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "794f7a30-5fb5-394b-b72b-7fb077f1bb47"],
 ") inside a comoving Fermi ball |k| < kF, and the mean fields reduce to an \
effective mass M(x0) = m + G_S \[Rho]S and a vector potential V0 = G_V \[Rho]:"
}], "Text",ExpressionUUID->"d58342f0-f7be-8645-9aee-571507416503"],

Cell[TextData[{
 "      i dc/dx0 = (\[Alpha]D\[CenterDot](",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "e34bbbe0-4c01-9b4b-a9da-cc007ef76002"],
 "/a, ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "0c7c0691-4245-ab49-bded-7361b9848915"],
 "/b) + \[Beta]D M(x0) + V0(x0)) c."
}], "Text",ExpressionUUID->"d0455346-6868-2842-9382-e47398eadf23"],

Cell["\<\
The physical densities are integrals over the comoving ball, with |k_a| = k \
cos\[Theta] (ordinary space) and |k_b| = k sin\[Theta] (auxiliary space), the \
solid-angle weight cos\.b2\[Theta] sin\.b3\[Theta], and \[Omega] = \[Sqrt](k\
\.b2 cos\.b2\[Theta]/a\.b2 + k\.b2 sin\.b2\[Theta]/b\.b2 + M\.b2):\
\>", "Text",ExpressionUUID->"17a3c77b-8c0e-0c41-8cc1-8f2e68ae879d"],

Cell["\<\
      \[LeftAngleBracket]f\[RightAngleBracket] = (1/(2\[Pi]\:2074 a\.b3 b\
\:2074)) \[Integral]_0^kF dk k\:2076 \[Integral]_0^(\[Pi]/2) d\[Theta] \
cos\.b2\[Theta] sin\.b3\[Theta] f,    \[Rho] = \[LeftAngleBracket]1\
\[RightAngleBracket] = kF\:2077/(105 \[Pi]\:2074 a\.b3 b\:2074),   \[Rho]S = \
\[LeftAngleBracket]M/\[Omega]\[RightAngleBracket],\
\>", "Text",ExpressionUUID->"89da9102-92b0-344a-82ba-1ab81b4c78fe"],

Cell["\<\
      \[Epsilon] = \[LeftAngleBracket]\[Omega]\[RightAngleBracket] \[Minus] \
(M \[Minus] m)\.b2/(2 G_S) + (G_V/2) \[Rho]\.b2,   pa = \[LeftAngleBracket]k\
\.b2 cos\.b2\[Theta]/(3 a\.b2 \[Omega])\[RightAngleBracket] + \[CapitalPi],   \
pb = \[LeftAngleBracket]k\.b2 sin\.b2\[Theta]/(4 b\.b2 \[Omega])\
\[RightAngleBracket] + \[CapitalPi],   \[CapitalPi] = (M \[Minus] m)\.b2/(2 \
G_S) + (G_V/2) \[Rho]\.b2,\
\>", "Text",ExpressionUUID->"5596a68b-f295-dd49-b3ac-de7d5034c64e"],

Cell["\<\
with the gap equation M = m + G_S \[Rho]S(M). T^\[Mu]_\[Nu] = \
diag(\[Epsilon], \[Minus]pa, \[Minus]pa, \[Minus]pa, \[Minus]pb, \[Minus]pb, \
\[Minus]pb, \[Minus]pb) is conserved, \[Epsilon]\[Prime] + 3Ha (\[Epsilon] + \
pa) + 4Hb (\[Epsilon] + pb) = 0, for every expansion history (a, b): the \
stationarity of \[Epsilon] in M removes the term in M\[Prime]. The integrals \
are evaluated with Gauss\[Dash]Legendre quadrature (96 nodes in k, 64 in \
\[Theta]). Units: m = 1; couplings of section 8.7 (G_S = \[Minus]100000, G_V \
= 10000, Hartree); comoving kF = kFsat = 0.756636\[Ellipsis] (the saturation \
density of section 8.7 at a = b = 1).\
\>", "Text",ExpressionUUID->"887f8f27-bac3-c54b-b9ad-d9b4f5bf57fe"],

Cell[CellGroupData[{

Cell["\<\
16.1 Homogeneous Kohn\[Dash]Sham matter in the cosmological spacetime\
\>", "Subsection",ExpressionUUID->"280ef7e5-efc6-614a-b661-d1d7ce416f1f"],

Cell[CellGroupData[{

Cell["\<\
Needs[\"NumericalDifferentialEquationAnalysis`\"];
glK = GaussianQuadratureWeights[96, 0, 1, 30]; glT = \
GaussianQuadratureWeights[64, 0, Pi/2, 30];
uK = N[glK[[All, 1]]]; wuK = N[glK[[All, 2]]]; thG = N[glT[[All, 1]]]; wthG = \
N[glT[[All, 2]]];
kFsat = 0.75663615070149289469`20; gSks = -100000.; gVks = 10000.; mks = 1.;
wGrid[kF_] := wGrid[kF] = kF^7 Outer[Times, wuK uK^6, wthG Cos[thG]^2 \
Sin[thG]^3];
ksMoments[M_?NumericQ, a_?NumericQ, b_?NumericQ, kF_?NumericQ] := Module[{w = \
wGrid[kF], pa2, pb2, om, pref},
   pa2 = Outer[Times, (kF uK)^2, Cos[thG]^2]/a^2; pb2 = Outer[Times, (kF \
uK)^2, Sin[thG]^2]/b^2;
   om = Sqrt[pa2 + pb2 + M^2]; pref = 1/(2 Pi^4 a^3 b^4);
   <|\"rho\" -> pref Total[w, 2], \"rhoS\" -> pref Total[w M/om, 2], \"ekin\" \
-> pref Total[w om, 2], \"pa\" -> pref Total[w pa2/om, 2]/3, \"pb\" -> pref \
Total[w pb2/om, 2]/4|>];
ksGap[a_?NumericQ, b_?NumericQ, kF_?NumericQ] := Mx /. FindRoot[Mx - mks - \
gSks ksMoments[Mx, a, b, kF][\"rhoS\"], {Mx, 10^-14, mks}, Method -> \
\"Brent\", AccuracyGoal -> 15, PrecisionGoal -> 15];
ksStress[a_?NumericQ, b_?NumericQ, kF_?NumericQ] := Module[{M = ksGap[a, b, \
kF], mo, pint},
   mo = ksMoments[M, a, b, kF]; pint = (M - mks)^2/(2 gSks) + gVks/2 mo[\"rho\
\"]^2;
   <|\"M\" -> M, \"rho\" -> mo[\"rho\"], \"rhoS\" -> mo[\"rhoS\"], \"eps\" -> \
mo[\"ekin\"] - (M - mks)^2/(2 gSks) + gVks/2 mo[\"rho\"]^2, \"pa\" -> mo[\"pa\
\"] + pint, \"pb\" -> mo[\"pb\"] + pint|>];
st0ks = ksStress[1., 1., kFsat];
check[\"flat limit a = b = 1, kF = kFsat: m* == 0.3480973401... and E/A - m \
== -0.0283214279... (section 8.7), to 10^-11\",
  Abs[st0ks[\"M\"] - 0.34809734014624326514] < 10^-11 && \
Abs[st0ks[\"eps\"]/st0ks[\"rho\"] - 1 + 0.028321427964738575854] < 10^-11]
check[\"flat limit: pa == pb == rho eps_F - eps (Gibbs-Duhem), which is 0 at \
the saturation density\",
  Abs[st0ks[\"pa\"] - st0ks[\"pb\"]] < 10^-15 && Abs[st0ks[\"pa\"] - \
(st0ks[\"rho\"] (gVks st0ks[\"rho\"] + Sqrt[kFsat^2 + st0ks[\"M\"]^2]) - \
st0ks[\"eps\"])] < 10^-15]
aHist[x_] := 1 + 0.3 x + 0.05 x^2; bHist[x_] := 1/(1 + 0.2 x);
epsHist[x_?NumericQ] := ksStress[aHist[x], bHist[x], kFsat];
hst = 10.^-3; xcs = 0.7;
deps = (epsHist[xcs - 2 hst][\"eps\"] - 8 epsHist[xcs - hst][\"eps\"] + 8 \
epsHist[xcs + hst][\"eps\"] - epsHist[xcs + 2 hst][\"eps\"])/(12 hst);
consKS = deps + 3 aHist'[xcs]/aHist[xcs] (epsHist[xcs][\"eps\"] + \
epsHist[xcs][\"pa\"]) + 4 bHist'[xcs]/bHist[xcs] (epsHist[xcs][\"eps\"] + \
epsHist[xcs][\"pb\"]);
check[\"energy-momentum conservation of the Kohn-Sham matter: eps' + 3Ha(eps \
+ pa) + 4Hb(eps + pb) == 0 (a = 1 + 0.3x + 0.05x^2, b = 1/(1 + 0.2x), x0 = \
0.7; relative 10^-8)\",
  Abs[consKS/deps] < 10^-8]
{\"m*\" -> st0ks[\"M\"], \"rho\" -> st0ks[\"rho\"], \"eps\" -> \
st0ks[\"eps\"], \"p\" -> st0ks[\"pa\"], \"conservation residual / eps'\" -> \
consKS/deps}\
\>", "Input",
 CellLabel->
  "In[754]:=",ExpressionUUID->"43f9f60a-3995-b34d-afb4-c4ad0a9b4f5e"],

Cell[BoxData[
 RowBox[{"\<\"flat limit a = b = 1, kF = kFsat: m* == 0.3480973401... and E/A \
- m == -0.0283214279... (section 8.7), to 10^-11\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0021471994331245`*^9},
 CellLabel->
  "Out[763]=",ExpressionUUID->"1f34abd4-a042-2c44-96b2-2b998872e507"],

Cell[BoxData[
 RowBox[{"\<\"flat limit: pa == pb == rho eps_F - eps (Gibbs-Duhem), which is \
0 at the saturation density\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021471994351234`*^9},
 CellLabel->
  "Out[764]=",ExpressionUUID->"ef12aeac-5590-554a-8ea0-ae37356011b8"],

Cell[BoxData[
 RowBox[{"\<\"energy-momentum conservation of the Kohn-Sham matter: eps' + \
3Ha(eps + pa) + 4Hb(eps + pb) == 0 (a = 1 + 0.3x + 0.05x^2, b = 1/(1 + 0.2x), \
x0 = 0.7; relative 10^-8)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021472001114464`*^9},
 CellLabel->
  "Out[770]=",ExpressionUUID->"1cf22b3a-fc6d-f145-8b89-5eb1addbdd36"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"m*\"\>", "\[Rule]", "0.3480973401462433`"}], ",", 
   RowBox[{"\<\"rho\"\>", "\[Rule]", "0.000013881002132316879`"}], ",", 
   RowBox[{"\<\"eps\"\>", "\[Rule]", "0.000013487872330348084`"}], ",", 
   RowBox[{"\<\"p\"\>", "\[Rule]", "0.`"}], ",", 
   RowBox[{"\<\"conservation residual / eps'\"\>", "\[Rule]", 
    RowBox[{"-", "3.994167412227712`*^-12"}]}]}], "}"}]], "Output",
 CellChangeTimes->{4.002147200113447*^9},
 CellLabel->
  "Out[771]=",ExpressionUUID->"b98e6a8e-01ba-974f-a538-3e982f0876c3"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["16.2 The three epochs", "Subsection",ExpressionUUID->"d212ddab-57d7-8f47-bbb1-0dfe0d726caf"],

Cell["\<\
Primordial: the Einstein\[Dash]Kasner background a = x0^0.547, b = x0^(\
\[Minus]0.160) of section 14.1, normalized so that a = b = 1 at x0 = 1. The \
density grows like 1/x0 (a\.b3b\:2074 = x0), but the ordinary momenta are \
blue-shifted (p/a \[RightArrow] \[Infinity]), so the scalar density per \
particle M/\[Omega] falls and the attractive scalar coupling drives the \
effective mass toward zero: chiral symmetry is effectively restored near x0 = \
0. Modern: a static auxiliary space (b = 1) and growing a: the ordinary \
momenta redshift, M \[RightArrow] m, \[Epsilon] a\.b3 \[RightArrow] constant \
and pa/\[Epsilon] \[RightArrow] 0 \[LongDash] dirac16complex behaves as cold \
(pressureless) matter in ordinary space, while a stress pb remains along the \
auxiliary space, which the stabilizing stress of section 14.4 must balance. \
Far future: de Sitter a = e^{0.1 x0}, b = 1: \[Rho] = \[Rho]0 e^{\[Minus]0.3 \
x0} and 1 \[Minus] M decays like \[Rho].\
\>", "Text",ExpressionUUID->"0d1c8410-3636-f041-bb0c-0353bd19d81f"],

Cell[CellGroupData[{

Cell["\<\
pKs = N[(1 + 2 Sqrt[2])/7, 20]; qKs = N[(2 - 3 Sqrt[2])/14, 20];
primKS = Table[x -> ksStress[x^pKs, x^qKs, kFsat], {x, {10.^-4, 10.^-3, \
10.^-2, 10.^-1, 1., 10.}}];
check[\"primordial: rho x0 == kFsat^7/(105 Pi^4) at every x0, and m* \
decreases monotonically to below 0.05 at x0 = 10^-4\",
  And @@ Table[Abs[(r[[2]][\"rho\"]) r[[1]] - kFsat^7/(105 Pi^4)] < 10^-12, \
{r, primKS}] && OrderedQ[primKS[[All, 2]][[All, Key[\"M\"]]]] && primKS[[1, \
2]][\"M\"] < 0.05]
modKS = Table[aa -> ksStress[aa, 1., kFsat], {aa, {1., 2., 4., 10., 100.}}];
check[\"modern (b = 1): eps a^3 tends to a constant and pa/eps -> 0 \
(pressureless in ordinary space)\",
  Abs[(modKS[[5, 2]][\"eps\"] 100.^3)/(modKS[[4, 2]][\"eps\"] 10.^3) - 1] < \
0.05 && modKS[[5, 2]][\"pa\"]/modKS[[5, 2]][\"eps\"] < 10^-3]
futKS = Table[x -> ksStress[Exp[0.1 x], 1., kFsat], {x, {0., 10., 20., 40., \
80.}}];
check[\"far future (de Sitter, H = 0.1): rho == rho0 e^{-3 H x0} and 1 - m* \
decays like rho\",
  Abs[futKS[[4, 2]][\"rho\"]/futKS[[1, 2]][\"rho\"] - Exp[-12.]] < 10^-12 && \
Abs[(1 - futKS[[5, 2]][\"M\"])/(1 - futKS[[4, 2]][\"M\"])/Exp[-12.] - 1] < \
0.05]
{\"primordial m*(x0), x0 = 1e-4 .. 10\" -> primKS[[All, 2]][[All, \
Key[\"M\"]]], \"primordial pa/pb at x0 = 1e-3, 1e-1, 10\" -> \
(#[\"pa\"]/#[\"pb\"] & /@ primKS[[{2, 4, 6}, 2]]),
 \"modern m*(a), a = 1, 2, 4, 10, 100\" -> modKS[[All, 2]][[All, \
Key[\"M\"]]], \"modern pb/eps at a = 100\" -> modKS[[5, 2]][\"pb\"]/modKS[[5, \
2]][\"eps\"],
 \"far future m*(x0), x0 = 0, 10, 20, 40, 80\" -> futKS[[All, 2]][[All, \
Key[\"M\"]]]}\
\>", "Input",
 CellLabel->
  "In[772]:=",ExpressionUUID->"bee59f5a-19ae-7d4f-88ea-120674c18c70"],

Cell[BoxData[
 RowBox[{"\<\"primordial: rho x0 == kFsat^7/(105 Pi^4) at every x0, and m* \
decreases monotonically to below 0.05 at x0 = 10^-4\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002147200592943*^9},
 CellLabel->
  "Out[774]=",ExpressionUUID->"48e14932-8cae-1f43-82d9-44723e950011"],

Cell[BoxData[
 RowBox[{"\<\"modern (b = 1): eps a^3 tends to a constant and pa/eps -> 0 \
(pressureless in ordinary space)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021472009392376`*^9},
 CellLabel->
  "Out[776]=",ExpressionUUID->"9d42975d-1e38-b14c-aa0a-a3232c8e4ec3"],

Cell[BoxData[
 RowBox[{"\<\"far future (de Sitter, H = 0.1): rho == rho0 e^{-3 H x0} and 1 \
- m* decays like rho\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021472012388306`*^9},
 CellLabel->
  "Out[778]=",ExpressionUUID->"f12deaeb-150c-494a-bf58-f7e8f39cfa96"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"primordial m*(x0), x0 = 1e-4 .. 10\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "0.003824179379430471`", ",", "0.010783989711922494`", ",", 
      "0.03023851961204259`", ",", "0.08844464116180194`", ",", 
      "0.3480973401462433`", ",", "0.8917637493589151`"}], "}"}]}], ",", 
   RowBox[{"\<\"primordial pa/pb at x0 = 1e-3, 1e-1, 10\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.0868869169150368`", ",", "1.6461737747098397`", ",", 
      RowBox[{"-", "0.4036333858521349`"}]}], "}"}]}], ",", 
   RowBox[{"\<\"modern m*(a), a = 1, 2, 4, 10, 100\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "0.3480973401462433`", ",", "0.85354080904854`", ",", 
      "0.9807410717586907`", ",", "0.9987576007278518`", ",", 
      "0.9999987563024887`"}], "}"}]}], ",", 
   RowBox[{"\<\"modern pb/eps at a = 100\"\>", "\[Rule]", 
    "0.04977351208721611`"}], ",", 
   RowBox[{"\<\"far future m*(x0), x0 = 0, 10, 20, 40, 80\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "0.3480973401462433`", ",", "0.9395796910293628`", ",", 
      "0.996923581335845`", ",", "0.9999923586141617`", ",", 
      "0.9999999999530483`"}], "}"}]}]}], "}"}]], "Output",
 CellChangeTimes->{4.0021472012547607`*^9},
 CellLabel->
  "Out[779]=",ExpressionUUID->"f1dd7d05-72c7-d747-b2c4-875e9a1b1d21"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
16.3 Self-consistent evolution: Einstein\[Dash]Lovelock gravity driven by the \
Kohn\[Dash]Sham matter\
\>", "Subsection",ExpressionUUID->"0b85b013-b76c-bc48-834f-1a8e79c9374b"],

Cell["\<\
With T^\[Mu]_\[Nu] of the Kohn\[Dash]Sham matter the field equations of \
section 14 are a closed system for a, b. The 11 and 44 equations are LINEAR \
in Ha\[Prime] and Hb\[Prime] (Lovelock equations are quasi-linear), so they \
are solved for (Ha\[Prime], Hb\[Prime]) at every step; the 00 equation \
contains no second derivatives and is a CONSTRAINT, imposed on the initial \
data (Hb(0) from Ha(0)) and then preserved by the evolution because both \
sides are conserved (Bianchi identity of section 12, conservation law of \
section 16.1). The runs below (\[Kappa] = 1000, \[CapitalLambda] = 0, Ha(0) = \
0.05, a(0) = b(0) = 1, x0 from 0 to 20) check that preservation for Einstein \
gravity and for Einstein\[Dash]Lovelock gravity with \[Alpha]_2 = 20, \
\[Alpha]_3 = 500.\
\>", "Text",ExpressionUUID->"ee24242b-a4f9-414f-a738-7e09c5a8459e"],

Cell[CellGroupData[{

Cell["\<\
eTot[c_] := Sum[alf[k] toH[ECos[[k + 1, c, c]]], {k, 1, 3}] - lamb;
coefLin[c_] := {Coefficient[eTot[c], dHa], Coefficient[eTot[c], dHb], eTot[c] \
/. {dHa -> 0, dHb -> 0}};
check[\"the 11 and 44 Einstein-Lovelock equations are linear in (Ha', Hb'); \
the 00 equation contains neither (constraint)\",
  Exponent[eTot[2], dHa] <= 1 && Exponent[eTot[2], dHb] <= 1 && \
Exponent[eTot[5], dHa] <= 1 && Exponent[eTot[5], dHb] <= 1 && FreeQ[eTot[1], \
dHa | dHb]]
cl11 = coefLin[2]; cl44 = coefLin[5]; con00 = eTot[1];
dHsol[al2_?NumericQ, al3_?NumericQ, kap_?NumericQ, a_?NumericQ, b_?NumericQ, \
ha_?NumericQ, hb_?NumericQ] := dHsol[al2, al3, kap, a, b, ha, hb] =
   Module[{st = ksStress[a, b, kFsat], rule = {alf[1] -> 1, alf[2] -> al2, \
alf[3] -> al3, lamb -> 0, Ha -> ha, Hb -> hb}},
    LinearSolve[{cl11[[1 ;; 2]], cl44[[1 ;; 2]]} /. rule, {-kap st[\"pa\"] - \
(cl11[[3]] /. rule), -kap st[\"pb\"] - (cl44[[3]] /. rule)}]];
dHaF[al2_?NumericQ, al3_?NumericQ, kap_?NumericQ, a_?NumericQ, b_?NumericQ, \
ha_?NumericQ, hb_?NumericQ] := dHsol[al2, al3, kap, a, b, ha, hb][[1]];
dHbF[al2_?NumericQ, al3_?NumericQ, kap_?NumericQ, a_?NumericQ, b_?NumericQ, \
ha_?NumericQ, hb_?NumericQ] := dHsol[al2, al3, kap, a, b, ha, hb][[2]];
evolveEL[al2_, al3_, kap_, ha0_] := Module[{st = ksStress[1., 1., kFsat], \
cpol, hb0, sol, rule, viol},
   cpol = con00 /. {alf[1] -> 1, alf[2] -> al2, alf[3] -> al3, lamb -> 0, Ha \
-> ha0};
   hb0 = Hb /. First[SortBy[NSolve[cpol == kap st[\"eps\"], Hb, Reals], \
Abs[Hb /. #] &]];
   sol = NDSolve[{aE'[x] == hE[x] aE[x], bE'[x] == kE[x] bE[x],
       hE'[x] == dHaF[al2, al3, kap, aE[x], bE[x], hE[x], kE[x]], kE'[x] == \
dHbF[al2, al3, kap, aE[x], bE[x], hE[x], kE[x]],
       aE[0] == 1, bE[0] == 1, hE[0] == ha0, kE[0] == N[hb0]}, {aE, bE, hE, \
kE}, {x, 0, 20},
      Method -> {\"ExplicitRungeKutta\", \"DifferenceOrder\" -> 8}, \
PrecisionGoal -> 10, AccuracyGoal -> 13, MaxSteps -> 10^6,
      InterpolationOrder -> All][[1]];      (* InterpolationOrder -> All: the \
dense output has the order of the method between the steps *)
   viol = Max[Table[With[{aa = aE[x] /. sol, bb = bE[x] /. sol, ha = hE[x] /. \
sol, hb = kE[x] /. sol},
       Abs[((con00 /. {alf[1] -> 1, alf[2] -> al2, alf[3] -> al3, lamb -> 0, \
Ha -> ha, Hb -> hb}) - kap ksStress[aa, bb, kFsat][\"eps\"])/(kap \
ksStress[aa, bb, kFsat][\"eps\"])]], {x, 0, 20, 4}]];
   {N[hb0], {aE[20], bE[20], hE[20], kE[20]} /. sol, viol}];
runE = evolveEL[0., 0., 1000., 0.05];
runL = evolveEL[20., 500., 1000., 0.05];
check[\"self-consistent evolution: the constraint Sum alpha_k E^(k)0_0 - \
Lambda == kappa eps is preserved to 10^-7 (relative) for Einstein and for \
Einstein-Lovelock (alpha2 = 20, alpha3 = 500)\",
  runE[[3]] < 10^-7 && runL[[3]] < 10^-7]
{\"Einstein: Hb(0), {a, b, Ha, Hb}(20), violation\" -> runE, \
\"Einstein-Lovelock: Hb(0), {a, b, Ha, Hb}(20), violation\" -> runL}\
\>", "Input",
 CellLabel->
  "In[780]:=",ExpressionUUID->"705cff9a-3114-264a-980d-00426ac46e1e"],

Cell[BoxData[
 RowBox[{"\<\"the 11 and 44 Einstein-Lovelock equations are linear in (Ha', \
Hb'); the 00 equation contains neither (constraint)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002147201312208*^9},
 CellLabel->
  "Out[782]=",ExpressionUUID->"ba4a7426-63f3-8845-ab9b-4f1467cdf172"],

Cell[BoxData[
 RowBox[{"\<\"self-consistent evolution: the constraint Sum alpha_k E^(k)0_0 \
- Lambda == kappa eps is preserved to 10^-7 (relative) for Einstein and for \
Einstein-Lovelock (alpha2 = 20, alpha3 = 500)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0021473107850437`*^9},
 CellLabel->
  "Out[790]=",ExpressionUUID->"73d2ee8d-bd72-e74b-b98c-9c1621e8e05d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Einstein: Hb(0), {a, b, Ha, Hb}(20), violation\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.009143712444558975`", ",", 
      RowBox[{"{", 
       RowBox[{
       "1.5817386798481468`", ",", "1.1975585618423619`", ",", 
        "0.011877999367551987`", ",", "0.007419107766692174`"}], "}"}], ",", 
      "1.9727626114021923`*^-14"}], "}"}]}], ",", 
   RowBox[{"\<\"Einstein-Lovelock: Hb(0), {a, b, Ha, Hb}(20), violation\"\>", 
    "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.014980703942304672`", ",", 
      RowBox[{"{", 
       RowBox[{
       "1.4773514780944115`", ",", "1.276084053398622`", ",", 
        "0.010175914492202693`", ",", "0.008488764693550076`"}], "}"}], ",", 
      "2.377784774179952`*^-14"}], "}"}]}]}], "}"}]], "Output",
 CellChangeTimes->{4.002147310793316*^9},
 CellLabel->
  "Out[791]=",ExpressionUUID->"84d78b02-8bbf-8344-9597-dfa28804c497"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["17. The Standard Model on the world brane of 7+1 spacetime", "Section",ExpressionUUID->"3a9cefda-67e9-8249-8097-88dc39d5a925"],

Cell[TextData[{
 StyleBox["About sections 17\[Dash]19. ",
  FontWeight->"Bold"],
 "Dirac_claude places the Standard Model on a seven-dimensional fold of its \
4+4 spacetime. Here the same idea is rebuilt for 7+1: the four auxiliary \
coordinates x4 \[Ellipsis] x7 form a torus T\:2074 (x_k \[TildeEqual] x_k + \
Lc, coordinate period Lc, proper size b\[CenterDot]Lc), and the Standard \
Model lives on the 3+1-dimensional WORLD BRANE W = {x4 = x5 = x6 = x7 = 0}, \
spanned by the time x0 and ordinary space x1, x2, x3. Gravity (sections 11\
\[Dash]14) and dirac16complex (sections 7\[Dash]10, 13, 15\[Dash]16) live in \
the whole 7+1 spacetime (the bulk); every Standard Model field lives on W and \
feels gravity through the induced metric h_\[Mu]\[Nu] = g_\[Mu]\[Nu](x, y = \
0) (\[Mu], \[Nu] = 0 \[Ellipsis] 3). The two sectors meet at W through \
portals. The bulk has one time-like and seven space-like dimensions (in xAct, \
section 12: the signature list {7, 1, 0}); the brane W has one time-like \
dimension (x0) and three space-like dimensions (x1, x2, x3) (in the same \
counting: {3, 1, 0}). The flat frame metric of the brane, diag(+1, \[Minus]1, \
\[Minus]1, \[Minus]1), is \[Eta]17 restricted to x0 \[Ellipsis] x3: simply \
the squares of the basis e[0] = 1, e[1], e[2], e[3] of the quaternion \
subalgebra \[DoubleStruckCapitalH] of the octonions. The total action is"
}], "Text",ExpressionUUID->"58cc2438-2e03-ca43-949d-b6c4681793e4"],

Cell["\<\
      S = S_EL[g] + S_dirac16complex[\[Psi], g] + \[Integral]_W d\:2074x \
\[Sqrt]|h| (L_SM + L_portal) + S_stab,\
\>", "Text",ExpressionUUID->"26889c07-2df3-734d-b9e5-70bdf641f9c5"],

Cell["\<\
with S_EL the Einstein\[Dash]Lovelock action of section 12, the self-coupled \
covariant dirac16complex action of sections 13 and 15, L_SM the complete \
Standard Model Lagrangian below (gauge fields, Higgs doublet, three \
generations of quarks and leptons including right-handed neutrinos, Yukawa \
couplings), L_portal the couplings of section 18, and S_stab the stabilizing \
stress of section 14.4 that keeps b constant in the modern epoch. In \
eight-dimensional form \[Integral]_W d\:2074x \[Sqrt]|h| (\[Ellipsis]) = \
\[Integral] d\:2078X \[Sqrt]|g| \[Delta]\:2074(y)/b\:2074 (\[Ellipsis]).\
\>", "Text",ExpressionUUID->"000324d4-b2e5-fa41-85d5-485e3148381e"],

Cell[CellGroupData[{

Cell["\<\
check[\"brane frame metric diag(+1, -1, -1, -1) == eta17 restricted to \
x0..x3: the squares of the octonion basis e[0], e[1], e[2], e[3] of the \
quaternion subalgebra (Re(e[A] e[B]), A, B = 0..3), which is closed under the \
octonion product\",
  \[Eta]17[[1 ;; 4, 1 ;; 4]] == DiagonalMatrix[{1, -1, -1, -1}] == \
Table[oRe[oMul[ev[A], ev[B]]], {A, 0, 3}, {B, 0, 3}] &&
  And @@ Flatten[Table[oMul[ev[A], ev[B]][[5 ;; 8]] == {0, 0, 0, 0}, {A, 0, \
3}, {B, 0, 3}]]]\
\>", "Input",
 CellLabel->
  "In[792]:=",ExpressionUUID->"a7e24644-2d11-9545-a197-8e62b2f0511d"],

Cell[BoxData[
 RowBox[{"\<\"brane frame metric diag(+1, -1, -1, -1) == eta17 restricted to \
x0..x3: the squares of the octonion basis e[0], e[1], e[2], e[3] of the \
quaternion subalgebra (Re(e[A] e[B]), A, B = 0..3), which is closed under the \
octonion product\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002147310819866*^9},
 CellLabel->
  "Out[792]=",ExpressionUUID->"3d82e75c-9688-ce46-b1ed-d1fd1dbe5609"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
17.1 The fields, their quantum numbers, and anomaly cancellation\
\>", "Subsection",ExpressionUUID->"853c5e2e-8896-4045-a1b3-cfcd292355c2"],

Cell["\<\
Gauge group SU(3)_C \[Times] SU(2)_L \[Times] U(1)_Y with gauge fields G^a_\
\[Mu] (a = 1 \[Ellipsis] 8), W^I_\[Mu] (I = 1, 2, 3), B_\[Mu] and couplings \
gs, g, g\[Prime]. Matter in each of three generations (Weyl fields; Q = T3 + \
Y):\
\>", "Text",ExpressionUUID->"dcdb460c-ad43-d144-80c4-c2f8f65694ef"],

Cell["\<\
Q_L = (u_L, d_L): (3, 2, 1/6);  u_R: (3, 1, 2/3);  d_R: (3, 1, \[Minus]1/3);  \
L_L = (\[Nu]_L, e_L): (1, 2, \[Minus]1/2);  e_R: (1, 1, \[Minus]1);  \[Nu]_R: \
(1, 1, 0).\
\>", "Item",ExpressionUUID->"1ec80115-973c-da48-9698-a2b6fcb36329"],

Cell["Higgs doublet \[CapitalPhi]: (1, 2, 1/2), \[CapitalPhi]\:0303 = i\
\[Sigma]2 \[CapitalPhi]*.", "Item",ExpressionUUID->"fdeedd8d-7d9d-3c46-b3c7-\
b3cc953f1d0f"],

Cell["\<\
The gauge anomalies (with left-handed fields counted +, right-handed \
\[Minus]) cancel generation by generation, with or without \[Nu]_R, and the \
number of SU(2) doublets per generation is even (no Witten anomaly). The \
relativistic degrees of freedom of the fields above, without \[Nu]_R, give g* \
= 28 + (7/8)\[CenterDot]90 = 106.75.\
\>", "Text",ExpressionUUID->"54c5a687-b0a8-d045-9a84-3ade188ebebf"],

Cell[CellGroupData[{

Cell["\<\
smF = {{\"Q\", 3, 2, 1/6, 1}, {\"uR\", 3, 1, 2/3, -1}, {\"dR\", 3, 1, -1/3, \
-1}, {\"L\", 1, 2, -1/2, 1}, {\"eR\", 1, 1, -1, -1}, {\"nuR\", 1, 1, 0, -1}};
anom = <|\"SU(3)^2 U(1)\" -> Total[(#[[5]] #[[3]] #[[4]]) & /@ Select[smF, \
#[[2]] == 3 &]],
   \"SU(2)^2 U(1)\" -> Total[(#[[5]] #[[2]] #[[4]]) & /@ Select[smF, #[[3]] \
== 2 &]],
   \"U(1)^3\" -> Total[(#[[5]] #[[2]] #[[3]] #[[4]]^3) & /@ smF], \"grav^2 \
U(1)\" -> Total[(#[[5]] #[[2]] #[[3]] #[[4]]) & /@ smF],
   \"SU(3)^3\" -> Total[(#[[5]] #[[3]]) & /@ Select[smF, #[[2]] == 3 &]]|>;
check[\"anomaly cancellation per generation (with nu_R): SU(3)^2U(1), \
SU(2)^2U(1), U(1)^3, grav^2U(1), SU(3)^3 all vanish; doublets per generation \
even\",
  Values[anom] == {0, 0, 0, 0, 0} && EvenQ[Total[Select[smF, #[[3]] == 2 \
&][[All, 2]]]]]
check[\"electric charges Q = T3 + Y: (u, d) = (2/3, -1/3), (nu, e) = (0, -1), \
u_R 2/3, d_R -1/3, e_R -1, nu_R 0\",
  ({1/6 + 1/2, 1/6 - 1/2, -1/2 + 1/2, -1/2 - 1/2} == {2/3, -1/3, 0, -1})]
gStar = (8 2 + 3 2 + 2 + 4) + 7/8 3 Total[(2 #[[2]] #[[3]]) & /@ Select[smF, \
#[[1]] != \"nuR\" &]];
check[\"g* = 28 + (7/8) 90 = 106.75 for the Standard Model fields (without \
nu_R)\", gStar == 427/4]\
\>", "Input",
 CellLabel->
  "In[793]:=",ExpressionUUID->"da884999-c08b-5e41-a773-b81bb1c6979f"],

Cell[BoxData[
 RowBox[{"\<\"anomaly cancellation per generation (with nu_R): SU(3)^2U(1), \
SU(2)^2U(1), U(1)^3, grav^2U(1), SU(3)^3 all vanish; doublets per generation \
even\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002147310827318*^9},
 CellLabel->
  "Out[795]=",ExpressionUUID->"405f4a0f-d324-c34b-8ee6-4a6cafa39c43"],

Cell[BoxData[
 RowBox[{"\<\"electric charges Q = T3 + Y: (u, d) = (2/3, -1/3), (nu, e) = \
(0, -1), u_R 2/3, d_R -1/3, e_R -1, nu_R 0\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002147310827318*^9},
 CellLabel->
  "Out[796]=",ExpressionUUID->"af054fd8-2ae3-bc4a-9769-3c6853bc8060"],

Cell[BoxData[
 RowBox[{"\<\"g* = 28 + (7/8) 90 = 106.75 for the Standard Model fields \
(without nu_R)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002147310827318*^9},
 CellLabel->
  "Out[798]=",ExpressionUUID->"dfa1258d-b6bf-dc4c-957c-a37210e2d886"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["17.2 The Lagrangian on the brane, in the gravitational field", \
"Subsection",ExpressionUUID->"82ccd0ae-4285-9f45-8192-621f2a956c5c"],

Cell["\<\
With the induced metric h_\[Mu]\[Nu], its frame (tetrad) and spin connection, \
complex 4\[Times]4 Dirac matrices \[Gamma]^\[Mu](x) of the brane ({\[Gamma]^\
\[Mu], \[Gamma]^\[Nu]} = 2 h^\[Mu]\[Nu]) and the gauge-covariant derivatives \
D_\[Mu] = \[Del]_\[Mu] \[Minus] i gs G^a_\[Mu] T^a \[Minus] i g W^I_\[Mu] \
\[Tau]^I/2 \[Minus] i g\[Prime] Y B_\[Mu]:\
\>", "Text",ExpressionUUID->"28f7b493-2f6b-a24c-8d27-ecbee499231f"],

Cell["\<\
      L_SM = \[Minus](1/4) G^a_\[Mu]\[Nu] G^a\[Mu]\[Nu] \[Minus] (1/4) W^I_\
\[Mu]\[Nu] W^I\[Mu]\[Nu] \[Minus] (1/4) B_\[Mu]\[Nu] B^\[Mu]\[Nu] + (D_\[Mu]\
\[CapitalPhi])\[Dagger](D^\[Mu]\[CapitalPhi]) \[Minus] \[Mu]\.b2 \
\[CapitalPhi]\[Dagger]\[CapitalPhi] \[Minus] \[Lambda] \
(\[CapitalPhi]\[Dagger]\[CapitalPhi])\.b2\
\>", "Text",ExpressionUUID->"d3b3ad7c-7ac8-1941-8899-2b7843701ea1"],

Cell["\<\
            + \[CapitalSigma]_f fbar i \[Gamma]^\[Mu] D_\[Mu] f \[Minus] [Q\
\:0304_L Y_u \[CapitalPhi]\:0303 u_R + Q\:0304_L Y_d \[CapitalPhi] d_R + L\
\:0304_L Y_e \[CapitalPhi] e_R + L\:0304_L Y_\[Nu] \[CapitalPhi]\:0303 \
\[Nu]_R + h.c.],\
\>", "Text",ExpressionUUID->"f08419ee-131b-6842-978b-a411361446e4"],

Cell["\<\
with G^a_\[Mu]\[Nu] = \[PartialD]_\[Mu]G^a_\[Nu] \[Minus] \
\[PartialD]_\[Nu]G^a_\[Mu] + gs f^abc G^b_\[Mu] G^c_\[Nu], W^I_\[Mu]\[Nu] = \
\[PartialD]_\[Mu]W^I_\[Nu] \[Minus] \[PartialD]_\[Nu]W^I_\[Mu] + g \
\[Epsilon]^IJK W^J_\[Mu] W^K_\[Nu], B_\[Mu]\[Nu] = \[PartialD]_\[Mu]B_\[Nu] \
\[Minus] \[PartialD]_\[Nu]B_\[Mu], f summing over all Weyl fields of the \
three generations, and 3\[Times]3 Yukawa matrices Y_u, Y_d, Y_e, Y_\[Nu]. Its \
field equations (\[Del]_\[Mu] G^a\[Mu]\[Nu] = gs \[CapitalSigma]_q q\:0304\
\[Gamma]^\[Nu] T^a q + gauge self-coupling, and so on) are the ordinary ones \
with \[PartialD] \[RightArrow] \[Del] (Levi-Civita connection of h).\
\>", "Text",ExpressionUUID->"fc312e9f-9b35-044a-90da-52753635287a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["17.3 Electroweak symmetry breaking", "Subsection",ExpressionUUID->"4c77224c-3c4c-4b4e-9354-adb49a6b612d"],

Cell["\<\
With \[LeftAngleBracket]\[CapitalPhi]\[RightAngleBracket] = (0, v/\[Sqrt]2) \
the term |D_\[Mu]\[LeftAngleBracket]\[CapitalPhi]\[RightAngleBracket]|\.b2 is \
a mass matrix for (W\.b9, W\.b2, W\.b3, B) with eigenvalues g\.b2v\.b2/4 (W\
\[PlusMinus], twice), (g\.b2 + g\[Prime]\.b2)v\.b2/4 (Z) and 0 (photon). The \
inputs G_F = 1.1663788 \[Times] 10\:207b\:2075 GeV\:207b\.b2, m_W = 80.3692 \
GeV, m_Z = 91.1880 GeV, m_H = 125.20 GeV (PDG 2025) fix v = (\[Sqrt]2 G_F)^(\
\[Minus]1/2), g = 2m_W/v, cos\[Theta]_W = m_W/m_Z (on shell), g\[Prime] = g \
tan\[Theta]_W, e = g sin\[Theta]_W and \[Lambda] = m_H\.b2/(2v\.b2) at tree \
level.\
\>", "Text",ExpressionUUID->"4c16fa5c-49e0-bc40-996b-81a76d7e0183"],

Cell[CellGroupData[{

Cell["\<\
wF = {wW1, wW2, wW3, bB};       (* the components W^1, W^2, W^3 and B of the \
electroweak gauge fields *) tauP = {PauliMatrix[1], PauliMatrix[2], \
PauliMatrix[3]};
dPhi = -I (gW Sum[wF[[i]] tauP[[i]]/2, {i, 3}] + gY/2 bB \
IdentityMatrix[2]).{0, vH/Sqrt[2]};
massTerm = Expand[ComplexExpand[Conjugate[dPhi].dPhi]];
mGB = Table[D[massTerm, wF[[i]], wF[[j]]], {i, 4}, {j, 4}];
check[\"gauge-boson mass matrix: eigenvalues g^2 v^2/4 (twice), (g^2 + g'^2) \
v^2/4 and 0 (photon)\",
  Sort[Expand[Eigenvalues[mGB]]] == Sort[Expand[{gW^2 vH^2/4, gW^2 vH^2/4, \
(gW^2 + gY^2) vH^2/4, 0}]]]
gFermi = 1.1663788*^-5; mWb = 80.3692; mZb = 91.1880; mHb = 125.20;
vEW = (Sqrt[2] gFermi)^(-1/2); gEW = 2 mWb/vEW; cW = mWb/mZb; sW2 = 1 - cW^2; \
gpEW = gEW Sqrt[sW2]/cW; eEW = gEW Sqrt[sW2]; lamH = mHb^2/(2 vEW^2);
check[\"tree level: m_W == g v/2, m_Z == Sqrt[g^2 + g'^2] v/2, rho == \
m_W^2/(m_Z^2 cos^2 theta_W) == 1, m_H^2 == 2 lambda v^2\",
  Abs[gEW vEW/2 - mWb] < 10^-12 && Abs[Sqrt[gEW^2 + gpEW^2] vEW/2 - mZb] < \
10^-10 && Abs[mWb^2/(mZb^2 cW^2) - 1] < 10^-14 && Abs[2 lamH vEW^2 - mHb^2] < \
10^-9]
{\"v\" -> vEW, \"g\" -> gEW, \"g'\" -> gpEW, \"sin^2 thetaW\" -> sW2, \"e\" \
-> eEW, \"1/alpha tree\" -> 4 Pi/eEW^2, \"lambda\" -> lamH}\
\>", "Input",
 CellLabel->
  "In[799]:=",ExpressionUUID->"3c658998-e943-8d4e-959b-289aeb1a457b"],

Cell[BoxData[
 RowBox[{"\<\"gauge-boson mass matrix: eigenvalues g^2 v^2/4 (twice), (g^2 + \
g'^2) v^2/4 and 0 (photon)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002147310843014*^9},
 CellLabel->
  "Out[803]=",ExpressionUUID->"b6c84c1d-6e14-e042-9c53-4d7dc52a78ea"],

Cell[BoxData[
 RowBox[{"\<\"tree level: m_W == g v/2, m_Z == Sqrt[g^2 + g'^2] v/2, rho == \
m_W^2/(m_Z^2 cos^2 theta_W) == 1, m_H^2 == 2 lambda v^2\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002147310843014*^9},
 CellLabel->
