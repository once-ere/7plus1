Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"shares (Einstein, Gauss-Bonnet, cubic, gas) at Ha = 3 10^5, \
30, 10^-2, 10^15\"\>", "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "5.730063146836696`*^-10", ",", "0.5011389710001287`", ",", 
