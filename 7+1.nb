      RowBox[{"576", " ", "Ha", " ", 
       SuperscriptBox["Hb", "5"]}]}], 
     RowBox[{
      RowBox[{"432", " ", "dHb", " ", 
       SuperscriptBox["Ha", "3"], " ", "Hb"}], "+", 
      RowBox[{"648", " ", "dHa", " ", 
       SuperscriptBox["Ha", "2"], " ", 
       SuperscriptBox["Hb", "2"]}], "+", 
      RowBox[{"648", " ", "dHb", " ", 
       SuperscriptBox["Ha", "2"], " ", 
       SuperscriptBox["Hb", "2"]}], "+", 
