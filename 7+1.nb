Cell[CellGroupData[{

Cell["\<\
Plot[{rIIcap[tt][[4]] - rIIlnb0, (rIIaF Sin[rIIm tt + rIIphF]/(rIIm (tt - \
rIItEF))) /. rIIfit}, {tt, 2 10^4, 10^5}, PlotPoints -> 400, Frame -> True,
 FrameLabel -> {\"tau (units l2)\", \"beta = ln(b/b0)\"}, PlotLegends -> \
{\"coupled field equations (numerical)\", \"A sin(m_r tau + vartheta)/(m_r \
(tau - tau_E))\"}, ImageSize -> 600]\
\>", "Input",
 CellLabel->
  "In[1035]:=",ExpressionUUID->"62eebce8-dda9-0846-be18-1df45f31e9f1"],

