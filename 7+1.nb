 CellLabel->"Out[84]=",ExpressionUUID->"501264f7-f86b-574e-8237-23265889ee3e"],

Cell[BoxData[
 RowBox[{"\<\"mirror of 4+4: \[Tau]Obar[A] == gO.Transpose[\[Tau]O[A]].gO, as \
\[Tau]bar[A] == \[Sigma].Transpose[\[Tau][A]].\[Sigma]\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002040479285286*^9},
 CellLabel->"Out[85]=",ExpressionUUID->"00d8a36f-1fca-9348-b533-8d84eca5b0b6"],

Cell[BoxData[
 RowBox[{"\<\"\[Tau]O[4..7] are products of three split \[Tau]: \[Tau]O[4] == \
\[Tau][5].\[Tau][6].\[Tau][7], \[Tau]O[5] == -\[Tau][4].\[Tau][6].\[Tau][7], \
\[Tau]O[6] == \[Tau][4].\[Tau][5].\[Tau][7], \[Tau]O[7] == \
-\[Tau][4].\[Tau][5].\[Tau][6]\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002040479301092*^9},
 CellLabel->"Out[86]=",ExpressionUUID->"5c2b03e2-ea7e-9a45-b3cc-e1fa85557655"]
}, Open  ]],

Cell["\<\
Meaning of the relation \[Tau]O[A].\[Tau]Obar[B] + \[Tau]O[B].\[Tau]Obar[A] = \
2 \[Delta]_AB ID8: for x = \[CapitalSigma] x^A e[A] put \[Tau]O(x) = \
\[CapitalSigma] x^A \[Tau]O[A]; then \[Tau]O(x).\[Tau]Obar(x) = N(x) ID8 with \
N(x) = (x^0)\.b2 + \[Ellipsis] + (x^7)\.b2. This is the matrix form of x x\
\:0304 = N(x). In 4+4.nb the same relation holds with \[Eta]4488 instead of \
gO, i.e. with the split norm.\
\>", "Text",ExpressionUUID->"07770bb2-dc4f-8541-8668-fc1e6b98dac6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
3.2 The octonion vielbein (the same unit spinor u as in 4+4.nb)\
\>", "Subsection",ExpressionUUID->"526c6962-f4ae-e540-b74e-c62598afce84"],

Cell["\<\
In 4+4.nb the vielbein rows are u.\[Sigma].\[Tau]bar[B]: \[Sigma] is the \
split metric on spinor space. For the octonions the spinor metric is \
Euclidean, \[Sigma] \[RightArrow] gO = ID8, and the rows become \
u.\[Tau]Obar[B]. We keep the SAME unit spinor u = unit = (1,0,0,0,1,0,0,0)/\
\[Sqrt]2: it has unit length for both metrics (u.u = u.\[Sigma].u = 1), and \
\[Sigma].u = u, hence \[Tau]O[A].u = \[Tau][A].u for every A.\
\>", "Text",ExpressionUUID->"90d896f0-4ede-7e4a-ae0b-938799aab6d2"],

Cell[CellGroupData[{

Cell["\<\
EO = Table[unit.gO.\[Tau]Obar[B], {B, 0, 7}];
EOinv = FullSimplify[Inverse[EO]];
check[\"\[Sigma].unit == unit, hence \[Tau]O[A].unit == \[Tau][A].unit (A = \
0..7)\", \[Sigma].unit == unit && And @@ Table[\[Tau]O[A].unit == \
\[Tau][A].unit, {A, 0, 7}]]
check[\"EO is orthogonal: EOinv == Transpose[EO]\", FullSimplify[EOinv - \
Transpose[EO]] == Zero8]
check[\"mirror of 4+4.nb In[294]: EOinv == (u.gO.u) Transpose[Table[gO[[B,B]] \
\[Tau]O[B-1].u, {B,1,8}]]\",
  FullSimplify[EOinv - (unit.gO.unit) Transpose[Table[gO[[B, B]] \[Tau]O[B - \
1].unit, {B, 1, 8}]]] == Zero8]
check[\"EO == \[Eta]4488.E44[hUSE]: the two vielbeins differ only by the \
signs of rows 5..8\", FullSimplify[EO - \[Eta]4488.E44[hUSE]] == Zero8]
MatrixForm[EO]\
\>", "Input",
 CellLabel->"In[87]:=",ExpressionUUID->"04ba74af-0c94-6d47-b3e5-531ae958a404"],

Cell[BoxData[
 RowBox[{"\<\"\[Sigma].unit == unit, hence \[Tau]O[A].unit == \[Tau][A].unit \
(A = 0..7)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020404793076344`*^9},
 CellLabel->"Out[89]=",ExpressionUUID->"4aa5422c-3f64-7f48-9e86-8c344e4271da"],

Cell[BoxData[
 RowBox[{"\<\"EO is orthogonal: EOinv == Transpose[EO]\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020404793167763`*^9},
 CellLabel->"Out[90]=",ExpressionUUID->"79cd10b8-feaa-a74b-ab22-79a36b02688a"],

Cell[BoxData[
 RowBox[{"\<\"mirror of 4+4.nb In[294]: EOinv == (u.gO.u) \
Transpose[Table[gO[[B,B]] \[Tau]O[B-1].u, {B,1,8}]]\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020404793167763`*^9},
 CellLabel->"Out[91]=",ExpressionUUID->"ed16f3ae-2ef1-3445-821c-a65548cb8819"],

Cell[BoxData[
 RowBox[{"\<\"EO == \[Eta]4488.E44[hUSE]: the two vielbeins differ only by \
the signs of rows 5..8\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020404793253613`*^9},
 CellLabel->"Out[92]=",ExpressionUUID->"e3cbdb7d-c666-7e42-94d4-49c70e24e440"],

