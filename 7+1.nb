        ScientificForm[#, 2]& ], "\")\""},
      "RowDefault"], "\<\"DERIVED from the solutions; ESTIMATE for O\"\>", \
"\<\"sections 21.3, 22.1, 22.2, 24.4\"\>"},
    {
     TemplateBox[{
      "\"Yukawa portal: the Kaluza-Klein tower is overproduced unless c_y < \
\"", 
       TagBox[
        InterpretationBox[
         StyleBox[
          RowBox[{"\"9.9\"", "\[Times]", 
            SuperscriptBox["10", "\"-6\""]}], ShowStringCharacters -> False], 
         9.881775656983547*^-6, AutoDelete -> True], ScientificForm[#, 2]& ]},
      "RowDefault"], "\<\"ESTIMATE\"\>", "\<\"section 24.4\"\>"},
    {
     TemplateBox[{"\"Higgs portal: the observed abundance needs c_P = \"", 
       TagBox[
        InterpretationBox[
         StyleBox["\"149.\"", ShowStringCharacters -> False], 
         149.20792978254454`, AutoDelete -> True], NumberForm[#, 3]& ], 
       "\" (T_RH = T*)\""},
      "RowDefault"], "\<\"ESTIMATE\"\>", "\<\"section 24.4\"\>"},
    {"\<\"observed abundance m Y = 4.37 10^-10 GeV produced by the minimal \
model with natural couplings\"\>", "\<\"OPEN (not produced)\"\>", \
"\<\"section 24.4\"\>"},
    {"\<\"dirac16complex matter as dark energy\"\>", "\<\"excluded (DERIVED: \
w >= -0.06; p < 0 only where uniform matter is unstable or metastable)\"\>", \
