    {"\<\"xAct, cosmological metric: Lovelock1 == EinsteinCD == the Einstein \
tensor of the curvature engine of section 11.1\"\>", "True"},
    {"\<\"pair-set algorithm == brute-force generalized-delta contraction for \
E^(1) (cosmological metric)\"\>", "True"},
    {"\<\"pair-set algorithm == xAct (section 12.4) for E^(1), E^(2), E^(3) \
of the cosmological metric (two independent computations)\"\>", "True"},
    {"\<\"E^(1) == Einstein tensor G and L_1 == R (cosmological metric)\"\>", 
     "True"},
    {"\<\"trace identity E^(k)mu_mu == -((8-2k)/2) L_k for k = 0..4\"\>", 
     "True"},
    {"\<\"E^(4) == 0 identically in 8 dimensions, while the Euler density L_4 \
