Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"shares (Einstein, Gauss-Bonnet, cubic, gas) at Ha = 3 10^5, \
30, 10^-2, 10^15\"\>", "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "5.730063146836696`*^-10", ",", "0.5011389710001287`", ",", 
       "0.49767226027040995`", ",", "0.0011887681564550767`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
      "0.00023534899632430043`", ",", "0.9988000625274753`", ",", 
       "0.0009644039728473128`", ",", "1.8450335287438782`*^-7"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
      "0.9994556939404882`", ",", "0.0005159858581313255`", ",", 
       "6.272576290467197`*^-14", ",", "0.0000283202013179354`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
      "2.2963939633051745`*^-19", ",", "0.500000000000275`", ",", 
       "0.27777842385274043`", ",", "0.22222157614698462`"}], "}"}]}], 
    "}"}]}], "}"}]], "Output",
 CellChangeTimes->{4.002147353526764*^9},
 CellLabel->
  "Out[1108]=",ExpressionUUID->"38f7edec-8de1-0e4e-b178-ed1a9d8d5364"]
}, Open  ]],

