  "Out[406]=",ExpressionUUID->"79cabc33-e35f-8046-ada8-fa065c643eef"],

Cell[BoxData[
 RowBox[{"\<\"Fierz rearrangement of every exchange term: tr(o1 R o2 R) == \
(1/16) \[Sum]_K tr(Inverse[\[CapitalGamma]_K].R) \
tr(o1.\[CapitalGamma]_K.o2.R) for all 18 vertex pairs (random complex R)\"\>",
   "\[Rule]", "True"}]], "Output",
