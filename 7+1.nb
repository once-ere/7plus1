Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"u1, u2\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "0.29289321881345247559915563789515096072`16."}], ",", 
      RowBox[{"-", "0.26958419031043747778472150496431735274`16."}]}], 
     "}"}]}], ",", 
   RowBox[{"\<\"p1, q1, p2, q2\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.54691816067802715680048249263134230816`16.", ",", 
      RowBox[{"-", "0.16018862050852036760036186947350673112`16."}], ",", 
