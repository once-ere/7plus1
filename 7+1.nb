Cell[CellGroupData[{

Cell["\<\
check[\"xAct: Lovelock1 == R_a^b - (1/2) delta_a^b R, the Einstein tensor \
(abstract indices)\", ToCanonical[Lovelock1 - (RicciCD[-a, b] - delta[-a, b] \
RicciScalarCD[]/2)] === 0]
check[\"xAct: trace of Lovelock2 == -2 L_2 with L_2 = R^2 - 4 R_cd R^cd + \
R_cdfi R^cdfi (abstract indices)\",
  ToCanonical[ContractMetric[Lovelock2 delta[-b, a] + 2 (RicciScalarCD[]^2 - \
4 RicciCD[-c, -d] RicciCD[c, d] + RiemannCD[-c, -d, -f, -i] RiemannCD[c, d, \
f, i])],
    UseMetricOnVBundle -> All] === 0]
{\"Lovelock1 (InputForm)\" -> ToString[Lovelock1, InputForm], \"Lovelock2 \
(InputForm)\" -> ToString[Lovelock2, InputForm],
 \"Lovelock3 (InputForm)\" -> ToString[Lovelock3, InputForm]}\
\>", "Input",
 CellLabel->
  "In[546]:=",ExpressionUUID->"5d417eb2-a668-5241-a88a-7fa6b84a7b10"],

Cell[BoxData[
 RowBox[{"\<\"xAct: Lovelock1 == R_a^b - (1/2) delta_a^b R, the Einstein \
tensor (abstract indices)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021432664105816`*^9},
 CellLabel->
  "Out[546]=",ExpressionUUID->"6f6e626d-907b-8645-80d9-d4f6a43064eb"],

Cell[BoxData[
 RowBox[{"\<\"xAct: trace of Lovelock2 == -2 L_2 with L_2 = R^2 - 4 R_cd R^cd \
+ R_cdfi R^cdfi (abstract indices)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002143266426302*^9},
 CellLabel->
  "Out[547]=",ExpressionUUID->"84215e45-2e7c-bb47-bbeb-88d4dc3bcd6b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Lovelock1 (InputForm)\"\>", 
    "\[Rule]", "\<\"RicciCD[-a, b] - (delta[-a, b]*RicciScalarCD[])/2\"\>"}], 
   ",", 
   RowBox[{"\<\"Lovelock2 (InputForm)\"\>", 
    "\[Rule]", "\<\"-4*RicciCD[-a, j]*RicciCD[b, -j] + 2*(RicciCD[-a, \
b]*RicciScalarCD[] - 2*RicciCD[j, -k]*RiemannCD[-a, -j, b, k] + RiemannCD[-a, \
-j, k, l]*RiemannCD[b, j, -k, -l]) + (delta[-a, b]*(4*RicciCD[-j, \
k]*RicciCD[j, -k] - RicciScalarCD[]^2 - RiemannCD[-j, -k, l, m]*RiemannCD[j, \
k, -l, -m]))/2\"\>"}], ",", 
   RowBox[{"\<\"Lovelock3 (InputForm)\"\>", 
    "\[Rule]", "\<\"-8*delta[-a, b]*RicciCD[-j, l]*RicciCD[j, -k]*RicciCD[k, \
-l] + 6*delta[-a, b]*RicciCD[-j, k]*RicciCD[j, -k]*RicciScalarCD[] - \
(delta[-a, b]*RicciScalarCD[]^3)/2 - 12*RicciCD[j, \
-k]*RicciScalarCD[]*RiemannCD[-a, -j, b, k] + 24*RicciCD[b, -j]*RicciCD[k, \
-l]*RiemannCD[-a, -k, j, l] + 24*RicciCD[-j, l]*RicciCD[j, -k]*RiemannCD[-a, \
-l, b, k] + 6*RicciScalarCD[]*RiemannCD[-a, -j, k, l]*RiemannCD[b, j, -k, -l] \
- 12*RicciCD[j, -k]*RiemannCD[-a, -j, l, m]*RiemannCD[b, k, -l, -m] - \
24*RicciCD[j, -k]*RiemannCD[-a, -l, k, m]*RiemannCD[b, l, -j, -m] + \
12*RicciCD[-a, j]*(2*RicciCD[b, -k]*RicciCD[-j, k] - RicciCD[b, \
-j]*RicciScalarCD[] + 2*RicciCD[k, -l]*RiemannCD[b, l, -j, -k] - RiemannCD[b, \
k, -l, -m]*RiemannCD[-j, -k, l, m]) - 12*delta[-a, b]*RicciCD[j, \
-k]*RicciCD[l, -m]*RiemannCD[-j, -l, k, m] + 24*RicciCD[j, -k]*RiemannCD[-a, \
-l, b, m]*RiemannCD[-j, -m, k, l] - 12*RicciCD[b, -j]*RiemannCD[-a, -k, l, \
m]*RiemannCD[j, k, -l, -m] - (3*delta[-a, b]*RicciScalarCD[]*RiemannCD[-j, \
-k, l, m]*RiemannCD[j, k, -l, -m])/2 + 3*RicciCD[-a, b]*(-4*RicciCD[-j, \
k]*RicciCD[j, -k] + RicciScalarCD[]^2 + RiemannCD[-j, -k, l, m]*RiemannCD[j, \
k, -l, -m]) - 24*RiemannCD[-a, -j, k, l]*RiemannCD[b, m, -k, -n]*RiemannCD[j, \
n, -l, -m] + 6*RiemannCD[-a, -j, k, l]*RiemannCD[b, j, -m, -n]*RiemannCD[-k, \
-l, m, n] - 12*RiemannCD[-a, -j, b, k]*RiemannCD[j, l, -m, -n]*RiemannCD[-k, \
-l, m, n] + 4*delta[-a, b]*RiemannCD[-j, -n, l, p]*RiemannCD[j, k, -l, \
-m]*RiemannCD[-k, -p, m, n] + 12*delta[-a, b]*RicciCD[j, -k]*RiemannCD[-j, \
-l, m, n]*RiemannCD[k, l, -m, -n] - delta[-a, b]*RiemannCD[-j, -k, n, \
p]*RiemannCD[j, k, -l, -m]*RiemannCD[l, m, -n, -p]\"\>"}]}], "}"}]], "Output",
 CellChangeTimes->{4.002143266428303*^9},
 CellLabel->
  "Out[548]=",ExpressionUUID->"b80adfa0-0c9c-254e-81b0-befb6fdd95bd"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["12.4 Components with xAct: CD = LC[g]", "Subsection",ExpressionUUID->"c0100f7d-2f38-eb48-b9c5-65ef4c35e5f3"],

Cell["\<\
For a metric given as an 8\[Times]8 matrix of components with lower indices, \
the reference notebook makes it a CTensor in the basis of chartM8, lets \
MetricCompute compute and simplify its Christoffel symbols and curvature, and \
then sets CD = LC[g] (\"xAct magic\": the abstract covariant derivative \
becomes the Levi-Civita connection of the component metric). After RiemannCD \
= Riemann[CD], RicciCD = Ricci[CD], RicciScalarCD = RicciScalar[CD] and \
EinsteinCD = Einstein[CD] every abstract expression, in particular Lovelock1, \
Lovelock2 and Lovelock3, evaluates to components, and MyArrayComponents turns \
them into arrays. xActLovelock[gm] does exactly these steps and returns the \
matrices E^(k)\[Mu]_\[Nu] (k = 1, 2, 3, row \[Mu], column \[Nu]; the array of \
MyArrayComponents has the lower index a first, hence the Transpose) and G^\
\[Mu]_\[Nu], as functions of x0, \[Ellipsis], x7. It is applied here to the \
cosmological metric of section 11.2, and in sections 12.8 and 12.9 to the \
pp-wave and to exponential expansion.\
\>", "Text",ExpressionUUID->"6c8a2aa6-8ba3-9e44-9e92-6bc21b225cfa"],

Cell[CellGroupData[{

Cell["\<\
asMat8[mat_] := If[mat === 0, ConstantArray[0, {8, 8}], mat];
xActLovelock[gm_] := Module[{res},
   g71 = CTensor[gm /. toXc, {-chartM8, -chartM8}];
   MetricCompute[g71, chartM8, All, Parallelize -> False, Verbose -> False];
   CD = LC[g71];
   RiemannCD = Riemann[CD]; RicciCD = Ricci[CD]; RicciScalarCD = \
RicciScalar[CD]; EinsteinCD = Einstein[CD];
   res = Transpose[asMat8[MyArrayComponents[#]]] & /@ {Lovelock1, Lovelock2, \
Lovelock3, EinsteinCD[-a, b]};
   res /. fromXc];
xlCos = xActLovelock[gCos];
check[\"xAct, cosmological metric: Lovelock1 == EinsteinCD == the Einstein \
tensor of the curvature engine of section 11.1\",
  Simplify[xlCos[[1]] - xlCos[[4]]] == ConstantArray[0, {8, 8}] && \
Simplify[xlCos[[1]] - cvCos[\"G\"]] == ConstantArray[0, {8, 8}]]
Grid[Prepend[Table[{k, toH[xlCos[[k, 1, 1]]], toH[xlCos[[k, 2, 2]]], \
toH[xlCos[[k, 5, 5]]]}, {k, 1, 3}], {\"k\", \"Lovelock_k 0_0\", \"Lovelock_k \
1_1\", \"Lovelock_k 4_4\"}], Frame -> All]\
\>", "Input",
 CellLabel->
  "In[549]:=",ExpressionUUID->"f5f9ab2c-0eb9-a143-b704-5521fb36208d"],

Cell[BoxData[
 RowBox[{"\<\"xAct, cosmological metric: Lovelock1 == EinsteinCD == the \
Einstein tensor of the curvature engine of section 11.1\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002143270797823*^9},
 CellLabel->
  "Out[552]=",ExpressionUUID->"0703cc19-93bc-b641-b7de-05a96db4e7d3"],

