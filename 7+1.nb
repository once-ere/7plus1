Cell[CellGroupData[{

Cell["10. Summary of all checks (sections 1\[Dash]9)", "Section",ExpressionUUID->"24e2dd63-0d16-bc4d-bf6d-941073fc8d3c"],

Cell["\<\
The four cells below repeat the summary of section 6 after sections 7\[Dash]9 \
have been evaluated, so they cover every check of the notebook.\
\>", "Text",ExpressionUUID->"0969fdfb-8d7c-fb4a-ad04-a33997ba5c47"],

Cell[CellGroupData[{

Cell["Length[checks]", "Input",
 CellLabel->
  "In[500]:=",ExpressionUUID->"cbea2bbc-c0ec-0348-960b-b56de1c94b04"],

