Cell[BoxData[
 RowBox[{"\<\"divergence-free: d0 E^0_0 + 3Ha (E^0_0 - E^1_1) + 4Hb (E^0_0 - \
E^4_4) == 0 for k = 1, 2, 3 (arbitrary a, b)\"\>", "\[Rule]", 
