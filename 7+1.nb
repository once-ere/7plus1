   RowBox[{"\<\"H_inf (1/s, GeV), T_GH (K)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "1.8076961806308098`*^-18", ",", "1.1898472405336612`*^-42", ",", 
      "2.1975484073507046`*^-30"}], "}"}]}], ",", 
   RowBox[{"\<\"2 Pi M/H_inf for M = 1 eV, 1 GeV\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"5.280665528426574`*^33", ",", "5.280665528426574`*^42"}], 
     "}"}]}]}], "}"}]], "Output",
