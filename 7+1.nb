  {\"S_2: alpha2 H^2\", \"dominant for 10^-3 l2 < tau < l2\", \
N[rIIH0g^2/rIIM8^2, 3], N[(rIIIH rIIhbar)^2/rIIM8^2, 3]},
  {\"S_3: alpha3 H^4\", \"dominant for tau < 10^-3 l2\", N[10^-6 \
rIIH0g^4/rIIM8^4, 3], N[10^-6 (rIIIH rIIhbar)^4/rIIM8^4, 3]},
  {\"S_psi: dirac16complex (gas; matter)\", \"gas: first table; dominant near \
tau = 0\", \"Omega_m = 0.315 (0.265 if it is the dark matter)\", \"-> 0 like \
e^(-3 H t)\"},
  {\"S_m: m/H\", \"<< 1 (massless gas)\", \">> 1 (cold matter)\", \">> 1\"},
  {\"S_self: g_r n^(6/7) ~ (k_phys/M8)^6 (estimate)\", \"< 1 below the \
eight-dimensional Planck scale\", \"negligible\", \"negligible\"},
  {\"S_U: radion displacement beta\", \"catches b when H ~ m_r, then \
oscillates\", N[(3 rIIH0g^2 rIIOL + 1.5 rIIH0g^2 rIIOm)/(3 100.), 3], \
N[(rIIIH rIIhbar)^2/100., 3]},
  {\"S_f: brane tension kappa f_W/(3 H^2 V_perp)\", N[rIIM8^2/(3 rIIMPl^2), \
3], \"part of Lambda4\", \"part of Lambda4\"},
  {\"S_SM: brane plasma\", N[rIbrane, 3], N[rIIOr, 3], \"-> 0 like e^(-4 H t)\
\"},
  {\"S_P: portals (estimate)\", \"negligible (on the brane)\", \"production \
of dirac16complex (freeze-in)\", \"negligible\"},
  {\"L_phiW: radion-brane coupling\", \"radion not yet caught\", \
Row[{\"reheating, T_RH = \", NumberForm[rIITRH, 3], \" GeV (m_r = 10 \
GeV)\"}], \"-\"},
  {\"pair creation 2 Pi M/H (M = 1 eV)\", \"order 1 (Planckian times)\", N[2 \
