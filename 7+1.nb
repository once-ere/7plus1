      RowBox[{"-", "1.2500065415293071`"}]}], "}"}]}], ",", 
   RowBox[{"\<\"(p_eff, gas fraction) at Ha = 3 10^5, 30, 10^-2\"\>", "\[Rule]", 
    RowBox[{"{", 
