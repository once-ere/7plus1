Cell[CellGroupData[{

Cell["\<\
23.2 The radion in de Sitter: Gauss\[Dash]Bonnet corrections and relaxation\
\>", "Subsection",ExpressionUUID->"c3714a2b-0a87-134b-b6be-5582a74445c9"],

Cell["\<\
Linearize the full Einstein\[Dash]Lovelock equations (with U = (K_U/2)\[Beta]\
\.b2, \[Kappa]K_U = 12m_r\.b2) around Ha = H, Hb = 0, \[Beta] = \[Beta]_eq, \
eliminating \[Delta]Ha with the constraint. The radion obeys \[Beta]\
\[DoublePrime] + \[Gamma] \[Beta]\[Prime] + m_eff\.b2 (\[Beta] \[Minus] \
\[Beta]_eq) = 0 with (for \[Beta]_eq \[RightArrow] 0)\
\>", "Text",ExpressionUUID->"43f84eb7-4e5b-6947-bc82-40614f8e5b39"],

Cell["\<\
      \[Gamma]/(3H) = (1 \[Minus] 16\[Alpha]_2H\.b2 + 48\[Alpha]_2\.b2H\:2074 \
\[Minus] 48\[Alpha]_3H\:2074 + 512\[Alpha]_2\.b3H\:2076 + 192\[Alpha]_2\
\[Alpha]_3H\:2076 \[Minus] 1024\[Alpha]_2\:2074H\:2078)/(1 \[Minus] \
4\[Alpha]_2H\.b2 + 32\[Alpha]_2\.b2H\:2074)\.b2,\
\>", "Text",ExpressionUUID->"81e812cb-244a-bb44-adbd-a1a9f0ba73b7"],

Cell["\<\
      m_eff\.b2/m_r\.b2 = 1/(1 \[Minus] 4\[Alpha]_2H\.b2 + 32\[Alpha]_2\.b2H\
\:2074),     3 m_r\.b2 \[Beta]_eq = 3H\.b2 \[Minus] 12\[Alpha]_2H\:2074 (+ O(\
\[Beta]_eq\.b2)).\
\>", "Text",ExpressionUUID->"b4f16c0c-2f99-dd4a-b8c2-87b3563ef5a3"],

Cell[TextData[{
 "For \[Alpha]_2 = \[Alpha]_3 = 0: \[Gamma] = 3H and m_eff = m_r. The radion \
is stable and relaxes to its shifted equilibrium. A numerical test in units ",
 StyleBox["\[ScriptL]",
  FontFamily->"Cambria Math"],
 "2 = 1 (\[CapitalLambda] = 3 \[Times] 10\:207b\:2074, m_r = 0.1, \[Xi] = 10\
\:207b\:2076, start 0.05 above equilibrium) reaches the equilibrium \
(\[Beta]_eq, H_eq) of the two algebraic equations 3H\.b2 = \[CapitalLambda] + \
6m_r\.b2\[Beta]\.b2 and 3m_r\.b2\[Beta] = 3H\.b2 \[Minus] 12H\:2074 to 10\
\:207b\:2076. In the physical far future \[Alpha]_2H\[Infinity]\.b2 \
\[TildeTilde] 10\:207b\:2079\.b2 and \[Beta]_eq \[TildeTilde] \
H\[Infinity]\.b2/m_r\.b2: the auxiliary space is frozen forever."
}], "Text",ExpressionUUID->"e579f136-6a8a-1b4b-b8a2-ee4fec780e7d"],

Cell["\<\
Without the stabilizing potential the far future would instead be \
eight-dimensional de Sitter, a = b = e^(Hx0), an exact vacuum solution when \
21H\.b2 \[Minus] 420\[Alpha]_2H\:2074 + 2520\[Alpha]_3H\:2076 = \
\[CapitalLambda]: the auxiliary space would inflate and G4 \[Proportional] b\
\:207b\:2074 would fall like e^(\[Minus]4Hx0), which experiments exclude (|\
\:0120/G| is less than a few percent of H0).\
\>", "Text",ExpressionUUID->"da154e26-ef85-e547-8bb1-83301e899c5d"],

Cell[CellGroupData[{

Cell["\<\
rIIIeqC = (feTot[1] /. {Ha -> haV, Hb -> hbV}) - 6 m2V beV^2;
rIIIsl = First[Solve[{(feTot[2] /. {Ha -> haV, Hb -> hbV}) == 6 m2V beV^2, \
(feTot[5] /. {Ha -> haV, Hb -> hbV}) == 6 m2V beV^2 + 3 m2V beV}, {dHa, dHb}]];
rIIIFb = dHb /. rIIIsl;
rIIIbg = {haV -> hS, hbV -> 0, beV -> bqV, lamb -> (lamb /. \
First[Solve[(rIIIeqC /. {haV -> hS, hbV -> 0, beV -> bqV}) == 0, lamb]])};
rIIIcd = D[rIIIeqC, #] /. rIIIbg & /@ {haV, hbV, beV}; rIIIfd = D[rIIIFb, #] \
/. rIIIbg & /@ {haV, hbV, beV};
rIIIgam = Simplify[-(rIIIfd[[2]] - rIIIfd[[1]] rIIIcd[[2]]/rIIIcd[[1]])]; \
rIIImeff = Simplify[-(rIIIfd[[3]] - rIIIfd[[1]] rIIIcd[[3]]/rIIIcd[[1]])];
check[\"radion in de Sitter: gamma/(3H) and m_eff^2/m_r^2 as in the text \
(beta_eq -> 0); gamma = 3H and m_eff^2 = m_r^2 for alpha2 = alpha3 = 0\",
  Simplify[(rIIIgam /. bqV -> 0)/(3 hS) - (1 - 16 alf[2] hS^2 + 48 alf[2]^2 \
hS^4 - 48 alf[3] hS^4 + 512 alf[2]^3 hS^6 + 192 alf[2] alf[3] hS^6 - 1024 \
alf[2]^4 hS^8)/(1 - 4 alf[2] hS^2 + 32 alf[2]^2 hS^4)^2] === 0 &&
  Simplify[(rIIImeff /. bqV -> 0)/m2V - 1/(1 - 4 alf[2] hS^2 + 32 alf[2]^2 \
hS^4)] === 0 &&
  Simplify[rIIIgam /. {bqV -> 0, alf[2] -> 0, alf[3] -> 0}] === 3 hS && \
Simplify[rIIImeff /. {bqV -> 0, alf[2] -> 0, alf[3] -> 0}] === m2V]
check[\"radion equilibrium in de Sitter: 3 m_r^2 beta_eq == 3 H^2 - 12 alpha2 \
H^4 + O(beta_eq^2)\",
  Simplify[(bqV /. Solve[Normal[Series[rIIIFb /. rIIIbg, {bqV, 0, 1}]] == 0, \
bqV][[1]]) - (3 hS^2 - 12 alf[2] hS^4)/(3 m2V)] === 0]
rIIIlam = 3 10^-4; rIIImr = 1/10;
rIIIrhs[tt_?NumericQ, yy_?VectorQ] := Module[{ha, hb, la, lb, kU, d}, {ha, \
hb, la, lb} = yy; kU = 6 rIIImr^2 lb^2;
   d = rIsolve2[rIlinMf[ha, hb], -rIlinBf[ha, hb] + {rIIIlam + kU, rIIIlam + \
kU + 3 rIIImr^2 lb}]; {d[[1]], d[[2]], ha, hb}];
rIIIeqs = FindRoot[{3 rIIIhh^2 == rIIIlam + 6 rIIImr^2 rIIIbb^2, 3 rIIImr^2 \
rIIIbb == 3 rIIIhh^2 - 12 rIIIhh^4}, {{rIIIbb, 1/100}, {rIIIhh, 1/100}}, \
WorkingPrecision -> 30];
rIIIb0 = (rIIIbb /. rIIIeqs) + 1/20;
rIIIds = NDSolveValue[{rIIIyD'[tt] == rIIIrhs[tt, rIIIyD[tt]], rIIIyD[0] == \
N[{Sqrt[(rIIIlam + 6 rIIImr^2 rIIIb0^2)/3], 0, 0, rIIIb0}]}, rIIIyD, {tt, 0, \
3000},
    Method -> {\"ExplicitRungeKutta\", \"DifferenceOrder\" -> 8, \
\"StiffnessTest\" -> False}, PrecisionGoal -> 11, AccuracyGoal -> 14, \
MaxSteps -> 10^7, MaxStepSize -> 1];
check[\"the radion relaxes to the equilibrium of the two algebraic equations: \
beta(3000) to 10^-6, Ha(3000) to 10^-8 (relative)\",
  Abs[rIIIds[3000][[4]]/(rIIIbb /. rIIIeqs) - 1] < 10^-6 && \
Abs[rIIIds[3000][[1]]/(rIIIhh /. rIIIeqs) - 1] < 10^-8]
rIIIds8 = Expand[feTot[1] /. {Ha -> h8, Hb -> h8}];
check[\"eight-dimensional de Sitter (no stabilizer): all three equations read \
21 H^2 - 420 alpha2 H^4 + 2520 alpha3 H^6 == Lambda\",
  Expand[rIIIds8 - (21 h8^2 - 420 alf[2] h8^4 + 2520 alf[3] h8^6 - lamb)] === \
0 &&
  AllTrue[{feTot[2], feTot[5]}, Expand[(# /. {Ha -> h8, Hb -> h8, dHa -> 0, \
dHb -> 0}) - rIIIds8] === 0 &]]
{\"gamma/(3H), m_eff^2/m_r^2 (beta_eq -> 0)\" -> {Factor[(rIIIgam /. bqV -> \
0)/(3 hS)], Factor[(rIIImeff /. bqV -> 0)/m2V]},
 \"de Sitter test: beta(3000), Ha(3000), beta_eq, H_eq\" -> \
{rIIIds[3000][[4]], rIIIds[3000][[1]], rIIIbb /. rIIIeqs, rIIIhh /. rIIIeqs}}\
\>", "Input",
 CellLabel->
  "In[1087]:=",ExpressionUUID->"980f4678-acf7-8442-b98c-76805fbc6502"],

Cell[BoxData[
 RowBox[{"\<\"radion in de Sitter: gamma/(3H) and m_eff^2/m_r^2 as in the \
text (beta_eq -> 0); gamma = 3H and m_eff^2 = m_r^2 for alpha2 = alpha3 = 0\"\
\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021473524240856`*^9},
 CellLabel->
  "Out[1093]=",ExpressionUUID->"c9a4f783-e5ee-3d4d-beda-044ea8370fd8"],

Cell[BoxData[
 RowBox[{"\<\"radion equilibrium in de Sitter: 3 m_r^2 beta_eq == 3 H^2 - 12 \
alpha2 H^4 + O(beta_eq^2)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002147352434807*^9},
 CellLabel->
  "Out[1094]=",ExpressionUUID->"8596012d-079e-5e44-b4e6-f97fbcd1140a"],

Cell[BoxData[
 RowBox[{"\<\"the radion relaxes to the equilibrium of the two algebraic \
equations: beta(3000) to 10^-6, Ha(3000) to 10^-8 (relative)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0021473534543056`*^9},
 CellLabel->
  "Out[1100]=",ExpressionUUID->"97a1692f-15c3-f148-8a3c-8ea8dbdf2566"],

Cell[BoxData[
 RowBox[{"\<\"eight-dimensional de Sitter (no stabilizer): all three \
equations read 21 H^2 - 420 alpha2 H^4 + 2520 alpha3 H^6 == Lambda\"\>", "\[Rule]",
   "True"}]], "Output",
 CellChangeTimes->{4.0021473534563046`*^9},
 CellLabel->
  "Out[1102]=",ExpressionUUID->"ddb8072c-0f39-8f46-bf07-ebb2511216f8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"gamma/(3H), m_eff^2/m_r^2 (beta_eq -> 0)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           RowBox[{"16", " ", 
            SuperscriptBox["hS", "2"], " ", 
            RowBox[{"alf", "[", "2", "]"}]}], "-", 
           RowBox[{"48", " ", 
            SuperscriptBox["hS", "4"], " ", 
            SuperscriptBox[
             RowBox[{"alf", "[", "2", "]"}], "2"]}], "-", 
           RowBox[{"512", " ", 
            SuperscriptBox["hS", "6"], " ", 
            SuperscriptBox[
             RowBox[{"alf", "[", "2", "]"}], "3"]}], "+", 
           RowBox[{"1024", " ", 
            SuperscriptBox["hS", "8"], " ", 
            SuperscriptBox[
             RowBox[{"alf", "[", "2", "]"}], "4"]}], "+", 
           RowBox[{"48", " ", 
            SuperscriptBox["hS", "4"], " ", 
            RowBox[{"alf", "[", "3", "]"}]}], "-", 
           RowBox[{"192", " ", 
            SuperscriptBox["hS", "6"], " ", 
            RowBox[{"alf", "[", "2", "]"}], " ", 
            RowBox[{"alf", "[", "3", "]"}]}]}], ")"}], "/", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"4", " ", 
             SuperscriptBox["hS", "2"], " ", 
             RowBox[{"alf", "[", "2", "]"}]}], "+", 
            RowBox[{"32", " ", 
             SuperscriptBox["hS", "4"], " ", 
             SuperscriptBox[
              RowBox[{"alf", "[", "2", "]"}], "2"]}]}], ")"}], "2"]}], 
        ")"}]}], ",", 
      FractionBox["1", 
       RowBox[{"1", "-", 
        RowBox[{"4", " ", 
         SuperscriptBox["hS", "2"], " ", 
         RowBox[{"alf", "[", "2", "]"}]}], "+", 
        RowBox[{"32", " ", 
         SuperscriptBox["hS", "4"], " ", 
         SuperscriptBox[
          RowBox[{"alf", "[", "2", "]"}], "2"]}]}]]}], "}"}]}], ",", 
   RowBox[{"\<\"de Sitter test: beta(3000), Ha(3000), beta_eq, H_eq\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "0.010204078087430533`", ",", "0.010103586699399753`", ",", 
      "0.01020407808743053201647110308533191987108177643503532582`30.", ",", 
      "0.0101035866993997532026732842892867587108988337454732022951`30."}], 
     "}"}]}]}], "}"}]], "Output",
 CellChangeTimes->{4.0021473534645576`*^9},
 CellLabel->
  "Out[1103]=",ExpressionUUID->"1b1572a7-ef78-c744-9f31-70663825e0ef"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["23.3 The size of every interaction in the three regimes", "Subsection",ExpressionUUID->"c1f8af2f-0a4b-7348-9496-faa93aae4d56"],

Cell["\<\
The first table gives, at four points of the coupled primordial solution of \
section 21.3, the share of each term of the 00 equation: its size (S_1, S_2, \
S_3 of section 21.3 for the Einstein, Gauss\[Dash]Bonnet and cubic terms, \
\[Kappa]\[Epsilon] for the dirac16complex gas) divided by the sum of the four \
sizes. The second table collects, for each term of the action of section \
20.1, its weight in the field equations of each regime, computed in sections \
21\[Dash]23 (M8 = 10 TeV, \[Alpha]_2 = 1/M8\.b2, \[Alpha]_3 = \
10\:207b\:2076/M8\:2074, m_r = 10 GeV, f_W = M8\:2074; \"estimate\" marks an \
order-of-magnitude statement).\
\>", "Text",ExpressionUUID->"414047aa-1dd6-da48-bd3a-fee010feba15"],

Cell[CellGroupData[{

Cell["\<\
rIIIshare[h_] := With[{sz = rIstate[h][\"S\"]}, sz/Total[sz]];
rIIIbudget = {{\"regime I: cubic (Ha = 3 10^5)\", Sequence @@ rIIIshare[3 \
10^5]}, {\"regime I: Gauss-Bonnet (Ha = 30)\", Sequence @@ rIIIshare[30]},
   {\"regime I: Einstein (Ha = 10^-2)\", Sequence @@ rIIIshare[10^-2]}, \
{\"regime I: near the singularity (Ha = 10^15)\", Sequence @@ \
rIIIshare[10^15]}};
check[\"the shares of the four terms of the 00 equation: Einstein > 0.99 at \
Ha = 10^-2, Gauss-Bonnet > 0.9 at Ha = 30, Gauss-Bonnet and cubic about 1/2 \
each at Ha = 3 10^5, gas > 0.1 at Ha = 10^15\",
  rIIIbudget[[3, 2]] > 0.99 && rIIIbudget[[2, 3]] > 0.9 && Abs[rIIIbudget[[1, \
3]] - 1/2] < 0.01 && Abs[rIIIbudget[[1, 4]] - 1/2] < 0.01 && rIIIbudget[[4, \
5]] > 0.1]
Grid[Prepend[Map[If[NumberQ[#], NumberForm[#, 4], #] &, rIIIbudget, {2}], {\"\
\", \"Einstein S_1\", \"Gauss-Bonnet S_2\", \"cubic S_3\", \"dirac16complex \
gas\"}], Frame -> All]
{\"shares (Einstein, Gauss-Bonnet, cubic, gas) at Ha = 3 10^5, 30, 10^-2, \
10^15\" -> rIIIbudget[[All, 2 ;; 5]]}\
\>", "Input",
 CellLabel->
  "In[1104]:=",ExpressionUUID->"2378586a-46fb-8a47-802a-3d583be4468f"],

Cell[BoxData[
 RowBox[{"\<\"the shares of the four terms of the 00 equation: Einstein > \
0.99 at Ha = 10^-2, Gauss-Bonnet > 0.9 at Ha = 30, Gauss-Bonnet and cubic \
about 1/2 each at Ha = 3 10^5, gas > 0.1 at Ha = 10^15\"\>", "\[Rule]", 
  "True"}]], "Output",
