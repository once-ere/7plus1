 CellLabel->
  "Out[130]=",ExpressionUUID->"f2ae0f09-2749-214b-8277-74b0e2d0e17b"],

Cell[BoxData[
 RowBox[{"\<\"norm is multiplicative: N(xy) == N(x) N(y) (symbolic; Degen's \
eight-square identity)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494704213753`*^9},
 CellLabel->
  "Out[131]=",ExpressionUUID->"06167516-2bf4-7d4a-883a-36de2bb724d9"],

Cell[BoxData[
 RowBox[{"\<\"inverse x^-1 = x\:0304/N(x): x x^-1 == x^-1 x == e[0] \
(symbolic)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002049470425375*^9},
 CellLabel->
  "Out[132]=",ExpressionUUID->"5cadadef-886b-3947-90ca-86f40203fc13"],

Cell[BoxData[
 RowBox[{"\<\"every x satisfies x x - 2 Re(x) x + N(x) e[0] == 0, so the \
subalgebra generated by x is \[DoubleStruckCapitalR] or \
\[DoubleStruckCapitalC]\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494704307785`*^9},
 CellLabel->
  "Out[133]=",ExpressionUUID->"870d9126-b3f8-0f45-8ec0-7c94189ac4f2"]
}, Open  ]],

Cell["\<\
Degen\[CloseCurlyQuote]s eight-square identity, explicitly: the eight \
components of x y are bilinear forms, and the sum of their squares equals (a0\
\.b2 + \[Ellipsis] + a7\.b2)(b0\.b2 + \[Ellipsis] + b7\.b2). Hence N(x) = 0 \
forces x = 0, and xy = 0 forces x = 0 or y = 0: unlike the split octonions, \
the octonions have no zero divisors (a division algebra).\
\>", "Text",ExpressionUUID->"0a2b30b4-9a5d-4747-ab77-236083de67b0"],

Cell[CellGroupData[{

