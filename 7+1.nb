 CellLabel->
  "Out[658]=",ExpressionUUID->"fabfac65-c910-de42-a052-924c85d94c15"],

Cell[BoxData[
 RowBox[{"\<\"static radial metric: psi = f^(-1/4) r^(-3) chi removes the \
spin connection, Gamma^mu D_mu psi == f^(-1/4) r^(-3) Gamma^mu d_mu chi\"\>", 
  "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021244014102535`*^9},
