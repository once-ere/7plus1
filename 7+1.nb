Cell[BoxData[
 RowBox[{"\<\"graviton + radion: far from the source the images add up to (5 \
kappa M/(32 Pi^3)) (4 Pi^2/(3 V_perp r)) == (5/3) G4 M/r with G4 = kappa/(8 \
Pi V_perp); the radion of section 20.3, coupled to matter by (phi/(Sqrt[3] \
M_Pl)) T, gives the potential -(1/(Sqrt[3] M_Pl))^2 M M' Exp[-m_r r]/(4 Pi \
r), and (1/(Sqrt[3] M_Pl))^2/(4 Pi) == (2/3) G4 (8 Pi G4 = 1/M_Pl^2): \
graviton 1 + massless radion 2/3 = 5/3\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002191852199684*^9},
 CellLabel->
  "Out[1226]=",ExpressionUUID->"c524d97f-ff76-e74b-8eb0-66dd7824917d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"images S(r), Kaluza-Klein (4 Pi^2/(3 r)) Sum Exp[-2 Pi r \
|m|], relative difference, at r = 1/4, 1/2, 1, 2\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1046.849375969645`", ",", "1046.8493759704083`", ",", 
        RowBox[{"-", "7.290834602713403`*^-13"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"51.125251795261846`", ",", "51.12525179602523`", ",", 
        RowBox[{"-", "1.4931722525091118`*^-11"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"13.409604541405546`", ",", "13.409604542168914`", ",", 
        RowBox[{"-", "5.6926907632259827`*^-11"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"6.579922931695465`", ",", "6.579922932458837`", ",", 
        RowBox[{"-", "1.1601541949346483`*^-10"}]}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"Z(5/2) = 7 zeta(5/2) zeta(3/2), shell sum with tail\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "24.53127768992602917867685663329136736403`20.", ",", 
