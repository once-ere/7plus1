  "Out[736]=",ExpressionUUID->"53f94d5f-0d7e-764d-9cd7-c12a7b421e56"],

Cell[BoxData[
 RowBox[{"\<\"section 8 recovered: with g = (gS, gV, 0, 0, 0, 0, 0, -gA, -gP) \
the exchange energy of uniform matter is that of section 8.7\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0021244105701237`*^9},
 CellLabel->
  "Out[737]=",ExpressionUUID->"37f2c92a-f13b-9e49-8ad6-f89fada07d6d"],

Cell[BoxData[
 RowBox[{"\<\"the Hartree-Fock couplings of section 8.7: gS = -100000, gV = \
10000 give G_0 = -98750, G_1 = 20000\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021244105701237`*^9},
 CellLabel->
  "Out[738]=",ExpressionUUID->"eec855f5-a8e8-c84e-b268-b6a40e5f643b"],

