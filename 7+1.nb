        RowBox[{"-", "4"}], ",", 
        RowBox[{"-", "2"}], ",", "4", ",", "14", ",", "28"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"56", ",", 
        RowBox[{"-", "14"}], ",", 
        RowBox[{"-", "4"}], ",", "6", ",", "0", ",", 
        RowBox[{"-", "6"}], ",", "4", ",", "14", ",", 
        RowBox[{"-", "56"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"70", ",", "0", ",", 
        RowBox[{"-", "10"}], ",", "0", ",", "6", ",", "0", ",", 
        RowBox[{"-", "10"}], ",", "0", ",", "70"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"56", ",", "14", ",", 
        RowBox[{"-", "4"}], ",", 
        RowBox[{"-", "6"}], ",", "0", ",", "6", ",", "4", ",", 
        RowBox[{"-", "14"}], ",", 
        RowBox[{"-", "56"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"28", ",", 
        RowBox[{"-", "14"}], ",", "4", ",", "2", ",", 
        RowBox[{"-", "4"}], ",", "2", ",", "4", ",", 
        RowBox[{"-", "14"}], ",", "28"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"8", ",", "6", ",", "4", ",", "2", ",", "0", ",", 
