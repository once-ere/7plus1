Cell[CellGroupData[{

Cell["\<\
check[\"exponential expansion a = e^{H x0}, b = e^{qH H x0}: xAct Lovelock_k \
== the closed forms of section 12.6 with Ha = H, Hb = qH H, Ha' = Hb' = 0 (k \
= 1, 2, 3)\",
  And @@ Table[Simplify[xlExp[[kk]] - (toH /@ (Diagonal[ECos[[kk + 1]]]) /. \
{Ha -> H, Hb -> qH H, dHa -> 0, dHb -> 0} // DiagonalMatrix)] == \
ConstantArray[0, {8, 8}], {kk, 1, 3}]]
fieldEqsExp = -\[CapitalLambda] IdentityMatrix[8] + H^-2 w1 xlExp[[1]] + H^-4 \
w2 xlExp[[2]] + H^-6 w3 xlExp[[3]];
eqsExp = DeleteCases[Union[Flatten[Expand[fieldEqsExp]]], 0];
check[\"exponential expansion: three distinct vacuum equations, related by 3 \
Ha (eq00 - eq11) + 4 Hb (eq00 - eq44) == 0\",
  Length[eqsExp] == 3 && Expand[3 H (fieldEqsExp[[1, 1]] - fieldEqsExp[[2, \
2]]) + 4 qH H (fieldEqsExp[[1, 1]] - fieldEqsExp[[5, 5]])] === 0]
wsExp = Factor[Solve[{fieldEqsExp[[2, 2]] == 0, fieldEqsExp[[5, 5]] == 0}, \
{w2, w3}]]      (* eq11 and eq44; eq00 then follows from the relation above *)\
\>", "Input",
 CellLabel->
  "In[602]:=",ExpressionUUID->"86762ab4-e89b-b34e-a7c9-90b54e80d95c"],

Cell[BoxData[
 RowBox[{"\<\"exponential expansion a = e^{H x0}, b = e^{qH H x0}: xAct \
