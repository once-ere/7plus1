Cell[CellGroupData[{

Cell["\<\
dkTstar = (rIIM8^6/rIIMPl)^(1/5);
dkS[x_?NumericQ] := 2/(3 Pi) NIntegrate[tV^3 BesselK[1, tV], {tV, x, \
Infinity}, PrecisionGoal -> 12, AccuracyGoal -> 30];
dkSstar = dkS[mHb/dkTstar];
check[\"Boltzmann factor of production below T_RH: Int_0^Infinity t^3 K_1(t) \
dt == 3 Pi/2 (exact), S(0) = 1, S(m_h/T*) < 10^-2 with T* = (M8^6/M_Pl)^(1/5) \
= 13.3 GeV\",
  Integrate[tV^3 BesselK[1, tV], {tV, 0, Infinity}] == 3 Pi/2 && Abs[dkS[0] - \
1] < 10^-10 && dkSstar < 10^-2 && 13 < dkTstar < 14]
dkC = 135/(8 Pi^3 1.66) 1/106.75^(3/2) 1.22091*^19;            (* Y = dkC \
Gamma S/m_h^2 *)
dkYfi[cyx_, nch_] := dkC nch ((cyx dkYeff)^2 mHb/(16 Pi))/mHb^2;   (* zero \
mode, Yukawa portal, S = 1 *)
dkYhp[cpx_] := dkC ((cpx dkLam vEW)^2 mHb/(8 Pi))/mHb^2;           (* zero \
mode, Higgs portal, S = 1 *)
dkK = dkTau3[1, 1.];                                               (* tau(chi \
-> 3 nu) = dkK/(c_y^2 m^3), m in GeV *)
dkMstar[nch_] := Sqrt[dkYfi[1, nch] dkK/(dkYm dkAge)];
dkCyNeed[mx_, nch_] := Sqrt[dkYm/(mx dkYfi[1, nch])]; dkCyMax[mx_] := \
Sqrt[dkK/(mx^3 dkAge)];
check[\"zero mode through the Yukawa portal: the abundance (~ c_y^2 m) and \
the stability (lifetime ~ 1/(c_y^2 m^3) > age) are compatible only for m < \
m*, and m* < 5.7 keV (Lyman-alpha) for N = 1 and N = 12 channels even with S \
= 1\",
  dkMstar[1] < 5.7*^-6 && dkMstar[12] < 5.7*^-6 && Abs[dkCyNeed[dkMstar[1], \
1]/dkCyMax[dkMstar[1]] - 1] < 10^-9]
dkTowN = rIIVp mHb^4/(192 Pi^2); dkTowE = rIIVp mHb^5/(315 Pi^2);
dkLat = 1 + Total[rIIr4[[1 ;; 10^4]] (1 - Range[10^4]/10.^4)^2]; dkLatE = \
Total[rIIr4[[1 ;; 10^4]] Sqrt[Range[10^4]/10.^4] (1 - Range[10^4]/10.^4)^2];
check[\"Kaluza-Klein tower: Sum_n (1 - mu_n^2/m_h^2)^2 -> V_perp m_h^4/(192 \
Pi^2) and Sum_n mu_n (1 - mu_n^2/m_h^2)^2 -> V_perp m_h^5/(315 Pi^2) (d^4n = \
2 Pi^2 |n|^3 d|n|: exact integrals); the lattice sums with r_4(k) for R = 100 \
equal Pi^2 R^4/12 and 16 Pi^2 R^4/315 to 10^-8\",
  Integrate[2 Pi^2 uV^3 (1 - uV^2)^2, {uV, 0, 1}] == Pi^2/12 && Integrate[2 \
Pi^2 uV^4 (1 - uV^2)^2, {uV, 0, 1}] == 16 Pi^2/315 &&
  Simplify[(Pi^2/12) (mhS rLS/(2 Pi))^4 - rLS^4 mhS^4/(192 Pi^2)] === 0 && \
Simplify[(16 Pi^2/315) mhS (mhS rLS/(2 Pi))^4 - rLS^4 mhS^5/(315 Pi^2)] === 0 \
&&
  Abs[dkLat/(Pi^2 10.^8/12) - 1] < 10^-8 && Abs[dkLatE/(16 Pi^2 10.^8/315) - \
1] < 10^-8]
dkCyTow = Sqrt[dkYm/(dkYfi[1, 1] dkTowE dkSstar)];
check[\"Kaluza-Klein tower through the Yukawa portal: 7.7 10^17 states below \
m_h with mean mass (192/315) m_h; at T_RH = T* it carries more energy than \
all the dark matter unless c_y < 2 10^-5 (N = 1)\",
  Abs[dkTowN/7.688*^17 - 1] < 10^-3 && Abs[dkTowE/(dkTowN 192/315 mHb) - 1] < \
10^-12 && dkCyTow < 2*^-5]
dkIhp = NIntegrate[u1V^3 u2V^3 (1 - (u1V + u2V)^2)^(3/2) Sqrt[1 - (u1V - \
u2V)^2], {u1V, 0, 1}, {u2V, 0, 1 - u1V}, PrecisionGoal -> 10, AccuracyGoal -> \
20];
dkIhpE = NIntegrate[(u1V + u2V) u1V^3 u2V^3 (1 - (u1V + u2V)^2)^(3/2) Sqrt[1 \
- (u1V - u2V)^2], {u1V, 0, 1}, {u2V, 0, 1 - u1V}, PrecisionGoal -> 10, \
AccuracyGoal -> 20];
dkPairs = (rIIVp mHb^4/(8 Pi^2))^2;
dkRhp[cpx_, nch_, x_] := dkYhp[cpx] nch dkPairs mHb dkIhpE dkS[x];        (* \
mass of the Kaluza-Klein pairs per entropy, GeV *)
dkCpNeed[x_] := Sqrt[dkYm/dkRhp[1, 4, x]];
check[\"Higgs portal: the zero mode gets Y < 10^-40 (c_P = 1); the pairs of \
Kaluza-Klein levels (lambda(1, u1^2, u2^2) == (1 - (u1 + u2)^2)(1 - (u1 - \
u2)^2)) give the observed abundance only for c_P between 10 and 20 (T_RH >> \
m_h, S -> 1) or between 100 and 200 (T_RH = T*)\",
  dkYhp[1] < 10^-40 && Expand[(1 - u1V^2 - u2V^2)^2 - 4 u1V^2 u2V^2 - (1 - \
(u1V + u2V)^2) (1 - (u1V - u2V)^2)] === 0 &&
  10 < dkCpNeed[0] < 20 && 100 < dkCpNeed[mHb/dkTstar] < 200]
dkTV = (rIIM8^12/rIIMPl)^(1/11);
check[\"vector portal: gravitational strength per pair; the production rate \
of all pairs lighter than T divided by H ~ (T/T_V)^11 with T_V = \
(M8^12/M_Pl)^(1/11) = 490 GeV is below 10^-17 at T*\",
  480 < dkTV < 500 && (dkTstar/dkTV)^11 < 10^-17]
{\"T* (GeV), S(m_h/T*)\" -> {dkTstar, dkSstar}, \"zero mode: Yukawa-portal Y \
at c_y = 1 (N = 1, S = 1), Higgs-portal Y at c_P = 1 (S = 1)\" -> {dkYfi[1, \
1], dkYhp[1]},
 \"m* (GeV) for N = 1 and N = 12\" -> {dkMstar[1], dkMstar[12]}, \"c_y needed \
and allowed at m = 10 keV, 10 MeV\" -> {dkCyNeed[10^-5, 1], dkCyMax[10^-5], \
dkCyNeed[0.01, 1], dkCyMax[0.01]},
 \"Kaluza-Klein tower below m_h: number, mass sum (GeV), Y_tower and mass per \
entropy (GeV) at c_y = 1 (N = 1, S = 1); c_y bound at T*\" -> {dkTowN, \
dkTowE, dkYfi[1, 1] dkTowN, dkYfi[1, 1] dkTowE, dkCyTow},
 \"tau(chi_n -> 3 nu) (s) at mu_n = 10 GeV, c_y = 1; largest m (GeV) with \
tau(chi -> 3 nu) > age for c_y = 10^-5\" -> {dkTau3[1, 10.], (dkK/(10^-10 \
dkAge))^(1/3)},
 \"Higgs portal pairs: I_hp, I_hp^E, number of pairs, mass per entropy (GeV) \
at c_P = 1 (N = 4, S = 1); c_P needed for S = 1 and at T*\" -> {dkIhp, \
dkIhpE, dkPairs, dkRhp[1, 4, 0], dkCpNeed[0], dkCpNeed[mHb/dkTstar]},
 \"Higgs portal pairs at c_P = 1, T_RH = T*: fraction of the dark matter\" -> \
dkRhp[1, 4, mHb/dkTstar]/dkYm,
 \"vector portal: T_V (GeV), (T*/T_V)^11\" -> {dkTV, (dkTstar/dkTV)^11},
 \"T_RH (GeV) = 5, 8, 10, T*: S(m_h/T_RH), c_y bound of the tower (N = 1), \
c_P needed by the Higgs-portal pairs (N = 4)\" ->
   Table[{trh, dkS[mHb/trh], Sqrt[dkYm/(dkYfi[1, 1] dkTowE dkS[mHb/trh])], \
dkCpNeed[mHb/trh]}, {trh, {5., 8., 10., dkTstar}}]}\
\>", "Input",
 CellLabel->
  "In[1143]:=",ExpressionUUID->"265d42c1-0896-fb44-909d-40769e769b5f"],

