    RowBox[{"{", 
     RowBox[{"1.9453688391750839`", ",", "112.01641316574337`"}], "}"}]}], ",", 
   RowBox[{"\<\"DUNE P(mu->e) with vector portal V_P,e = 0.2 V_CC, \
without\"\>", "\[Rule]", 
    RowBox[{"{", 
