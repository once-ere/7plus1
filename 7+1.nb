}, Open  ]],

Cell[CellGroupData[{

Cell["allChecksPassed = AllTrue[Values[checks], TrueQ]", "Input",
 CellLabel->
  "In[502]:=",ExpressionUUID->"8288bbc3-25d7-964a-9287-4a9a68f188ab"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{4.0021915987151737`*^9},
 CellLabel->
  "Out[502]=",ExpressionUUID->"e9aa19d7-8f7c-564c-a0a6-5acd2a96eae3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Grid[Prepend[KeyValueMap[{#1, #2} &, checks], {Style[\"check\", Bold], Style[\
\"result\", Bold]}], Frame -> All, Alignment -> Left]\
\>", "Input",
 CellLabel->
  "In[503]:=",ExpressionUUID->"3c53b17a-4866-064d-8cdb-82c882dee5ed"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"check\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"result\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {"\<\"4+4: \[Zeta][7] == diag(-1,-1,-1,-1,1,1,1,1)\"\>", "True"},
    {"\<\"4+4: \[Sigma] == \[Zeta][1].\[Zeta][2].\[Zeta][3]\"\>", "True"},
    {"\<\"4+4: (\[Zeta][A].\[Zeta][B] + \[Zeta][B].\[Zeta][A])/2 == \
-\[Eta]4488[[A+1,B+1]] ID8 (A,B = 1..7)\"\>", "True"},
    {"\<\"4+4: -\[Eta]4488[[A+1,A+1]] \[Zeta][A] == Transpose[\[Zeta][A]] (A \
= 1..7)\"\>", "True"},
    {"\<\"4+4: (\[Tau][A].\[Tau]bar[B] + \[Tau][B].\[Tau]bar[A])/2 == \
\[Eta]4488[[A+1,B+1]] ID8\"\>", "True"},
    {"\<\"4+4: (\[Tau]bar[A].\[Tau][B] + \[Tau]bar[B].\[Tau][A])/2 == \
\[Eta]4488[[A+1,B+1]] ID8\"\>", "True"},
    {"\<\"4+4: \[Tau][1].\[Tau][2]...\[Tau][7] == ID8\"\>", "True"},
    {"\<\"4+4: \[Sigma] == \[Tau][1].\[Tau][2].\[Tau][3] == \
\[Tau][4].\[Tau][5].\[Tau][6].\[Tau][7]\"\>", "True"},
    {"\<\"4+4: \[Sigma] commutes with \[Tau][1..3] and anticommutes with \
\[Tau][4..7]; \[Sigma].\[Sigma] == ID8\"\>", "True"},
    {"\<\"4+4: (T16[A].T16[B] + T16[B].T16[A])/2 == \[Eta]4488[[A+1,B+1]] \
ID16\"\>", "True"},
    {"\<\"4+4: T16[A] real (entries 0, \[PlusMinus]1)\"\>", "True"},
    {"\<\"4+4: T16[8] == diag(-ID8, ID8)\"\>", "True"},
    {"\<\"4+4: \[Sigma]16 == diag(-\[Sigma], \[Sigma])\"\>", "True"},
    {"\<\"4+4: PL44 + PR44 == ID16, PL44.PL44 == PL44, PR44.PR44 == PR44, \
PL44.PR44 == 0\"\>", "True"},
    {"\<\"4+4: uBasis == evecs/Sqrt[2] from Eigensystem[\[Sigma]] (the basis \
of 4+4.nb)\"\>", "True"},
    {"\<\"4+4: unit == (1,0,0,0,1,0,0,0)/Sqrt[2], \[Sigma].unit == unit, \
unit.unit == 1, unit.\[Sigma].unit == 1\"\>", "True"},
    {"\<\"4+4 (In[294]): E44inv[h] == (u.\[Sigma].u) \
Transpose[Table[\[Eta]4488[[B,B]] \[Tau][B-1].u, {B,1,8}]] for h = 1..8\"\>", 
     "True"},
    {"\<\"4+4: gridx44 is identical to the split-octonion table printed by \
4+4.nb\"\>", "True"},
    {"\<\"4+4: LS[A] are signed permutation matrices (constants 0, \
\[PlusMinus]1)\"\>", "True"},
    {"\<\"split: eA[1] is the identity; eA[2..4]^2 == -eA[1]; eA[5..8]^2 == \
+eA[1]\"\>", "True"},
    {"\<\"split: x x\:0304 == N(x) eA[1] with N = \[Eta]4488 (symbolic)\"\>", 
     "True"},
    {"\<\"split: N(xy) == N(x) N(y) (symbolic)\"\>", "True"},
    {"\<\"split: alternative x(xy) == (xx)y and (yx)x == y(xx) \
(symbolic)\"\>", "True"},
    {"\<\"split: (eA[1] + eA[5])(eA[1] - eA[5]) == 0 with both factors \
nonzero: NOT a division algebra\"\>", "True"},
    {"\<\"\[Tau]O[A] (A = 1..7): real, antisymmetric, \[Tau]O[A].\[Tau]O[A] \
== -ID8\"\>", "True"},
    {"\<\"\[Tau]O[A] anticommute: \[Tau]O[A].\[Tau]O[B] == \
-\[Tau]O[B].\[Tau]O[A] (A != B, A,B = 1..7)\"\>", "True"},
    {"\<\"mirror of 4+4: (\[Tau]O[A].\[Tau]Obar[B] + \
\[Tau]O[B].\[Tau]Obar[A])/2 == gO[[A+1,B+1]] ID8\"\>", "True"},
    {"\<\"mirror of 4+4: (\[Tau]Obar[A].\[Tau]O[B] + \
\[Tau]Obar[B].\[Tau]O[A])/2 == gO[[A+1,B+1]] ID8\"\>", "True"},
    {"\<\"mirror of 4+4: \[Tau]O[1].\[Tau]O[2]...\[Tau]O[7] == ID8\"\>", 
     "True"},
    {"\<\"mirror of 4+4: \[Tau]Obar[A] == gO.Transpose[\[Tau]O[A]].gO, as \
\[Tau]bar[A] == \[Sigma].Transpose[\[Tau][A]].\[Sigma]\"\>", "True"},
    {"\<\"\[Tau]O[4..7] are products of three split \[Tau]: \[Tau]O[4] == \
\[Tau][5].\[Tau][6].\[Tau][7], \[Tau]O[5] == -\[Tau][4].\[Tau][6].\[Tau][7], \
\[Tau]O[6] == \[Tau][4].\[Tau][5].\[Tau][7], \[Tau]O[7] == \
-\[Tau][4].\[Tau][5].\[Tau][6]\"\>", "True"},
    {"\<\"\[Sigma].unit == unit, hence \[Tau]O[A].unit == \[Tau][A].unit (A = \
0..7)\"\>", "True"},
    {"\<\"EO is orthogonal: EOinv == Transpose[EO]\"\>", "True"},
    {"\<\"mirror of 4+4.nb In[294]: EOinv == (u.gO.u) \
Transpose[Table[gO[[B,B]] \[Tau]O[B-1].u, {B,1,8}]]\"\>", "True"},
    {"\<\"EO == \[Eta]4488.E44[hUSE]: the two vielbeins differ only by the \
signs of rows 5..8\"\>", "True"},
    {"\<\"gridO equals the octonion table computed independently in \
Python\"\>", "True"},
    {"\<\"LO[A] are signed permutation matrices (all multiplication constants \
are 0, \[PlusMinus]1)\"\>", "True"},
    {"\<\"oMul reproduces gridO on all 64 pairs of basis units\"\>", "True"},
    {"\<\"e[0] is a two-sided identity\"\>", "True"},
    {"\<\"e[i] e[i] == -e[0] (i = 1..7)\"\>", "True"},
    {"\<\"e[i] e[j] == -e[j] e[i] (i != j, i,j = 1..7): non-commutative\"\>", 
     "True"},
    {"\<\"7 Fano lines; every pair of distinct imaginary units lies on \
exactly one line\"\>", "True"},
    {"\<\"each oriented line (a,b,c) is cyclic: e[a]e[b] == e[c], e[b]e[c] == \
e[a], e[c]e[a] == e[b]\"\>", "True"},
    {"\<\"each line spans a quaternion subalgebra: {e[0], e[a], e[b], e[c]} \
closed and associative\"\>", "True"},
    {"\<\"the picture's 7 lines are exactly fanoLines\"\>", "True"},
    {"\<\"left alternative: x(xy) == (xx)y (symbolic)\"\>", "True"},
    {"\<\"right alternative: (yx)x == y(xx) (symbolic)\"\>", "True"},
    {"\<\"flexible: (xy)x == x(yx) (symbolic)\"\>", "True"},
    {"\<\"associator is alternating: [x,y,z] == -[y,x,z] == -[x,z,y] \
(symbolic)\"\>", "True"},
    {"\<\"power associativity: x(xx) == (xx)x (symbolic)\"\>", "True"},
    {"\<\"Moufang: z(x(zy)) == ((zx)z)y, x(z(yz)) == ((xz)y)z, (zx)(yz) == \
(z(xy))z (x, y basis units, z symbolic)\"\>", "True"},
    {"\<\"x x\:0304 == x\:0304 x == N(x) e[0] (symbolic)\"\>", "True"},
    {"\<\"conjugation is an anti-automorphism: conj(xy) == conj(y) conj(x) \
(symbolic)\"\>", "True"},
    {"\<\"Re(x) == (x + x\:0304)/2 == x0\"\>", "True"},
    {"\<\"norm is multiplicative: N(xy) == N(x) N(y) (symbolic; Degen's \
eight-square identity)\"\>", "True"},
    {"\<\"inverse x^-1 = x\:0304/N(x): x x^-1 == x^-1 x == e[0] \
(symbolic)\"\>", "True"},
    {"\<\"every x satisfies x x - 2 Re(x) x + N(x) e[0] == 0, so the \
subalgebra generated by x is \[DoubleStruckCapitalR] or \
\[DoubleStruckCapitalC]\"\>", "True"},
    {"\<\"exactly 168 of the 512 ordered basis triples are non-associative (= \
7*6*4: distinct imaginary units not on one Fano line)\"\>", "True"},
    {"\<\"example: (e[1]e[2])e[4] == e[7] but e[1](e[2]e[4]) == -e[7]\"\>", 
     "True"},
    {"\<\"numerical example: N(x y) == N(x) N(y) == 15*6 == 90 and x x^-1 == \
e[0]\"\>", "True"},
    {"\<\"numerical example: x y != y x and (x y) z != x (y z)\"\>", "True"},
    {"\<\"\[DoubleStruckCapitalH] = span{e[0],e[1],e[2],e[3]} is a subalgebra\
\"\>", "True"},
    {"\<\"\[ScriptL] = e[4] doubles \[DoubleStruckCapitalH]: e[4] e[k] == \
e[4+k] (k = 1,2,3) and e[4] e[4] == -e[0]\"\>", "True"},
    {"\<\"orientation inherited from 4+4.nb: e[1] e[2] == -e[3]\"\>", "True"},
    {"\<\"Cayley-Dickson, \[Gamma] = -1: (ac - d b\:0304, a\:0304 d + c b) \
reproduces the octonion product (symbolic)\"\>", "True"},
    {"\<\"Cayley-Dickson, \[Gamma] = +1: (ac + d b\:0304, a\:0304 d + c b) \
reproduces the SPLIT product of 4+4.nb (symbolic)\"\>", "True"},
    {"\<\"the formula (ac - d\:0304 b, a\:0304 d + c b) of [1A] is NOT \
alternative: x\[CenterDot]x\[CenterDot]y != x(xy) for x = e[0]+e[4], y = e[1]\
\"\>", "True"},
    {"\<\"... and its norm is not multiplicative (symbolic)\"\>", "True"},
    {"\<\"e[A]e[B] (octonion) == s_AB e[A]e[B] (split) for all A, B = \
0..7\"\>", "True"},
    {"\<\"over \[DoubleStruckCapitalC]: \[CurlyPhi](x *split y) == \
\[CurlyPhi](x) *oct \[CurlyPhi](y) (symbolic): split \[CircleTimes] \
\[DoubleStruckCapitalC] \[TildeFullEqual] \[DoubleStruckCapitalO] \
\[CircleTimes] \[DoubleStruckCapitalC]\"\>", "True"},
    {"\<\"the norms correspond: N_oct(\[CurlyPhi](x)) == N_split(x) \
(symbolic)\"\>", "True"},
    {"\<\"Cl(8,0): (T16O[A].T16O[B] + T16O[B].T16O[A])/2 == gO[[A+1,B+1]] \
ID16\"\>", "True"},
    {"\<\"S44 == diag(\[Sigma], \[Sigma])\"\>", "True"},
    {"\<\"T16O from the 4+4 matrices: T16O[A] == T16[A] (A = 0..3), T16O[k] \
== T16[k].S44 (k = 4..7)\"\>", "True"},
    {"\<\"T16O[8] == T16[8] == diag(-ID8, ID8): same chirality matrix and \
same PL44, PR44 as 4+4.nb\"\>", "True"},
    {"\<\"7+1 REAL Clifford relation: \
(\[CapitalGamma]17[A].\[CapitalGamma]17[B] + \[CapitalGamma]17[B].\
\[CapitalGamma]17[A])/2 == \[Eta]17[[A+1,B+1]] ID16 == -\[Eta]71[[A+1,B+1]] \
ID16\"\>", "True"},
    {"\<\"\[CapitalGamma]17[A] are REAL: every entry is 0 or \
\[PlusMinus]1\"\>", "True"},
    {"\<\"block form: \[CapitalGamma]17[0] == {{0,ID8},{ID8,0}}, \
\[CapitalGamma]17[i] == {{\[Tau]O[i],0},{0,\[Tau]Obar[i]}}\"\>", "True"},
    {"\<\"built from the real 4+4 matrices: \[CapitalGamma]17[0] == T16[0], \
\[CapitalGamma]17[i] == T16[0].T16[i] (i = 1,2,3), \[CapitalGamma]17[k] == \
T16[0].T16[k].S44 (k = 4..7)\"\>", "True"},
    {"\<\"\[CapitalGamma]17[0] symmetric, \[CapitalGamma]17[i] antisymmetric, \
so Transpose[\[CapitalGamma]17[A]] == \
\[CapitalGamma]17[0].\[CapitalGamma]17[A].\[CapitalGamma]17[0] (real Dirac \
adjoint)\"\>", "True"},
    {"\<\"the 256 products \[CapitalGamma]17[A1]...\[CapitalGamma]17[Ak] (A1 \
< ... < Ak) are linearly independent: Cl(1,7) \[TildeFullEqual] \
\[DoubleStruckCapitalR](16)\"\>", "True"},
    {"\<\"grades: binomial(8,k) == {1,8,28,56,70,56,28,8,1}, total 256 \
(binomial(8,4) == 70, not 72)\"\>", "True"},
    {"\<\"Tr[product] == 0 for every non-empty product, so Tr[M]/16 is the \
scalar part of M\"\>", "True"},
    {"\<\"irreducible over \[DoubleStruckCapitalR]: only multiples of ID16 \
commute with all \[CapitalGamma]17[A] (Schur; real commutant of dimension \
1)\"\>", "True"},
    {"\<\"universal property: \[CapitalGamma]17(v).\[CapitalGamma]17(v) == \
(v.\[Eta]17.v) ID16 for a symbolic vector v = X\"\>", "True"},
    {"\<\"7+1 COMPLEX Clifford relation, 4+4.nb sign: (\[CapitalGamma]71[A].\
\[CapitalGamma]71[B] + \[CapitalGamma]71[B].\[CapitalGamma]71[A])/2 == \
\[Eta]71[[A+1,B+1]] ID16\"\>", "True"},
    {"\<\"\[CapitalGamma]71[0] == I T16[0] and \[CapitalGamma]71[k] == \
T16O[k] (k = 1..7): only the time component is complex\"\>", "True"},
    {"\<\"S = (ID16 - I \[CapitalGamma]17[0])/Sqrt[2] is unitary and \
\[CapitalGamma]71[A] == S.(I \[CapitalGamma]17[A]).Inverse[S]\"\>", "True"},
    {"\<\"Schur: the intertwiners M with M.Conjugate[\[CapitalGamma]71[A]] == \
\[CapitalGamma]71[A].M form a 1-dimensional space\"\>", "True"},
    {"\<\"... spanned by the volume element \[CapitalGamma]17[8] == \
{{0,-ID8},{ID8,0}}, and \[CapitalGamma]17[8].\[CapitalGamma]17[8] == \
-ID16\"\>", "True"},
    {"\<\"indicator(\[CapitalGamma]71) == -1: Cl(7,1) \[TildeFullEqual] \
\[DoubleStruckCapitalH](8), NO real 16\[Times]16 realization of the \[Eta]71 \
relation\"\>", "True"},
    {"\<\"indicator(\[CapitalGamma]17) == +1: Cl(1,7) \[TildeFullEqual] \
\[DoubleStruckCapitalR](16), real realization exists (\[CapitalGamma]17)\"\>",
      "True"},
    {"\<\"REAL 32\[Times]32 realization of the \[Eta]71 relation: (\
\[CapitalGamma]71R32[A].\[CapitalGamma]71R32[B] + \[CapitalGamma]71R32[B].\
\[CapitalGamma]71R32[A])/2 == \[Eta]71[[A+1,B+1]] ID32\"\>", "True"},
    {"\<\"Qi, Qj, Qk commute with every \[CapitalGamma]71R32[A]; Qi.Qi == \
Qj.Qj == Qk.Qk == -ID32; Qi.Qj == Qk == -Qj.Qi\"\>", "True"},
    {"\<\"the commutant of {\[CapitalGamma]71R32[A]} has dimension exactly 4 \
and is spanned by ID32, Qi, Qj, Qk: it is \[DoubleStruckCapitalH]\"\>", 
     "True"},
    {"\<\"\[CapitalGamma]17[8].\[CapitalGamma]17[8] == -ID16 and \
\[CapitalGamma]17[8] anticommutes with every \[CapitalGamma]17[A]: no real \
chirality in 7+1\"\>", "True"},
    {"\<\"\[CapitalGamma]71[8].\[CapitalGamma]71[8] == -ID16 and \[Chi]71 = \
-I \[CapitalGamma]71[8] == T16O[8] == T16[8] (real, diagonal)\"\>", "True"},
    {"\<\"7+1 chiral projectors in the \[CapitalGamma]71 basis are exactly \
PL44, PR44 of 4+4.nb; \[Chi]71 anticommutes with every \[CapitalGamma]71[A]\"\
\>", "True"},
    {"\<\"complex chiral projectors for \[CapitalGamma]17: PL17 + PR17 == \
ID16, PL17.PL17 == PL17, PL17.PR17 == 0, rank 8 each\"\>", "True"},
    {"\<\"\[Eta]17 is simply the squares of the octonion basis: e[A] e[A] == \
\[Eta]17[[A+1, A+1]] e[0] (e[0]^2 = +1, e[i]^2 = -1) and Re(e[A] e[B]) == \
\[Eta]17[[A+1, B+1]] (A, B = 0..7)\"\>", "True"},
    {"\<\"Re(x x) == X.\[Eta]17.X: the octonion square produces the 7+1 \
interval (symbolic)\"\>", "True"},
    {"\<\"octonion basis: \[CapitalGamma]17e[0] == {{0,ID8},{ID8,0}} and \
\[CapitalGamma]17e[i] == {{LO[i],0},{0,-LO[i]}}\"\>", "True"},
    {"\<\"alternativity in action: xImag(xImag \[Psi]) == -|xImag|^2 \[Psi] \
for the imaginary part xImag of x (symbolic)\"\>", "True"},
    {"\<\"T16O(x)^2 == N(x) ID16 (octonion norm) and T16(x)^2 == \
(X.\[Eta]4488.X) ID16 (4+4.nb)\"\>", "True"},
    {"\<\"28 real generators \[CapitalSigma]17[A,B] (A < B), linearly \
independent\"\>", "True"},
    {"\<\"[\[CapitalSigma]17[A,B], \[CapitalGamma]17[K]] == \
\[Eta]17[[B+1,K+1]] \[CapitalGamma]17[A] - \[Eta]17[[A+1,K+1]] \
\[CapitalGamma]17[B]\"\>", "True"},
    {"\<\"so(1,7): [\[CapitalSigma]_AB, \[CapitalSigma]_KL] == \[Eta]_BK \
\[CapitalSigma]_AL - \[Eta]_AK \[CapitalSigma]_BL - \[Eta]_BL \
\[CapitalSigma]_AK + \[Eta]_AL \[CapitalSigma]_BK\"\>", "True"},
    {"\<\"the complex structure J = \[CapitalGamma]17[8] commutes with all \
\[CapitalSigma]17[A,B] (Spin(1,7) acts complex-linearly on \
\[DoubleStruckCapitalR]^16 = \[DoubleStruckCapitalC]^8)\"\>", "True"},
    {"\<\"S(\[Beta]) and R(\[Theta]) are the exponentials: dS/d\[Beta] == \
\[CapitalSigma]17[0,1].S, S(0) == ID16, dR/d\[Theta] == \
\[CapitalSigma]17[4,5].R, R(0) == ID16, and S.Sinv == R.Rinv == ID16\"\>", 
     "True"},
    {"\<\"S(\[Beta]).\[CapitalGamma]17[K].S(\[Beta])^-1 == \[Sum]_B \
\[CapitalLambda]boost[[B+1,K+1]] \[CapitalGamma]17[B]; \[CapitalLambda]boost \
is the boost along x1\"\>", "True"},
    {"\<\"R(\[Theta]).\[CapitalGamma]17[K].R(\[Theta])^-1 == \[Sum]_B \
\[CapitalLambda]rot[[B+1,K+1]] \[CapitalGamma]17[B]; \[CapitalLambda]rot is \
the rotation in the x4-x5 plane\"\>", "True"},
    {"\<\"both \[CapitalLambda] preserve the 7+1 metric: Transpose[\
\[CapitalLambda]].\[Eta]17.\[CapitalLambda] == \[Eta]17\"\>", "True"},
    {"\<\"(\[CapitalGamma]17^A \[PartialD]_A)^2 \[CapitalPsi] == \
(\[PartialD]0^2 - \[PartialD]1^2 - ... - \[PartialD]7^2) \[CapitalPsi] for 16 \
arbitrary functions of x0..x7\"\>", "True"},
    {"\<\"p is on the mass shell (p.\[Eta]17.p == m^2) and pslash.pslash == \
m^2 ID16\"\>", "True"},
    {"\<\"(pslash - m) w == 0 has 8 linearly independent REAL solutions \
w\"\>", "True"},
    {"\<\"\[CapitalPsi] = w Exp[-I p.x] solves (I \[CapitalGamma]17^A \
\[PartialD]_A - m) \[CapitalPsi] == 0\"\>", "True"},
    {"\<\"the matrices anticommuting with every \[CapitalGamma]17[A] are \
exactly the multiples of \[CapitalGamma]17[8], and (c \[CapitalGamma]17[8])^2 \
== -c^2 ID16: no real J with J.J == +ID16\"\>", "True"},
    {"\<\"null momentum k = (1,1,0,0,0,0,0,0): k.\[Eta]17.k == 0, \
kslash.kslash == 0, and kslash.w == 0 has 8 REAL solutions\"\>", "True"},
    {"\<\"\[CapitalPsi] = w Cos[k.x] is a REAL solution of the real massless \
Dirac equation \[CapitalGamma]17^A \[PartialD]_A \[CapitalPsi] == 0\"\>", 
     "True"},
    {"\<\"(\[CapitalGamma]71R32^A \[PartialD]_A)^2 \[CapitalPsi] == -(\
\[PartialD]0^2 - \[PartialD]1^2 - ... - \[PartialD]7^2) \[CapitalPsi] for 32 \
arbitrary functions of x0..x7\"\>", "True"},
    {"\<\"p.\[Eta]71.p == -m^2 and pslash32.pslash32 == -m^2 ID32\"\>", 
     "True"},
    {"\<\"\[CapitalPsi] = w Cos[p.x] + (pslash32.w/m) Sin[p.x], with 32 \
arbitrary REAL constants w, solves the REAL massive equation \
(\[CapitalGamma]71R32^A \[PartialD]_A - m) \[CapitalPsi] == 0\"\>", "True"},
    {"\<\"... and \[CapitalPsi] obeys the Klein-Gordon equation \
(\[PartialD]0^2 - \[PartialD]1^2 - ... - \[PartialD]7^2 + m^2) \[CapitalPsi] \
== 0\"\>", "True"},
    {"\<\"split analogue: Re(x x) of split octonions == X.\[Eta]53.X, and \
\[CapitalGamma]53 realizes Cl(5,3) with REAL 16\[Times]16 matrices\"\>", 
     "True"},
    {"\<\"\[CapitalGamma]08[A] = T16O[8].T16O[A] realizes Cl(0,8) with REAL \
16\[Times]16 matrices\"\>", "True"},
    {"\<\"gens[p] satisfy the Clifford relation of signature (p, 8-p) for p = \
0..8\"\>", "True"},
    {"\<\"classification: \[DoubleStruckCapitalR](16) for \
(8,0),(5,3),(4,4),(1,7),(0,8); \[DoubleStruckCapitalH](8) for \
(7,1),(6,2),(3,5),(2,6)\"\>", "True"},
    {"\<\"every \[DoubleStruckCapitalR](16) case has explicit REAL \
16\[Times]16 generators in this notebook (T16O, \[CapitalGamma]53, T16, \
\[CapitalGamma]17, \[CapitalGamma]08)\"\>", "True"},
    {"\<\"\[DoubleStruckCapitalC](16) cannot occur: its real dimension 2*16^2 \
= 512 differs from 2^8 = 256\"\>", "True"},
    {"\<\"Dirac matrices: \[CapitalGamma]17up[0] == \[CapitalGamma]17[0], \
\[CapitalGamma]17up[i] == -\[CapitalGamma]17[i]; all REAL, every entry 0 or \
\[PlusMinus]1\"\>", "True"},
    {"\<\"Dirac adjoint: ConjugateTranspose[\[CapitalGamma]17up[A]] == \
\[CapitalGamma]17[0].\[CapitalGamma]17up[A].\[CapitalGamma]17[0] for A = 0..7\
\"\>", "True"},
    {"\<\"\[Beta]D == {{0,ID8},{ID8,0}} and \[Alpha]D[i] == \
{{0,\[Tau]O[i]},{-\[Tau]O[i],0}}: real and symmetric\"\>", "True"},
    {"\<\"\[Alpha]D[i].\[Alpha]D[j] + \[Alpha]D[j].\[Alpha]D[i] == 2 \
\[Delta]ij ID16, \[Alpha]D[i].\[Beta]D + \[Beta]D.\[Alpha]D[i] == 0, \
\[Beta]D.\[Beta]D == ID16\"\>", "True"},
    {"\<\"\[Omega]17 = \[CapitalGamma]17[8] == {{0,-ID8},{ID8,0}} is real, \
\[Omega]17.\[Omega]17 == -ID16, and \[Omega]17 anticommutes with every \
\[CapitalGamma]17[A]\"\>", "True"},
    {"\<\"(I \[CapitalGamma]17up[A] \[PartialD]_A + m)(I \
\[CapitalGamma]17up[A] \[PartialD]_A - m) dirac16complex == -(\[PartialD]0^2 \
- \[PartialD]1^2 - ... - \[PartialD]7^2 + m^2) dirac16complex (16 arbitrary \
functions)\"\>", "True"},
    {"\<\"\[CapitalGamma]17[0].(I \[CapitalGamma]17up[A] \[PartialD]_A - m) \
\[Psi] == I \[PartialD]0 \[Psi] - h \[Psi] with h = -I \[Alpha]D[i] \
\[PartialD]_i + \[Beta]D m (16 arbitrary functions)\"\>", "True"},
    {"\<\"h(p) == {{0, M}, {Transpose[M], 0}} with the REAL 8\[Times]8 matrix \
M = m ID8 + p_i \[Tau]O[i]\"\>", "True"},
    {"\<\"M.Transpose[M] == Transpose[M].M == E^2 ID8 and h(p).h(p) == E^2 \
ID16, E^2 = m^2 + p^2\"\>", "True"},
    {"\<\"h(p).u_s == E u_s and h(-p).v_s == -E v_s for s = 1..8\"\>", "True"},
    {"\<\"(pslash - m).u_s == 0 and (pslash + m).v_s == 0, pslash = E \
\[CapitalGamma]17[0] + p_i \[CapitalGamma]17[i]\"\>", "True"},
    {"\<\"u_s.u_r == v_s.v_r == 2E \[Delta]sr, and u_s(p).v_r(-p) == 0\"\>", 
     "True"},
    {"\<\"plane waves: u_s Exp[-I(E x0 - p.x)] and v_s Exp[+I(E x0 - p.x)] \
solve (I \[CapitalGamma]17up[A] \[PartialD]_A - m) \[Psi] == 0\"\>", "True"},
    {"\<\"example p = (2,2,4,0,0,0,0), m = 1: E = 5 and the eight u_s are \
real (entries in Sqrt[5] \[DoubleStruckCapitalQ]) and solve h(p).u_s == 5 u_s\
\"\>", "True"},
    {"\<\"spin sums: \[Sum]_s u_s ubar_s == pslash + m and \[Sum]_s v_s \
vbar_s == pslash - m\"\>", "True"},
    {"\<\"completeness: \[Sum]_s u_s(p) u_s(p)^T + \[Sum]_s v_s(-p) v_s(-p)^T \
== 2E ID16\"\>", "True"},
    {"\<\"U = (u_1..u_8, v_1(-p)..v_8(-p))/Sqrt[2E] is orthogonal and \
Transpose[U].h(p).U == diag(E ID8, -E ID8)\"\>", "True"},
    {"\<\"Grassmann: \[Theta]1 \[Theta]2 == -\[Theta]2 \[Theta]1, \[Theta]1 \
\[Theta]1 == 0, associativity, and \[PartialD]/\[PartialD]\[Theta]2 \
(\[Theta]1 \[Theta]2 \[Theta]3) == -\[Theta]1 \[Theta]3\"\>", "True"},
    {"\<\"the three plane waves U1, U2, U3 solve the Dirac equation with m = \
1\"\>", "True"},
    {"\<\"Grassmann field: \[Psi]_a \[Psi]_b + \[Psi]_b \[Psi]_a == 0 for all \
a, b (in particular \[Psi]_a^2 == 0)\"\>", "True"},
    {"\<\"current conservation \[PartialD]_A (\[Psi]bar \
\[CapitalGamma]17up[A] \[Psi]) == 0 for the Grassmann-valued solution \[Psi] \
= \[Theta]1 U1 + \[Theta]2 U2 + \[Theta]3 U3\"\>", "True"},
    {"\<\"canonical anticommutator from the mode algebra: {\[Psi]_a(x0,x), \
\[Psi]_b(x0,y)^\[Dagger]} == \[Delta]ab (1/V) \[Sum]_p Exp[I p.(x - y)] (five \
momenta, symbolic x, y)\"\>", "True"},
    {"\<\"\[Psi] -> \[Psi]c = \[Omega]17.\[Psi]^*: (I \[CapitalGamma]17up[A] \
\[PartialD]_A - m)(\[Omega]17.\[Psi]^*) == \[Omega]17.((I \
\[CapitalGamma]17up[A] \[PartialD]_A - m) \[Psi])^* for arbitrary \[Psi] = \
\[Psi]re + I \[Psi]im\"\>", "True"},
    {"\<\"(pslash + m).\[Omega]17.u_s == 0 and \[Omega]17.u_s == \[Sum]_r v_r \
(-Transpose[M]/E)_rs; \[Omega]17.\[Omega]17 == -ID16 (no Majorana \
spinors)\"\>", "True"},
    {"\<\"boost at \[Beta] = 2 log 2: S == 5/4 ID16 + 3/4 \
\[CapitalGamma]17[0].\[CapitalGamma]17[1], p' = \[CapitalLambda].p == (55/8, \
-41/8, 2, 4, 0, 0, 0, 0) is on shell, (pslash' - m).S.u_s(p) == 0\"\>", 
     "True"},
    {"\<\"\[Chi]17 = I \[Omega]17: Hermitian, \[Chi]17.\[Chi]17 == ID16, \
anticommutes with every \[CapitalGamma]17[A], commutes with every \
\[CapitalSigma]17[A,B]\"\>", "True"},
    {"\<\"PL17, PR17 are complex (not real); \[CapitalGamma]17[A].PL17 == \
PR17.\[CapitalGamma]17[A]; ConjugateTranspose[PL17].\[CapitalGamma]17[0] == \
\[CapitalGamma]17[0].PR17\"\>", "True"},
    {"\<\"EL, ER: \[Chi]17.EL == -EL, \[Chi]17.ER == ER, EL^\[Dagger].EL == \
ER^\[Dagger].ER == ID8, EL^\[Dagger].ER == 0, EL.EL^\[Dagger] == PL17, ER.ER^\
\[Dagger] == PR17, W unitary\"\>", "True"},
    {"\<\"\[Phi]L == (\[Psi]up + I \[Psi]down)/Sqrt[2], \[Phi]R == (I \
\[Psi]up + \[Psi]down)/Sqrt[2], PL17.\[Psi] == EL.\[Phi]L, PR17.\[Psi] == ER.\
\[Phi]R, \[Psi] == EL.\[Phi]L + ER.\[Phi]R\"\>", "True"},
    {"\<\"\[Sigma]W[i] = I \[Tau]O[i]: Hermitian, \[Sigma]W[i].\[Sigma]W[j] + \
\[Sigma]W[j].\[Sigma]W[i] == 2 \[Delta]ij ID8\"\>", "True"},
    {"\<\"chiral (Weyl) form: W^\[Dagger].h(p).W == {{-\[Sigma]W.p, m ID8}, \
{m ID8, \[Sigma]W.p}} (symbolic p)\"\>", "True"},
    {"\<\"EL^\[Dagger].\[CapitalGamma]17[0].(I \[CapitalGamma]17up[A] \
\[PartialD]_A - m) \[Psi] == (I \[PartialD]0 + \[Tau]O[i] \[PartialD]_i) \
\[Phi]L - m \[Phi]R (16 arbitrary functions)\"\>", "True"},
    {"\<\"ER^\[Dagger].\[CapitalGamma]17[0].(I \[CapitalGamma]17up[A] \
\[PartialD]_A - m) \[Psi] == (I \[PartialD]0 - \[Tau]O[i] \[PartialD]_i) \
\[Phi]R - m \[Phi]L (16 arbitrary functions)\"\>", "True"},
    {"\<\"Klein-Gordon for each 8-component field: (I \[PartialD]0 - \
\[Tau]O[i] \[PartialD]_i)(I \[PartialD]0 + \[Tau]O[j] \[PartialD]_j) f == -(\
\[PartialD]0^2 - \[PartialD]1^2 - ... - \[PartialD]7^2) f (8 arbitrary \
functions)\"\>", "True"},
    {"\<\"plane-wave example p = (2,2,4,0,0,0,0), m = 1, E = 5: (E + \
\[Sigma]W.p) \[Phi]L == m \[Phi]R and (E - \[Sigma]W.p) \[Phi]R == m \[Phi]L \
for all eight u_s\"\>", "True"},
    {"\<\"the densities \[Rho]S, \[Rho]P, j^A, j5^A are real: \
\[CapitalGamma]17[0].op is Hermitian for op = ID16, I \[Chi]17, \
\[CapitalGamma]17up[A], \[CapitalGamma]17up[A].\[Chi]17\"\>", "True"},
    {"\<\"18 vertex pairs; lower vertex == \[Eta]17[[A+1,A+1]] upper vertex \
in the V and A channels\"\>", "True"},
    {"\<\"nonlinear field equation: left derivative \[PartialD]L_int/\
\[PartialD]\[Psi]bar_a == -[gS (\[Psi]bar \[Psi]) \[Psi] + gP (\[Psi]bar I\
\[Chi]17 \[Psi]) I\[Chi]17 \[Psi] + gV (\[Psi]bar \[CapitalGamma]17[A] \
\[Psi]) \[CapitalGamma]17up[A] \[Psi] + gA (\[Psi]bar \[CapitalGamma]17[A]\
\[Chi]17 \[Psi]) \[CapitalGamma]17up[A]\[Chi]17 \[Psi]]_a (32 Grassmann \
generators)\"\>", "True"},
    {"\<\"h_KS(p) is Hermitian for real S, P, V_A, A_A (symbolic momentum and \
potentials)\"\>", "True"},
    {"\<\"plane wave: \[CapitalGamma]17[0].(pslash(\[Epsilon],p) - m - S - I \
\[Chi]17 P - \[CapitalGamma]17up[A](V_A + \[Chi]17 A_A)) == \[Epsilon] ID16 - \
h_KS(p)\"\>", "True"},
    {"\<\"Hartree potentials: \[PartialD]E_H/\[PartialD]\[Phi]_a^* == (v_H.\
\[Phi])_a, v_H = h_KS - h with S = gS \[Rho]S, P = gP \[Rho]P, V_A = gV j_A, \
A_A = gA j5_A (32 variables)\"\>", "True"},
    {"\<\"Wick's theorem in the 560-dimensional Fock space: <\[CapitalPhi]| \
:(\[Psi]bar o1 \[Psi])(\[Psi]bar o2 \[Psi]): |\[CapitalPhi]> == tr(o1 R) \
tr(o2 R) - tr(o1 R o2 R) for all 18 vertex pairs\"\>", "True"},
    {"\<\"exchange self-energy: d/dt E_x(R + t dR) at t = 0 == tr(\
\[CapitalSigma]_x.dR) and E_x == tr(\[CapitalSigma]_x.R)/2 (random complex R, \
dR; symbolic couplings)\"\>", "True"},
    {"\<\"the 256 products \[CapitalGamma]_K are orthogonal matrices with \
tr(Inverse[\[CapitalGamma]_K].\[CapitalGamma]_L) == 16 \[Delta]KL\"\>", 
     "True"},
    {"\<\"Fierz completeness: \[Sum]_K (\[CapitalGamma]_K)_ab (Inverse[\
\[CapitalGamma]_K])_cd == 16 \[Delta]ad \[Delta]cb (as the 256\[Times]256 \
matrix identity Transpose[F].F == 16 ID)\"\>", "True"},
    {"\<\"Fierz rearrangement of every exchange term: tr(o1 R o2 R) == (1/16) \
\[Sum]_K tr(Inverse[\[CapitalGamma]_K].R) tr(o1.\[CapitalGamma]_K.o2.R) for \
all 18 vertex pairs (random complex R)\"\>", "True"},
    {"\<\"uniform matter: tr R == \[Rho]S, tr(\[CapitalGamma]17up[0].R) == \
\[Rho], and the densities \[Rho]P, j^i, j5^A vanish\"\>", "True"},
    {"\<\"the occupied plane waves give this R: (1/2) \[Sum]_s [u_s(p) \
ubar_s(p) + u_s(-p) ubar_s(-p)]/(2E) == (E \[CapitalGamma]17[0] + m \
ID16)/(2E)\"\>", "True"},
    {"\<\"uniform exchange energy: E_x(R) == -gS/32 (\[Rho]S^2 + \[Rho]^2) + \
gP/32 (\[Rho]S^2 - \[Rho]^2) - gV/32 (8\[Rho]S^2 - 6\[Rho]^2) + gA/32 \
(8\[Rho]S^2 + 6\[Rho]^2)\"\>", "True"},
    {"\<\"uniform exchange self-energy: \[CapitalSigma]_x == S_x ID16 + V_x \
\[CapitalGamma]17[0] with S_x == \[PartialD]E_x/\[PartialD]\[Rho]S and V_x == \
\[PartialD]E_x/\[PartialD]\[Rho]\"\>", "True"},
    {"\<\"uniform Hartree-Fock == Hartree with the Fierz-transformed \
couplings: gS/2 \[Rho]S^2 + gV/2 \[Rho]^2 + E_x == G_S/2 \[Rho]S^2 + G_V/2 \
\[Rho]^2 (gP, gA arbitrary)\"\>", "True"},
    {"\<\"c7 == 8 |S^6|/(2 Pi)^7 == 1/(15 Pi^4), |S^6| == 2 \
Pi^(7/2)/Gamma[7/2] == 16 Pi^3/15, and \[Rho] == c7 kF^7/7 == kF^7/(105 Pi^4)\
\"\>", "True"},
    {"\<\"closed forms: d/dkF of the integrals gives the integrands, both \
vanish at kF = 0, and d\[Epsilon]_kin/dm* == \[Rho]S\"\>", "True"},
    {"\<\"Hartree gap equation m* == m + gS \[Rho]S(m*) solved to 45 digits; \
m* is a stationary point of \[Epsilon](m*) at fixed kF\"\>", "True"},
    {"\<\"total energy == sum of KS eigenvalues - E_H (double counting) == \
\[Epsilon]_kin - (m* - m) \[Rho]S + E_H\"\>", "True"},
    {"\<\"Hugenholtz-Van Hove at saturation: E/A == \[Epsilon]_F == d\
\[Epsilon]/d\[Rho]; E/A - m < 0 and E/A at 0.95 kF0 and 1.05 kF0 is \
higher\"\>", "True"},
    {"\<\"Hugenholtz-Van Hove away from saturation: \[Mu] == d\[Epsilon]/d\
\[Rho] == \[Epsilon]_F at kF = 1\"\>", "True"},
    {"\<\"Hartree-Fock at kF = 3/4 (gP = gA = 0): G_S == -98750, G_V == \
20000; m* - m == gS \[Rho]S + S_x, V_0 == gV \[Rho] + V_x; \[Mu] == \
\[Epsilon]_F\"\>", "True"},
    {"\<\"chiral densities: \[Rho]S == \[Kappa] + \[Kappa]^*, \[Rho]P == I(\
\[Kappa] - \[Kappa]^*), j^A == jL^A + jR^A, j5^A == jR^A - jL^A (symbolic \
chiral orbitals)\"\>", "True"},
    {"\<\"the chiral blocks behind these densities: EL^\[Dagger].\[Beta]D.ER \
== ID8, EL^\[Dagger].\[Beta]D.EL == 0, EL^\[Dagger].\[Alpha]D[i].EL == -\
\[Sigma]W[i], ER^\[Dagger].\[Alpha]D[i].ER == \[Sigma]W[i], EL^\[Dagger].\
\[Alpha]D[i].ER == 0\"\>", "True"},
    {"\<\"E_H (16-component form, chiral orbitals) == gS/2 (\[Kappa] + \
\[Kappa]^*)^2 - gP/2 (\[Kappa] - \[Kappa]^*)^2 + (gV + gA)/2 (jL.jL + jR.jR) \
+ (gV - gA) jL.jR\"\>", "True"},
    {"\<\"chiral KS Hamiltonian: W^\[Dagger].h_KS(p).W == {{V^L_0 - \
\[Sigma]W.(p + V^L), M}, {M^*, V^R_0 + \[Sigma]W.(p + V^R)}}, M = m + S + I \
P, V^L = V - A, V^R = V + A\"\>", "True"},
    {"\<\"Hartree (Wirtinger): M - m == \[PartialD]e_H/\[PartialD]\[Kappa] == \
gS \[Rho]S + I gP \[Rho]P, V^L_A == \[PartialD]e_H/\[PartialD]jL^A; V^L_A == \
V_A - A_A and V^R_A == V_A + A_A with V_A = gV j_A, A_A = gA j5_A\"\>", 
     "True"},
    {"\<\"chiral KS potentials are derivatives: \[PartialD]E_H/\[PartialD]\
\[Phi]L^* == (V^L_0 - \[Sigma]W[i] V^L_i) \[Phi]L + (M - m) \[Phi]R and \
\[PartialD]E_H/\[PartialD]\[Phi]R^* == (V^R_0 + \[Sigma]W[i] V^R_i) \[Phi]R + \
(M - m)^* \[Phi]L\"\>", "True"},
    {"\<\"e^(I\[Theta]\[Chi]17) == cos\[Theta] ID16 - sin\[Theta] \[Omega]17 \
is REAL and orthogonal; U.EL == e^(-I\[Theta]) EL, U.ER == e^(I\[Theta]) ER\"\
\>", "True"},
    {"\<\"U^\[Dagger].\[Beta]D.U == \[Beta]D.(cos 2\[Theta] ID16 + I sin 2\
\[Theta] \[Chi]17); vector and axial densities invariant\"\>", "True"},
    {"\<\"E_H(e^(I\[Theta]\[Chi]17) \[Psi]) - E_H(\[Psi]) == (gS - gP)/2 \
[(e^(4I\[Theta]) - 1) \[Kappa]^2 + (e^(-4I\[Theta]) - 1) \[Kappa]^*2]: U(1)_A \
symmetric iff gP == gS\"\>", "True"},
    {"\<\"uniform matter in chiral form: \[Kappa] == \[Rho]S/2, jL^0 == jR^0 \
== \[Rho]/2, jL^i == jR^i == 0\"\>", "True"},
    {"\<\"(h_\[Chi] - V_0)^2 == (p^2 + m*^2) ID16: eigenvalues V_0 \
\[PlusMinus] Sqrt[p^2 + m*^2], eight times each\"\>", "True"},
    {"\<\"|S^6|/(2 Pi)^7 == 1/(120 Pi^4); J(0) == \[CapitalLambda]^6/(720 \
Pi^4); g_c == -1/(8 J(0)) == -90 Pi^4/\[CapitalLambda]^6; J(M) -> J(0) and \
K(M) -> K(0) as M -> 0\"\>", "True"},
    {"\<\"m = 0, g = 6/5 g_c: the gap equation 1 + 8 g J(|M|) == 0 has the \
root |M| (32 digits); M == 2 g \[Kappa]^* with \[Kappa] == -4 M J; E is \
stationary there and lower than E(0)\"\>", "True"},
    {"\<\"degenerate chiral vacua for m = 0: E(|M| e^(I \[CurlyPhi])) == \
E(|M|) for \[CurlyPhi] = 1, 2, 4 (the phase is the Goldstone direction)\"\>", 
     "True"},
    {"\<\"explicit breaking m = 1/100: the real M == m - 8 g J(M) M solves \
the gap equation, E is stationary there, and every complex phase raises \
E\"\>", "True"},
    {"\<\"the sea at one momentum: h_\[Chi]^2 == E^2 ID16; \[CapitalPi]_- is \
a projector of rank 8; \[Kappa]_p == tr(\[CapitalPi]_- RL block) == -4 M^*/E; \
tr(\[CapitalPi]_-.h0) == -8E + 8 Re[(M - m) M^*]/E\"\>", "True"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellChangeTimes->{4.002191598729683*^9},
 CellLabel->
  "Out[503]=",ExpressionUUID->"5ac8645c-d95b-3d4a-826f-ceafaa72f09b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
11. Gravity on the 7+1 spacetime: metric, curvature and the Einstein tensor\
\>", "Section",ExpressionUUID->"1c85d714-d5b4-8d4c-87f6-92e23ede3891"],

Cell[TextData[{
 StyleBox["About sections 11\[Dash]14. ",
  FontWeight->"Bold"],
 "Sections 11\[Dash]14 were appended on 26 October 2026. The notebook as it \
was before (sections 0\[Dash]10, evaluated) is kept in the workspace as \
backups/7+1_2026-10-26_before_gravity.nb (excluded from the repository by \
.gitignore). They take the IDEAS of the repository \
github.com/once-ere/Dirac_claude \[LongDash] a 16-component field \
dirac16complex coupled to gravity through the canonical spin connection, \
Einstein\[Dash]Lovelock gravity, a primordial pair-creation epoch, a Kohn\
\[Dash]Sham treatment, the Standard Model at a lower-dimensional world \
surface with portals to dirac16complex \[LongDash] and rebuild them on THIS \
project\[CloseCurlyQuote]s spacetime. Dirac_claude works on a 4+4 spacetime \
(four time-like coordinates, a fold, a warped metric); none of that metric is \
used here. Here there is ONE time coordinate x0 and SEVEN space coordinates \
x1 \[Ellipsis] x7, the frame metric \[Eta]17 = diag(+1, \[Minus]1, \
\[Ellipsis], \[Minus]1) is simply the squares of the octonion basis (e0\.b2 = \
+1 for the unit e0 = 1, e_i\.b2 = \[Minus]1 for the seven imaginary units), \
and the Dirac matrices are the real \[CapitalGamma]17[A] of section 4.2."
}], "Text",ExpressionUUID->"7ef2b449-efb6-7a41-b1f9-dbe22fce958f"],

Cell[TextData[{
 StyleBox["Task of sections 11\[Dash]14. ",
  FontWeight->"Bold"],
 "(i) Curvature of a general 7+1 metric: Christoffel symbols, Riemann, Ricci \
and Einstein tensors; (ii) the Lovelock tensors of 7+1 spacetime (Einstein, \
Gauss\[Dash]Bonnet, cubic; the quartic one vanishes identically in eight \
dimensions) and the Einstein\[Dash]Lovelock field equations; (iii) the \
generalized frame matrices \[CapitalGamma]_\[Mu](X) = e^A_\[Mu](X) \
\[CapitalGamma]17[A], the canonical spin connection, and the total covariant \
derivative, under which the frame matrices are constant (\[Del]_\[Mu] \
\[CapitalGamma]_\[Nu] = 0); (iv) the covariant Dirac equation of \
dirac16complex, with which the spin connection couples gravity to the field; \
(v) the three cosmological epochs \[LongDash] primordial (near x0 = 0), \
modern, far future \[LongDash] with the pair creation of dirac16complex in \
each."
}], "Text",ExpressionUUID->"23dd96fc-6188-bd44-8730-cd7a6de4785e"],

Cell[TextData[{
 StyleBox["Conventions. ",
  FontWeight->"Bold"],
 "\:0127 = c = 1. Coordinates X = {x0, \[Ellipsis], x7}; coordinate (Greek) \
indices \[Mu], \[Nu], \[Lambda], \[Rho], \[Sigma] = 0 \[Ellipsis] 7; frame \
(Latin capital) indices A, B, C = 0 \[Ellipsis] 7, raised and lowered with \
\[Eta]17. The spacetime has one time-like dimension, x0, and seven space-like \
dimensions: x1, x2, x3 (ordinary space) and x4 \[Ellipsis] x7 (the four \
auxiliary space-like coordinates); the tensor packages xAct declare this with \
the signature {7, 1, 0} (section 12.2). The metric g_\[Mu]\[Nu] = \[Eta]17_AB \
e^A_\[Mu] e^B_\[Nu] carries the signs of \[Eta]17 = diag(+1, \[Minus]1, \
\[Ellipsis], \[Minus]1), which are simply the squares of the octonion basis: \
e0\.b2 = +1, e_i\.b2 = \[Minus]1 (i = 1 \[Ellipsis] 7), i.e. \[Eta]17_AB = \
Re(e_A e_B) and Re(x x) = x0\.b2 \[Minus] x1\.b2 \[Minus] \[Ellipsis] \
\[Minus] x7\.b2 for x = x^A e_A; so g00 > 0 along the time-like direction and \
the squares along the seven space-like directions are negative. The \
Christoffel symbols are written {\[Lambda] \[Mu]\[Nu]} (never \
\[CapitalGamma], which is reserved for Dirac matrices); in the code chr[[\
\[Lambda]+1, \[Mu]+1, \[Nu]+1]]. Curvature (Landau\[Dash]Lifshitz): R^\[Rho]_\
\[Sigma]\[Mu]\[Nu] = \[PartialD]_\[Mu]{\[Rho] \[Sigma]\[Nu]} \[Minus] \
\[PartialD]_\[Nu]{\[Rho] \[Sigma]\[Mu]} + {\[Rho] \[Mu]\[Lambda]}{\[Lambda] \
\[Sigma]\[Nu]} \[Minus] {\[Rho] \[Nu]\[Lambda]}{\[Lambda] \[Sigma]\[Mu]},  R_\
\[Sigma]\[Nu] = R^\[Rho]_\[Sigma]\[Rho]\[Nu],  R = g^\[Sigma]\[Nu] R_\[Sigma]\
\[Nu],  G^\[Mu]_\[Nu] = R^\[Mu]_\[Nu] \[Minus] \[Delta]^\[Mu]_\[Nu] R/2. With \
these conventions the field equations are G^\[Mu]_\[Nu] \[Minus] \
\[CapitalLambda] \[Delta]^\[Mu]_\[Nu] = \[Kappa] T^\[Mu]_\[Nu] with \[Kappa] \
= 8\[Pi]G8 (G8 the Newton constant of eight dimensions) and T^0_0 > 0 the \
energy density."
}], "Text",ExpressionUUID->"9d01cf4a-3e35-b24d-8684-934bb2e9a592"],

Cell[CellGroupData[{

Cell["11.1 The curvature engine", "Subsection",ExpressionUUID->"60689c54-1b36-0e4a-b241-24caaa5d00c9"],

Cell["\<\
curvature[g, simp] returns, for a metric g given as an 8\[Times]8 matrix in \
the coordinates X, the inverse metric, the Christoffel symbols, the Riemann \
tensor riem[[\[Rho]+1, \[Sigma]+1, \[Mu]+1, \[Nu]+1]] = \
R^\[Rho]_\[Sigma]\[Mu]\[Nu], the tensor rud[[c+1, d+1, a+1, b+1]] = R^cd_ab = \
g^d\[Sigma] R^c_\[Sigma]ab (two indices up, two down, the form used by the \
Lovelock tensors), the Ricci tensor, the scalar curvature and the mixed \
Einstein tensor G^\[Mu]_\[Nu]. rudAssoc lists the non-zero components R^cd_ab \
with c < d and a < b.\
\>", "Text",ExpressionUUID->"577c1c68-cbd8-6d4b-b828-648475e1d0b5"],

Cell["\<\
curvature[g_, simp_: Simplify] := Module[{gi, chr, riem, rud, ric, rs},
  gi = simp[Inverse[g]];
  chr = Table[simp[Sum[gi[[l, r]] (D[g[[r, n]], X[[m]]] + D[g[[r, m]], \
X[[n]]] - D[g[[m, n]], X[[r]]]), {r, 8}]/2], {l, 8}, {m, 8}, {n, 8}];
  riem = Table[simp[D[chr[[r, s, n]], X[[m]]] - D[chr[[r, s, m]], X[[n]]] + \
Sum[chr[[r, m, l]] chr[[l, s, n]] - chr[[r, n, l]] chr[[l, s, m]], {l, 8}]],
    {r, 8}, {s, 8}, {m, 8}, {n, 8}];
  rud = Table[simp[Sum[gi[[d, s]] riem[[c, s, a, b]], {s, 8}]], {c, 8}, {d, \
8}, {a, 8}, {b, 8}];
  ric = Table[simp[Sum[riem[[r, s, r, n]], {r, 8}]], {s, 8}, {n, 8}];
  rs = simp[Sum[gi[[s, n]] ric[[s, n]], {s, 8}, {n, 8}]];
  <|\"g\" -> g, \"ginv\" -> gi, \"chr\" -> chr, \"riem\" -> riem, \"rud\" -> \
rud, \"ric\" -> ric, \"R\" -> rs,
    \"G\" -> simp[gi.ric - rs IdentityMatrix[8]/2]|>];
rudAssoc[rud_] := Association[Select[Flatten[Table[{c, d, a, b} -> rud[[c + \
1, d + 1, a + 1, b + 1]],
     {c, 0, 7}, {d, c + 1, 7}, {a, 0, 7}, {b, a + 1, 7}], 3], #[[2]] =!= 0 &]];
divergenceMixed[cv_, T_] := Table[Sum[D[T[[m, n]], X[[m]]] + \
Sum[cv[\"chr\"][[m, m, l]] T[[l, n]] - cv[\"chr\"][[l, m, n]] T[[m, l]], {l, \
8}], {m, 8}], {n, 8}];\
\>", "Input",
 CellLabel->
  "In[504]:=",ExpressionUUID->"2e95477d-43c7-a24a-819f-d6d3d8168b7c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11.2 The cosmological metric of 7+1 spacetime", "Subsection",ExpressionUUID->"a63bb3f3-c5ee-054b-bca7-4909fd50a6c8"],

Cell["\<\
The spacetime of the three epochs (section 14) is homogeneous, isotropic \
within ordinary 3-space and isotropic within the four-dimensional auxiliary \
space, but the two spaces may expand at different rates:\
\>", "Text",ExpressionUUID->"85e5c70d-1d13-f64e-beb6-fca15a306e4a"],

Cell["\<\
      ds\.b2 = dx0\.b2 \[Minus] a(x0)\.b2 (dx1\.b2 + dx2\.b2 + dx3\.b2) \
\[Minus] b(x0)\.b2 (dx4\.b2 + dx5\.b2 + dx6\.b2 + dx7\.b2),\
\>", "Text",ExpressionUUID->"5c48d50e-fbbb-c746-a144-5f2391ac0d56"],

Cell["\<\
with the scale factor a(x0) (code a3[x0]) of ordinary space and b(x0) (code \
b4[x0]) of the auxiliary space. The Hubble rates are Ha = a\[Prime]/a and Hb \
= b\[Prime]/b (a prime is d/dx0; the code writes dHa, dHb for Ha\[Prime], Hb\
\[Prime]). toH rewrites any expression in Ha, Hb, Ha\[Prime], Hb\[Prime]. In \
an orthonormal frame the Riemann tensor of this metric is diagonal on pairs \
of indices: its only components are the sectional curvatures K_AB = R^AB_AB \
(no sum).\
\>", "Text",ExpressionUUID->"e1bb830b-c46a-a147-8f90-0609979d2c79"],

Cell[CellGroupData[{

Cell["\<\
gCos = DiagonalMatrix[{1, -a3[x0]^2, -a3[x0]^2, -a3[x0]^2, -b4[x0]^2, \
-b4[x0]^2, -b4[x0]^2, -b4[x0]^2}];
cvCos = curvature[gCos];
toH[e_] := Expand[Simplify[e /. {a3''[x0] -> (dHa + Ha^2) a3[x0], b4''[x0] -> \
(dHb + Hb^2) b4[x0]} /. {a3'[x0] -> Ha a3[x0], b4'[x0] -> Hb b4[x0]}]];
secK[cv_, i_, j_] := cv[\"rud\"][[i + 1, j + 1, i + 1, j + 1]];
check[\"cosmological metric: sectional curvatures K_0i = -(Ha'+Ha^2), K_0k = \
-(Hb'+Hb^2), K_ij = -Ha^2, K_kl = -Hb^2, K_ik = -Ha Hb\",
  toH[secK[cvCos, 0, 1]] == -(dHa + Ha^2) && toH[secK[cvCos, 0, 4]] == -(dHb \
+ Hb^2) && toH[secK[cvCos, 1, 2]] == -Ha^2 &&
  toH[secK[cvCos, 4, 5]] == -Hb^2 && toH[secK[cvCos, 1, 4]] == -Ha Hb]
check[\"cosmological metric: R^cd_ab is non-zero only for {c,d} = {a,b}\",
  AllTrue[Keys[rudAssoc[cvCos[\"rud\"]]], Sort[#[[1 ;; 2]]] == Sort[#[[3 ;; \
4]]] &]]
check[\"Einstein tensor: G^0_0 = 3Ha^2 + 12 Ha Hb + 6 Hb^2, G^1_1 = 2Ha' + \
3Ha^2 + 4Hb' + 10Hb^2 + 8HaHb, G^4_4 = 3Ha' + 6Ha^2 + 3Hb' + 6Hb^2 + 9HaHb\",
  toH[cvCos[\"G\"][[1, 1]]] == 3 Ha^2 + 12 Ha Hb + 6 Hb^2 && \
toH[cvCos[\"G\"][[2, 2]]] == Expand[2 dHa + 3 Ha^2 + 4 dHb + 10 Hb^2 + 8 Ha \
Hb] &&
  toH[cvCos[\"G\"][[5, 5]]] == Expand[3 dHa + 6 Ha^2 + 3 dHb + 6 Hb^2 + 9 Ha \
Hb]]
check[\"scalar curvature R = -2 (3Ha' + 6Ha^2 + 4Hb' + 10Hb^2 + 12 Ha Hb)\", \
toH[cvCos[\"R\"]] == Expand[-2 (3 dHa + 6 Ha^2 + 4 dHb + 10 Hb^2 + 12 Ha Hb)]]
{\"G^0_0\" -> toH[cvCos[\"G\"][[1, 1]]], \"G^1_1\" -> toH[cvCos[\"G\"][[2, \
2]]], \"G^4_4\" -> toH[cvCos[\"G\"][[5, 5]]], \"R\" -> toH[cvCos[\"R\"]]}\
\>", "Input",
 CellLabel->
  "In[507]:=",ExpressionUUID->"1b0735b9-d850-9645-8d82-964c62a80226"],

Cell[BoxData[
 RowBox[{"\<\"cosmological metric: sectional curvatures K_0i = -(Ha'+Ha^2), \
K_0k = -(Hb'+Hb^2), K_ij = -Ha^2, K_kl = -Hb^2, K_ik = -Ha Hb\"\>", "\[Rule]",
   "True"}]], "Output",
 CellChangeTimes->{4.002191598887953*^9},
 CellLabel->
  "Out[511]=",ExpressionUUID->"36b90ac5-d655-0446-879b-4e60c7cb6567"],

Cell[BoxData[
 RowBox[{"\<\"cosmological metric: R^cd_ab is non-zero only for {c,d} = {a,b}\
\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021915988939934`*^9},
 CellLabel->
  "Out[512]=",ExpressionUUID->"b1af92a0-1e9d-644a-be33-c5bd35b725ee"],

Cell[BoxData[
 RowBox[{"\<\"Einstein tensor: G^0_0 = 3Ha^2 + 12 Ha Hb + 6 Hb^2, G^1_1 = \
2Ha' + 3Ha^2 + 4Hb' + 10Hb^2 + 8HaHb, G^4_4 = 3Ha' + 6Ha^2 + 3Hb' + 6Hb^2 + \
9HaHb\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021915988939934`*^9},
 CellLabel->
  "Out[513]=",ExpressionUUID->"5edeb45c-6ee4-1040-baac-d2ea092193ae"],

Cell[BoxData[
 RowBox[{"\<\"scalar curvature R = -2 (3Ha' + 6Ha^2 + 4Hb' + 10Hb^2 + 12 Ha \
Hb)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002191598895996*^9},
 CellLabel->
  "Out[514]=",ExpressionUUID->"4f76c4e2-7834-b344-87ec-4e246496e123"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"G^0_0\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"3", " ", 
      SuperscriptBox["Ha", "2"]}], "+", 
     RowBox[{"12", " ", "Ha", " ", "Hb"}], "+", 
     RowBox[{"6", " ", 
      SuperscriptBox["Hb", "2"]}]}]}], ",", 
   RowBox[{"\<\"G^1_1\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"2", " ", "dHa"}], "+", 
     RowBox[{"4", " ", "dHb"}], "+", 
     RowBox[{"3", " ", 
      SuperscriptBox["Ha", "2"]}], "+", 
     RowBox[{"8", " ", "Ha", " ", "Hb"}], "+", 
     RowBox[{"10", " ", 
      SuperscriptBox["Hb", "2"]}]}]}], ",", 
   RowBox[{"\<\"G^4_4\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"3", " ", "dHa"}], "+", 
     RowBox[{"3", " ", "dHb"}], "+", 
     RowBox[{"6", " ", 
      SuperscriptBox["Ha", "2"]}], "+", 
     RowBox[{"9", " ", "Ha", " ", "Hb"}], "+", 
     RowBox[{"6", " ", 
      SuperscriptBox["Hb", "2"]}]}]}], ",", 
   RowBox[{"\<\"R\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "6"}], " ", "dHa"}], "-", 
     RowBox[{"8", " ", "dHb"}], "-", 
     RowBox[{"12", " ", 
      SuperscriptBox["Ha", "2"]}], "-", 
     RowBox[{"24", " ", "Ha", " ", "Hb"}], "-", 
     RowBox[{"20", " ", 
      SuperscriptBox["Hb", "2"]}]}]}]}], "}"}]], "Output",
 CellChangeTimes->{4.0021915988980007`*^9},
 CellLabel->
  "Out[515]=",ExpressionUUID->"43130649-8622-7d42-af77-74e78ff3a246"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
11.3 Symmetries of the Riemann tensor and the contracted Bianchi identity\
\>", "Subsection",ExpressionUUID->"09e2753e-2045-9f48-9441-c6bd8f12b39c"],

Cell["\<\
An INHOMOGENEOUS test metric checks the engine away from homogeneity: ds\.b2 \
= n\.b2 dx0\.b2 \[Minus] a\.b2 (dx1\.b2 + dx2\.b2 + dx3\.b2) \[Minus] b\.b2 \
(dx4\.b2 + \[Ellipsis] + dx7\.b2) with the explicit polynomials n = 1 + x0 \
x4/5 + x0\.b2/11, a = 1 + x0/3 + x4\.b2/7, b = 2 \[Minus] x0 x4/4 + x0\.b2/9 \
+ x4/13 (code nP, aP, bP), so that n, a, b depend on BOTH x0 and x4. With R_\
\[Rho]\[Sigma]\[Mu]\[Nu] = g_\[Rho]\[Lambda] R^\[Lambda]_\[Sigma]\[Mu]\[Nu] \
the Riemann tensor is antisymmetric in each pair, symmetric under exchange of \
the pairs and satisfies the first Bianchi identity, and the Einstein tensor \
is divergence-free: \[Del]_\[Mu] G^\[Mu]_\[Nu] = \[PartialD]_\[Mu] G^\[Mu]_\
\[Nu] + {\[Mu] \[Mu]\[Lambda]} G^\[Lambda]_\[Nu] \[Minus] {\[Lambda] \[Mu]\
\[Nu]} G^\[Mu]_\[Lambda] = 0 (contracted Bianchi identity). The checks are \
EXACT (rational numbers) at the point x0 = 1/2, x4 = 1/3; the symbolic checks \
for arbitrary a(x0), b(x0) are those of the cosmological metric.\
\>", "Text",ExpressionUUID->"7c286c47-b48c-3740-9d9b-87b9e6cda703"],

Cell[CellGroupData[{

Cell["\<\
nP = 1 + x0 x4/5 + x0^2/11; aP = 1 + x0/3 + x4^2/7; bP = 2 - x0 x4/4 + x0^2/9 \
+ x4/13;
gPoly = DiagonalMatrix[{nP^2, -aP^2, -aP^2, -aP^2, -bP^2, -bP^2, -bP^2, \
-bP^2}];
cvPoly = curvature[gPoly, Together];
ptP = {x0 -> 1/2, x4 -> 1/3};
riemLow[cv_] := Table[Sum[cv[\"g\"][[r, l]] cv[\"riem\"][[l, s, m, n]], {l, \
8}], {r, 8}, {s, 8}, {m, 8}, {n, 8}];
riemAtP = cvPoly[\"riem\"] /. ptP; rlAtP = Table[Sum[(gPoly /. ptP)[[r, l]] \
riemAtP[[l, s, m, n]], {l, 8}], {r, 8}, {s, 8}, {m, 8}, {n, 8}];
check[\"inhomogeneous metric, exactly at (x0, x4) = (1/2, 1/3): R_rsmn = \
-R_srmn = -R_rsnm = R_mnrs and R^r_[smn] = 0 (first Bianchi identity)\",
  AllTrue[Flatten[Table[{rlAtP[[r, s, m, n]] + rlAtP[[s, r, m, n]], rlAtP[[r, \
s, m, n]] + rlAtP[[r, s, n, m]], rlAtP[[r, s, m, n]] - rlAtP[[m, n, r, s]],
      riemAtP[[r, s, m, n]] + riemAtP[[r, m, n, s]] + riemAtP[[r, n, s, m]]}, \
{r, 8}, {s, 8}, {m, 8}, {n, 8}]], # == 0 &]]
divGPoly = Table[Sum[(D[cvPoly[\"G\"][[m, n]], X[[m]]] /. ptP) + Sum[(cvPoly[\
\"chr\"][[m, m, l]] cvPoly[\"G\"][[l, n]] - cvPoly[\"chr\"][[l, m, n]] \
cvPoly[\"G\"][[m, l]]) /. ptP, {l, 8}], {m, 8}], {n, 8}];
check[\"inhomogeneous metric: contracted Bianchi identity nabla_mu G^mu_nu == \
0, exactly at (x0, x4) = (1/2, 1/3)\", divGPoly == ConstantArray[0, 8]]
check[\"cosmological metric: contracted Bianchi identity nabla_mu G^mu_nu = 0 \
(arbitrary a, b)\", AllTrue[Simplify[divergenceMixed[cvCos, cvCos[\"G\"]]], # \
=== 0 &]]\
\>", "Input",
 CellLabel->
  "In[516]:=",ExpressionUUID->"c4e7e9f6-119b-1849-a15c-53c877188bf1"],

Cell[BoxData[
 RowBox[{"\<\"inhomogeneous metric, exactly at (x0, x4) = (1/2, 1/3): R_rsmn \
= -R_srmn = -R_rsnm = R_mnrs and R^r_[smn] = 0 (first Bianchi identity)\"\>", 
  "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021915998025017`*^9},
 CellLabel->
  "Out[522]=",ExpressionUUID->"f1eeeeba-97d9-d045-923f-abaae02abae8"],

Cell[BoxData[
 RowBox[{"\<\"inhomogeneous metric: contracted Bianchi identity nabla_mu \
G^mu_nu == 0, exactly at (x0, x4) = (1/2, 1/3)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0021915998128757`*^9},
 CellLabel->
  "Out[524]=",ExpressionUUID->"4186e772-6668-3046-a14b-09202174b785"],

Cell[BoxData[
 RowBox[{"\<\"cosmological metric: contracted Bianchi identity nabla_mu \
G^mu_nu = 0 (arbitrary a, b)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021915998139725`*^9},
 CellLabel->
  "Out[525]=",ExpressionUUID->"48520096-e9d1-454e-8d6b-04d93ac3df6a"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["12. The Lovelock tensors of 7+1 spacetime", "Section",ExpressionUUID->"fd0f9654-7256-094f-8ccd-61fdd4035e48"],

Cell["\<\
The generalized Kronecker delta \[Delta]^{\[Mu]1\[Ellipsis]\[Mu]n}_{\[Nu]1\
\[Ellipsis]\[Nu]n} is the determinant of the n\[Times]n matrix of ordinary \
Kronecker deltas \[Delta]^{\[Mu]i}_{\[Nu]j}: it is +1 (\[Minus]1) if the \
lower indices are an even (odd) permutation of the upper ones, all different, \
and 0 otherwise. In eight dimensions it vanishes for n > 8.\
\>", "Text",ExpressionUUID->"5f394896-2429-a242-8e13-5a326b11a50c"],

Cell[TextData[{
 StyleBox["Lovelock\[CloseCurlyQuote]s theorem. ",
  FontWeight->"Bold"],
 "In n dimensions the most general tensor A^{lh} that is symmetric, \
divergence-free and built from the metric and its first and second \
derivatives is (D. Lovelock and H. Rund, Tensors, Differential Forms, and \
Variational Principles, Dover; Remark 2 after Eq. (4.38))"
}], "Text",ExpressionUUID->"204b5227-e20a-b747-ae86-0d301957567a"],

Cell["\<\
      A^{lh} = \[Sqrt]|g| \[CapitalSigma]_{k=1}^{m\[Minus]1} \[Alpha]_(k) \
g^{jl} \[Delta]^{h h1\[Ellipsis]h2k}_{j j1\[Ellipsis]j2k} R^{j1 j2}_{h1 h2} \
\[CenterEllipsis] R^{j2k\[Minus]1 j2k}_{h2k\[Minus]1 h2k} + \[Lambda] \
\[Sqrt]|g| g^{lh},      m = n/2 (n even), m = (n + 1)/2 (n odd),\
\>", "Text",ExpressionUUID->"990df180-9bc0-7945-99b8-4c783f228a10"],

Cell["\<\
with arbitrary constants \[Alpha]_(k) and \[Lambda]. For n = 8, m \[Minus] 1 \
= 8/2 \[Minus] 1 = 3: there are exactly three curvature terms, the Einstein \
(k = 1), Gauss\[Dash]Bonnet (k = 2) and cubic (k = 3) Lovelock tensors. With \
the normalization of the reference notebook Einstein-Lovelock-7+1-Nash.nb (P. \
L. Nash, under the GNU GPL), which this section follows, the Lovelock tensors \
and densities are\
\>", "Text",ExpressionUUID->"04b8c536-3f7a-db4f-817d-cef3ac6a04a3"],

Cell["\<\
      Lovelock_k \[Congruent] E^(k)\[Mu]_\[Nu] = \[Minus](1/2^(k+1)) \
\[Delta]^{\[Mu] \[Alpha]1\[Beta]1\[Ellipsis]\[Alpha]k\[Beta]k}_{\[Nu] \
\[Gamma]1\[Delta]1\[Ellipsis]\[Gamma]k\[Delta]k} R^{\[Gamma]1\[Delta]1}_{\
\[Alpha]1\[Beta]1} \[CenterEllipsis] \
R^{\[Gamma]k\[Delta]k}_{\[Alpha]k\[Beta]k},\
\>", "Text",ExpressionUUID->"08d38451-9ae1-1d44-b3f2-ad46faf0caab"],

Cell["\<\
      L_k = (1/2^k) \
\[Delta]^{\[Alpha]1\[Beta]1\[Ellipsis]\[Alpha]k\[Beta]k}_{\[Gamma]1\[Delta]1\
\[Ellipsis]\[Gamma]k\[Delta]k} R^{\[Gamma]1\[Delta]1}_{\[Alpha]1\[Beta]1} \
\[CenterEllipsis] R^{\[Gamma]k\[Delta]k}_{\[Alpha]k\[Beta]k}.\
\>", "Text",ExpressionUUID->"bacc4b58-0e51-7b45-91fa-e1bdb38c270c"],

Cell["\<\
L_0 = 1 and E^(0)\[Mu]_\[Nu] = \[Minus]\[Delta]^\[Mu]_\[Nu]/2 (the \
cosmological term); L_1 = R and E^(1) = G (Einstein); L_2 = R\.b2 \[Minus] \
4R_\[Mu]\[Nu]R^\[Mu]\[Nu] + R_\[Mu]\[Nu]\[Rho]\[Sigma]R^\[Mu]\[Nu]\[Rho]\
\[Sigma] (Gauss\[Dash]Bonnet) and E^(2) is the Lanczos tensor; L_3 and E^(3) \
are cubic. E^(k) contains 2k+1 different upper indices, so E^(4) = 0 \
identically in eight dimensions; L_4, the Euler density, is not zero, but \
\[Sqrt]|g| L_4 is a total derivative. The trace is E^(k)\[Mu]_\[Mu] = \
\[Minus]((8 \[Minus] 2k)/2) L_k. Each E^(k) is symmetric (with both indices \
down) and divergence-free for every metric, and \[Delta](\[Sqrt]|g| L_k) = \
\[Sqrt]|g| E^(k)_\[Mu]\[Nu] \[Delta]g^\[Mu]\[Nu].\
\>", "Text",ExpressionUUID->"af37bdc9-dd5a-ab4c-83b8-4d178975c94e"],

Cell[TextData[{
 StyleBox["Field equations. ",
  FontWeight->"Bold"],
 "The Einstein\[Dash]Lovelock VACUUM field equations of the reference \
notebook are"
}], "Text",ExpressionUUID->"25b2a7b2-e951-ca4e-b9d6-f47f712b2fed"],

Cell["\<\
      0 = \[Minus]\[CapitalLambda] \[Delta]^\[Mu]_\[Nu] + H^(\[Minus]2) w1 \
Lovelock1 + H^(\[Minus]4) w2 Lovelock2 + H^(\[Minus]6) w3 Lovelock3,\
\>", "Text",ExpressionUUID->"f5e5cd78-a137-6941-9d8b-479f828d9d5c"],

Cell["\<\
where w1, w2, w3 and \[CapitalLambda] are pure numbers and H is a fundamental \
inverse length, which exists because the Lovelock tensors of different orders \
have different dimensions (length^(\[Minus]2k)). With matter, sections 14\
\[Dash]16 use the equivalent dimensional form\
\>", "Text",ExpressionUUID->"3efc07ba-4e10-1642-bf03-cc17cf786f08"],

Cell["\<\
      S = \[Minus](1/(2\[Kappa])) \[Integral] d\:2078X \[Sqrt]|g| \
\[CapitalSigma]_{k=0}^{3} \[Alpha]_k L_k + S_matter,    \
\[CapitalSigma]_{k=0}^{3} \[Alpha]_k E^(k)\[Mu]_\[Nu] = \[Kappa] \
T^\[Mu]_\[Nu],    \[Alpha]_0 = 2\[CapitalLambda]\:0304,\
\>", "Text",ExpressionUUID->"0a10ecb5-fb5c-cb4f-9e1c-af7ddbaee196"],

Cell["\<\
with \[Kappa] = 8\[Pi]G8, \[Delta]S_matter = (1/2) \[Integral] \[Sqrt]|g| T_\
\[Mu]\[Nu] \[Delta]g^\[Mu]\[Nu], \[Alpha]_1 = 1 (Einstein), \[Alpha]_2 and \
\[Alpha]_3 the Gauss\[Dash]Bonnet and cubic couplings (dimensions length\.b2 \
and length\:2074) and \[CapitalLambda]\:0304 the cosmological constant \
(dimension length^(\[Minus]2); it is written \[CapitalLambda] in sections 14\
\[Dash]16). For T = 0 the two forms are the same equation: divide the first \
by w1/H\.b2, so \[Alpha]_2 = w2/(w1 H\.b2), \[Alpha]_3 = w3/(w1 H\:2074) and \
\[CapitalLambda]\:0304 = \[CapitalLambda] H\.b2/w1. For \[Alpha]_2 = \
\[Alpha]_3 = 0 the field equations are G^\[Mu]_\[Nu] \[Minus] \
\[CapitalLambda]\:0304 \[Delta]^\[Mu]_\[Nu] = \[Kappa] T^\[Mu]_\[Nu].\
\>", "Text",ExpressionUUID->"ad65132e-a829-5742-a0ea-bc3c4346b804"],

Cell[TextData[{
 StyleBox["Two independent computations. ",
  FontWeight->"Bold"],
 "The Lovelock tensors are computed twice in this notebook: (1) exactly as in \
the reference notebook, with the tensor packages xAct (xTensor, xCoba, xTras; \
J. M. Mart\[IAcute]n-Garc\[IAcute]a et al., GPL), the generalized Kronecker \
delta k\[Delta] and abstract indices, the components of a given metric \
following from CD = LC[g] (sections 12.2\[Dash]12.4); (2) by an explicit sum \
over sets of index pairs in plain Wolfram Language (section 12.5). Every \
comparison below is exact."
}], "Text",ExpressionUUID->"7d1b5bd3-b0e7-8b40-8c92-350757f95ab9"],

Cell[CellGroupData[{

Cell["12.1 The generalized Kronecker delta", "Subsection",ExpressionUUID->"1e758f1e-829e-1d4d-ac54-c95d9f2b334f"],

Cell[CellGroupData[{

Cell["\<\
gKD[up_List, dn_List] := Det[Outer[KroneckerDelta, up, dn]];
SeedRandom[7108];
check[\"generalized Kronecker delta: contraction identity delta^{m1..mp \
r}_{n1..np r} = (8-p) delta^{m1..mp}_{n1..np} (p = 1..4, 60 random index sets \
each)\",
  And @@ Flatten[Table[With[{u = RandomInteger[{0, 7}, pp], d = \
RandomInteger[{0, 7}, pp]},
      Sum[gKD[Append[u, r], Append[d, r]], {r, 0, 7}] == (8 - pp) gKD[u, d]], \
{pp, 1, 4}, {60}]]]
check[\"generalized Kronecker delta with 9 upper indices vanishes in 8 \
dimensions (100 random index sets)\",
  And @@ Table[gKD[RandomInteger[{0, 7}, 9], RandomInteger[{0, 7}, 9]] == 0, \
{100}]]\
\>", "Input",
 CellLabel->
  "In[526]:=",ExpressionUUID->"ee9ad062-17f2-7e41-99ab-e87b75998247"],

Cell[BoxData[
 RowBox[{"\<\"generalized Kronecker delta: contraction identity delta^{m1..mp \
r}_{n1..np r} = (8-p) delta^{m1..mp}_{n1..np} (p = 1..4, 60 random index sets \
each)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002191599848974*^9},
 CellLabel->
  "Out[528]=",ExpressionUUID->"230848ec-00ca-644b-bec6-adc4c3bca6ff"],

Cell[BoxData[
 RowBox[{"\<\"generalized Kronecker delta with 9 upper indices vanishes in 8 \
dimensions (100 random index sets)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002191599848974*^9},
 CellLabel->
  "Out[529]=",ExpressionUUID->"e90db313-c17b-a14a-98ae-557e9cf281b8"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
12.2 The tensor packages xAct: manifold, metric and chart (as in \
Einstein-Lovelock-7+1-Nash.nb)\
\>", "Subsection",ExpressionUUID->"1feff04d-3359-554b-b054-fe1b1790d516"],

Cell["\<\
The packages xAct`xCoba` (components in a basis; it loads xPerm and xTensor) \
and xAct`xTras` (it provides Simplification) are loaded exactly as in the \
reference notebook. Two kinds of output are suppressed while they load: the \
package banners, and the warnings that xTensor cannot attach rules to \
Commutator and Anticommutator, which are protected built-in symbols of \
Wolfram 15 (the reference notebook shows the same warnings; these two symbols \
are not used here). The manifold M8 has dimension 8 and the abstract indices \
a, b, c, d, f, i, j, k, l, m, n, p, q, r, s, y (the list of the reference \
notebook); the metric g71 is declared, exactly as in the reference notebook, \
with the signature {7, 1, 0}: in xAct this list declares the spacetime of \
this notebook, seven space-like dimensions (x1, \[Ellipsis], x7) and one \
time-like dimension (x0), with no degenerate direction \[LongDash] the \
signature (7,1) of \[Eta]71 = diag(\[Minus]1, +1, \[Ellipsis], +1) in the \
sign convention of 4+4.nb (space-like = +1, section 1.2). Its Levi-Civita \
covariant derivative is CD; the chart chartM8 has the coordinate scalars \
x0[], \[Ellipsis], x7[] (the coordinates X = {x0, \[Ellipsis], x7} of this \
notebook; a component computed by xAct is turned into a function of x0, \
\[Ellipsis], x7 by x0[] \[RightArrow] x0, \[Ellipsis]). The signature list is \
not to be confused with the matrix \[Eta]17 = \[Minus]\[Eta]71 = diag(+1, \
\[Minus]1, \[Ellipsis], \[Minus]1): \[Eta]17 is simply the squares of the \
octonion basis, e0\.b2 = +1 for the unit e0 = 1 (the time direction x0) and \
e_i\.b2 = \[Minus]1 for the seven imaginary units (the space directions x1, \
\[Ellipsis], x7), i.e. \[Eta]17_AB = Re(e_A e_B), the quadratic form Re(x x) \
= x0\.b2 \[Minus] x1\.b2 \[Minus] \[Ellipsis] \[Minus] x7\.b2 of an octonion \
x = x^A e_A, and the Clifford relation \
\[CapitalGamma]17[A].\[CapitalGamma]17[B] + \[CapitalGamma]17[B].\
\[CapitalGamma]17[A] = 2 \[Eta]17_AB ID16 of section 4. The metrics of \
sections 11\[Dash]16 are given to xAct with the signs of \[Eta]17 (g00 > 0 \
along the time-like x0, negative squares along the space-like directions). \
The declared signature fixes for xAct the sign of the determinant of the \
metric, SignDetOfMetric[g71] = \[Minus]1, which is the same in both \
conventions (a metric with one time-like and seven space-like directions has \
a negative determinant either way); the components of the Lovelock tensors \
follow from the component matrix of the metric. The scale factors and \
profiles of the metrics below are declared scalar functions and H a constant \
symbol. The guard If[! MemberQ[$Manifolds, M8], \[Ellipsis]] and the final \
Unset make the cell safe to evaluate twice while the notebook stays open. \
xAct keeps its definitions in the kernel, while a notebook that is closed and \
opened again gets a new private context; to evaluate the notebook again after \
reopening it, start from a fresh kernel (Evaluation \[RightPointer] Quit \
Kernel), as tools/run_eval.wl does.\
\>", "Text",ExpressionUUID->"06a8efa9-941c-cd4a-9df9-94b75e7a184a"],

Cell[CellGroupData[{

Cell["\<\
Quiet[Block[{Print = (Null &)}, Needs[\"xAct`xCoba`\"]; \
Needs[\"xAct`xTras`\"]],
  {Commutator::argtu, Anticommutator::argtu, UpSetDelayed::write, \
SetDelayed::write, General::stop}];
$DefInfoQ = False; $CVVerbose = False;
SetOptions[ToCanonical, UseMetricOnVBundle -> None, Verbose -> False];
If[! MemberQ[$Manifolds, M8],
  DefManifold[M8, 8, {a, b, c, d, f, i, j, k, l, m, n, p, q, r, s, y}];
  DefMetric[{7, 1, 0}, g71[-a, -b], CD, {\";\", \"D\"}, WeightedWithBasis -> \
AIndex];
  DefChart[chartM8, M8, {0, 1, 2, 3, 4, 5, 6, 7}, {x0[], x1[], x2[], x3[], \
x4[], x5[], x6[], x7[]},
    ExtendedCoordinateDerivatives -> True, FormatBasis -> {\"Partials\", \
\"Differentials\"}];
  DefScalarFunction /@ {a3, b4, fPP};
  DefConstantSymbol[H]];
Quiet[g71 =.; CD =.; RiemannCD =.; RicciCD =.; RicciScalarCD =.; EinsteinCD \
=.];
MyArrayComponents[expr_] := expr // ToBasis[chartM8] // ComponentArray // \
ToValues // ToValues // Simplify;
toXc = Thread[X -> Through[X[]]]; fromXc = Thread[Through[X[]] -> X];
{\"xPerm\" -> xAct`xPerm`$Version, \"xTensor\" -> xAct`xTensor`$Version, \
\"xCoba\" -> xAct`xCoba`$Version, \"xTras\" -> xAct`xTras`$Version,
 \"SignatureOfMetric[g71]\" -> SignatureOfMetric[g71], \"DimOfManifold[M8]\" \
-> DimOfManifold[M8]}\
\>", "Input",
 CellLabel->
  "In[530]:=",ExpressionUUID->"41786114-a2f2-354e-b780-fc5b2e6b1ab9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"xPerm\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"1.2.3\"\>", ",", 
      RowBox[{"{", 
       RowBox[{"2015", ",", "8", ",", "23"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"xTensor\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"1.2.0\"\>", ",", 
      RowBox[{"{", 
       RowBox[{"2021", ",", "10", ",", "17"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"xCoba\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"0.8.6\"\>", ",", 
      RowBox[{"{", 
       RowBox[{"2021", ",", "2", ",", "28"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"xTras\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"1.4.2\"\>", ",", 
      RowBox[{"{", 
       RowBox[{"2014", ",", "10", ",", "30"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"SignatureOfMetric[g71]\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"7", ",", "1", ",", "0"}], "}"}]}], ",", 
   RowBox[{"\<\"DimOfManifold[M8]\"\>", "\[Rule]", "8"}]}], "}"}]], "Output",
 CellChangeTimes->{4.002191601417919*^9},
 CellLabel->
  "Out[537]=",ExpressionUUID->"ddf31e78-0bed-b04c-a3f4-276be3a82530"]
}, Open  ]],

Cell["\<\
Three checks make the two objects explicit: the xAct declaration (seven \
space-like dimensions, one time-like dimension), and the matrix \[Eta]17 as \
the squares of the octonion basis (with the octonion product oMul, the real \
part oRe and the basis units ev[A] = e_A of section 3).\
\>", "Text",ExpressionUUID->"41311b92-2424-5b4a-a6ce-1aa43e074765"],

Cell[CellGroupData[{

Cell["\<\
check[\"xAct declaration as in the reference notebook: SignatureOfMetric[g71] \
== {7, 1, 0} (seven space-like dimensions, one time-like dimension, none \
degenerate) and SignDetOfMetric[g71] == -1\",
  SignatureOfMetric[g71] === {7, 1, 0} && SignDetOfMetric[g71] === -1]
check[\"eta17 is simply the squares of the octonion basis: eta17[[A+1, B+1]] \
== Re(e_A e_B), e_0^2 == +1 (time x0), e_i^2 == -1 (space x_i, i = 1..7)\",
  Table[oRe[oMul[ev[A], ev[B]]], {A, 0, 7}, {B, 0, 7}] == \[Eta]17]
check[\"the quadratic form of the octonions has the signs of the squares of \
the octonion basis: Re(x x) == x0^2 - x1^2 - ... - x7^2 == x.eta17.x for x = \
x^A e_A (symbolic)\",
  With[{xq = Array[qO, 8, 0]}, Expand[oRe[oMul[xq, xq]] - xq.\[Eta]17.xq] === \
0]]\
\>", "Input",
 CellLabel->
  "In[538]:=",ExpressionUUID->"7bbec69f-11d3-d64e-b2fb-6cbe17cafc6c"],

Cell[BoxData[
 RowBox[{"\<\"xAct declaration as in the reference notebook: \
SignatureOfMetric[g71] == {7, 1, 0} (seven space-like dimensions, one \
time-like dimension, none degenerate) and SignDetOfMetric[g71] == -1\"\>", "\[Rule]",
   "True"}]], "Output",
 CellChangeTimes->{4.0021916015007*^9},
 CellLabel->
  "Out[538]=",ExpressionUUID->"742c066a-a30e-5841-b4a0-15d7d535d18b"],

Cell[BoxData[
 RowBox[{"\<\"eta17 is simply the squares of the octonion basis: eta17[[A+1, \
B+1]] == Re(e_A e_B), e_0^2 == +1 (time x0), e_i^2 == -1 (space x_i, i = \
1..7)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002191601511389*^9},
 CellLabel->
  "Out[539]=",ExpressionUUID->"f123df22-72de-c743-a29f-9562baba063b"],

Cell[BoxData[
 RowBox[{"\<\"the quadratic form of the octonions has the signs of the \
squares of the octonion basis: Re(x x) == x0^2 - x1^2 - ... - x7^2 == \
x.eta17.x for x = x^A e_A (symbolic)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002191601513569*^9},
 CellLabel->
  "Out[540]=",ExpressionUUID->"a776d1a4-5fc8-1044-824c-0fe07151ca5e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
12.3 The Lovelock tensors with abstract indices: the generalized Kronecker \
delta k\[Delta]\
\>", "Subsection",ExpressionUUID->"1dda8bdb-c381-db4e-bbee-1c69cd052667"],

Cell["\<\
k\[Delta][lower, upper] is the determinant of the matrix of xAct Kronecker \
deltas delta[lower_i, upper_j], i.e. the generalized Kronecker delta \
\[Delta]^{upper}_{lower} with abstract indices. The three Lovelock tensors \
are then typed exactly as in the reference notebook and reduced to curvature \
monomials by Simplification (xTras):\
\>", "Text",ExpressionUUID->"0999f3bd-a2bf-3a4a-88c3-c7d9f9639b0a"],

Cell["\<\
      Lovelock1 = \[Minus](1/4) R_cd^fi \[Delta]^{bcd}_{afi},   Lovelock2 = \
\[Minus](1/8) R_cd^fi R_jk^lm \[Delta]^{bcdjk}_{afilm},   Lovelock3 = \
\[Minus](1/16) R_cd^fi R_jk^lm R_np^qr \[Delta]^{bcdjknp}_{afilmqr},\
\>", "Text",ExpressionUUID->"c9666436-836b-9e49-984b-d4bbab347d59"],

Cell["\<\
with R_cd^fi = RiemannCD[-c, -d, f, i]; the free indices are a (down) and b \
(up), so Lovelock_k = E^(k)b_a. The checks: Lovelock1 is the Einstein tensor \
R_a^b \[Minus] (1/2) \[Delta]_a^b R, and the trace of Lovelock2 is \[Minus]2 \
L_2 with the Gauss\[Dash]Bonnet density L_2 = R\.b2 \[Minus] 4 R_cd R^cd + \
R_cdfi R^cdfi (both with abstract indices, by ToCanonical). The reference \
notebook sets the option UseMetricOnVBundle -> None of ToCanonical, so that \
indices are not moved up and down; for the trace identity the metric must be \
used to identify the dummy pairs R_cd R^cd and R^c_d R_c^d, so that one call \
uses UseMetricOnVBundle -> All.\
\>", "Text",ExpressionUUID->"e42c4472-ddf4-7044-bf58-948b90ede331"],

Cell[CellGroupData[{

Cell["\<\
k\[Delta][lower_, upper_] /; Length[lower] == Length[upper] := \
Det[Outer[delta, lower, upper]];
{k\[Delta][{-a}, {b}], k\[Delta][{-a, -f}, {b, c}]}\
\>", "Input",
 CellLabel->
  "In[541]:=",ExpressionUUID->"5cb8155d-eb01-d543-a218-80c1e605a631"],

