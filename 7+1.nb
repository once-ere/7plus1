       RowBox[{"gg", "[", "0", "]"}], "16"]}], "+", 
     FractionBox[
      RowBox[{"11", " ", 
       RowBox[{"gg", "[", "1", "]"}]}], "8"], "-", 
     FractionBox[
      RowBox[{"7", " ", 
       RowBox[{"gg", "[", "2", "]"}]}], "8"], "+", 
     FractionBox[
      RowBox[{"7", " ", 
       RowBox[{"gg", "[", "3", "]"}]}], "8"], "-", 
     FractionBox[
      RowBox[{"7", " ", 
       RowBox[{"gg", "[", "5", "]"}]}], "8"], "+", 
     FractionBox[
      RowBox[{"7", " ", 
       RowBox[{"gg", "[", "6", "]"}]}], "8"], "-", 
     FractionBox[
      RowBox[{"3", " ", 
       RowBox[{"gg", "[", "7", "]"}]}], "8"], "+", 
     FractionBox[
      RowBox[{"gg", "[", "8", "]"}], "16"]}]}], ",", 
   RowBox[{"\<\"example g = (-100000, 10000, 3000, 0, ...): {G_0, G_1}\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "104000"}], ",", "17375"}], "}"}]}]}], "}"}]], "Output",
