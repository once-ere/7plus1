Cell[CellGroupData[{

Cell["12.5 An independent computation: the pair-set algorithm", "Subsection",ExpressionUUID->"9744ac11-21c0-3741-a80d-dc4284d01236"],

Cell["\<\
Because the generalized delta is antisymmetric in its upper and in its lower \
indices and every curvature factor is antisymmetric in each of its index \
pairs, the sum over all index values can be organized by sets of index pairs. \
Let U run over the sets of k disjoint pairs (\[Alpha]<\[Beta]) not containing \
\[Mu], and L over the ORDERED sequences of k disjoint pairs \
(\[Gamma]<\[Delta]) of the remaining indices of U \:222a {\[Mu]} without \
\[Nu]. Then\
\>", "Text",ExpressionUUID->"4dc4f528-aa75-2e4b-acec-3a4e2b18addb"],

Cell["\<\
      E^(k)\[Mu]_\[Nu] = \[Minus]2^(k\[Minus]1) k! \[CapitalSigma]_U \
\[CapitalSigma]_L sgn(\[Mu] U \[RightArrow] \[Nu] L) \[CapitalPi]_i \
R^{L_i}_{U_i},      L_k = 2^k k! \[CapitalSigma]_U \[CapitalSigma]_L sgn(U \
\[RightArrow] L) \[CapitalPi]_i R^{L_i}_{U_i},\
\>", "Text",ExpressionUUID->"a6975489-ea87-f945-a07b-f965bbe09572"],

Cell["\<\
where sgn is the sign of the permutation that takes the upper index sequence \
to the lower one (Signature[up] Signature[dn]). The checks compare E^(1) with \
the brute-force \[Delta]-contraction \[Minus](1/4) \[Delta]^{\[Mu]\[Alpha]\
\[Beta]}_{\[Nu]\[Gamma]\[Delta]} R^\[Gamma]\[Delta]_\[Alpha]\[Beta], and \
E^(1), E^(2), E^(3) of the cosmological metric with the xAct computation of \
section 12.4. This second method works with any curvature table, including \
the exact rational numbers of section 12.7.\
\>", "Text",ExpressionUUID->"b8b69ca5-65de-c544-a377-4d330b047c50"],

Cell[CellGroupData[{

Cell["\<\
pairSets[idx_List, 0] := {{}};
pairSets[idx_List, k_Integer?Positive] := pairSets[idx, k] = If[Length[idx] < \
2 k, {},
   Join[Flatten[Table[Prepend[#, {First[idx], idx[[j]]}] & /@ \
pairSets[Delete[Rest[idx], j - 1], k - 1], {j, 2, Length[idx]}], 1],
    pairSets[Rest[idx], k]]];
orderedSeqs[idx_List, k_Integer] := orderedSeqs[idx, k] = \
Flatten[Permutations /@ pairSets[Sort[idx], k], 1];
lovelockComp[ra_Association, k_Integer, mu_Integer, nu_Integer] := \
Module[{tot = 0, up, t},
  Do[up = Join[{mu}, Flatten[U]];
   If[MemberQ[up, nu],
    Do[t = Signature[up] Signature[Join[{nu}, Flatten[L]]];
     Do[t = t Lookup[ra, Key[Join[L[[i]], U[[i]]]], 0]; If[t === 0, Break[]], \
{i, k}];
     tot += t, {L, orderedSeqs[DeleteCases[up, nu], k]}]], {U, \
pairSets[DeleteCases[Range[0, 7], mu], k]}];
  -2^(k - 1) k! tot];
lovelockE[ra_Association, 0] := -IdentityMatrix[8]/2;
lovelockE[ra_Association, k_Integer?Positive] := Table[lovelockComp[ra, k, \
mu, nu], {mu, 0, 7}, {nu, 0, 7}];
lovelockL[ra_Association, 0] := 1;
lovelockL[ra_Association, k_Integer?Positive] := Module[{tot = 0, up, t},
  Do[up = Flatten[U];
   Do[t = Signature[up] Signature[Flatten[L]];
    Do[t = t Lookup[ra, Key[Join[L[[i]], U[[i]]]], 0]; If[t === 0, Break[]], \
{i, k}];
    tot += t, {L, orderedSeqs[up, k]}], {U, pairSets[Range[0, 7], k]}];
  2^k k! tot];
{\"number of upper pair-sets (k = 1, 2, 3, 4; mu fixed)\" -> \
Table[Length[pairSets[Range[1, 7], k]], {k, 1, 4}],
 \"number of ordered lower sequences of 2k indices (k = 1, 2, 3, 4)\" -> \
Table[Length[orderedSeqs[Range[1, 2 k], k]], {k, 1, 4}]}\
\>", "Input",
 CellLabel->
  "In[554]:=",ExpressionUUID->"3a71d61e-81bf-2842-9782-e12059a807b8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"number of upper pair-sets (k = 1, 2, 3, 4; mu fixed)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"21", ",", "105", ",", "105", ",", "0"}], "}"}]}], ",", 
   RowBox[{"\<\"number of ordered lower sequences of 2k indices (k = 1, 2, 3, \
4)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "6", ",", "90", ",", "2520"}], "}"}]}]}], 
  "}"}]], "Output",
 CellChangeTimes->{4.002191627516262*^9},
 CellLabel->
  "Out[562]=",ExpressionUUID->"566491eb-1fdb-ba46-af9b-1921406f333f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
rudCos = rudAssoc[cvCos[\"rud\"]];
E1brute = Table[-1/4 Sum[gKD[{mu, a, b}, {nu, c, d}] cvCos[\"rud\"][[c + 1, d \
+ 1, a + 1, b + 1]], {a, 0, 7}, {b, 0, 7}, {c, 0, 7}, {d, 0, 7}], {mu, 0, 7}, \
{nu, 0, 7}];
check[\"pair-set algorithm == brute-force generalized-delta contraction for \
E^(1) (cosmological metric)\", Simplify[E1brute - lovelockE[rudCos, 1]] == \
ConstantArray[0, {8, 8}]]
check[\"pair-set algorithm == xAct (section 12.4) for E^(1), E^(2), E^(3) of \
the cosmological metric (two independent computations)\",
  And @@ Table[Simplify[lovelockE[rudCos, k] - xlCos[[k]]] == \
ConstantArray[0, {8, 8}], {k, 1, 3}]]\
\>", "Input",
 CellLabel->
  "In[563]:=",ExpressionUUID->"173f5c9c-d064-9343-81c6-ef60b03ed07f"],

Cell[BoxData[
 RowBox[{"\<\"pair-set algorithm == brute-force generalized-delta contraction \
for E^(1) (cosmological metric)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021916286787395`*^9},
 CellLabel->
  "Out[565]=",ExpressionUUID->"bb2e12e8-3e75-a441-bce3-10eb3513fcb2"],

Cell[BoxData[
 RowBox[{"\<\"pair-set algorithm == xAct (section 12.4) for E^(1), E^(2), \
E^(3) of the cosmological metric (two independent computations)\"\>", "\[Rule]",
   "True"}]], "Output",
 CellChangeTimes->{4.0021916311464767`*^9},
 CellLabel->
  "Out[566]=",ExpressionUUID->"60738ff7-944f-ad4f-875b-be214864e85e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["12.6 The Lovelock tensors of the cosmological metric", "Subsection",ExpressionUUID->"bb23097d-8329-7e49-95ce-a5eddfbe0cfa"],

Cell["\<\
The checks: E^(1) = G and L_1 = R; the trace identity for k = 0 \[Ellipsis] \
4; E^(4) = 0 while L_4 \[NotEqual] 0; every E^(k) is diagonal with equal \
entries inside ordinary space and inside the auxiliary space; E^(2) equals \
the Lanczos tensor H_\[Mu]\[Nu] = 2(R R_\[Mu]\[Nu] \[Minus] 2R_\[Mu]\[Alpha] \
R^\[Alpha]_\[Nu] \[Minus] 2R^\[Alpha]\[Beta] R_\[Mu]\[Alpha]\[Nu]\[Beta] + R_\
\[Mu]^\[Alpha]\[Beta]\[Gamma] R_\[Nu]\[Alpha]\[Beta]\[Gamma]) \[Minus] (1/2) \
g_\[Mu]\[Nu] L_2; and the closed forms below. Divergence-freeness becomes, \
for this metric, d/dx0 E^0_0 + 3Ha (E^0_0 \[Minus] E^1_1) + 4Hb (E^0_0 \
\[Minus] E^4_4) = 0.\
\>", "Text",ExpressionUUID->"772e3a53-cd47-914a-813f-c5de03d1b20f"],

Cell[CellGroupData[{

Cell["\<\
ECos = Table[Simplify[lovelockE[rudCos, k]], {k, 0, 4}];      (* ECos[[k+1]] \
= E^(k) *)
LCos = Table[Simplify[lovelockL[rudCos, k]], {k, 0, 4}];
check[\"E^(1) == Einstein tensor G and L_1 == R (cosmological metric)\", \
Simplify[ECos[[2]] - cvCos[\"G\"]] == ConstantArray[0, {8, 8}] && \
Simplify[LCos[[2]] - cvCos[\"R\"]] === 0]
check[\"trace identity E^(k)mu_mu == -((8-2k)/2) L_k for k = 0..4\", And @@ \
Table[Simplify[Tr[ECos[[k + 1]]] + (8 - 2 k)/2 LCos[[k + 1]]] === 0, {k, 0, \
4}]]
check[\"E^(4) == 0 identically in 8 dimensions, while the Euler density L_4 \
!= 0\", ECos[[5]] == ConstantArray[0, {8, 8}] && LCos[[5]] =!= 0]
check[\"every E^(k) is diagonal, E^(k)1_1 = E^(k)2_2 = E^(k)3_3 and E^(k)4_4 \
= ... = E^(k)7_7\",
  And @@ Table[DiagonalMatrix[Diagonal[ECos[[k + 1]]]] == ECos[[k + 1]] && \
Simplify[ECos[[k + 1, 2, 2]] - ECos[[k + 1, 3, 3]]] === 0 &&
     Simplify[ECos[[k + 1, 2, 2]] - ECos[[k + 1, 4, 4]]] === 0 && And @@ \
Table[Simplify[ECos[[k + 1, 5, 5]] - ECos[[k + 1, j, j]]] === 0, {j, 6, 8}], \
{k, 0, 4}]]
lanczosDiag[cv_] := Module[{g = cv[\"g\"], gi = cv[\"ginv\"], ric = \
cv[\"ric\"], rs = cv[\"R\"], rl = riemLow[cv], ricU, rlU, l2},
  ricU = gi.ric.gi;
  rlU = Table[gi[[a, a]] gi[[b, b]] gi[[c, c]] rl[[m, a, b, c]], {m, 8}, {a, \
8}, {b, 8}, {c, 8}];        (* diagonal metric *)
  l2 = rs^2 - 4 Total[ric ricU, 2] + Total[Table[gi[[m, m]] rlU[[m]] rl[[m]], \
{m, 8}], 4];
  {l2, gi.Table[2 (rs ric[[m, n]] - 2 Sum[ric[[m, a]] gi[[a, a]] ric[[a, n]], \
{a, 8}] - 2 Sum[ricU[[a, b]] rl[[m, a, n, b]], {a, 8}, {b, 8}]
        + Total[rlU[[m]] rl[[n]], 3]) - g[[m, n]] l2/2, {m, 8}, {n, 8}]}];
lzCos = lanczosDiag[cvCos];
check[\"E^(2) == Lanczos tensor and L_2 == R^2 - 4 Ric.Ric + Riem.Riem \
(cosmological metric)\", Simplify[lzCos[[1]] - LCos[[3]]] === 0 && \
Simplify[lzCos[[2]] - ECos[[3]]] == ConstantArray[0, {8, 8}]]
E2closed = -12 Hb (4 Ha^3 + 18 Ha^2 Hb + 12 Ha Hb^2 + Hb^3); E3closed = 360 \
Ha^2 Hb^3 (4 Ha + 3 Hb);
check[\"E^(2)0_0 = -12 Hb (4Ha^3 + 18Ha^2 Hb + 12 Ha Hb^2 + Hb^3) and \
E^(3)0_0 = 360 Ha^2 Hb^3 (4Ha + 3Hb)\",
  toH[ECos[[3, 1, 1]]] == Expand[E2closed] && toH[ECos[[4, 1, 1]]] == \
Expand[E3closed]]
consCos[k_] := Simplify[D[ECos[[k + 1, 1, 1]], x0] + 3 a3'[x0]/a3[x0] \
(ECos[[k + 1, 1, 1]] - ECos[[k + 1, 2, 2]]) + 4 b4'[x0]/b4[x0] (ECos[[k + 1, \
1, 1]] - ECos[[k + 1, 5, 5]])];
check[\"divergence-free: d0 E^0_0 + 3Ha (E^0_0 - E^1_1) + 4Hb (E^0_0 - E^4_4) \
== 0 for k = 1, 2, 3 (arbitrary a, b)\", And @@ Table[consCos[k] === 0, {k, \
1, 3}]]
Grid[Prepend[Table[{k, toH[ECos[[k + 1, 1, 1]]], toH[ECos[[k + 1, 2, 2]]], \
toH[ECos[[k + 1, 5, 5]]]}, {k, 1, 3}], {\"k\", \"E^(k)0_0\", \"E^(k)1_1\", \
\"E^(k)4_4\"}], Frame -> All]\
\>", "Input",
 CellLabel->
  "In[567]:=",ExpressionUUID->"54dd1e0c-5311-534c-aa39-644cf816dc63"],

Cell[BoxData[
 RowBox[{"\<\"E^(1) == Einstein tensor G and L_1 == R (cosmological metric)\"\
\>", "\[Rule]", "True"}]], "Output",
