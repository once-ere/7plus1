            SuperscriptBox["10", "\"34\""]}], ShowStringCharacters -> False], 
         6.7624611095290465`*^34, AutoDelete -> True], 
        ScientificForm[#, 2]& ], "\" rho_Lambda)\""},
      "RowDefault"], "\<\"not an explanation (DERIVED: a contribution to \
Lambda4 with w = -1)\"\>", "\<\"section 24.5\"\>"},
    {"\<\"evolving dark energy (DESI DR2: 2.8 to 4.2 sigma)\"\>", "\<\"in \
tension with the model (w = -1 exactly)\"\>", "\<\"section 24.5\"\>"}
   },
   AutoDelete->False,
