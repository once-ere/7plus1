(same unit spinor u)\"\>"},
    {"\<\"\[LongDash]\"\>", "\<\"e[0] \[Ellipsis] e[7], eList\"\>", "\<\"NEW: \
octonion basis, 0-based: e[A] \[LeftRightArrow] \[Tau]O[A] \[LeftRightArrow] \
xA\"\>"},
    {"\<\"\[LongDash]\"\>", "\<\"LO[A]\"\>", "\<\"NEW: left multiplication by \
e[A] in the e-basis\"\>"},
    {"\<\"\[LongDash]\"\>", "\<\"gridO\"\>", "\<\"NEW: octonion \
multiplication table\"\>"},
    {"\<\"\[LongDash]\"\>", "\<\"oMul, oConj, oNorm2, oRe, oInv\"\>", \
"\<\"NEW: octonion product, conjugate, norm, real part, inverse\"\>"},
    {"\<\"\[LongDash]\"\>", "\<\"T16O[A]\"\>", "\<\"NEW: 16\[Times]16 \
generators of Cl(8,0), the exact mirror of T16\"\>"},
    {"\<\"\[LongDash]\"\>", "\<\"\[CapitalGamma]17[A]\"\>", "\<\"NEW: REAL 16\
\[Times]16 generators of the 7+1 Clifford algebra, metric \[Eta]17 = \[Minus]\
\[Eta]71\"\>"},
    {"\<\"\[LongDash]\"\>", "\<\"\[CapitalGamma]71[A]\"\>", "\<\"NEW: COMPLEX \
16\[Times]16 generators, metric \[Eta]71 (4+4.nb sign convention)\"\>"},
    {"\<\"\[LongDash]\"\>", "\<\"\[CapitalGamma]71R32[A]\"\>", "\<\"NEW: REAL \
32\[Times]32 generators, metric \[Eta]71\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       GrayLevel[0.85]}},
