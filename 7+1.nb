Cell[BoxData[
 RowBox[{"\<\"every \[DoubleStruckCapitalR](16) case has explicit REAL 16\
\[Times]16 generators in this notebook (T16O, \[CapitalGamma]53, T16, \
\[CapitalGamma]17, \[CapitalGamma]08)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494742910824`*^9},
 CellLabel->
  "Out[282]=",ExpressionUUID->"0507ba7d-de1c-244b-a475-7fda95ca1edf"],

Cell[BoxData[
 RowBox[{"\<\"\[DoubleStruckCapitalC](16) cannot occur: its real dimension \
2*16^2 = 512 differs from 2^8 = 256\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002049474297081*^9},
