Cell[BoxData[
 RowBox[{"\<\"Einstein + fluid power laws a ~ tau^P, b ~ tau^Q: (wa, wb) = \
(0, 1/4) -> (0, 2/5); (1/3, 0) -> (1/2, 0); (1/7, 1/7) -> (1/4, 1/4) (tau^2 \
E^(1) from EKas of section 14.1)\"\>", "\[Rule]", "True"}]], "Output",
