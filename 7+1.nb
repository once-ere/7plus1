Cell[CellGroupData[{

Cell["1.3 Dictionary: names in 4+4.nb \[RightArrow] names in this notebook", \
"Subsection",ExpressionUUID->"f0e0f7db-cae6-0f48-ab70-45a10e7b1234"],

Cell["\<\
4+4.nb used the Notation package (Symbolize) to create 2-D symbols such as \
\[Tau]\:0304, T16^A, E^A_a and E^a_A. They are hard to read (T16^A[A1] looks \
like a power of T16) and easy to confuse with indices, so this notebook uses \
plain one-line names. Nothing else changes: every object of 4+4.nb that is \
used here is redefined below with exactly the formula of 4+4.nb.\
\>", "Text",ExpressionUUID->"bd407925-f09e-b646-8988-78b846a58d25"],

Cell[CellGroupData[{

Cell["\<\
Grid[Prepend[{
   {\"\[Sigma] (= \[Sigma]88)\", \"\[Sigma]\", \"8\[Times]8 split metric on \
spinor space, {{0, ID4}, {ID4, 0}}\"},
   {\"s4by4[h], t4by4[h], \[Zeta][A]\", \"unchanged\", \"self-dual / \
anti-self-dual 4\[Times]4 blocks and the 8\[Times]8 \[Zeta][A] built from \
them\"},
   {\"\[Tau][A]\", \"\[Tau][A]\", \"split-octonion 8\[Times]8 matrices, A = 0 \
\[Ellipsis] 7\"},
   {\"\[Tau]\:0304[A]   (Symbolize)\", \"\[Tau]bar[A]\", \
\"\[Sigma].Transpose[\[Tau][A]].\[Sigma]\"},
   {\"T16^A[A1]   (Symbolize)\", \"T16[A]\", \"4+4 Dirac matrices {{0, \
\[Tau]bar[A]}, {\[Tau][A], 0}}; T16[8] = product of all eight\"},
   {\"P_L, P_R\", \"PL44, PR44\", \"4+4 chiral projectors (ID16 \[Minus]/+ \
T16[8])/2\"},
   {\"\[DoubleStruckU] (eigenvectors of \[Sigma] / \[Sqrt]2)\", \"uBasis\", \
\"orthonormal eigenbasis of \[Sigma]\"},
   {\"unit = \[DoubleStruckU][[hUSE]], hUSE = 8\", \"unit, hUSE\", \"unit \
spinor u = (1,0,0,0,1,0,0,0)/\[Sqrt]2 used for the vielbeins\"},
   {\"g_AB\", \"gAB44 (= \[Eta]4488)\", \"split-octonion norm metric\"},
   {\"E^A_a[h], E^a_A[h]   (Symbolize)\", \"E44[h], E44inv[h]\", \"4+4 \
vielbein (rows u.\[Sigma].\[Tau]bar[B]) and its inverse\"},
   {\"eA[1] \[Ellipsis] eA[8], EA\", \"eA[1] \[Ellipsis] eA[8], EA\", \
\"split-octonion basis, 1-based: eA[B] \[LeftRightArrow] \[Tau][B\[Minus]1] \
\[LeftRightArrow] x(B\[Minus]1)\"},
   {\"gridx\", \"gridx44\", \"split-octonion multiplication table\"},
   {\"\[LongDash]\", \"\[Tau]O[A], \[Tau]Obar[A]\", \"NEW: octonion \
8\[Times]8 matrices\"},
   {\"\[LongDash]\", \"gO = ID8\", \"NEW: octonion norm metric\"},
   {\"\[LongDash]\", \"EO, EOinv\", \"NEW: octonion vielbein (same unit \
spinor u)\"},
   {\"\[LongDash]\", \"e[0] \[Ellipsis] e[7], eList\", \"NEW: octonion basis, \
0-based: e[A] \[LeftRightArrow] \[Tau]O[A] \[LeftRightArrow] xA\"},
   {\"\[LongDash]\", \"LO[A]\", \"NEW: left multiplication by e[A] in the \
e-basis\"},
   {\"\[LongDash]\", \"gridO\", \"NEW: octonion multiplication table\"},
   {\"\[LongDash]\", \"oMul, oConj, oNorm2, oRe, oInv\", \"NEW: octonion \
product, conjugate, norm, real part, inverse\"},
   {\"\[LongDash]\", \"T16O[A]\", \"NEW: 16\[Times]16 generators of Cl(8,0), \
the exact mirror of T16\"},
   {\"\[LongDash]\", \"\[CapitalGamma]17[A]\", \"NEW: REAL 16\[Times]16 \
generators of the 7+1 Clifford algebra, metric \[Eta]17 = \[Minus]\[Eta]71\"},
   {\"\[LongDash]\", \"\[CapitalGamma]71[A]\", \"NEW: COMPLEX 16\[Times]16 \
generators, metric \[Eta]71 (4+4.nb sign convention)\"},
   {\"\[LongDash]\", \"\[CapitalGamma]71R32[A]\", \"NEW: REAL 32\[Times]32 \
generators, metric \[Eta]71\"}},
  {\"4+4.nb\", \"7+1.nb (this notebook)\", \"meaning\"}],
 Frame -> All, Alignment -> Left, Background -> {None, {LightGray}}]\
\>", "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"c5651357-c79b-a64a-9433-4917f2a2451e"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"4+4.nb\"\>", "\<\"7+1.nb (this notebook)\"\>", "\<\"meaning\"\>"},
    {"\<\"\[Sigma] (= \[Sigma]88)\"\>", "\<\"\[Sigma]\"\>", "\<\"8\[Times]8 \
split metric on spinor space, {{0, ID4}, {ID4, 0}}\"\>"},
    {"\<\"s4by4[h], t4by4[h], \[Zeta][A]\"\>", "\<\"unchanged\"\>", \
"\<\"self-dual / anti-self-dual 4\[Times]4 blocks and the 8\[Times]8 \
\[Zeta][A] built from them\"\>"},
    {"\<\"\[Tau][A]\"\>", "\<\"\[Tau][A]\"\>", "\<\"split-octonion 8\[Times]8 \
matrices, A = 0 \[Ellipsis] 7\"\>"},
    {"\<\"\[Tau]\:0304[A]   (Symbolize)\"\>", "\<\"\[Tau]bar[A]\"\>", "\<\"\
\[Sigma].Transpose[\[Tau][A]].\[Sigma]\"\>"},
    {"\<\"T16^A[A1]   (Symbolize)\"\>", "\<\"T16[A]\"\>", "\<\"4+4 Dirac \
matrices {{0, \[Tau]bar[A]}, {\[Tau][A], 0}}; T16[8] = product of all eight\"\
\>"},
    {"\<\"P_L, P_R\"\>", "\<\"PL44, PR44\"\>", "\<\"4+4 chiral projectors \
(ID16 \[Minus]/+ T16[8])/2\"\>"},
    {"\<\"\[DoubleStruckU] (eigenvectors of \[Sigma] / \[Sqrt]2)\"\>", \
"\<\"uBasis\"\>", "\<\"orthonormal eigenbasis of \[Sigma]\"\>"},
    {"\<\"unit = \[DoubleStruckU][[hUSE]], hUSE = 8\"\>", "\<\"unit, \
hUSE\"\>", "\<\"unit spinor u = (1,0,0,0,1,0,0,0)/\[Sqrt]2 used for the \
vielbeins\"\>"},
    {"\<\"g_AB\"\>", "\<\"gAB44 (= \[Eta]4488)\"\>", "\<\"split-octonion norm \
metric\"\>"},
    {"\<\"E^A_a[h], E^a_A[h]   (Symbolize)\"\>", "\<\"E44[h], E44inv[h]\"\>", \
"\<\"4+4 vielbein (rows u.\[Sigma].\[Tau]bar[B]) and its inverse\"\>"},
    {"\<\"eA[1] \[Ellipsis] eA[8], EA\"\>", "\<\"eA[1] \[Ellipsis] eA[8], \
EA\"\>", "\<\"split-octonion basis, 1-based: eA[B] \[LeftRightArrow] \[Tau][B\
\[Minus]1] \[LeftRightArrow] x(B\[Minus]1)\"\>"},
    {"\<\"gridx\"\>", "\<\"gridx44\"\>", "\<\"split-octonion multiplication \
table\"\>"},
    {"\<\"\[LongDash]\"\>", "\<\"\[Tau]O[A], \[Tau]Obar[A]\"\>", "\<\"NEW: \
octonion 8\[Times]8 matrices\"\>"},
    {"\<\"\[LongDash]\"\>", "\<\"gO = ID8\"\>", "\<\"NEW: octonion norm \
metric\"\>"},
    {"\<\"\[LongDash]\"\>", "\<\"EO, EOinv\"\>", "\<\"NEW: octonion vielbein \
(same unit spinor u)\"\>"},
    {"\<\"\[LongDash]\"\>", "\<\"e[0] \[Ellipsis] e[7], eList\"\>", "\<\"NEW: \
octonion basis, 0-based: e[A] \[LeftRightArrow] \[Tau]O[A] \[LeftRightArrow] \
xA\"\>"},
    {"\<\"\[LongDash]\"\>", "\<\"LO[A]\"\>", "\<\"NEW: left multiplication by \
e[A] in the e-basis\"\>"},
    {"\<\"\[LongDash]\"\>", "\<\"gridO\"\>", "\<\"NEW: octonion \
multiplication table\"\>"},
    {"\<\"\[LongDash]\"\>", "\<\"oMul, oConj, oNorm2, oRe, oInv\"\>", \
"\<\"NEW: octonion product, conjugate, norm, real part, inverse\"\>"},
    {"\<\"\[LongDash]\"\>", "\<\"T16O[A]\"\>", "\<\"NEW: 16\[Times]16 \
generators of Cl(8,0), the exact mirror of T16\"\>"},
    {"\<\"\[LongDash]\"\>", "\<\"\[CapitalGamma]17[A]\"\>", "\<\"NEW: REAL 16\
\[Times]16 generators of the 7+1 Clifford algebra, metric \[Eta]17 = \[Minus]\
\[Eta]71\"\>"},
    {"\<\"\[LongDash]\"\>", "\<\"\[CapitalGamma]71[A]\"\>", "\<\"NEW: COMPLEX \
16\[Times]16 generators, metric \[Eta]71 (4+4.nb sign convention)\"\>"},
    {"\<\"\[LongDash]\"\>", "\<\"\[CapitalGamma]71R32[A]\"\>", "\<\"NEW: REAL \
32\[Times]32 generators, metric \[Eta]71\"\>"}
   },
   AutoDelete->False,
