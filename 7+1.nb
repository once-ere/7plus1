    {"\<\"unit = \[DoubleStruckU][[hUSE]], hUSE = 8\"\>", "\<\"unit, \
hUSE\"\>", "\<\"unit spinor u = (1,0,0,0,1,0,0,0)/\[Sqrt]2 used for the \
vielbeins\"\>"},
    {"\<\"g_AB\"\>", "\<\"gAB44 (= \[Eta]4488)\"\>", "\<\"split-octonion norm \
