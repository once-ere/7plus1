 TagBox[GridBox[{
    {"\<\"4+4.nb\"\>", "\<\"7+1.nb (this notebook)\"\>", "\<\"meaning\"\>"},
    {"\<\"\[Sigma] (= \[Sigma]88)\"\>", "\<\"\[Sigma]\"\>", "\<\"8\[Times]8 \
