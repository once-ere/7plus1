Cell[CellGroupData[{

Cell[TextData[{
 "3.5 Cayley\[Dash]Dickson doubling: ",
 Cell[BoxData[
  FormBox["\[DoubleStruckCapitalO]", TraditionalForm]],ExpressionUUID->
  "ab0d4121-d545-9344-a72b-594c2c7f27e9"],
 " = \[DoubleStruckCapitalH] \[CirclePlus] ",
 StyleBox["\[ScriptL]",
  FontFamily->"Cambria Math"],
 "\[DoubleStruckCapitalH]"
}], "Subsection",ExpressionUUID->"70939cc6-d746-ec4b-9186-6263a0ac8beb"],

Cell[TextData[{
 "The span of e[0], e[1], e[2], e[3] \[LongDash] the time direction and the \
three ordinary space directions x0 \[Ellipsis] x3 \[LongDash] is a quaternion \
subalgebra \[DoubleStruckCapitalH], and ",
 StyleBox["\[ScriptL]",
  FontFamily->"Cambria Math"],
 " = e[4] doubles it: e[4+k] = ",
 StyleBox["\[ScriptL]",
  FontFamily->"Cambria Math"],
 " e[k] (k = 1, 2, 3). Every octonion is x = a + ",
 StyleBox["\[ScriptL]",
  FontFamily->"Cambria Math"],
 " b with quaternions a = (x0, x1, x2, x3) and b = (x4, x5, x6, x7). \
Orientation inherited from 4+4.nb: e[1] e[2] = \[Minus]e[3], so i = e[1], j = \
e[2], k = \[Minus]e[3] are Hamilton\[CloseCurlyQuote]s units. With ",
 StyleBox["\[ScriptL]",
  FontFamily->"Cambria Math"],
 "\.b2 = \[Gamma] the product is"
}], "Text",ExpressionUUID->"864a9ca4-7761-1d4b-8aa3-3b90e299d763"],

Cell["\<\
      (a, b)(c, d) = (a c + \[Gamma] d b\:0304,  \[ABar] d + c b),     \
\[Gamma] = \[Minus]1: octonions,   \[Gamma] = +1: split octonions.\
\>", "Text",ExpressionUUID->"f0c98d8b-a502-8649-8c55-4afcf7e63715"],

Cell[CellGroupData[{

Cell["\<\
qMul[p1_List, p2_List] := Take[oMul[Join[p1, {0, 0, 0, 0}], Join[p2, {0, 0, \
0, 0}]], 4];
qConj[p1_List] := {p1[[1]], -p1[[2]], -p1[[3]], -p1[[4]]};
asPair[xx_List] := {Take[xx, 4], Take[xx, -4]};                       (* x = \
a + \[ScriptL] b  <->  {a, b} *)
cdMul[\[Gamma]_][{a1_, b1_}, {a2_, b2_}] := {qMul[a1, a2] + \[Gamma] qMul[b2, \
qConj[b1]], qMul[qConj[a1], b2] + qMul[a2, b1]};
check[\"\[DoubleStruckCapitalH] = span{e[0],e[1],e[2],e[3]} is a \
subalgebra\", And @@ Flatten[Table[Take[oMul[ev[A], ev[K]], -4] == {0, 0, 0, \
0}, {A, 0, 3}, {K, 0, 3}]]]
check[\"\[ScriptL] = e[4] doubles \[DoubleStruckCapitalH]: e[4] e[k] == \
e[4+k] (k = 1,2,3) and e[4] e[4] == -e[0]\",
  And @@ Table[oMul[ev[4], ev[k]] == ev[4 + k], {k, 1, 3}] && oMul[ev[4], \
ev[4]] == -ev[0]]
check[\"orientation inherited from 4+4.nb: e[1] e[2] == -e[3]\", oMul[ev[1], \
ev[2]] == -ev[3]]
check[\"Cayley-Dickson, \[Gamma] = -1: (ac - d b\:0304, a\:0304 d + c b) \
reproduces the octonion product (symbolic)\",
  Expand[Flatten[cdMul[-1][asPair[xs], asPair[ys]]] - oMul[xs, ys]] === zero8]
check[\"Cayley-Dickson, \[Gamma] = +1: (ac + d b\:0304, a\:0304 d + c b) \
reproduces the SPLIT product of 4+4.nb (symbolic)\",
  Expand[Flatten[cdMul[+1][asPair[xs], asPair[ys]]] - sMul[xs, ys]] === zero8]\
\>", "Input",
 CellLabel->
  "In[142]:=",ExpressionUUID->"51d6f63e-1c80-e047-9af9-2b7fea800372"],

Cell[BoxData[
 RowBox[{"\<\"\[DoubleStruckCapitalH] = span{e[0],e[1],e[2],e[3]} is a \
subalgebra\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002040480061962*^9},
 CellLabel->
  "Out[146]=",ExpressionUUID->"f4b5380d-b110-c043-8d8a-b404d764f077"],

Cell[BoxData[
 RowBox[{"\<\"\[ScriptL] = e[4] doubles \[DoubleStruckCapitalH]: e[4] e[k] == \
e[4+k] (k = 1,2,3) and e[4] e[4] == -e[0]\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020404800694485`*^9},
 CellLabel->
  "Out[147]=",ExpressionUUID->"4895ba09-2242-d540-b3db-2c12f5828b6f"],

Cell[BoxData[
 RowBox[{"\<\"orientation inherited from 4+4.nb: e[1] e[2] == -e[3]\"\>", "\[Rule]",
   "True"}]], "Output",
 CellChangeTimes->{4.0020404800739803`*^9},
 CellLabel->
  "Out[148]=",ExpressionUUID->"0526cacc-15ae-d64f-9ca5-c44025aed9e4"],

Cell[BoxData[
 RowBox[{"\<\"Cayley-Dickson, \[Gamma] = -1: (ac - d b\:0304, a\:0304 d + c \
b) reproduces the octonion product (symbolic)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020404800794983`*^9},
 CellLabel->
  "Out[149]=",ExpressionUUID->"03a0bd06-7240-f242-b5d0-527cc4994dfe"],

Cell[BoxData[
 RowBox[{"\<\"Cayley-Dickson, \[Gamma] = +1: (ac + d b\:0304, a\:0304 d + c \
b) reproduces the SPLIT product of 4+4.nb (symbolic)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020404800835*^9},
 CellLabel->
  "Out[150]=",ExpressionUUID->"5fa338af-bf10-954c-83e4-8c9a8ba0ea15"]
}, Open  ]],

Cell["\<\
The second formula of [1A], (a,b)(c,d) = (ac \[Minus] d\:0304 b, \[ABar] d + \
c b), mixes two conventions. It fails already for x = e[0] + e[4] = (1, 1) \
and y = e[1] = (i, 0) (no product of two imaginary quaternion units occurs, \
so the orientation of \[DoubleStruckCapitalH] does not matter): x\.b2 = (0, \
2), x\.b2y = (0, 2i), but x y = (i, i) and x(xy) = (2i, 2i).\
\>", "Text",ExpressionUUID->"3522d9e5-32d0-c342-a545-0a1ed9f6bc5c"],

Cell[CellGroupData[{

Cell["\<\
cdPrompt[{a1_, b1_}, {a2_, b2_}] := {qMul[a1, a2] - qMul[qConj[b2], b1], \
qMul[qConj[a1], b2] + qMul[a2, b1]};
pm[xx_List, yy_List] := Flatten[cdPrompt[asPair[xx], asPair[yy]]];
promptX = ev[0] + ev[4]; promptY = ev[1];
{toE[pm[pm[promptX, promptX], promptY]], toE[pm[promptX, pm[promptX, \
promptY]]]}\
\>", "Input",
 CellLabel->
  "In[151]:=",ExpressionUUID->"cc9655bf-4462-b843-aadf-58cd4dd298f0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"2", " ", 
    RowBox[{"e", "[", "5", "]"}]}], ",", 
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{"e", "[", "1", "]"}]}], "+", 
    RowBox[{"2", " ", 
     RowBox[{"e", "[", "5", "]"}]}]}]}], "}"}]], "Output",
 CellChangeTimes->{4.0020404800965614`*^9},
 CellLabel->
  "Out[154]=",ExpressionUUID->"ef3aea90-2b40-8645-8530-68e507955a6b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"the formula (ac - d\:0304 b, a\:0304 d + c b) of [1A] is NOT \
alternative: x\[CenterDot]x\[CenterDot]y != x(xy) for x = e[0]+e[4], y = e[1]\
\",
  pm[pm[promptX, promptX], promptY] =!= pm[promptX, pm[promptX, promptY]]]
check[\"... and its norm is not multiplicative (symbolic)\", \
Expand[oNorm2[pm[xs, ys]] - oNorm2[xs] oNorm2[ys]] =!= 0]\
\>", "Input",
 CellLabel->
  "In[155]:=",ExpressionUUID->"d8948511-7593-984c-a553-0d4d9c9b56d3"],

Cell[BoxData[
 RowBox[{"\<\"the formula (ac - d\:0304 b, a\:0304 d + c b) of [1A] is NOT \
alternative: x\[CenterDot]x\[CenterDot]y != x(xy) for x = e[0]+e[4], y = e[1]\
\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002040480106573*^9},
 CellLabel->
  "Out[155]=",ExpressionUUID->"3551bad5-1d56-9846-8dcd-842869294d39"],

Cell[BoxData[
 RowBox[{"\<\"... and its norm is not multiplicative (symbolic)\"\>", "\[Rule]",
   "True"}]], "Output",
 CellChangeTimes->{4.0020404801125813`*^9},
 CellLabel->
  "Out[156]=",ExpressionUUID->"8eabd0d8-63e0-4f45-b532-7c04f6721a68"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.6 Octonions versus split octonions", "Subsection",ExpressionUUID->"7902f8d9-ba84-da46-9e9f-7eb240c043b0"],

Cell[TextData[{
 "Comparing gridO with gridx44 (relabelled 0-based, eA[B] \[RightArrow] e[B\
\[Minus]1]): e[A]e[B] (octonion) = s_AB \[Times] e[A]e[B] (split), with s_AB \
= \[Minus]1 when both A \[GreaterEqual] 4 and B \[GreaterEqual] 4, and s_AB = \
+1 otherwise. Only products of two \[OpenCurlyDoubleQuote]doubled\
\[CloseCurlyDoubleQuote] units change sign, because ",
 StyleBox["\[ScriptL]",
  FontFamily->"Cambria Math"],
 "\.b2 = \[Minus]1 instead of +1. Over \[DoubleStruckCapitalC] the two \
algebras are isomorphic: \[Phi](eA[A+1]) = c_A e[A] with c = (1, 1, 1, 1, i, \
i, i, i)."
}], "Text",ExpressionUUID->"60f35f3d-28e3-c44f-a668-c58dbf825274"],

Cell[CellGroupData[{

Cell["\<\
sAB[A_, K_] := If[A >= 4 && K >= 4, -1, 1];
check[\"e[A]e[B] (octonion) == s_AB e[A]e[B] (split) for all A, B = 0..7\",
  And @@ Flatten[Table[oMul[ev[A], ev[K]] == sAB[A, K] sMul[ev[A], ev[K]], \
{A, 0, 7}, {K, 0, 7}]]]
cc = {1, 1, 1, 1, I, I, I, I};
\[CurlyPhi][xx_List] := cc xx;
check[\"over \[DoubleStruckCapitalC]: \[CurlyPhi](x *split y) == \
\[CurlyPhi](x) *oct \[CurlyPhi](y) (symbolic): split \[CircleTimes] \
\[DoubleStruckCapitalC] \[TildeFullEqual] \[DoubleStruckCapitalO] \
\[CircleTimes] \[DoubleStruckCapitalC]\",
  Expand[\[CurlyPhi][sMul[xs, ys]] - oMul[\[CurlyPhi][xs], \[CurlyPhi][ys]]] \
=== zero8]
check[\"the norms correspond: N_oct(\[CurlyPhi](x)) == N_split(x) \
(symbolic)\", Expand[oNorm2[\[CurlyPhi][xs]] - sNorm2[xs]] === 0]\
\>", "Input",
 CellLabel->
  "In[157]:=",ExpressionUUID->"af0cbe4d-d6c2-dc40-b35b-55d5f397a1bb"],

Cell[BoxData[
 RowBox[{"\<\"e[A]e[B] (octonion) == s_AB e[A]e[B] (split) for all A, B = \
0..7\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020404801243362`*^9},
 CellLabel->
  "Out[158]=",ExpressionUUID->"74f41550-e072-8549-864a-55199d482ea5"],

Cell[BoxData[
 RowBox[{"\<\"over \[DoubleStruckCapitalC]: \[CurlyPhi](x *split y) == \
\[CurlyPhi](x) *oct \[CurlyPhi](y) (symbolic): split \[CircleTimes] \
\[DoubleStruckCapitalC] \[TildeFullEqual] \[DoubleStruckCapitalO] \
\[CircleTimes] \[DoubleStruckCapitalC]\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020404801243362`*^9},
 CellLabel->
  "Out[161]=",ExpressionUUID->"be960260-c345-9348-a056-2191bbd7fab2"],

Cell[BoxData[
 RowBox[{"\<\"the norms correspond: N_oct(\[CurlyPhi](x)) == N_split(x) \
(symbolic)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020404801243362`*^9},
 CellLabel->
  "Out[162]=",ExpressionUUID->"3b73b1fb-4f59-814f-9ffb-1d06a7453d91"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Clifford algebras from the octonions: 16\[Times]16 matrices", \
"Section",ExpressionUUID->"72dd0b66-8ce3-c946-a3c5-b4129ac84d03"],

Cell[CellGroupData[{

Cell["\<\
4.1 The exact mirror of T16: the Euclidean Clifford algebra Cl(8,0)\
\>", "Subsection",ExpressionUUID->"d09ca8d3-97d5-b649-9e52-7b85326107d7"],

Cell["\<\
Copying the 4+4.nb definition T16[A] = {{0, \[Tau]bar[A]}, {\[Tau][A], 0}} \
with \[Tau] \[RightArrow] \[Tau]O and \[Tau]bar \[RightArrow] \[Tau]Obar \
gives real 16\[Times]16 matrices T16O[A] whose anticommutators are governed \
by the octonion norm gO = ID8: they generate Cl(8,0) \[TildeFullEqual] \
\[DoubleStruckCapitalR](16). They can be written with the 4+4 matrices alone: \
T16O[A] = T16[A] for A = 0 \[Ellipsis] 3 and T16O[k] = T16[k].S44 for k = 4 \
\[Ellipsis] 7, where S44 = T16[4].T16[5].T16[6].T16[7] = diag(\[Sigma], \
\[Sigma]).\
\>", "Text",ExpressionUUID->"c81422f3-c832-9941-aebb-5f48f6b9f99c"],

Cell[CellGroupData[{

Cell["\<\
Do[T16O[A] = ArrayFlatten[{{0, \[Tau]Obar[A]}, {\[Tau]O[A], 0}}], {A, 0, 7}];
T16O[8] = Dot @@ Table[T16O[A], {A, 0, 7}];
S44 = T16[4].T16[5].T16[6].T16[7];
check[\"Cl(8,0): (T16O[A].T16O[B] + T16O[B].T16O[A])/2 == gO[[A+1,B+1]] ID16\",
  And @@ Flatten[Table[(T16O[A].T16O[B] + T16O[B].T16O[A])/2 == gO[[A + 1, B \
+ 1]] ID16, {A, 0, 7}, {B, 0, 7}]]]
check[\"S44 == diag(\[Sigma], \[Sigma])\", S44 == ArrayFlatten[{{\[Sigma], \
0}, {0, \[Sigma]}}]]
check[\"T16O from the 4+4 matrices: T16O[A] == T16[A] (A = 0..3), T16O[k] == \
T16[k].S44 (k = 4..7)\",
  And @@ Table[T16O[A] == T16[A], {A, 0, 3}] && And @@ Table[T16O[k] == \
T16[k].S44, {k, 4, 7}]]
check[\"T16O[8] == T16[8] == diag(-ID8, ID8): same chirality matrix and same \
PL44, PR44 as 4+4.nb\",
  T16O[8] == T16[8] == ArrayFlatten[{{-ID8, 0}, {0, ID8}}]]\
\>", "Input",
 CellLabel->
  "In[163]:=",ExpressionUUID->"a3a1faae-ab0d-2d45-ac9a-e1d487c11e44"],

Cell[BoxData[
 RowBox[{"\<\"Cl(8,0): (T16O[A].T16O[B] + T16O[B].T16O[A])/2 == gO[[A+1,B+1]] \
ID16\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020404801446953`*^9},
 CellLabel->
  "Out[166]=",ExpressionUUID->"8b3774ae-2f92-014a-87e9-72a449c6cd46"],

Cell[BoxData[
 RowBox[{"\<\"S44 == diag(\[Sigma], \[Sigma])\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020404801446953`*^9},
 CellLabel->
  "Out[167]=",ExpressionUUID->"0eb0edc4-576c-834f-a4d6-097326ff9474"],

Cell[BoxData[
 RowBox[{"\<\"T16O from the 4+4 matrices: T16O[A] == T16[A] (A = 0..3), \
T16O[k] == T16[k].S44 (k = 4..7)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002040480155607*^9},
 CellLabel->
  "Out[168]=",ExpressionUUID->"91036b72-dc70-1c49-9980-4e9d1906c55c"],

Cell[BoxData[
 RowBox[{"\<\"T16O[8] == T16[8] == diag(-ID8, ID8): same chirality matrix and \
same PL44, PR44 as 4+4.nb\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002040480155607*^9},
 CellLabel->
  "Out[169]=",ExpressionUUID->"e40f5460-e45c-554e-b696-76818f8fd9ab"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
4.2 The REAL Clifford algebra of 7+1 spacetime: \[CapitalGamma]17, Cl(1,7) \
\[TildeFullEqual] \[DoubleStruckCapitalR](16)\
\>", "Subsection",ExpressionUUID->"29a3082b-53c6-d541-8497-265d7918d7e4"],

Cell[TextData[{
 StyleBox["Definition. ",
  FontWeight->"Bold"],
 "\[CapitalGamma]17[0] = T16O[0] (time) and \[CapitalGamma]17[i] = \
T16O[0].T16O[i] (i = 1 \[Ellipsis] 7, space). Then"
}], "Text",ExpressionUUID->"31b4414e-9658-6c40-8961-5424e5acac10"],

Cell["\<\
      \[CapitalGamma]17[A].\[CapitalGamma]17[B] + \[CapitalGamma]17[B].\
\[CapitalGamma]17[A] = 2 \[Eta]17[[A+1,B+1]] ID16 = \[Minus]2 \
\[Eta]71[[A+1,B+1]] ID16:\
\>", "Text",ExpressionUUID->"6d6f0d1b-6d18-3542-88f3-24ddc72c9d28"],

Cell["\<\
time squares to +ID16, each of the seven space directions to \[Minus]ID16. In \
block form \[CapitalGamma]17[0] = {{0, ID8}, {ID8, 0}} (the same block form \
as T16[0]) and \[CapitalGamma]17[i] = {{\[Tau]O[i], 0}, {0, \[Tau]Obar[i]}} \
(block-diagonal). With the 4+4 matrices only: \[CapitalGamma]17[0] = T16[0], \
\[CapitalGamma]17[i] = T16[0].T16[i] (i = 1, 2, 3), \[CapitalGamma]17[k] = \
T16[0].T16[k].S44 (k = 4 \[Ellipsis] 7). All entries are 0 or \[PlusMinus]1.\
\>", "Text",ExpressionUUID->"6f434c28-dfd9-3041-b62d-b5c6ffcbe4d5"],

Cell[TextData[{
 StyleBox["Why this is the Clifford algebra of [1B]. ",
  FontWeight->"Bold"],
 "(i) The linear map v \[RightTeeArrow] \[CapitalGamma]17(v) = \
\[CapitalSigma] v^A \[CapitalGamma]17[A] satisfies \[CapitalGamma]17(v)\.b2 = \
Q(v) ID16 with Q(v) = v.\[Eta]17.v, so by the universal property of Cl(V,Q) = \
T(V)/I_Q(V) it extends to an algebra homomorphism Cl(V,Q) \[RightArrow] \
\[DoubleStruckCapitalR](16). (ii) The 256 ordered products \
\[CapitalGamma]17[A1]\[Ellipsis]\[CapitalGamma]17[Ak] (A1 < \[Ellipsis] < Ak) \
are linearly independent, so the homomorphism is injective; both sides have \
dimension 256, so it is an isomorphism Cl(1,7) \[TildeFullEqual] \
\[DoubleStruckCapitalR](16)."
}], "Text",ExpressionUUID->"4e05aabc-227b-ef4a-9242-c5d7c0c535c6"],

Cell[CellGroupData[{

Cell["\<\
\[CapitalGamma]17[0] = T16O[0];
Do[\[CapitalGamma]17[i] = T16O[0].T16O[i], {i, 1, 7}];
\[CapitalGamma]17[8] = Dot @@ Table[\[CapitalGamma]17[A], {A, 0, 7}];
check[\"7+1 REAL Clifford relation: \
(\[CapitalGamma]17[A].\[CapitalGamma]17[B] + \[CapitalGamma]17[B].\
\[CapitalGamma]17[A])/2 == \[Eta]17[[A+1,B+1]] ID16 == -\[Eta]71[[A+1,B+1]] \
ID16\",
  And @@ Flatten[Table[(\[CapitalGamma]17[A].\[CapitalGamma]17[B] + \
\[CapitalGamma]17[B].\[CapitalGamma]17[A])/2 == \[Eta]17[[A + 1, B + 1]] ID16 \
== -\[Eta]71[[A + 1, B + 1]] ID16, {A, 0, 7}, {B, 0, 7}]]]
check[\"\[CapitalGamma]17[A] are REAL: every entry is 0 or \[PlusMinus]1\", \
And @@ Table[SubsetQ[{-1, 0, 1}, Union[Flatten[\[CapitalGamma]17[A]]]], {A, \
0, 7}]]
check[\"block form: \[CapitalGamma]17[0] == {{0,ID8},{ID8,0}}, \
\[CapitalGamma]17[i] == {{\[Tau]O[i],0},{0,\[Tau]Obar[i]}}\",
  \[CapitalGamma]17[0] == ArrayFlatten[{{0, ID8}, {ID8, 0}}] && And @@ Table[\
\[CapitalGamma]17[i] == ArrayFlatten[{{\[Tau]O[i], 0}, {0, \[Tau]Obar[i]}}], \
{i, 1, 7}]]
check[\"built from the real 4+4 matrices: \[CapitalGamma]17[0] == T16[0], \
\[CapitalGamma]17[i] == T16[0].T16[i] (i = 1,2,3), \[CapitalGamma]17[k] == \
T16[0].T16[k].S44 (k = 4..7)\",
  \[CapitalGamma]17[0] == T16[0] && And @@ Table[\[CapitalGamma]17[i] == \
T16[0].T16[i], {i, 1, 3}] && And @@ Table[\[CapitalGamma]17[k] == \
T16[0].T16[k].S44, {k, 4, 7}]]
check[\"\[CapitalGamma]17[0] symmetric, \[CapitalGamma]17[i] antisymmetric, \
so Transpose[\[CapitalGamma]17[A]] == \
\[CapitalGamma]17[0].\[CapitalGamma]17[A].\[CapitalGamma]17[0] (real Dirac \
adjoint)\",
  Transpose[\[CapitalGamma]17[0]] == \[CapitalGamma]17[0] && And @@ \
Table[Transpose[\[CapitalGamma]17[i]] == -\[CapitalGamma]17[i], {i, 1, 7}] &&
  And @@ Table[Transpose[\[CapitalGamma]17[A]] == \[CapitalGamma]17[0].\
\[CapitalGamma]17[A].\[CapitalGamma]17[0], {A, 0, 7}]]\
\>", "Input",
 CellLabel->
  "In[170]:=",ExpressionUUID->"bfc0ac03-9467-be4a-b57b-2deb06c08f0c"],

Cell[BoxData[
 RowBox[{"\<\"7+1 REAL Clifford relation: (\[CapitalGamma]17[A].\
\[CapitalGamma]17[B] + \[CapitalGamma]17[B].\[CapitalGamma]17[A])/2 == \
\[Eta]17[[A+1,B+1]] ID16 == -\[Eta]71[[A+1,B+1]] ID16\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002040480171316*^9},
 CellLabel->
  "Out[173]=",ExpressionUUID->"f1523f9b-30e8-a044-8c0e-73744fc81273"],

Cell[BoxData[
 RowBox[{"\<\"\[CapitalGamma]17[A] are REAL: every entry is 0 or \
\[PlusMinus]1\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002040480171316*^9},
 CellLabel->
  "Out[174]=",ExpressionUUID->"2d21bfae-ab45-0d4a-ad2f-12cb354cca29"],

Cell[BoxData[
 RowBox[{"\<\"block form: \[CapitalGamma]17[0] == {{0,ID8},{ID8,0}}, \
\[CapitalGamma]17[i] == {{\[Tau]O[i],0},{0,\[Tau]Obar[i]}}\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002040480171316*^9},
 CellLabel->
  "Out[175]=",ExpressionUUID->"25d08f1b-a760-dc47-9d93-a0381e6ef29e"],

Cell[BoxData[
 RowBox[{"\<\"built from the real 4+4 matrices: \[CapitalGamma]17[0] == \
T16[0], \[CapitalGamma]17[i] == T16[0].T16[i] (i = 1,2,3), \
\[CapitalGamma]17[k] == T16[0].T16[k].S44 (k = 4..7)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020404801869564`*^9},
 CellLabel->
  "Out[176]=",ExpressionUUID->"4dbede42-c531-3744-bb6e-08025c1e2f98"],

Cell[BoxData[
 RowBox[{"\<\"\[CapitalGamma]17[0] symmetric, \[CapitalGamma]17[i] \
antisymmetric, so Transpose[\[CapitalGamma]17[A]] == \[CapitalGamma]17[0].\
\[CapitalGamma]17[A].\[CapitalGamma]17[0] (real Dirac adjoint)\"\>", "\[Rule]",
   "True"}]], "Output",
 CellChangeTimes->{4.0020404801869564`*^9},
 CellLabel->
  "Out[177]=",ExpressionUUID->"4ff88a48-b0df-f740-8d79-2f5822f8d455"]
}, Open  ]],

Cell[CellGroupData[{

