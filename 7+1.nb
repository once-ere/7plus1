 CellLabel->
  "Out[827]=",ExpressionUUID->"9df5b4ff-3343-a547-b612-f6ce55dea4cc"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
18. dirac16complex at the world brane: the 16 components as four brane Dirac \
spinors, and the portals\
\>", "Section",ExpressionUUID->"cf100b11-f1dd-df4c-83fd-20d521c4a605"],

Cell["\<\
At the brane the eight Dirac matrices split into four along W and four \
transverse to it. With complex 4\[Times]4 Dirac matrices \[Gamma]^(4)_\[Mu] \
(Dirac representation, \[Gamma]5 = i\[Gamma]0\[Gamma]1\[Gamma]2\[Gamma]3) and \
four anti-Hermitian 4\[Times]4 matrices \[Rho]_k (k = 4 \[Ellipsis] 7), {\
\[Rho]_k, \[Rho]_l} = \[Minus]2\[Delta]kl (\[Rho]4 = i\[Gamma]0, \[Rho]5 = \
\[Minus]\[Gamma]1, \[Rho]6 = \[Minus]\[Gamma]2, \[Rho]7 = \[Minus]\[Gamma]3), \
the sixteen matrices\
\>", "Text",ExpressionUUID->"c772f1e2-7fd8-5648-b1af-38732f5c6603"],

Cell["\<\
      R_\[Mu] = \[Gamma]^(4)_\[Mu] \[CircleTimes] 1_4  (\[Mu] = 0 \[Ellipsis] \
3),      R_k = \[Gamma]5 \[CircleTimes] \[Rho]_k  (k = 4 \[Ellipsis] 7)\
\>", "Text",ExpressionUUID->"4e791566-065f-1143-9e7b-cfe738fc5806"],

Cell["\<\
satisfy the same Clifford relations as \[CapitalGamma]17[A]; both \
representations are irreducible, so there is a unitary U (Schur average over \
the 256 Clifford products) with \[CapitalGamma]17[A].U = U.R_A. Writing \
\[Psi] = U.\[Zeta] with \[Zeta] \[Element] \[DoubleStruckCapitalC]\:2074 \
\[CircleTimes] \[DoubleStruckCapitalC]\:2074, \[Zeta] = \[CapitalSigma]_a \
\[Psi]_a \[CircleTimes] e_a, dirac16complex at the brane is FOUR brane Dirac \
spinors \[Psi]_a (a = 1 \[Ellipsis] 4, the transverse spinor index): \
\[Psi]bar \[Psi]\[Prime] = \[CapitalSigma]_a \[Psi]\:0304_a \[Psi]\[Prime]_a \
and \[Psi]bar \[CapitalGamma]^\[Mu] \[Psi]\[Prime] = \[CapitalSigma]_a \[Psi]\
\:0304_a \[Gamma]^\[Mu] \[Psi]\[Prime]_a. The eight-dimensional chirality is \
\[Chi]17 = U.(\[Gamma]5 \[CircleTimes] \[Rho]4567).U\[Dagger] (\[Rho]4567 = \
\[Rho]4\[Rho]5\[Rho]6\[Rho]7, eigenvalues +1, +1, \[Minus]1, \[Minus]1): the \
left-handed half \[Psi]_L contains brane-right-handed parts with \[Rho]4567 = \
\[Minus]1 and brane-left-handed parts with \[Rho]4567 = +1.\
\>", "Text",ExpressionUUID->"55cb4b23-f64b-ac45-9cce-fe19f2b0bc7f"],

Cell[CellGroupData[{

Cell["\<\
g4D = {DiagonalMatrix[{1, 1, -1, -1}]};
Do[AppendTo[g4D, ArrayFlatten[{{0, PauliMatrix[i]}, {-PauliMatrix[i], 0}}]], \
{i, 3}];
g5D = I g4D[[1]].g4D[[2]].g4D[[3]].g4D[[4]];
rhoK = {I g4D[[1]], -g4D[[2]], -g4D[[3]], -g4D[[4]]};
rBr = Join[Table[KroneckerProduct[g4D[[mu + 1]], IdentityMatrix[4]], {mu, 0, \
3}], Table[KroneckerProduct[g5D, rhoK[[k]]], {k, 4}]];
check[\"brane representation: R_A R_B + R_B R_A == 2 eta17_AB ID16 for R = \
(gamma_mu (x) 1_4, gamma5 (x) rho_k)\",
  And @@ Flatten[Table[rBr[[A]].rBr[[B]] + rBr[[B]].rBr[[A]] == 2 \
\[Eta]17[[A, B]] ID16, {A, 8}, {B, 8}]]]
clifProd[gs_, K_] := Dot @@ Join[{ID16}, gs[[K + 1]]];
uSchur[seed_] := Sum[clifProd[Table[\[CapitalGamma]17[A], {A, 0, 7}], \
K].seed.Inverse[clifProd[rBr, K]], {K, mIdx}];
uInt = Module[{s, u}, Do[s = ConstantArray[0, {16, 16}]; s[[Quotient[j, 16] + \
1, Mod[j, 16] + 1]] = 1; u = uSchur[s]; If[u =!= ConstantArray[0, {16, 16}], \
Break[]], {j, 0, 255}];
   u/Sqrt[Tr[ConjugateTranspose[u].u]/16]];
check[\"intertwiner: Gamma17[A].U == U.R_A for A = 0..7, and U is unitary\", \
And @@ Table[\[CapitalGamma]17[A].uInt == uInt.rBr[[A + 1]], {A, 0, 7}] &&
  Simplify[ConjugateTranspose[uInt].uInt] == ID16]
rho4567 = rhoK[[1]].rhoK[[2]].rhoK[[3]].rhoK[[4]];
check[\"chi17 == U.(gamma5 (x) rho4567).U^dag; rho4567 Hermitian with \
eigenvalues {-1, -1, 1, 1}\",
  Simplify[\[Chi]17 - uInt.KroneckerProduct[g5D, \
rho4567].ConjugateTranspose[uInt]] == ConstantArray[0, {16, 16}] &&
  ConjugateTranspose[rho4567] == rho4567 && Sort[Eigenvalues[rho4567]] == \
{-1, -1, 1, 1}]
{z1B, z2B} = {rndSpinor[], rndSpinor[]};
bar4[z_, a_] := Conjugate[Transpose[Partition[z, 4]][[a]]].g4D[[1]];
check[\"bilinears at the brane: psibar psi' == Sum_a psibar_a psi'_a and \
psibar Gamma^mu psi' == Sum_a psibar_a gamma^mu psi'_a (mu = 0..3)\",
  Simplify[Conjugate[uInt.z1B].\[CapitalGamma]17[0].(uInt.z2B) - \
Sum[bar4[z1B, a].Transpose[Partition[z2B, 4]][[a]], {a, 4}]] === 0 &&
  And @@ Table[Simplify[Conjugate[uInt.z1B].\[CapitalGamma]17[0].\
\[CapitalGamma]17up[mu].(uInt.z2B) -
       Sum[bar4[z1B, a].(\[Eta]17[[mu + 1, mu + 1]] g4D[[mu + \
1]]).Transpose[Partition[z2B, 4]][[a]], {a, 4}]] === 0, {mu, 0, 3}]]\
\>", "Input",
 CellLabel->
  "In[828]:=",ExpressionUUID->"41da3fad-beec-3546-8d38-7c8b5262d29f"],

Cell[BoxData[
 RowBox[{"\<\"brane representation: R_A R_B + R_B R_A == 2 eta17_AB ID16 for \
R = (gamma_mu (x) 1_4, gamma5 (x) rho_k)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021473108875847`*^9},
 CellLabel->
  "Out[833]=",ExpressionUUID->"39e774cf-66cf-164b-a24c-b8f76e69776f"],

Cell[BoxData[
 RowBox[{"\<\"intertwiner: Gamma17[A].U == U.R_A for A = 0..7, and U is \
unitary\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021473113145638`*^9},
 CellLabel->
  "Out[837]=",ExpressionUUID->"83a7f27b-f148-e64b-ba61-c328a082cf15"],

Cell[BoxData[
 RowBox[{"\<\"chi17 == U.(gamma5 (x) rho4567).U^dag; rho4567 Hermitian with \
eigenvalues {-1, -1, 1, 1}\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021473113235645`*^9},
 CellLabel->
  "Out[839]=",ExpressionUUID->"5250a21d-9ed9-c644-b60e-24d583a861e6"],

Cell[BoxData[
 RowBox[{"\<\"bilinears at the brane: psibar psi' == Sum_a psibar_a psi'_a \
and psibar Gamma^mu psi' == Sum_a psibar_a gamma^mu psi'_a (mu = 0..3)\"\>", "\[Rule]",
   "True"}]], "Output",
 CellChangeTimes->{4.002147311324564*^9},
 CellLabel->
  "Out[842]=",ExpressionUUID->"49348916-75a0-4c42-a10a-712cf5ed05ab"]
}, Open  ]],

Cell[CellGroupData[{

Cell["18.1 Kaluza\[Dash]Klein masses on the auxiliary torus", "Subsection",ExpressionUUID->"2e04bb76-86a1-104a-ae8e-7866861d5010"],

Cell[TextData[{
 "With b = b0 and \[Psi] \[Proportional] e^{i ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "7de70796-a402-8c48-806a-e9499eb09806"],
 "\[CenterDot]",
 Cell[BoxData[
  FormBox[
   OverscriptBox["y", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "2d1c4b1a-50ec-4f45-abca-add93756872c"],
 "} (",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "5873217c-af97-004f-82ab-56785f8842db"],
 " = 2\[Pi] ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["n", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "44755fde-9530-a043-a75e-4b06e461f7c4"],
 "/Lc, ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["n", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "25bc767d-a9d9-3647-b8c9-731766d330f2"],
 " \[Element] \:2124\:2074) the eight-dimensional Dirac equation at the brane \
becomes, in the variables \[Zeta], (\[Gamma]\[CenterDot]p \[CircleTimes] 1_4 \
+ X \[Minus] m) \[Zeta] = 0 with X = \[Gamma]5 \[CircleTimes] (\[Rho]\
\[CenterDot]",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "6c6d5dfe-fde0-434e-b56f-2e72192f9a74"],
 ")/b0. X anticommutes with every \[Gamma]^\[Mu] \[CircleTimes] 1_4 and X\.b2 \
= \[Minus]|",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "742aa97a-063e-dc4e-a4b8-c80915725418"],
 "|\.b2/b0\.b2, so each Fourier mode is four brane Dirac fermions of mass m_n \
= \[Sqrt](m\.b2 + |",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "1bf533ed-74fb-284d-b9f2-92ef9da05267"],
 "|\.b2/b0\.b2) (a Kaluza\[Dash]Klein tower; the zero mode ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["n", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "0413d490-129a-7945-84ae-e85d94aec847"],
 " = 0 has mass m)."
}], "Text",ExpressionUUID->"7cc5cc46-41ea-9248-af33-171183d472f7"],

Cell[CellGroupData[{

Cell["\<\
mPs = 7/10; b0K = 13/10; qKK = 2 Pi {2, -1, 1/2, 3};
xKK = KroneckerProduct[g5D, qKK.rhoK]/b0K;
check[\"KK operator: X.X == -|q|^2/b0^2 ID16 and X anticommutes with gamma_mu \
(x) 1_4\", Simplify[xKK.xKK + qKK.qKK/b0K^2 ID16] == ConstantArray[0, {16, \
16}] &&
  And @@ Table[Simplify[xKK.rBr[[mu]] + rBr[[mu]].xKK] == ConstantArray[0, \
{16, 16}], {mu, 1, 4}]]
detKK[en_] := Det[N[KroneckerProduct[en g4D[[1]] - (3/10 g4D[[2]] - 2/10 \
g4D[[3]] + 4/10 g4D[[4]]), IdentityMatrix[4]] + xKK - mPs ID16, 40]];
eOn = Sqrt[mPs^2 + qKK.qKK/b0K^2 + (3/10)^2 + (2/10)^2 + (4/10)^2];
check[\"KK masses: Det[gamma.p (x) 1 + X - m] vanishes on p0^2 - |p|^2 == m^2 \
+ |q|^2/b0^2 (40-digit arithmetic) and not off shell\",
  Abs[detKK[eOn]] < 10^-25 Abs[detKK[11/10 eOn]] && Abs[detKK[11/10 eOn]] > \
10^-3]\
\>", "Input",
 CellLabel->
  "In[843]:=",ExpressionUUID->"3903392e-7590-2c4b-a193-2d89e4cd462e"],

Cell[BoxData[
 RowBox[{"\<\"KK operator: X.X == -|q|^2/b0^2 ID16 and X anticommutes with \
gamma_mu (x) 1_4\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002147311338564*^9},
 CellLabel->
  "Out[845]=",ExpressionUUID->"53fb59f7-8f67-c347-b6ec-7ec829ca221a"],

Cell[BoxData[
 RowBox[{"\<\"KK masses: Det[gamma.p (x) 1 + X - m] vanishes on p0^2 - |p|^2 \
== m^2 + |q|^2/b0^2 (40-digit arithmetic) and not off shell\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0021473113395615`*^9},
 CellLabel->
  "Out[848]=",ExpressionUUID->"2a3557b1-46e5-0548-8fc9-2904924084ad"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["18.2 The portals", "Subsection",ExpressionUUID->"12395c25-16d9-1246-8bf5-4f353abcb2f1"],

Cell["\<\
The portals of dirac16complex (an INVENTED interaction, as in Dirac_claude; \
separate couplings for the two eight-dimensional chiral halves) are local \
couplings at the brane, with \[Psi]_a(x) the brane spinors of \[Psi](x, y = \
0):\
\>", "Text",ExpressionUUID->"c7aba434-4ce5-a445-a46b-46cb018ddd1a"],

Cell["\<\
Neutrino (Yukawa) portal: \[Minus]\[CapitalSigma]_{i,s} [y^L_is L\:0304_i \
\[CapitalPhi]\:0303 P_R \[Psi]^(L)_s + y^R_is L\:0304_i \[CapitalPhi]\:0303 \
P_R \[Psi]^(R)_s] + h.c., where \[Psi]^(L)_s (\[Psi]^(R)_s) are the \
brane-right-handed parts of the left (right) half of dirac16complex (two \
each, s = 1, 2). After symmetry breaking it is a Dirac mass \[Mu]_ia = y_ia \
v/(\[Sqrt]2 \[Sqrt]V\[UpTee]) between \[Nu]_L and every Kaluza\[Dash]Klein \
mode (the factor 1/\[Sqrt]V\[UpTee] normalizes the modes on the torus).\
\>", "Item",ExpressionUUID->"dbd976b7-8b00-8948-90fe-35abb148a8bc"],

Cell["\<\
Vector (current) portal: \[Minus]G_P^f (\[Psi]bar \[CapitalGamma]^\[Mu] \
\[Psi])|_W (f\:0304 \[Gamma]_\[Mu] f) for Standard Model fermions f; in a \
background of dirac16complex with brane density n_\[Psi] it adds the \
potential V_P^f = G_P^f n_\[Psi] to the forward scattering of f (for \
neutrinos: non-standard matter effects).\
\>", "Item",ExpressionUUID->"0a8b0653-87e1-9641-b789-23ec11b09305"],

Cell["\<\
Higgs (scalar) portal: \[Minus]\[Lambda]_P \
\[CapitalPhi]\[Dagger]\[CapitalPhi] (\[Psi]bar \[Psi])|_W, which shifts the \
dirac16complex mass by \[Lambda]_P v\.b2/(2 V\[UpTee]) after symmetry \
breaking.\
\>", "Item",ExpressionUUID->"fd14a415-234a-9543-bf2f-d53e8d279d25"],

Cell["\<\
Coupled field equations (all fields): \[CapitalSigma]_k \[Alpha]_k \
E^(k)\[Mu]_\[Nu] = \[Kappa] (T_\[Psi] + T_stab + \[Delta]\:2074(y)/b\:2074 \
T_W)^\[Mu]_\[Nu]; (i \[CapitalGamma]^\[Mu] D_\[Mu] \[Minus] m)\[Psi] \[Minus] \
\[CapitalSigma]_r g_r \[CapitalSigma]_K (\[Psi]bar \[CapitalTheta]_K \[Psi]) \
\[CapitalTheta]^K \[Psi] = \[Delta]\:2074(y)/b\:2074 \[Times] (portal \
sources: U.(\[CapitalSigma] y* \[CapitalPhi]\:0303\[Dagger] L \[CircleTimes] \
e_s + \[Ellipsis])); the Standard Model field equations on W with the portal \
terms as additional sources. In the neutrino sector the Yukawa portal gives, \
in the basis (\[Nu]_L, \[Psi]_L) \[Times] (\[Nu]_R, \[Psi]_R), the Dirac mass \
matrix {{m_D, \[Mu]}, {0, m 1_4}} for the zero mode; with m \[GreaterGreater] \
\[Mu] the light mixing matrix N = (1 \[Minus] \[Eta]) U_PMNS is no longer \
unitary, \[Eta] \[TildeTilde] \[Mu] \[Mu]\[Dagger]/(2m\.b2), and the heavy \
states are mostly dirac16complex.\
\>", "Text",ExpressionUUID->"70f9e455-fc74-b54b-8143-df32951c54b1"],

Cell[CellGroupData[{

Cell["\<\
mDnu = uPMNS.DiagonalMatrix[N[mNu]]; mPsi = 1.0*^9;
muPortal = Transpose[{{3*^4, 1*^4, -2*^4}, {1*^4, 2*^4, 1*^4}, {0, 0, 0}, {0, \
0, 0}}];
mFull = ArrayFlatten[{{mDnu, muPortal}, {ConstantArray[0, {4, 3}], mPsi \
IdentityMatrix[4]}}];
{ulP, svP, vrP} = SingularValueDecomposition[mFull];
ordP = Ordering[Diagonal[svP]]; ulP = ulP[[All, ordP]]; svL = \
Diagonal[svP][[ordP]];
nAct = ulP[[1 ;; 3, 1 ;; 3]];
devNN = IdentityMatrix[3] - nAct.ConjugateTranspose[nAct];
check[\"portal mixing: 1 - N.N^dag == mu.mu^dag/m^2 to second order \
(non-unitary light mixing)\", Norm[devNN - \
muPortal.ConjugateTranspose[muPortal]/mPsi^2] < 10^-14]
{\"light masses (eV)\" -> svL[[1 ;; 3]], \"heavy masses (GeV)\" -> svL[[4 ;; \
7]] 10^-9, \"(1 - N.N^dag)_ee\" -> Re[devNN[[1, 1]]]}\
\>", "Input",
 CellLabel->
  "In[849]:=",ExpressionUUID->"e0d2945a-aab6-4e48-aac9-347e4853e0fe"],

Cell[BoxData[
 RowBox[{"\<\"portal mixing: 1 - N.N^dag == mu.mu^dag/m^2 to second order \
(non-unitary light mixing)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002147311341568*^9},
 CellLabel->
  "Out[856]=",ExpressionUUID->"7b6eda97-f332-6240-88d2-8f84867c880d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"light masses (eV)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "0.`", ",", "0.008654474266054325`", ",", "0.05033883297204202`"}], 
     "}"}]}], ",", 
   RowBox[{"\<\"heavy masses (GeV)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "1.`", ",", "1.`", ",", "1.0000000002500002`", ",", 
      "1.0000000007499998`"}], "}"}]}], ",", 
   RowBox[{"\<\"(1 - N.N^dag)_ee\"\>", "\[Rule]", 
    "1.0000001937626735`*^-9"}]}], "}"}]], "Output",
 CellChangeTimes->{4.002147311341568*^9},
 CellLabel->
  "Out[857]=",ExpressionUUID->"40917847-4fa5-844e-b749-8ae6ed7c9fc7"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["19. Neutrino flavour and flavour conversion", "Section",ExpressionUUID->"cdbb10b7-91c9-c641-b686-b4a851379a07"],

Cell["\<\
A neutrino of flavour \[Alpha] produced with energy E is the superposition \
\[CapitalSigma]_i U*_\[Alpha]i |\[Nu]_i\[RightAngleBracket]. In vacuum, with \
\:0127c = 1.973269804 \[Times] 10\:207b\.b9\:2076 GeV m, the amplitude after \
a distance L is A(\[Alpha] \[RightArrow] \[Beta]) = \[CapitalSigma]_i U_\
\[Beta]i U*_\[Alpha]i exp(\[Minus]i m_i\.b2 L/(2E)), so\
\>", "Text",ExpressionUUID->"0dd943fb-4713-3046-b2db-f00109a284fa"],

Cell["\<\
      P(\[Alpha] \[RightArrow] \[Beta]) = \[Delta]\[Alpha]\[Beta] \[Minus] 4 \
\[CapitalSigma]_{i>j} Re X_ij sin\.b2\[CapitalDelta]_ij + 2 \
\[CapitalSigma]_{i>j} Im X_ij sin 2\[CapitalDelta]_ij,   X_ij = U*_\[Alpha]i \
U_\[Beta]i U_\[Alpha]j U*_\[Beta]j,   \[CapitalDelta]_ij = \[CapitalDelta]m\
\.b2_ij L/(4E),   \[CapitalDelta]m\.b2_ij = m_i\.b2 \[Minus] m_j\.b2.\
\>", "Text",ExpressionUUID->"b99c97de-e9e0-c845-88cf-9e4ac56bcf28"],

Cell["\<\
In matter of electron density n_e the forward scattering on electrons adds \
V_CC = \[Sqrt]2 G_F n_e to the \[Nu]_e row of the flavour Hamiltonian H = U \
diag(0, \[CapitalDelta]m\.b221, \[CapitalDelta]m\.b231) U\[Dagger]/(2E) + \
diag(V_CC, 0, 0) (V_CC \[RightArrow] \[Minus]V_CC and U \[RightArrow] U* for \
antineutrinos; a common potential drops out). In two flavours the mixing \
angle in matter obeys tan 2\[Theta]_m = sin 2\[Theta]/(cos 2\[Theta] \[Minus] \
2EV/\[CapitalDelta]m\.b2): it is maximal at the MSW resonance 2EV = \
\[CapitalDelta]m\.b2 cos 2\[Theta]. In the Sun (n_e = 245 N_A \
e^{\[Minus]10.54 r/R\[CircleDot]} cm\:207b\.b3) the 8B neutrinos convert \
adiabatically, P_ee = c13\:2074 (1 + cos 2\[Theta]12 cos 2\[Theta]_m(0))/2 + \
s13\:2074; low-energy neutrinos approach the vacuum average c13\:2074(1 \
\[Minus] sin\.b22\[Theta]12/2) + s13\:2074 (at 0.3 MeV the residual matter \
effect at the centre, 2EV/\[CapitalDelta]m\.b221 \[TildeTilde] 0.15, still \
lowers P_ee by about 0.025).\
\>", "Text",ExpressionUUID->"22ee3d8f-f7e3-ac4a-b368-a304fbdbb415"],

Cell[CellGroupData[{

Cell["\<\
hbarcGeVmN = 1.973269804*^-16; NAv = 6.02214076*^23; hbarcEVcm = \
1.973269804*^-5;
phaseF[L_, en_] := 10^-18 L 10^3/(2 en hbarcGeVmN);
pVac[u_, L_, en_] := Abs[Transpose[u.DiagonalMatrix[Exp[-I {0, dm21, dm31} \
phaseF[L, en]]].ConjugateTranspose[u]]]^2;
pD = pVac[uPMNS, 1300., 2.5]; pDbar = pVac[Conjugate[uPMNS], 1300., 2.5];
xFormula[u_, a_, b_, L_, en_] := Boole[a == b] + Sum[With[{xx = \
Conjugate[u[[a, i]]] u[[b, i]] u[[a, j]] Conjugate[u[[b, j]]], dd = {0, dm21, \
dm31}[[i]] - {0, dm21, dm31}[[j]]},
     -4 Re[xx] Sin[dd phaseF[L, en]/2]^2 + 2 Im[xx] Sin[dd phaseF[L, en]]], \
{i, 3}, {j, i - 1}];
check[\"vacuum: P(a->b) doubly stochastic; equals delta - 4 Sum Re X sin^2 \
Delta + 2 Sum Im X sin 2Delta; CPT P(a->b) == P(bbar->abar)\",
  Norm[Total[pD, {2}] - 1] < 10^-13 && Norm[Total[pD] - 1] < 10^-13 && \
Max[Abs[Table[xFormula[uPMNS, a, b, 1300., 2.5] - pD[[a, b]], {a, 3}, {b, \
3}]]] < 10^-13 &&
  Norm[pD - Transpose[pDbar]] < 10^-13]
vCC[rho_, ye_] := Sqrt[2] gFermi 10^-18 rho ye NAv hbarcEVcm^3;
pMat[u_, L_, en_, rho_, ye_, anti_: False, extra_: {0, 0, 0}] := Module[{uu = \
If[anti, Conjugate[u], u], h, ev, vec},
   h = uu.DiagonalMatrix[{0, dm21, dm31}].ConjugateTranspose[uu]/(2 en 10^9) \
+ If[anti, -1, 1] (DiagonalMatrix[{vCC[rho, ye], 0, 0}] + \
DiagonalMatrix[extra]);
   Abs[Transpose[MatrixExp[-I h L 10^3/(hbarcGeVmN 10^9)]]]^2];
pM = pMat[uPMNS, 1300., 2.5, 2.848, 0.5];
check[\"V_CC(rho Y_e = 1 g/cm^3) == 7.63 x 10^-14 eV; matter evolution doubly \
stochastic; a flavour-universal potential has no effect\",
  Abs[vCC[1., 1.] - 7.63*^-14] < 0.01*^-14 && Norm[Total[pM, {2}] - 1] < \
10^-12 && Norm[pMat[uPMNS, 1300., 2.5, 2.848, 0.5, False, {1*^-13, 1*^-13, \
1*^-13}] - pM] < 10^-11]
th12 = ArcSin[Sqrt[0.307]];
thM[en_, V_] := ArcTan[Cos[2 th12] - 2 en 10^6 V/dm21, Sin[2 th12]]/2;
sinThNum[en_, V_] := Module[{h2 = dm21/(4 en 10^6) {{-Cos[2 th12], Sin[2 \
th12]}, {Sin[2 th12], Cos[2 th12]}} + DiagonalMatrix[{V, 0}], vv},
   vv = Eigensystem[h2][[2]][[Ordering[Eigenvalues[h2]]]]; \
Abs[Normalize[vv[[2]]][[1]]]^2];
eRes = dm21 Cos[2 th12]/(2 5*^-12)/10^6;
check[\"two-flavour MSW: sin^2 theta_m from diagonalization == formula, and \
sin^2 2theta_m == 1 at 2 E V == dm^2 cos 2theta\",
  Max[Table[Abs[sinThNum[e, 5*^-12] - Sin[thM[e, 5*^-12]]^2], {e, {0.5, 2., \
10.}}]] < 10^-12 && Abs[Sin[2 thM[eRes, 5*^-12]]^2 - 1] < 10^-12]
{\"DUNE vacuum P(mu->e), P(mubar->ebar), P(mu->mu)\" -> {pD[[2, 1]], \
pDbar[[2, 1]], pD[[2, 2]]},
 \"DUNE matter P(mu->e), P(mubar->ebar)\" -> {pM[[2, 1]], pMat[uPMNS, 1300., \
2.5, 2.848, 0.5, True][[2, 1]]}}\
\>", "Input",
 CellLabel->
  "In[858]:=",ExpressionUUID->"25b8b3f1-f464-5c41-83ca-32db7391626f"],

Cell[BoxData[
 RowBox[{"\<\"vacuum: P(a->b) doubly stochastic; equals delta - 4 Sum Re X \
sin^2 Delta + 2 Sum Im X sin 2Delta; CPT P(a->b) == P(bbar->abar)\"\>", "\[Rule]",
   "True"}]], "Output",
 CellChangeTimes->{4.002147311341568*^9},
 CellLabel->
  "Out[863]=",ExpressionUUID->"b8e06e60-0b91-7847-b7cd-a1d92a24b201"],

Cell[BoxData[
 RowBox[{"\<\"V_CC(rho Y_e = 1 g/cm^3) == 7.63 x 10^-14 eV; matter evolution \
doubly stochastic; a flavour-universal potential has no effect\"\>", "\[Rule]",
   "True"}]], "Output",
 CellChangeTimes->{4.002147311341568*^9},
 CellLabel->
  "Out[867]=",ExpressionUUID->"39634309-18d8-474f-82a2-faf3efbe55b6"],

Cell[BoxData[
 RowBox[{"\<\"two-flavour MSW: sin^2 theta_m from diagonalization == formula, \
and sin^2 2theta_m == 1 at 2 E V == dm^2 cos 2theta\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002147311341568*^9},
 CellLabel->
  "Out[872]=",ExpressionUUID->"0140241d-4d9a-5144-b623-904bb529d669"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"DUNE vacuum P(mu->e), P(mubar->ebar), P(mu->mu)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "0.04883685296656591`", ",", "0.0501985103457476`", ",", 
      "0.01281313918934762`"}], "}"}]}], ",", 
   RowBox[{"\<\"DUNE matter P(mu->e), P(mubar->ebar)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.07232693782692833`", ",", "0.029191799469459427`"}], 
     "}"}]}]}], "}"}]], "Output",
 CellChangeTimes->{4.002147311341568*^9},
 CellLabel->
  "Out[873]=",ExpressionUUID->"aa220da0-ccb6-1144-8929-c5775d6dfb57"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
rSun = 6.957*^8; s13sq = 0.02195; c13sq = 1 - s13sq;
vSun[r_] := Sqrt[2] gFermi 10^-18 245 NAv Exp[-10.54 r/rSun] hbarcEVcm^3;
peeSunNum[en_] := Module[{k = dm21/(4 en 10^6), sol, y, ps},
   sol = NDSolveValue[{y'[r] == -I/(hbarcGeVmN 10^9) ({{-k Cos[2 th12] + \
vSun[r] c13sq/2, k Sin[2 th12]}, {k Sin[2 th12], k Cos[2 th12] - vSun[r] \
c13sq/2}}.y[r]),
      y[0] == {1., 0.}}, y[rSun], {r, 0, rSun}, MaxSteps -> Infinity, \
PrecisionGoal -> 9, AccuracyGoal -> 11, Method -> {\"ExplicitRungeKutta\", \
\"DifferenceOrder\" -> 8}];
   ps = Abs[{{Cos[th12], -Sin[th12]}, {Sin[th12], Cos[th12]}}.sol]^2;
   c13sq^2 (ps[[1]] Cos[th12]^2 + ps[[2]] Sin[th12]^2) + s13sq^2];
peeSunAd[en_] := c13sq^2 (1 + Cos[2 th12] Cos[2 ArcTan[Cos[2 th12] - 2 en \
10^6 vSun[0] c13sq/dm21, Sin[2 th12]]/2])/2 + s13sq^2;
sunTab = Table[{e, peeSunNum[e], peeSunAd[e]}, {e, {0.3, 1., 5., 10.}}];
check[\"Sun: numerical P_ee == adiabatic MSW formula to 2 x 10^-3 at 0.3, 1, \
5 and 10 MeV; P_ee(0.3 MeV) within 0.03 of the vacuum average; P_ee falls \
with energy\",
  Max[Abs[sunTab[[All, 2]] - sunTab[[All, 3]]]] < 2*^-3 && Abs[sunTab[[1, 2]] \
- (c13sq^2 (1 - Sin[2 th12]^2/2) + s13sq^2)] < 0.03 &&
  OrderedQ[Reverse[sunTab[[All, 2]]]]]
rhoRes[dm_, th_, en_] := dm Cos[2 th]/(2 en 10^6 vCC[1., 0.5]);
tNu = (4/11)^(1/3) 2.7255; nNu = 3 Zeta[3]/(4 Pi^2) 2 (8.617333262*^-5 \
tNu/hbarcEVcm)^3;
check[\"cosmic neutrino background: T_nu == 1.945 K and n == 112 cm^-3 per \
flavour\", Abs[tNu - 1.945] < 0.001 && Abs[nNu - 112] < 0.5]
pNonU[n_, ms_, L_, en_] := Abs[Transpose[n.DiagonalMatrix[Exp[-I ms^2 \
phaseF[L, en]]].ConjugateTranspose[n]]]^2;
pNU = pNonU[nAct, svL[[1 ;; 3]], 1300., 2.5];
check[\"dirac16complex portal: non-unitary oscillations, Sum_b P(a->b) < 1 \
(zero-distance effect); decoupled limit == three-flavour vacuum result\",
  And @@ Table[Total[pNU[[a]]] < 1, {a, 3}] && Norm[pNonU[uPMNS, N[mNu], \
1300., 2.5] - pD] < 10^-13]
pMP = pMat[uPMNS, 1300., 2.5, 2.848, 0.5, False, {0.2 vCC[2.848, 0.5], 0, 0}];
{\"Sun P_ee {E, numerical, adiabatic}\" -> sunTab, \"SN resonance densities \
H, L (g/cm^3)\" -> {rhoRes[dm31, ArcSin[Sqrt[s13sq]], 20.], rhoRes[dm21, \
th12, 20.]},
 \"T_nu, n_nu\" -> {tNu, nNu}, \"DUNE P(mu->e) with vector portal V_P,e = 0.2 \
V_CC, without\" -> {pMP[[2, 1]], pM[[2, 1]]}}\
\>", "Input",
 CellLabel->
  "In[874]:=",ExpressionUUID->"e2cfe8d4-4c1c-a542-93ee-0970a8845e85"],

Cell[BoxData[
 RowBox[{"\<\"Sun: numerical P_ee == adiabatic MSW formula to 2 x 10^-3 at \
0.3, 1, 5 and 10 MeV; P_ee(0.3 MeV) within 0.03 of the vacuum average; P_ee \
falls with energy\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021473194946632`*^9},
 CellLabel->
  "Out[879]=",ExpressionUUID->"18b40520-c708-d147-8ba8-023a44be5595"],

Cell[BoxData[
 RowBox[{"\<\"cosmic neutrino background: T_nu == 1.945 K and n == 112 cm^-3 \
per flavour\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002147319496664*^9},
 CellLabel->
  "Out[882]=",ExpressionUUID->"28950542-de73-f447-a575-b181a3548f5d"],

Cell[BoxData[
 RowBox[{"\<\"dirac16complex portal: non-unitary oscillations, Sum_b P(a->b) \
< 1 (zero-distance effect); decoupled limit == three-flavour vacuum \
result\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021473194976635`*^9},
 CellLabel->
  "Out[885]=",ExpressionUUID->"bca55941-220a-6740-9f24-d493ee11d086"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Sun P_ee {E, numerical, adiabatic}\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "0.3`", ",", "0.5251644425322154`", ",", "0.5251645055880892`"}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "1.`", ",", "0.4584119428047913`", ",", "0.4584122490661078`"}], "}"}],
       ",", 
      RowBox[{"{", 
       RowBox[{
       "5.`", ",", "0.3103377782622033`", ",", "0.3103335111666083`"}], "}"}],
       ",", 
      RowBox[{"{", 
       RowBox[{
       "10.`", ",", "0.29792182695937575`", ",", "0.29791748878645763`"}], 
       "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"SN resonance densities H, L (g/cm^3)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1587.1391520947038`", ",", "18.93974810761938`"}], "}"}]}], ",", 
   RowBox[{"\<\"T_nu, n_nu\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.9453688391750839`", ",", "112.01641316574337`"}], "}"}]}], ",", 
   RowBox[{"\<\"DUNE P(mu->e) with vector portal V_P,e = 0.2 V_CC, \
without\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.07704998293140908`", ",", "0.07232693782692833`"}], "}"}]}]}],
   "}"}]], "Output",
 CellChangeTimes->{4.002147319498665*^9},
 CellLabel->
  "Out[887]=",ExpressionUUID->"3942917e-2a19-8e44-a8fe-64a72f49602c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["20. The coupled field equations: every interaction", "Section",ExpressionUUID->"2ef5daf7-b83a-d543-9488-1f041b3d06b5"],

Cell[TextData[{
 StyleBox["About sections 20\[Dash]23. ",
  FontWeight->"Bold"],
 "Sections 20\[Dash]23 were appended on 27 October 2026. The notebook as it \
was before (sections 0\[Dash]20, evaluated; section 20 was then the summary \
of all checks) is kept in the workspace as \
backups/7+1_2026-10-27_before_coupled.nb (excluded from the repository by \
.gitignore). Section 20 writes the complete action of the model, interaction \
by interaction, derives the coupled field equations and the \
energy\[Dash]momentum tensor of every sector, and reduces them to the \
homogeneous cosmological equations. Sections 21\[Dash]23 solve the coupled \
equations in the three gravity regimes of the model: the PRIMORDIAL regime \
(section 21: near x0 = 0 the higher Lovelock terms dominate; inside it the \
cubic, Gauss\[Dash]Bonnet and Einstein terms take over one after another), \
the MODERN regime (section 22: the auxiliary space x4 \[Ellipsis] x7 is held \
fixed by its stabilizing potential and gravity on the brane is \
four-dimensional Einstein gravity), and the FAR FUTURE (section 23: de Sitter \
expansion of ordinary space). In each regime the solution is given in closed \
form (exact where possible, asymptotic otherwise), and every closed form is \
compared with a high-accuracy numerical solution of the full equations; the \
size of every interaction in every regime is listed in section 23.3."
}], "Text",ExpressionUUID->"ee54e6cd-37bd-b943-806c-30913bf7ae05"],

Cell[TextData[{
 StyleBox["Conventions (as in sections 11\[Dash]19). ",
  FontWeight->"Bold"],
 "\:0127 = c = 1; coordinates X = {x0, \[Ellipsis], x7}: x0 is time (the unit \
e0 = 1 of the octonions), x1, x2, x3 ordinary space, x4 \[Ellipsis] x7 the \
four auxiliary space-like coordinates. \[Eta]17 = diag(+1, \[Minus]1, \
\[Ellipsis], \[Minus]1) is simply the squares of the octonion basis (e0\.b2 = \
+1, e_i\.b2 = \[Minus]1); in xAct the spacetime is declared with the \
signature list {7, 1, 0}: seven space-like and one time-like dimension. \
Curvature conventions, the Lovelock tensors E^(k) and densities L_k are those \
of sections 11\[Dash]12; \[Kappa] = 8\[Pi]G8."
}], "Text",ExpressionUUID->"d8bb9078-1d38-9643-862a-f1d68e9efa57"],

Cell[CellGroupData[{

Cell["20.1 The action, term by term", "Subsection",ExpressionUUID->"abd9580b-f5cb-f644-b522-3afa27a42e24"],

Cell["\<\
The total action is the sum of the following terms (\[Sqrt]|g| d\:2078X is \
the volume element of the bulk, \[Sqrt]|h| d\:2074x that of the world brane W \
= {x4 = \[Ellipsis] = x7 = 0}, h_\[Mu]\[Nu] = g_\[Mu]\[Nu](x, y = 0) its \
induced metric; \[Psi] is dirac16complex, \[Psi]bar = \[Psi]\[Dagger] \
\[CapitalGamma]17[0]):\
\>", "Text",ExpressionUUID->"a4608bbb-2669-e843-a4db-2aa0745f3036"],

Cell["\<\
Gravity, k = 0 (cosmological term):  S_0 = \[Minus](1/(2\[Kappa])) \
\[Integral] d\:2078X \[Sqrt]|g| \[Alpha]_0,  \[Alpha]_0 = 2\[CapitalLambda] (\
\[CapitalLambda] the bulk cosmological constant).\
\>", "Item",ExpressionUUID->"1bf404a0-dc64-5440-8630-dad4ac7f5999"],

Cell["\<\
Gravity, k = 1 (Einstein\[Dash]Hilbert):  S_1 = \[Minus](1/(2\[Kappa])) \
\[Integral] d\:2078X \[Sqrt]|g| R.\
\>", "Item",ExpressionUUID->"705d1c5b-f725-9e4a-a18c-b81e3f41c043"],

Cell["\<\
Gravity, k = 2 (Gauss\[Dash]Bonnet):  S_2 = \[Minus](\[Alpha]_2/(2\[Kappa])) \
\[Integral] d\:2078X \[Sqrt]|g| (R\.b2 \[Minus] 4 R_\[Mu]\[Nu] R^\[Mu]\[Nu] + \
R_\[Mu]\[Nu]\[Rho]\[Sigma] R^\[Mu]\[Nu]\[Rho]\[Sigma]).\
\>", "Item",ExpressionUUID->"e2a41fbc-9360-9b4a-8ab6-32ef74b32073"],

Cell["\<\
Gravity, k = 3 (cubic Lovelock):  S_3 = \[Minus](\[Alpha]_3/(2\[Kappa])) \
\[Integral] d\:2078X \[Sqrt]|g| L_3,  L_3 = R\.b3 \[Minus] 12 R R_\[Mu]\[Nu] \
R^\[Mu]\[Nu] + 16 R^\[Mu]_\[Nu] R^\[Nu]_\[Rho] R^\[Rho]_\[Mu] + 24 R^\[Mu]\
\[Rho] R^\[Nu]\[Sigma] R_\[Mu]\[Nu]\[Rho]\[Sigma] + 3 R R_\[Mu]\[Nu]\[Rho]\
\[Sigma] R^\[Mu]\[Nu]\[Rho]\[Sigma] \[Minus] 24 R^\[Mu]\[Nu] R_\[Mu]^\[Rho]\
\[Sigma]\[Tau] R_\[Nu]\[Rho]\[Sigma]\[Tau] + 4 R^\[Mu]\[Nu]_\[Rho]\[Sigma] R^\
\[Rho]\[Sigma]_\[Lambda]\[Tau] R^\[Lambda]\[Tau]_\[Mu]\[Nu] \[Minus] 8 \
R_\[Mu]^\[Rho]_\[Nu]^\[Sigma] R_\[Rho]^\[Lambda]_\[Sigma]^\[Tau] R_\[Lambda]^\
\[Mu]_\[Tau]^\[Nu] (= (1/8) \[Delta]^{\[Alpha]1\[Beta]1\[Alpha]2\[Beta]2\
\[Alpha]3\[Beta]3}_{\[Gamma]1\[Delta]1\[Gamma]2\[Delta]2\[Gamma]3\[Delta]3} \
R^{\[Gamma]1\[Delta]1}_{\[Alpha]1\[Beta]1} R^{\[Gamma]2\[Delta]2}_{\[Alpha]2\
\[Beta]2} R^{\[Gamma]3\[Delta]3}_{\[Alpha]3\[Beta]3}, section 12; the \
invariant form is checked below). The quartic term would be the Euler \
density, a total derivative in eight dimensions.\
\>", "Item",ExpressionUUID->"b099d40d-7c59-6942-ab9e-8b8f39c30c6c"],

Cell["\<\
dirac16complex and its coupling to gravity:  S_\[Psi] = \[Integral] d\:2078X \
\[Sqrt]|g| \[Psi]bar i \[CapitalGamma]^\[Mu](X) (\[PartialD]_\[Mu] + \
\[CapitalOmega]_\[Mu]) \[Psi], with the frame matrices \[CapitalGamma]^\[Mu] \
= e_A^\[Mu] \[CapitalGamma]17up[A] and the spin connection \[CapitalOmega]_\
\[Mu] = (1/4) \[Omega]_\[Mu]AB \[CapitalGamma]17up[A].\[CapitalGamma]17up[B] \
of section 13. Expanded about flat space (g_\[Mu]\[Nu] = \[Eta]17_\[Mu]\[Nu] \
+ h_\[Mu]\[Nu]) this is the graviton vertex \[Minus](1/2) h_\[Mu]\[Nu] T_\
\[Psi]^\[Mu]\[Nu] + O(h\.b2).\
\>", "Item",ExpressionUUID->"49198317-5242-6b44-b37f-38db1c0b73db"],

Cell["The mass of dirac16complex:  S_m = \[Minus]\[Integral] d\:2078X \
\[Sqrt]|g| m \[Psi]bar \[Psi].", "Item",ExpressionUUID->"bb7718ab-09d2-664f-\
8a08-136b5f8d2e76"],

Cell["\<\
The nine self-couplings of dirac16complex (section 15):  S_self = \
\[Minus](1/2) \[CapitalSigma]_{r=0}^{8} g_r \[Integral] d\:2078X \[Sqrt]|g| \
\[CapitalSigma]_{|K|=r} \[Eta]_K (\[Psi]bar \[CapitalTheta]^K \[Psi])\.b2.\
\>", "Item",ExpressionUUID->"5f4059a9-e4b8-9846-b5cf-7ff647053a89"],

Cell["\<\
The stabilizing potential of the auxiliary space:  S_U = \[Minus]\[Integral] \
d\:2078X \[Sqrt]|g| U(b), a function of the proper size b of the auxiliary \
torus (b\:2078 = det(\[Minus]g_kl), k, l = 4 \[Ellipsis] 7). Sections 21\
\[Dash]23 use U(b) = U_0 + (K_U/2) (ln(b/b0))\.b2, whose minimum b0 fixes the \
size of the auxiliary space today.\
\>", "Item",ExpressionUUID->"e4909f6f-d319-e64c-85d2-d8392c8b4196"],

Cell["The brane tension:  S_f = \[Minus]\[Integral]_W d\:2074x \[Sqrt]|h| \
f_W.", "Item",ExpressionUUID->"6bd64d44-5065-d947-bfa3-5c2a385e726a"],

Cell["\<\
The Standard Model on the brane (section 17.2):  S_SM = \[Integral]_W \
d\:2074x \[Sqrt]|h| L_SM, with the gauge interactions (vertices gs q\:0304 \
\[Gamma]^\[Mu] T^a q G^a_\[Mu], g f\:0304_L \[Gamma]^\[Mu] (\[Tau]^I/2) f_L \
W^I_\[Mu], g\[Prime] Y f\:0304 \[Gamma]^\[Mu] f B_\[Mu], the cubic and \
quartic self-couplings of G and W in \[Minus](1/4) F\.b2, and the \
Higgs\[Dash]gauge couplings in (D_\[Mu]\[CapitalPhi])\[Dagger](D^\[Mu]\
\[CapitalPhi])), the Higgs potential \[Minus]\[Mu]\.b2 \[CapitalPhi]\[Dagger]\
\[CapitalPhi] \[Minus] \[Lambda] (\[CapitalPhi]\[Dagger]\[CapitalPhi])\.b2, \
and the Yukawa couplings \[Minus][Q\:0304_L Y_u \[CapitalPhi]\:0303 u_R + Q\
\:0304_L Y_d \[CapitalPhi] d_R + L\:0304_L Y_e \[CapitalPhi] e_R + L\:0304_L \
Y_\[Nu] \[CapitalPhi]\:0303 \[Nu]_R + h.c.]. Its fields feel gravity through \
h_\[Mu]\[Nu], the brane tetrad and the brane spin connection.\
\>", "Item",ExpressionUUID->"e4752702-56b2-1a4e-8862-58c234e6fef8"],

Cell["\<\
The three portals between the Standard Model and dirac16complex (section \
18.2):  S_P = \[Integral]_W d\:2074x \[Sqrt]|h| [\[Minus]\[CapitalSigma] y_is \
L\:0304_i \[CapitalPhi]\:0303 P_R \[Psi]_s + h.c. \[Minus] G_P^f (\[Psi]bar \
\[CapitalGamma]^\[Mu] \[Psi])|_W (f\:0304 \[Gamma]_\[Mu] f) \[Minus] \
\[Lambda]_P \[CapitalPhi]\[Dagger]\[CapitalPhi] (\[Psi]bar \[Psi])|_W].\
\>", "Item",ExpressionUUID->"92a27b4d-15ba-a34b-9849-a74026291021"],

Cell["\<\
In eight-dimensional form a brane integral is \[Integral]_W d\:2074x \
\[Sqrt]|h| (\[Ellipsis]) = \[Integral] d\:2078X \[Sqrt]|g| \
(\[Delta]\:2074(y)/b\:2074) (\[Ellipsis]). Two checks below make the \
gravitational part explicit: the invariant form of L_3 and of the \
Gauss\[Dash]Bonnet density L_2 is compared EXACTLY with the generalized-delta \
(pair-set) densities lovelockL of section 12.5, on random integer tensors \
with all the algebraic symmetries of the Riemann tensor (an algebraic \
identity needs no metric). Such tensors are sums of products R_abcd = S_ac \
S_bd \[Minus] S_ad S_bc of random symmetric integer matrices S.\
\>", "Text",ExpressionUUID->"670274c2-830f-ba4d-988c-75b328122b29"],

Cell[CellGroupData[{

Cell["\<\
feRandCurv[seed_] := Module[{S, R4 = ConstantArray[0, {8, 8, 8, 8}]}, \
SeedRandom[seed];
   Do[S = RandomInteger[{-3, 3}, {8, 8}]; S = S + Transpose[S];
    R4 += Table[S[[a, c]] S[[b, d]] - S[[a, d]] S[[b, c]], {a, 8}, {b, 8}, \
{c, 8}, {d, 8}], {3}]; R4];
feEtaD = Diagonal[\[Eta]17];
feInvariants[RL_] := Module[{rud4, ric, rs, ricU, ricM, rU, tC, raU, m64},
   rud4 = Table[feEtaD[[a]] feEtaD[[b]] RL[[a, b, c, d]], {a, 8}, {b, 8}, {c, \
8}, {d, 8}];       (* R^{ab}_{cd} *)
   ric = Table[Sum[feEtaD[[a]] RL[[a, c, a, d]], {a, 8}], {c, 8}, {d, 8}];    \
                   (* R_cd = g^ab R_acbd *)
   rs = Sum[feEtaD[[c]] ric[[c, c]], {c, 8}];
   ricU = \[Eta]17.ric.\[Eta]17; ricM = \[Eta]17.ric;
   rU = Table[feEtaD[[a]] feEtaD[[b]] feEtaD[[c]] feEtaD[[d]] RL[[a, b, c, \
d]], {a, 8}, {b, 8}, {c, 8}, {d, 8}];
   tC = Table[feEtaD[[c]] feEtaD[[d]] RL[[a, c, b, d]], {a, 8}, {c, 8}, {b, \
8}, {d, 8}];       (* R_a^c_b^d *)
   raU = Table[feEtaD[[c]] feEtaD[[d]] feEtaD[[e]] RL[[b, c, d, e]], {b, 8}, \
{c, 8}, {d, 8}, {e, 8}];
   m64[t_] := ArrayReshape[t, {64, 64}];
   <|\"R\" -> rs, \"Ric.Ric\" -> Total[ric ricU, 2], \"Riem.Riem\" -> \
Total[rU RL, 4], \"R^3\" -> rs^3, \"R Ric.Ric\" -> rs Total[ric ricU, 2],
     \"Ric^3\" -> Tr[ricM.ricM.ricM], \"Ric Ric Riem\" -> Sum[ricU[[a, c]] \
ricU[[b, d]] RL[[a, b, c, d]], {a, 8}, {b, 8}, {c, 8}, {d, 8}],
     \"R Riem.Riem\" -> rs Total[rU RL, 4], \"Ric Riem Riem\" -> Total[ricU \
(ArrayReshape[RL, {8, 512}].Transpose[ArrayReshape[raU, {8, 512}]]), 2],
     \"Riem^3 pairs\" -> Tr[m64[rud4].m64[rud4].m64[rud4]],
     \"Riem^3 crossed\" -> Tr[#.#.#] &[ArrayReshape[Transpose[tC, {1, 3, 2, \
4}], {64, 64}]]|>];
feL3coef = <|\"R^3\" -> 1, \"R Ric.Ric\" -> -12, \"Ric^3\" -> 16, \"Ric Ric \
Riem\" -> 24, \"R Riem.Riem\" -> 3, \"Ric Riem Riem\" -> -24, \"Riem^3 \
pairs\" -> 4, \"Riem^3 crossed\" -> -8|>;
feL3test = Table[With[{RL = feRandCurv[seed]}, Module[{inv = \
feInvariants[RL], ra},
     ra = rudAssoc[Table[feEtaD[[a]] feEtaD[[b]] RL[[a, b, c, d]], {a, 8}, \
{b, 8}, {c, 8}, {d, 8}]];
     {lovelockL[ra, 3], Total[KeyValueMap[#2 inv[#1] &, feL3coef]], \
lovelockL[ra, 2], inv[\"R\"]^2 - 4 inv[\"Ric.Ric\"] + inv[\"Riem.Riem\"]}]], \
{seed, {3108, 2710, 1977, 88}}];
check[\"cubic Lovelock density in invariant form: L_3 == R^3 - 12 R Ric.Ric + \
16 Ric^3 + 24 R^ac R^bd R_abcd + 3 R Riem.Riem - 24 R^ab R_a^cde R_bcde + 4 \
R^ab_cd R^cd_ef R^ef_ab - 8 R_a^c_b^d R_c^e_d^f R_e^a_f^b (exact, four random \
integer algebraic curvature tensors)\",
  AllTrue[feL3test, #[[1]] == #[[2]] &]]
check[\"Gauss-Bonnet density in invariant form: L_2 == R^2 - 4 Ric.Ric + \
Riem.Riem (the same tensors, exact)\", AllTrue[feL3test, #[[3]] == #[[4]] &]]
{\"L_3 (pair-set) and the invariant form for the four tensors\" -> \
feL3test[[All, 1 ;; 2]]}\
\>", "Input",
 CellLabel->
  "In[888]:=",ExpressionUUID->"8bf8c6c3-bd40-ff41-ac04-762ee0e8ce4b"],

Cell[BoxData[
 RowBox[{"\<\"cubic Lovelock density in invariant form: L_3 == R^3 - 12 R \
Ric.Ric + 16 Ric^3 + 24 R^ac R^bd R_abcd + 3 R Riem.Riem - 24 R^ab R_a^cde \
R_bcde + 4 R^ab_cd R^cd_ef R^ef_ab - 8 R_a^c_b^d R_c^e_d^f R_e^a_f^b (exact, \
four random integer algebraic curvature tensors)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002147320401188*^9},
 CellLabel->
  "Out[893]=",ExpressionUUID->"61d9bb9c-649e-574e-81f2-813b9d60fdb2"],

Cell[BoxData[
 RowBox[{"\<\"Gauss-Bonnet density in invariant form: L_2 == R^2 - 4 Ric.Ric \
+ Riem.Riem (the same tensors, exact)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021473204033356`*^9},
 CellLabel->
  "Out[894]=",ExpressionUUID->"376c1093-9bd2-c94f-aa32-7c7627408817"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"L_3 (pair-set) and the invariant form for the four \
tensors\"\>", "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1015595040", ",", "1015595040"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"747514608", ",", "747514608"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1356905664", ",", "1356905664"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"501923088", ",", "501923088"}], "}"}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{4.0021473204043884`*^9},
 CellLabel->
  "Out[895]=",ExpressionUUID->"9c4dd5ac-71cd-c64a-a941-4475eca28f49"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
20.2 The coupled field equations and the energy\[Dash]momentum tensors\
\>", "Subsection",ExpressionUUID->"4296195e-bd20-8f42-90f9-5004fe99ef98"],

Cell["\<\
Varying the action gives the coupled field equations of all fields:\
\>", "Text",ExpressionUUID->"c9e055c5-f96a-ba49-b118-49fe092199da"],

Cell["\<\
      \[CapitalSigma]_{k=0}^{3} \[Alpha]_k E^(k)\[Mu]_\[Nu] = \[Kappa] [T_\
\[Psi] + T_U + (\[Delta]\:2074(y)/b\:2074) (T_f + T_SM + T_P)]^\[Mu]_\[Nu]    \
            (gravity, E^(0) = \[Minus]\[Delta]/2, \[Alpha]_1 = 1),\
\>", "Text",ExpressionUUID->"98cd72da-4d4d-ae46-91ac-c1ea0689d8b2"],

Cell["\<\
      (i \[CapitalGamma]^\[Mu] D_\[Mu] \[Minus] m) \[Psi] \[Minus] \
\[CapitalSigma]_r g_r \[CapitalSigma]_{|K|=r} (\[Psi]bar \[CapitalTheta]_K \
\[Psi]) \[CapitalTheta]^K \[Psi] = (\[Delta]\:2074(y)/b\:2074) [\
\[CapitalSigma] y*_is (\[CapitalPhi]\:0303\[Dagger] L_i) \[CircleTimes] \
(portal spinor s) + G_P^f (f\:0304\[Gamma]_\[Mu] f) \[CapitalGamma]^\[Mu] \
\[Psi] + \[Lambda]_P \[CapitalPhi]\[Dagger]\[CapitalPhi] \[Psi]]   \
(dirac16complex),\
\>", "Text",ExpressionUUID->"50dfdddf-4c12-f543-963f-7befe0d039d5"],

Cell["\<\
      \[Del]_\[Mu] F^a\[Mu]\[Nu] = (gauge currents) + (portal currents), D_\
\[Mu]D^\[Mu]\[CapitalPhi] + \[Mu]\.b2\[CapitalPhi] + 2\[Lambda](\[CapitalPhi]\
\[Dagger]\[CapitalPhi])\[CapitalPhi] + (Yukawa terms) + \[Lambda]_P \
(\[Psi]bar \[Psi])|_W \[CapitalPhi] = 0, i \[Gamma]^\[Mu] D_\[Mu] f = (Yukawa \
masses) + G_P^f (\[Psi]bar \[CapitalGamma]_\[Mu] \[Psi])|_W \[Gamma]^\[Mu] f  \
 (Standard Model on W).\
\>", "Text",ExpressionUUID->"53f4fe45-06af-5b4f-8d5c-f1f75107ed09"],

Cell[TextData[{
 "Every energy\[Dash]momentum tensor is T_\[Mu]\[Nu] = (2/\[Sqrt]|g|) \
\[Delta]S/\[Delta]g^\[Mu]\[Nu] (sections 12 and 16: \[Delta]S_matter = (1/2) \
\[Integral] \[Sqrt]|g| T_\[Mu]\[Nu] \[Delta]g^\[Mu]\[Nu], T^0_0 = \
\[Epsilon]). For the homogeneous cosmological metric ds\.b2 = n\.b2 dx0\.b2 \
\[Minus] a\.b2 d",
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "63d39b89-c8e0-7640-9d9c-cd88a9218be8"],
 "\.b2 \[Minus] b\.b2 d",
 Cell[BoxData[
  FormBox[
   OverscriptBox["y", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "695be9b0-cb74-e64b-a0fa-4edc82929da2"],
 "\.b2 every source is diag(\[Epsilon], \[Minus]pa, \[Minus]pa, \[Minus]pa, \
\[Minus]pb, \[Ellipsis], \[Minus]pb). For matter whose comoving energy \
depends only on the scale factors, W(a, b) = a\.b3 b\:2074 \[Epsilon] (at \
fixed occupation numbers), the action is \[Minus]\[Integral] n W dx0 and"
}], "Text",ExpressionUUID->"b4cd77ad-c7cf-5c45-aaad-7d8e43c61ea4"],

Cell["\<\
      \[Epsilon] = W/(a\.b3 b\:2074),    pa = \[Minus](\[PartialD]W/\
\[PartialD]a)/(3 a\.b2 b\:2074),    pb = \
\[Minus](\[PartialD]W/\[PartialD]b)/(4 a\.b3 b\.b3),\
\>", "Text",ExpressionUUID->"46df1b4c-7488-d242-9b87-ffc6a69cf8ed"],

Cell["\<\
which gives: the stabilizing potential (W = a\.b3b\:2074 U): \[Epsilon] = U, \
pa = \[Minus]U, pb = \[Minus]U \[Minus] (b/4) U\[Prime](b); the brane tension \
smeared over the torus (\[Delta]\:2074(y) \[RightArrow] 1/Lc\:2074, V\[UpTee] \
= b\:2074 Lc\:2074): \[Epsilon] = f_W/V\[UpTee], pa = \[Minus]f_W/V\[UpTee], \
pb = 0; a brane fluid with \[Rho]_4 \[Proportional] a^(\[Minus]3(1+w)): \
\[Epsilon] = \[Rho]_4/V\[UpTee], pa = w \[Epsilon], pb = 0; a massless \
dirac16complex particle of comoving momentum (k_a, k_b): \[Epsilon]V = \
\[Omega] = \[Sqrt](k_a\.b2/a\.b2 + k_b\.b2/b\.b2), paV = k_a\.b2/(3a\.b2\
\[Omega]), pbV = k_b\.b2/(4b\.b2\[Omega]). Each such source is conserved, \
\[Epsilon]\[Prime] + 3Ha(\[Epsilon] + pa) + 4Hb(\[Epsilon] + pb) = 0, and the \
minisuperspace variation of \[Minus](1/(2\[Kappa])) \[Integral] n \
a\.b3b\:2074 \[CapitalSigma] \[Alpha]_k L_k \[Minus] \[Integral] n W (with \
the identities of section 12.6) gives exactly the three cosmological field \
equations\
\>", "Text",ExpressionUUID->"e1306843-2208-d740-b781-c8527e76f3d4"],

Cell["\<\
      \[CapitalSigma]_k \[Alpha]_k E^(k)0_0 = \[Kappa] \[Epsilon],    \
\[CapitalSigma]_k \[Alpha]_k E^(k)1_1 = \[Minus]\[Kappa] pa,    \
\[CapitalSigma]_k \[Alpha]_k E^(k)4_4 = \[Minus]\[Kappa] pb.\
\>", "Text",ExpressionUUID->"8073f7be-7455-9a44-a651-e8702396a5c4"],

Cell[CellGroupData[{

Cell["\<\
feW = Function[{aa, rIIIbb}, wW[aa, rIIIbb]];
feStress[W_] := Simplify[{W[aS, bS]/(aS^3 bS^4), -D[W[aS, bS], aS]/(3 aS^2 \
bS^4), -D[W[aS, bS], bS]/(4 aS^3 bS^3)}];
check[\"stabilizing potential: W = a^3 b^4 U(b) gives eps = U, pa = -U, pb = \
-U - (b/4) U'(b)\",
  Simplify[feStress[Function[{aa, rIIIbb}, aa^3 rIIIbb^4 uPot[rIIIbb]]] - \
{uPot[bS], -uPot[bS], -uPot[bS] - bS uPot'[bS]/4}] === {0, 0, 0}]
check[\"brane tension smeared over the torus (V_perp = b^4 Lc^4): eps = \
f_W/V_perp, pa = -f_W/V_perp, pb = 0\",
  Simplify[feStress[Function[{aa, rIIIbb}, aa^3 fWb/lcT^4]] - {fWb/(bS^4 \
lcT^4), -fWb/(bS^4 lcT^4), 0}] === {0, 0, 0}]
check[\"brane fluid rho_4 = N a^(-3(1+w)), smeared: eps = rho_4/V_perp, pa = \
w eps, pb = 0\",
  Simplify[feStress[Function[{aa, rIIIbb}, aa^3 nW aa^(-3 (1 + wW0))/lcT^4]] \
- {nW aS^(-3 (1 + wW0))/(bS^4 lcT^4), wW0 nW aS^(-3 (1 + wW0))/(bS^4 lcT^4), \
0}] === {0, 0, 0}]
check[\"massless dirac16complex particle (comoving momentum (k_a, k_b)): eps \
V = omega, pa V = k_a^2/(3 a^2 omega), pb V = k_b^2/(4 b^2 omega)\",
  With[{st = feStress[Function[{aa, rIIIbb}, Sqrt[kaP^2/aa^2 + \
kbP^2/rIIIbb^2]]], om = Sqrt[kaP^2/aS^2 + kbP^2/bS^2]},
   Simplify[st aS^3 bS^4 - {om, kaP^2/(3 aS^2 om), kbP^2/(4 bS^2 om)}, aS > 0 \
&& bS > 0 && kaP > 0 && kbP > 0] === {0, 0, 0}]]
consW = With[{e = wW[a3[x0], b4[x0]]/(a3[x0]^3 b4[x0]^4), pa = \
-(Derivative[1, 0][wW][a3[x0], b4[x0]])/(3 a3[x0]^2 b4[x0]^4),
     pb = -(Derivative[0, 1][wW][a3[x0], b4[x0]])/(4 a3[x0]^3 b4[x0]^3)},
   D[e, x0] + 3 a3'[x0]/a3[x0] (e + pa) + 4 b4'[x0]/b4[x0] (e + pb)];
check[\"every such source is conserved: eps' + 3Ha(eps + pa) + 4Hb(eps + pb) \
== 0 for arbitrary W(a, b), a(x0), b(x0)\", Simplify[consW] === 0]
feELn = -(1/(2 kapS)) (-2 aS^3 bS^4 s00) - wW[aS, bS]; feELa = -(1/(2 kapS)) \
(-6 aS^2 bS^4 s11) - D[wW[aS, bS], aS];
feELb = -(1/(2 kapS)) (-8 aS^3 bS^3 s44) - D[wW[aS, bS], bS];
check[\"minisuperspace: EL_n == (a^3 b^4/kappa)(S00 - kappa eps), EL_a == (3 \
a^2 b^4/kappa)(S11 + kappa pa), EL_b == (4 a^3 b^3/kappa)(S44 + kappa pb) \
with S = Sum alpha_k E^(k) (identities of section 12.6)\",
  With[{st = feStress[Function[{aa, rIIIbb}, wW[aa, rIIIbb]]]},
   Simplify[{feELn - aS^3 bS^4/kapS (s00 - kapS st[[1]]), feELa - 3 aS^2 \
bS^4/kapS (s11 + kapS st[[2]]), feELb - 4 aS^3 bS^3/kapS (s44 + kapS \
st[[3]])}] === {0, 0, 0}]]\
\>", "Input",
 CellLabel->
  "In[896]:=",ExpressionUUID->"0b140032-a122-c94b-8d87-7f347e450e1c"],

Cell[BoxData[
 RowBox[{"\<\"stabilizing potential: W = a^3 b^4 U(b) gives eps = U, pa = -U, \
pb = -U - (b/4) U'(b)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021473204130974`*^9},
 CellLabel->
  "Out[898]=",ExpressionUUID->"09e9978d-ba1b-b34e-9dd6-e76c8b18d5dd"],

Cell[BoxData[
 RowBox[{"\<\"brane tension smeared over the torus (V_perp = b^4 Lc^4): eps = \
f_W/V_perp, pa = -f_W/V_perp, pb = 0\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021473204151*^9},
 CellLabel->
  "Out[899]=",ExpressionUUID->"fbde83bd-05dd-354b-be03-8d5e5ec98417"],

Cell[BoxData[
 RowBox[{"\<\"brane fluid rho_4 = N a^(-3(1+w)), smeared: eps = rho_4/V_perp, \
pa = w eps, pb = 0\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021473204171047`*^9},
 CellLabel->
  "Out[900]=",ExpressionUUID->"8182d122-a223-9640-a9ca-e1130aa10ab0"],

Cell[BoxData[
 RowBox[{"\<\"massless dirac16complex particle (comoving momentum (k_a, \
k_b)): eps V = omega, pa V = k_a^2/(3 a^2 omega), pb V = k_b^2/(4 b^2 \
omega)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002147320420328*^9},
 CellLabel->
  "Out[901]=",ExpressionUUID->"9d7e50a1-f4ad-ab44-9f8c-3159a556ead5"],

Cell[BoxData[
 RowBox[{"\<\"every such source is conserved: eps' + 3Ha(eps + pa) + 4Hb(eps \
+ pb) == 0 for arbitrary W(a, b), a(x0), b(x0)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0021473204223347`*^9},
 CellLabel->
  "Out[903]=",ExpressionUUID->"c7842a28-f615-e04b-b0a5-6a4f1e020523"],

Cell[BoxData[
 RowBox[{"\<\"minisuperspace: EL_n == (a^3 b^4/kappa)(S00 - kappa eps), EL_a \
== (3 a^2 b^4/kappa)(S11 + kappa pa), EL_b == (4 a^3 b^3/kappa)(S44 + kappa \
pb) with S = Sum alpha_k E^(k) (identities of section 12.6)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0021473204233303`*^9},
 CellLabel->
  "Out[906]=",ExpressionUUID->"32222c6c-80f5-4644-bae8-bc42dcbd9b71"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
20.3 The homogeneous equations, the radion and the four-dimensional constants\
\>", "Subsection",ExpressionUUID->"c395a629-4bb9-6040-807e-1d098473ac31"],

Cell["\<\
With the closed forms of section 12.6 the cosmological field equations are \
(Hubble rates Ha = a\[Prime]/a, Hb = b\[Prime]/b, a prime is d/dx0; the code \
writes eTot[c] = \[CapitalSigma]_k \[Alpha]_k E^(k)c_c \[Minus] \
\[CapitalLambda] with alf[k] = \[Alpha]_k, lamb = \[CapitalLambda]):\
\>", "Text",ExpressionUUID->"07ff088d-0bc9-cf46-9f58-449d7c60eda8"],

Cell["\<\
      00:  3(Ha\.b2 + 4HaHb + 2Hb\.b2) \[Minus] 12\[Alpha]_2 Hb(4Ha\.b3 + \
18Ha\.b2Hb + 12HaHb\.b2 + Hb\.b3) + 360\[Alpha]_3 Ha\.b2Hb\.b3(4Ha + 3Hb) \
\[Minus] \[CapitalLambda] = \[Kappa] \[Epsilon],\
\>", "Text",ExpressionUUID->"be7966ea-0221-0a41-95a4-fb326893986a"],

Cell["\<\
      11:  \[CapitalSigma]_k \[Alpha]_k E^(k)1_1 \[Minus] \[CapitalLambda] = \
\[Minus]\[Kappa] pa,     44:  \[CapitalSigma]_k \[Alpha]_k E^(k)4_4 \[Minus] \
\[CapitalLambda] = \[Minus]\[Kappa] pb,\
\>", "Text",ExpressionUUID->"211379dc-8a9a-054a-a3d1-6dfef8fd7e39"],

Cell["\<\
the 11 and 44 equations being linear in Ha\[Prime] and Hb\[Prime] and the 00 \
equation a constraint. The RADION is the logarithm of the size of the \
auxiliary space, \[Beta] = ln(b/b0), Hb = \[Beta]\[Prime]. In Einstein \
gravity the 11 and 44 equations combined with the constraint give the exact \
radion equation\
\>", "Text",ExpressionUUID->"a6aa6eba-bebf-b746-b504-4c9b71331727"],

Cell["      \[Beta]\[DoublePrime] + 3 Ha \[Beta]\[Prime] + 4 \[Beta]\[Prime]\
\.b2 = \[Kappa] (\[Epsilon]/6 \[Minus] pa/2 + pb/3) + \[CapitalLambda]/3.", \
"Text",ExpressionUUID->"7c5db710-223b-014a-a5a4-dc2d056d0eff"],

Cell["\<\
With U = U_0 + (K_U/2) \[Beta]\.b2 the right-hand side contains \[Minus](\
\[Kappa]K_U/12) \[Beta]: the radion mass is m_r\.b2 = \[Kappa] K_U/12. With \
the auxiliary space static (Hb = Hb\[Prime] = 0) the 00 and 11 equations are \
the Friedmann equations of the brane,\
\>", "Text",ExpressionUUID->"9aaa44a0-c0a0-a74d-a71b-fac838354f99"],

Cell["\<\
      3Ha\.b2 = 8\[Pi]G4 \[Rho]_4 + \[CapitalLambda]4,   Ha\[Prime] = \
\[Minus](\[Kappa]/2)(\[Epsilon] + pa),   8\[Pi]G4 = \[Kappa]/V\[UpTee],   \
\[CapitalLambda]4 = \[CapitalLambda] + \[Kappa] U_0 + \[Kappa] f_W/V\[UpTee],\
\>", "Text",ExpressionUUID->"554d8f1e-6939-8b4f-808e-a6db64bc825c"],

Cell["\<\
and the 44 equation fixes where the radion sits (the Gauss\[Dash]Bonnet term \
enters; the cubic term vanishes for Hb = 0):\
\>", "Text",ExpressionUUID->"c202cfce-9600-4f49-940d-f1a2e042d65a"],

Cell["\<\
      (\[Kappa]/4) b U\[Prime](b) = \[CapitalLambda] + \[Kappa] U + 2\[Kappa] \
f_W/V\[UpTee] + (\[Kappa]/2)(\[Epsilon] \[Minus] 3pa) + \[Kappa] pb \[Minus] \
12 \[Alpha]_2 Ha\.b2 (Ha\[Prime] + Ha\.b2).\
\>", "Text",ExpressionUUID->"88de37ab-c5f8-dd47-a70a-9c3f222c2b92"],

Cell["\<\
Finally the 00 equation in four-dimensional (Einstein-frame) form: with H_E = \
Ha + 2Hb (the expansion rate of a_E = a b\.b2) it reads 3H_E\.b2 = 6\[Beta]\
\[Prime]\.b2 + \[Kappa]\[Epsilon] exactly, i.e. 3 M_Pl\.b2 H_E\.b2 = (1/2) \
\[Phi]\[Prime]\.b2 + \[Rho] with the canonical radion \[Phi] = \[Sqrt]12 M_Pl \
\[Beta]. Brane fields see the metric h = (b0/b)\:2074 g_E, so the radion \
couples to them through L = (\[Phi]/(\[Sqrt]3 M_Pl)) T^\[Mu]_\[Mu] (the trace \
of their energy\[Dash]momentum tensor); this is the coupling through which \
the radion decays (section 22.2).\
\>", "Text",ExpressionUUID->"e4f14f55-a16c-e645-a728-a3543142d9ad"],

Cell[CellGroupData[{

Cell["\<\
feTot[c_] := Expand[eTot[c] /. {alf[1] -> 1}];
feSrc = {epsM + uB, paM - uB, pbM - uB - bUp/4};               (* matter + \
stabilizing potential: eps, pa, pb; uB = U, bUp = b U'(b) *)
feSolE = First[Solve[{(feTot[2] /. {alf[2] -> 0, alf[3] -> 0}) == -kapS \
feSrc[[2]], (feTot[5] /. {alf[2] -> 0, alf[3] -> 0}) == -kapS feSrc[[3]]}, \
{dHa, dHb}]];
feRad = Expand[(dHb /. feSolE) /. Ha^2 -> (kapS feSrc[[1]] + lamb - 12 Ha Hb \
- 6 Hb^2)/3];
check[\"radion equation of Einstein gravity: Hb' + 3 Ha Hb + 4 Hb^2 == kappa \
(eps/6 - pa/2 + pb/3) + Lambda/3 (constraint used)\",
  Simplify[feRad - (-3 Ha Hb - 4 Hb^2 + kapS (feSrc[[1]]/6 - feSrc[[2]]/2 + \
feSrc[[3]]/3) + lamb/3)] === 0]
check[\"radion mass: U = U0 + (K_U/2) beta^2, b U' = K_U beta gives the \
restoring term -(kappa K_U/12) beta, m_r^2 = kappa K_U/12\",
  Simplify[D[(-3 Ha Hb - 4 Hb^2 + kapS (feSrc[[1]]/6 - feSrc[[2]]/2 + \
feSrc[[3]]/3) + lamb/3) /. {uB -> u0B + kU/2 betR^2, bUp -> kU betR, Hb -> \
0}, betR] /. betR -> 0] === -kapS kU/12]
feSt = {epsM + uB + fV, paM - uB - fV, pbM - uB - bUp/4};      (* with the \
smeared brane tension fV = f_W/V_perp *)
feStatic = Solve[{(feTot[1] /. {Hb -> 0}) == kapS feSt[[1]], (feTot[2] /. {Hb \
-> 0, dHb -> 0}) == -kapS feSt[[2]]}, {lamb, dHa}][[1]];
check[\"static auxiliary space: (kappa/4) b U' == Lambda + kappa U + 2 kappa \
f_W/V_perp + (kappa/2)(eps - 3pa) + kappa pb - 12 alpha2 Ha^2 (Ha' + Ha^2)\",
  Simplify[(bUp /. First[Solve[((feTot[5] /. {Hb -> 0, dHb -> 0}) == -kapS \
feSt[[3]]) /. feStatic, bUp]]) -
    (4/kapS (lamb + kapS uB + 2 kapS fV + kapS (epsM - 3 paM)/2 + kapS pbM - \
12 alf[2] Ha^2 (dHa + Ha^2)) /. feStatic)] === 0]
check[\"static auxiliary space: Ha' == -(kappa/2)(eps + pa) and E^(3) does \
not contribute (Hb = 0)\",
  Simplify[(dHa /. feStatic) + kapS (epsM + paM)/2] === 0 && \
FreeQ[Simplify[{feTot[1], feTot[2], feTot[5]} /. {Hb -> 0, dHb -> 0}], alf[3]]]
check[\"brane Friedmann equation: 3 Ha^2 == (kappa/V_perp) rho_4 + Lambda4 \
with Lambda4 = Lambda + kappa U0 + kappa f_W/V_perp, i.e. 8 Pi G4 = \
kappa/V_perp\",
  Simplify[(feTot[1] /. Hb -> 0) - kapS (rho4/vPerpS + u0B + fV) - (3 Ha^2 - \
(kapS/vPerpS) rho4 - (lamb + kapS u0B + kapS fV))] === 0]
check[\"Einstein-frame form of the constraint: 3 (Ha + 2 Hb)^2 == 6 Hb^2 + \
(E^(1)0_0 of section 12.6), i.e. 3 M_Pl^2 H_E^2 == phi'^2/2 + rho with phi = \
Sqrt[12] M_Pl beta\",
  Expand[3 (Ha + 2 Hb)^2 - 6 Hb^2 - toH[ECos[[2, 1, 1]]]] === 0]\
\>", "Input",
 CellLabel->
  "In[907]:=",ExpressionUUID->"e7cfbd63-4614-2f48-a156-92acdb7ec6f8"],

Cell[BoxData[
 RowBox[{"\<\"radion equation of Einstein gravity: Hb' + 3 Ha Hb + 4 Hb^2 == \
kappa (eps/6 - pa/2 + pb/3) + Lambda/3 (constraint used)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0021473204333344`*^9},
 CellLabel->
  "Out[911]=",ExpressionUUID->"0ea3b127-3ca0-1142-b971-c612cb1095c3"],

Cell[BoxData[
 RowBox[{"\<\"radion mass: U = U0 + (K_U/2) beta^2, b U' = K_U beta gives the \
restoring term -(kappa K_U/12) beta, m_r^2 = kappa K_U/12\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002147320434332*^9},
 CellLabel->
  "Out[912]=",ExpressionUUID->"4caf2ac1-1659-1843-8e3f-3ae474e15c78"],

Cell[BoxData[
 RowBox[{"\<\"static auxiliary space: (kappa/4) b U' == Lambda + kappa U + 2 \
kappa f_W/V_perp + (kappa/2)(eps - 3pa) + kappa pb - 12 alpha2 Ha^2 (Ha' + \
Ha^2)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021473204363327`*^9},
 CellLabel->
  "Out[915]=",ExpressionUUID->"495b262c-d731-1241-ae5f-65c3d1dd2239"],

Cell[BoxData[
 RowBox[{"\<\"static auxiliary space: Ha' == -(kappa/2)(eps + pa) and E^(3) \
does not contribute (Hb = 0)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002147320437332*^9},
 CellLabel->
  "Out[916]=",ExpressionUUID->"14c82484-edc9-9f45-834b-0b53e111bdb3"],

Cell[BoxData[
 RowBox[{"\<\"brane Friedmann equation: 3 Ha^2 == (kappa/V_perp) rho_4 + \
Lambda4 with Lambda4 = Lambda + kappa U0 + kappa f_W/V_perp, i.e. 8 Pi G4 = \
kappa/V_perp\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021473204383316`*^9},
 CellLabel->
  "Out[917]=",ExpressionUUID->"41bda6e2-ab50-084f-bedc-69c76e1e4f19"],

Cell[BoxData[
 RowBox[{"\<\"Einstein-frame form of the constraint: 3 (Ha + 2 Hb)^2 == 6 \
Hb^2 + (E^(1)0_0 of section 12.6), i.e. 3 M_Pl^2 H_E^2 == phi'^2/2 + rho with \
phi = Sqrt[12] M_Pl beta\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021473204403343`*^9},
 CellLabel->
  "Out[918]=",ExpressionUUID->"d7110fdd-3cd4-af45-826e-f4a8b0112715"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["21. Regime I: the primordial Lovelock regime (near x0 = 0)", "Section",ExpressionUUID->"0ada64d2-f072-ed4b-9dcc-47e6662de06d"],

Cell[TextData[{
 "Units: the Gauss\[Dash]Bonnet length ",
 StyleBox["\[ScriptL]",
  FontFamily->"Cambria Math"],
 "2 = \[Sqrt]\[Alpha]_2 = 1 (time and length in units of ",
 StyleBox["\[ScriptL]",
  FontFamily->"Cambria Math"],
 "2, Hubble rates in units of 1/",
 StyleBox["\[ScriptL]",
  FontFamily->"Cambria Math"],
 "2), so that the only parameter of the vacuum equations is \[Xi] = \
\[Alpha]_3/\[Alpha]_2\.b2. This section uses \[Xi] = 10\:207b\:2076, which \
separates the three Lovelock regimes clearly; the crossover times scale as \
stated below. \[Tau] = x0 \[Minus] x_s is the time since the singularity x_s. \
\[CapitalLambda] is negligible in this regime (\[CapitalLambda] ",
 StyleBox["\[ScriptL]",
  FontFamily->"Cambria Math"],
 "2\.b2 \[TildeTilde] (H0/M8)\.b2 \[TildeTilde] 10\:207b\:2079\.b2, section \
23.3) and set to 0. If ",
 StyleBox["\[ScriptL]",
  FontFamily->"Cambria Math"],
 "2 = 1/M8 with M8 = 10 TeV, the unit of time is ",
 StyleBox["\[ScriptL]",
  FontFamily->"Cambria Math"],
 "2 = 6.6 \[Times] 10\:207b\.b2\:2079 s."
}], "Text",ExpressionUUID->"2c349af1-afbd-9640-8896-597120f9637a"],

Cell[CellGroupData[{

Cell["\<\
21.1 The exact vacuum solution: an algebraic curve and one quadrature\
\>", "Subsection",ExpressionUUID->"7ac91d14-74cf-604c-9f4d-ea8610622397"],

Cell["\<\
Write the vacuum constraint (the 00 equation with \[Epsilon] = 0) in the \
variables u = Hb/Ha and X = Ha\.b2. Dividing by Ha\.b2 it becomes\
\>", "Text",ExpressionUUID->"66618ce0-6d80-9147-9b94-65f318bf4604"],

Cell["\<\
      P_E(u) + X P_G(u) + \[Xi] X\.b2 P_C(u) = 0,   P_E = 3(2u\.b2 + 4u + 1), \
  P_G = \[Minus]12u(u\.b3 + 12u\.b2 + 18u + 4),   P_C = 360 u\.b3 (3u + 4),\
\>", "Text",ExpressionUUID->"4086f037-ec06-b94e-96a0-03b589b600e6"],

Cell["\<\
the Einstein, Gauss\[Dash]Bonnet and cubic parts. For every u in (u1, 0), u1 \
= \[Minus]1 + 1/\[Sqrt]2, it is a quadratic equation for X with exactly one \
positive root (P_C < 0 and P_E > 0 there), so the vacuum solution is the \
explicit curve\
\>", "Text",ExpressionUUID->"8f08af58-8e2d-d34e-a5e5-8622406df1ed"],

Cell["\<\
      Ha(u) = \[Sqrt]X(u),   Hb(u) = u \[Sqrt]X(u),   X(u) = [P_G + \
\[Sqrt](P_G\.b2 \[Minus] 4\[Xi] P_C P_E)]/(2\[Xi] |P_C|).\
\>", "Text",ExpressionUUID->"3bc3850e-374c-a348-8357-5fbb89e496df"],

Cell["\<\
The evolution moves along this curve (the constraint is preserved, section \
16.3); Ha\[Prime] follows from the 11 and 44 equations, and the time is one \
quadrature, \[Tau](Ha) = \[Integral]_Ha^\[Infinity] dH/F(H) with F = \
\[Minus]Ha\[Prime] > 0. The effective Kasner exponent p_eff = \
\[Minus]Ha\.b2/Ha\[Prime] (= p for a = \[Tau]^p) runs from p1 = (1 + \
2\[Sqrt]2)/7 (u \[RightArrow] u1: Einstein regime, Ha \[RightArrow] 0) \
through about p2 (u near u2, the root of u\.b3 + 12u\.b2 + 18u + 4 in (\
\[Minus]1/3, 0): Gauss\[Dash]Bonnet regime) to 1 (u \[RightArrow] 0: cubic \
regime, Ha \[RightArrow] \[Infinity], Hb \[RightArrow] h0 = \[Minus]\[Sqrt](\
\[Alpha]_2/(30\[Alpha]_3))). The two Kasner solutions are p1 = 1/(3 + 4u1), \
q1 = u1 p1 (3p + 4q = 1) and p2 = 3/(3 + 4u2), q2 = u2 p2 (3p + 4q = 3), the \
same exponents as in section 14.1.\
\>", "Text",ExpressionUUID->"8d798757-1240-f048-b6b9-3063a9af176f"],

Cell[CellGroupData[{

Cell["\<\
rIxi = 10^-6;
rIcon = Expand[Expand[(feTot[1] /. {alf[2] -> 1, alf[3] -> xiS, lamb -> 0, Hb \
-> uS Ha})/Ha^2] /. Ha -> Sqrt[xS]];
{rIpE, rIpG, rIpC} = {Factor[Coefficient[rIcon, xS, 0]], \
Factor[Coefficient[rIcon, xS, 1]], Factor[Coefficient[rIcon, xS, 2]/xiS]};
check[\"vacuum constraint in u = Hb/Ha, X = Ha^2 (alpha2 = 1, alpha3 = xi): \
P_E + X P_G + xi X^2 P_C == 0 with P_E = 3(2u^2 + 4u + 1), P_G = -12u(u^3 + \
12u^2 + 18u + 4), P_C = 360 u^3 (3u + 4)\",
  Expand[rIpE - 3 (2 uS^2 + 4 uS + 1)] === 0 && Expand[rIpG + 12 uS (uS^3 + \
12 uS^2 + 18 uS + 4)] === 0 && Expand[rIpC - 360 uS^3 (3 uS + 4)] === 0 &&
  Expand[rIcon - (rIpE + xS rIpG + xiS xS^2 rIpC)] === 0]
rIpEf[u_] := Evaluate[rIpE /. uS -> u]; rIpGf[u_] := Evaluate[rIpG /. uS -> \
u]; rIpCf[u_] := Evaluate[rIpC /. uS -> u];
rIX[u_, xi_] := (rIpGf[u] + Sqrt[rIpGf[u]^2 - 4 xi rIpCf[u] rIpEf[u]])/(2 xi \
Abs[rIpCf[u]]);
rIu1 = -1 + 1/Sqrt[2]; rIu2 = Root[#^3 + 12 #^2 + 18 # + 4 &, 3];
{rIp1, rIq1, rIp2, rIq2} = {1/(3 + 4 rIu1), rIu1/(3 + 4 rIu1), 3/(3 + 4 \
rIu2), 3 rIu2/(3 + 4 rIu2)};
check[\"Kasner constants: P_E(u1) == 0, p1 == (1 + 2 Sqrt[2])/7, q1 == (2 - 3 \
Sqrt[2])/14; u2 in (-1/3, 0) with P_G(u2) == 0, 3 p2 + 4 q2 == 3\",
  Simplify[rIpEf[rIu1]] == 0 && Simplify[rIp1 - (1 + 2 Sqrt[2])/7] == 0 && \
Simplify[rIq1 - (2 - 3 Sqrt[2])/14] == 0 &&
  -1/3 < N[rIu2] < 0 && RootReduce[rIpGf[rIu2]] == 0 && RootReduce[3 rIp2 + 4 \
rIq2] == 3]
rIdHsol = First[Solve[{feTot[2] == 0, feTot[5] == 0} /. {alf[2] -> 1, alf[3] \
-> xiS, lamb -> 0}, {dHa, dHb}]];
rIdHa[ha_, hb_, xi_] := Evaluate[(dHa /. rIdHsol) /. {Ha -> ha, Hb -> hb, xiS \
-> xi}];
rIdHb[ha_, hb_, xi_] := Evaluate[(dHb /. rIdHsol) /. {Ha -> ha, Hb -> hb, xiS \
-> xi}];
rIpeff[u_?NumericQ, xi_] := With[{h = Sqrt[rIX[u, xi]]}, -h^2/rIdHa[h, u h, \
xi]];
check[\"the explicit curve solves the vacuum constraint: residual < 10^-25 \
(relative) at u = u1 + 10^-6, -0.28, u2, -0.1, -10^-4 (xi = 10^-6, 40 digits)\
\",
  AllTrue[{N[rIu1, 40] + 10^-6, -28/100, N[rIu2, 40], -1/10, -1/10^4}, \
With[{x = rIX[SetPrecision[#, 40], rIxi]},
     Abs[rIpEf[SetPrecision[#, 40]] + x rIpGf[SetPrecision[#, 40]] + rIxi x^2 \
rIpCf[SetPrecision[#, 40]]] < 10^-25 Max[1, x^2]] &]]
rIpeffVals = {rIpeff[N[rIu1, 40] + 10^-10, rIxi], rIpeff[N[rIu2, 40], rIxi], \
rIpeff[-10^-6, rIxi]};
check[\"the effective exponent along the curve: p_eff -> p1 (u -> u1), about \
p2 at u = u2 (within 10^-2), -> 1 (u -> 0)\",
  Abs[rIpeffVals[[1]] - rIp1] < 10^-8 && Abs[rIpeffVals[[2]] - rIp2] < 10^-2 \
&& Abs[rIpeffVals[[3]] - 1] < 10^-5]
{\"u1, u2\" -> N[{rIu1, rIu2}, 16], \"p1, q1, p2, q2\" -> N[{rIp1, rIq1, \
rIp2, rIq2}, 16], \"p_eff at u -> u1, u2, u -> 0\" -> N[rIpeffVals, 12]}\
\>", "Input",
 CellLabel->
  "In[919]:=",ExpressionUUID->"b336e9fd-8195-4b4f-9ef8-a598115bc72a"],

Cell[BoxData[
 RowBox[{"\<\"vacuum constraint in u = Hb/Ha, X = Ha^2 (alpha2 = 1, alpha3 = \
xi): P_E + X P_G + xi X^2 P_C == 0 with P_E = 3(2u^2 + 4u + 1), P_G = \
-12u(u^3 + 12u^2 + 18u + 4), P_C = 360 u^3 (3u + 4)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0021473204493427`*^9},
 CellLabel->
  "Out[922]=",ExpressionUUID->"0cb41170-f034-1742-9d53-00b06d3a9c22"],

Cell[BoxData[
 RowBox[{"\<\"Kasner constants: P_E(u1) == 0, p1 == (1 + 2 Sqrt[2])/7, q1 == \
(2 - 3 Sqrt[2])/14; u2 in (-1/3, 0) with P_G(u2) == 0, 3 p2 + 4 q2 == 3\"\>", 
  "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002147320450428*^9},
 CellLabel->
  "Out[927]=",ExpressionUUID->"53bc89fc-6bf1-734a-8982-6444b8d59858"],

Cell[BoxData[
 RowBox[{"\<\"the explicit curve solves the vacuum constraint: residual < \
10^-25 (relative) at u = u1 + 10^-6, -0.28, u2, -0.1, -10^-4 (xi = 10^-6, 40 \
digits)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002147320455328*^9},
 CellLabel->
  "Out[932]=",ExpressionUUID->"68cb27b4-2848-e842-9db8-0637c58af616"],

Cell[BoxData[
 RowBox[{"\<\"the effective exponent along the curve: p_eff -> p1 (u -> u1), \
about p2 at u = u2 (within 10^-2), -> 1 (u -> 0)\"\>", "\[Rule]", 
