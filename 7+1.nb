Cell[CellGroupData[{

Cell["Non-associativity and a numerical example", "Subsubsection",ExpressionUUID->"20cad887-9a4e-f54c-9ca4-a60ec0a8ea10"],

Cell[CellGroupData[{

Cell["\<\
nonAssociativeTriples = Select[Tuples[Range[0, 7], 3], oAssoc[ev[#[[1]]], \
ev[#[[2]]], ev[#[[3]]]] =!= zero8 &];
check[\"exactly 168 of the 512 ordered basis triples are non-associative (= \
7*6*4: distinct imaginary units not on one Fano line)\",
  Length[nonAssociativeTriples] == 168 && AllTrue[nonAssociativeTriples, \
(Min[#] >= 1 && Length[Union[#]] == 3 && ! MemberQ[fanoLines, Sort[#]]) &]]
check[\"example: (e[1]e[2])e[4] == e[7] but e[1](e[2]e[4]) == -e[7]\",
  toE[oMul[oMul[ev[1], ev[2]], ev[4]]] === e[7] && toE[oMul[ev[1], \
oMul[ev[2], ev[4]]]] === -e[7]]\
\>", "Input",
 CellLabel->
  "In[135]:=",ExpressionUUID->"d2be5433-e30c-574a-9a4f-eef3e963d26f"],

Cell[BoxData[
 RowBox[{"\<\"exactly 168 of the 512 ordered basis triples are \
non-associative (= 7*6*4: distinct imaginary units not on one Fano line)\"\>",
   "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002050911740347*^9},
 CellLabel->
  "Out[136]=",ExpressionUUID->"5950965d-da24-4547-b4e8-ab162f93c1d5"],

Cell[BoxData[
 RowBox[{"\<\"example: (e[1]e[2])e[4] == e[7] but e[1](e[2]e[4]) == \
-e[7]\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020509117472954`*^9},
 CellLabel->
  "Out[137]=",ExpressionUUID->"73ded41f-915d-9649-a110-2ede2f37b42a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
xNum = {1, 2, 0, 0, -1, 0, 0, 3}; yNum = {-2, 0, 1, 0, 0, 1, 0, 0}; zNum = \
{0, 0, 0, 1, 0, 0, 1, 0};
Grid[{{\"x\", toE[xNum]}, {\"y\", toE[yNum]}, {\"z\", toE[zNum]}, {\"x y\", \
toE[oMul[xNum, yNum]]}, {\"y x\", toE[oMul[yNum, xNum]]},
   {\"N(x), N(y), N(x y)\", {oNorm2[xNum], oNorm2[yNum], oNorm2[oMul[xNum, \
yNum]]}}, {\"x^-1\", toE[oInv[xNum]]},
   {\"x x^-1\", toE[oMul[xNum, oInv[xNum]]]}, {\"(x y) z - x (y z)\", \
toE[oAssoc[xNum, yNum, zNum]]}}, Frame -> All, Alignment -> Left]\
\>", "Input",
 CellLabel->
  "In[138]:=",ExpressionUUID->"db0a0273-fb67-cb4b-9047-7b48b7d7cb32"],

