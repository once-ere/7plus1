Cell[CellGroupData[{

Cell["\<\
Grid[Prepend[KeyValueMap[{#1, #2} &, checks], {Style[\"check\", Bold], Style[\
\"result\", Bold]}], Frame -> All, Alignment -> Left]\
\>", "Input",
 CellLabel->
  "In[287]:=",ExpressionUUID->"7632ee32-2082-bd4f-8b8e-f58fd555bbdf"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"check\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"result\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {"\<\"4+4: \[Zeta][7] == diag(-1,-1,-1,-1,1,1,1,1)\"\>", "True"},
    {"\<\"4+4: \[Sigma] == \[Zeta][1].\[Zeta][2].\[Zeta][3]\"\>", "True"},
    {"\<\"4+4: (\[Zeta][A].\[Zeta][B] + \[Zeta][B].\[Zeta][A])/2 == \
-\[Eta]4488[[A+1,B+1]] ID8 (A,B = 1..7)\"\>", "True"},
    {"\<\"4+4: -\[Eta]4488[[A+1,A+1]] \[Zeta][A] == Transpose[\[Zeta][A]] (A \
= 1..7)\"\>", "True"},
    {"\<\"4+4: (\[Tau][A].\[Tau]bar[B] + \[Tau][B].\[Tau]bar[A])/2 == \
\[Eta]4488[[A+1,B+1]] ID8\"\>", "True"},
    {"\<\"4+4: (\[Tau]bar[A].\[Tau][B] + \[Tau]bar[B].\[Tau][A])/2 == \
\[Eta]4488[[A+1,B+1]] ID8\"\>", "True"},
    {"\<\"4+4: \[Tau][1].\[Tau][2]...\[Tau][7] == ID8\"\>", "True"},
    {"\<\"4+4: \[Sigma] == \[Tau][1].\[Tau][2].\[Tau][3] == \
\[Tau][4].\[Tau][5].\[Tau][6].\[Tau][7]\"\>", "True"},
    {"\<\"4+4: \[Sigma] commutes with \[Tau][1..3] and anticommutes with \
\[Tau][4..7]; \[Sigma].\[Sigma] == ID8\"\>", "True"},
    {"\<\"4+4: (T16[A].T16[B] + T16[B].T16[A])/2 == \[Eta]4488[[A+1,B+1]] \
ID16\"\>", "True"},
    {"\<\"4+4: T16[A] real (entries 0, \[PlusMinus]1)\"\>", "True"},
    {"\<\"4+4: T16[8] == diag(-ID8, ID8)\"\>", "True"},
    {"\<\"4+4: \[Sigma]16 == diag(-\[Sigma], \[Sigma])\"\>", "True"},
    {"\<\"4+4: PL44 + PR44 == ID16, PL44.PL44 == PL44, PR44.PR44 == PR44, \
PL44.PR44 == 0\"\>", "True"},
    {"\<\"4+4: uBasis == evecs/Sqrt[2] from Eigensystem[\[Sigma]] (the basis \
of 4+4.nb)\"\>", "True"},
    {"\<\"4+4: unit == (1,0,0,0,1,0,0,0)/Sqrt[2], \[Sigma].unit == unit, \
unit.unit == 1, unit.\[Sigma].unit == 1\"\>", "True"},
    {"\<\"4+4 (In[294]): E44inv[h] == (u.\[Sigma].u) \
Transpose[Table[\[Eta]4488[[B,B]] \[Tau][B-1].u, {B,1,8}]] for h = 1..8\"\>", 
     "True"},
    {"\<\"4+4: gridx44 is identical to the split-octonion table printed by \
4+4.nb\"\>", "True"},
    {"\<\"4+4: LS[A] are signed permutation matrices (constants 0, \
\[PlusMinus]1)\"\>", "True"},
    {"\<\"split: eA[1] is the identity; eA[2..4]^2 == -eA[1]; eA[5..8]^2 == \
+eA[1]\"\>", "True"},
    {"\<\"split: x x\:0304 == N(x) eA[1] with N = \[Eta]4488 (symbolic)\"\>", 
     "True"},
    {"\<\"split: N(xy) == N(x) N(y) (symbolic)\"\>", "True"},
    {"\<\"split: alternative x(xy) == (xx)y and (yx)x == y(xx) \
(symbolic)\"\>", "True"},
    {"\<\"split: (eA[1] + eA[5])(eA[1] - eA[5]) == 0 with both factors \
nonzero: NOT a division algebra\"\>", "True"},
    {"\<\"\[Tau]O[A] (A = 1..7): real, antisymmetric, \[Tau]O[A].\[Tau]O[A] \
== -ID8\"\>", "True"},
    {"\<\"\[Tau]O[A] anticommute: \[Tau]O[A].\[Tau]O[B] == \
-\[Tau]O[B].\[Tau]O[A] (A != B, A,B = 1..7)\"\>", "True"},
    {"\<\"mirror of 4+4: (\[Tau]O[A].\[Tau]Obar[B] + \
\[Tau]O[B].\[Tau]Obar[A])/2 == gO[[A+1,B+1]] ID8\"\>", "True"},
    {"\<\"mirror of 4+4: (\[Tau]Obar[A].\[Tau]O[B] + \
\[Tau]Obar[B].\[Tau]O[A])/2 == gO[[A+1,B+1]] ID8\"\>", "True"},
    {"\<\"mirror of 4+4: \[Tau]O[1].\[Tau]O[2]...\[Tau]O[7] == ID8\"\>", 
     "True"},
    {"\<\"mirror of 4+4: \[Tau]Obar[A] == gO.Transpose[\[Tau]O[A]].gO, as \
\[Tau]bar[A] == \[Sigma].Transpose[\[Tau][A]].\[Sigma]\"\>", "True"},
    {"\<\"\[Tau]O[4..7] are products of three split \[Tau]: \[Tau]O[4] == \
\[Tau][5].\[Tau][6].\[Tau][7], \[Tau]O[5] == -\[Tau][4].\[Tau][6].\[Tau][7], \
\[Tau]O[6] == \[Tau][4].\[Tau][5].\[Tau][7], \[Tau]O[7] == \
-\[Tau][4].\[Tau][5].\[Tau][6]\"\>", "True"},
    {"\<\"\[Sigma].unit == unit, hence \[Tau]O[A].unit == \[Tau][A].unit (A = \
0..7)\"\>", "True"},
    {"\<\"EO is orthogonal: EOinv == Transpose[EO]\"\>", "True"},
    {"\<\"mirror of 4+4.nb In[294]: EOinv == (u.gO.u) \
Transpose[Table[gO[[B,B]] \[Tau]O[B-1].u, {B,1,8}]]\"\>", "True"},
    {"\<\"EO == \[Eta]4488.E44[hUSE]: the two vielbeins differ only by the \
signs of rows 5..8\"\>", "True"},
    {"\<\"gridO equals the octonion table computed independently in \
Python\"\>", "True"},
    {"\<\"LO[A] are signed permutation matrices (all multiplication constants \
are 0, \[PlusMinus]1)\"\>", "True"},
    {"\<\"oMul reproduces gridO on all 64 pairs of basis units\"\>", "True"},
    {"\<\"e[0] is a two-sided identity\"\>", "True"},
    {"\<\"e[i] e[i] == -e[0] (i = 1..7)\"\>", "True"},
    {"\<\"e[i] e[j] == -e[j] e[i] (i != j, i,j = 1..7): non-commutative\"\>", 
     "True"},
    {"\<\"7 Fano lines; every pair of distinct imaginary units lies on \
exactly one line\"\>", "True"},
    {"\<\"each oriented line (a,b,c) is cyclic: e[a]e[b] == e[c], e[b]e[c] == \
e[a], e[c]e[a] == e[b]\"\>", "True"},
    {"\<\"each line spans a quaternion subalgebra: {e[0], e[a], e[b], e[c]} \
closed and associative\"\>", "True"},
    {"\<\"the picture's 7 lines are exactly fanoLines\"\>", "True"},
    {"\<\"left alternative: x(xy) == (xx)y (symbolic)\"\>", "True"},
    {"\<\"right alternative: (yx)x == y(xx) (symbolic)\"\>", "True"},
    {"\<\"flexible: (xy)x == x(yx) (symbolic)\"\>", "True"},
    {"\<\"associator is alternating: [x,y,z] == -[y,x,z] == -[x,z,y] \
(symbolic)\"\>", "True"},
    {"\<\"power associativity: x(xx) == (xx)x (symbolic)\"\>", "True"},
    {"\<\"Moufang: z(x(zy)) == ((zx)z)y, x(z(yz)) == ((xz)y)z, (zx)(yz) == \
(z(xy))z (x, y basis units, z symbolic)\"\>", "True"},
    {"\<\"x x\:0304 == x\:0304 x == N(x) e[0] (symbolic)\"\>", "True"},
    {"\<\"conjugation is an anti-automorphism: conj(xy) == conj(y) conj(x) \
(symbolic)\"\>", "True"},
    {"\<\"Re(x) == (x + x\:0304)/2 == x0\"\>", "True"},
    {"\<\"norm is multiplicative: N(xy) == N(x) N(y) (symbolic; Degen's \
eight-square identity)\"\>", "True"},
    {"\<\"inverse x^-1 = x\:0304/N(x): x x^-1 == x^-1 x == e[0] \
(symbolic)\"\>", "True"},
    {"\<\"every x satisfies x x - 2 Re(x) x + N(x) e[0] == 0, so the \
subalgebra generated by x is \[DoubleStruckCapitalR] or \
\[DoubleStruckCapitalC]\"\>", "True"},
    {"\<\"exactly 168 of the 512 ordered basis triples are non-associative (= \
7*6*4: distinct imaginary units not on one Fano line)\"\>", "True"},
    {"\<\"example: (e[1]e[2])e[4] == e[7] but e[1](e[2]e[4]) == -e[7]\"\>", 
     "True"},
    {"\<\"numerical example: N(x y) == N(x) N(y) == 15*6 == 90 and x x^-1 == \
e[0]\"\>", "True"},
    {"\<\"numerical example: x y != y x and (x y) z != x (y z)\"\>", "True"},
    {"\<\"\[DoubleStruckCapitalH] = span{e[0],e[1],e[2],e[3]} is a subalgebra\
\"\>", "True"},
    {"\<\"\[ScriptL] = e[4] doubles \[DoubleStruckCapitalH]: e[4] e[k] == \
e[4+k] (k = 1,2,3) and e[4] e[4] == -e[0]\"\>", "True"},
    {"\<\"orientation inherited from 4+4.nb: e[1] e[2] == -e[3]\"\>", "True"},
    {"\<\"Cayley-Dickson, \[Gamma] = -1: (ac - d b\:0304, a\:0304 d + c b) \
reproduces the octonion product (symbolic)\"\>", "True"},
    {"\<\"Cayley-Dickson, \[Gamma] = +1: (ac + d b\:0304, a\:0304 d + c b) \
reproduces the SPLIT product of 4+4.nb (symbolic)\"\>", "True"},
    {"\<\"the formula (ac - d\:0304 b, a\:0304 d + c b) of [1A] is NOT \
alternative: x\[CenterDot]x\[CenterDot]y != x(xy) for x = e[0]+e[4], y = e[1]\
\"\>", "True"},
    {"\<\"... and its norm is not multiplicative (symbolic)\"\>", "True"},
    {"\<\"e[A]e[B] (octonion) == s_AB e[A]e[B] (split) for all A, B = \
0..7\"\>", "True"},
    {"\<\"over \[DoubleStruckCapitalC]: \[CurlyPhi](x *split y) == \
\[CurlyPhi](x) *oct \[CurlyPhi](y) (symbolic): split \[CircleTimes] \
\[DoubleStruckCapitalC] \[TildeFullEqual] \[DoubleStruckCapitalO] \
\[CircleTimes] \[DoubleStruckCapitalC]\"\>", "True"},
    {"\<\"the norms correspond: N_oct(\[CurlyPhi](x)) == N_split(x) \
(symbolic)\"\>", "True"},
    {"\<\"Cl(8,0): (T16O[A].T16O[B] + T16O[B].T16O[A])/2 == gO[[A+1,B+1]] \
ID16\"\>", "True"},
    {"\<\"S44 == diag(\[Sigma], \[Sigma])\"\>", "True"},
    {"\<\"T16O from the 4+4 matrices: T16O[A] == T16[A] (A = 0..3), T16O[k] \
== T16[k].S44 (k = 4..7)\"\>", "True"},
    {"\<\"T16O[8] == T16[8] == diag(-ID8, ID8): same chirality matrix and \
same PL44, PR44 as 4+4.nb\"\>", "True"},
    {"\<\"7+1 REAL Clifford relation: \
(\[CapitalGamma]17[A].\[CapitalGamma]17[B] + \[CapitalGamma]17[B].\
\[CapitalGamma]17[A])/2 == \[Eta]17[[A+1,B+1]] ID16 == -\[Eta]71[[A+1,B+1]] \
ID16\"\>", "True"},
    {"\<\"\[CapitalGamma]17[A] are REAL: every entry is 0 or \
\[PlusMinus]1\"\>", "True"},
    {"\<\"block form: \[CapitalGamma]17[0] == {{0,ID8},{ID8,0}}, \
\[CapitalGamma]17[i] == {{\[Tau]O[i],0},{0,\[Tau]Obar[i]}}\"\>", "True"},
    {"\<\"built from the real 4+4 matrices: \[CapitalGamma]17[0] == T16[0], \
\[CapitalGamma]17[i] == T16[0].T16[i] (i = 1,2,3), \[CapitalGamma]17[k] == \
T16[0].T16[k].S44 (k = 4..7)\"\>", "True"},
    {"\<\"\[CapitalGamma]17[0] symmetric, \[CapitalGamma]17[i] antisymmetric, \
so Transpose[\[CapitalGamma]17[A]] == \
\[CapitalGamma]17[0].\[CapitalGamma]17[A].\[CapitalGamma]17[0] (real Dirac \
adjoint)\"\>", "True"},
    {"\<\"the 256 products \[CapitalGamma]17[A1]...\[CapitalGamma]17[Ak] (A1 \
< ... < Ak) are linearly independent: Cl(1,7) \[TildeFullEqual] \
\[DoubleStruckCapitalR](16)\"\>", "True"},
    {"\<\"grades: binomial(8,k) == {1,8,28,56,70,56,28,8,1}, total 256 \
(binomial(8,4) == 70, not 72)\"\>", "True"},
    {"\<\"Tr[product] == 0 for every non-empty product, so Tr[M]/16 is the \
scalar part of M\"\>", "True"},
    {"\<\"irreducible over \[DoubleStruckCapitalR]: only multiples of ID16 \
commute with all \[CapitalGamma]17[A] (Schur; real commutant of dimension \
1)\"\>", "True"},
    {"\<\"universal property: \[CapitalGamma]17(v).\[CapitalGamma]17(v) == \
(v.\[Eta]17.v) ID16 for a symbolic vector v = X\"\>", "True"},
    {"\<\"7+1 COMPLEX Clifford relation, 4+4.nb sign: (\[CapitalGamma]71[A].\
\[CapitalGamma]71[B] + \[CapitalGamma]71[B].\[CapitalGamma]71[A])/2 == \
\[Eta]71[[A+1,B+1]] ID16\"\>", "True"},
    {"\<\"\[CapitalGamma]71[0] == I T16[0] and \[CapitalGamma]71[k] == \
T16O[k] (k = 1..7): only the time component is complex\"\>", "True"},
    {"\<\"S = (ID16 - I \[CapitalGamma]17[0])/Sqrt[2] is unitary and \
\[CapitalGamma]71[A] == S.(I \[CapitalGamma]17[A]).Inverse[S]\"\>", "True"},
    {"\<\"Schur: the intertwiners M with M.Conjugate[\[CapitalGamma]71[A]] == \
\[CapitalGamma]71[A].M form a 1-dimensional space\"\>", "True"},
    {"\<\"... spanned by the volume element \[CapitalGamma]17[8] == \
{{0,-ID8},{ID8,0}}, and \[CapitalGamma]17[8].\[CapitalGamma]17[8] == \
-ID16\"\>", "True"},
    {"\<\"indicator(\[CapitalGamma]71) == -1: Cl(7,1) \[TildeFullEqual] \
\[DoubleStruckCapitalH](8), NO real 16\[Times]16 realization of the \[Eta]71 \
relation\"\>", "True"},
    {"\<\"indicator(\[CapitalGamma]17) == +1: Cl(1,7) \[TildeFullEqual] \
\[DoubleStruckCapitalR](16), real realization exists (\[CapitalGamma]17)\"\>",
      "True"},
    {"\<\"REAL 32\[Times]32 realization of the \[Eta]71 relation: (\
\[CapitalGamma]71R32[A].\[CapitalGamma]71R32[B] + \[CapitalGamma]71R32[B].\
\[CapitalGamma]71R32[A])/2 == \[Eta]71[[A+1,B+1]] ID32\"\>", "True"},
    {"\<\"Qi, Qj, Qk commute with every \[CapitalGamma]71R32[A]; Qi.Qi == \
Qj.Qj == Qk.Qk == -ID32; Qi.Qj == Qk == -Qj.Qi\"\>", "True"},
    {"\<\"the commutant of {\[CapitalGamma]71R32[A]} has dimension exactly 4 \
and is spanned by ID32, Qi, Qj, Qk: it is \[DoubleStruckCapitalH]\"\>", 
     "True"},
    {"\<\"\[CapitalGamma]17[8].\[CapitalGamma]17[8] == -ID16 and \
\[CapitalGamma]17[8] anticommutes with every \[CapitalGamma]17[A]: no real \
chirality in 7+1\"\>", "True"},
    {"\<\"\[CapitalGamma]71[8].\[CapitalGamma]71[8] == -ID16 and \[Chi]71 = \
-I \[CapitalGamma]71[8] == T16O[8] == T16[8] (real, diagonal)\"\>", "True"},
    {"\<\"7+1 chiral projectors in the \[CapitalGamma]71 basis are exactly \
PL44, PR44 of 4+4.nb; \[Chi]71 anticommutes with every \[CapitalGamma]71[A]\"\
\>", "True"},
    {"\<\"complex chiral projectors for \[CapitalGamma]17: PL17 + PR17 == \
ID16, PL17.PL17 == PL17, PL17.PR17 == 0, rank 8 each\"\>", "True"},
    {"\<\"Re(x x) == X.\[Eta]17.X: the octonion square produces the 7+1 \
interval (symbolic)\"\>", "True"},
    {"\<\"octonion basis: \[CapitalGamma]17e[0] == {{0,ID8},{ID8,0}} and \
\[CapitalGamma]17e[i] == {{LO[i],0},{0,-LO[i]}}\"\>", "True"},
    {"\<\"alternativity in action: xImag(xImag \[Psi]) == -|xImag|^2 \[Psi] \
for the imaginary part xImag of x (symbolic)\"\>", "True"},
    {"\<\"T16O(x)^2 == N(x) ID16 (octonion norm) and T16(x)^2 == \
(X.\[Eta]4488.X) ID16 (4+4.nb)\"\>", "True"},
    {"\<\"28 real generators \[CapitalSigma]17[A,B] (A < B), linearly \
independent\"\>", "True"},
    {"\<\"[\[CapitalSigma]17[A,B], \[CapitalGamma]17[K]] == \
\[Eta]17[[B+1,K+1]] \[CapitalGamma]17[A] - \[Eta]17[[A+1,K+1]] \
\[CapitalGamma]17[B]\"\>", "True"},
    {"\<\"so(1,7): [\[CapitalSigma]_AB, \[CapitalSigma]_KL] == \[Eta]_BK \
\[CapitalSigma]_AL - \[Eta]_AK \[CapitalSigma]_BL - \[Eta]_BL \
\[CapitalSigma]_AK + \[Eta]_AL \[CapitalSigma]_BK\"\>", "True"},
    {"\<\"the complex structure J = \[CapitalGamma]17[8] commutes with all \
\[CapitalSigma]17[A,B] (Spin(1,7) acts complex-linearly on \
\[DoubleStruckCapitalR]^16 = \[DoubleStruckCapitalC]^8)\"\>", "True"},
    {"\<\"S(\[Beta]) and R(\[Theta]) are the exponentials: dS/d\[Beta] == \
\[CapitalSigma]17[0,1].S, S(0) == ID16, dR/d\[Theta] == \
\[CapitalSigma]17[4,5].R, R(0) == ID16, and S.Sinv == R.Rinv == ID16\"\>", 
     "True"},
    {"\<\"S(\[Beta]).\[CapitalGamma]17[K].S(\[Beta])^-1 == \[Sum]_B \
\[CapitalLambda]boost[[B+1,K+1]] \[CapitalGamma]17[B]; \[CapitalLambda]boost \
is the boost along x1\"\>", "True"},
    {"\<\"R(\[Theta]).\[CapitalGamma]17[K].R(\[Theta])^-1 == \[Sum]_B \
\[CapitalLambda]rot[[B+1,K+1]] \[CapitalGamma]17[B]; \[CapitalLambda]rot is \
the rotation in the x4-x5 plane\"\>", "True"},
    {"\<\"both \[CapitalLambda] preserve the 7+1 metric: Transpose[\
\[CapitalLambda]].\[Eta]17.\[CapitalLambda] == \[Eta]17\"\>", "True"},
    {"\<\"(\[CapitalGamma]17^A \[PartialD]_A)^2 \[CapitalPsi] == \
(\[PartialD]0^2 - \[PartialD]1^2 - ... - \[PartialD]7^2) \[CapitalPsi] for 16 \
arbitrary functions of x0..x7\"\>", "True"},
    {"\<\"p is on the mass shell (p.\[Eta]17.p == m^2) and pslash.pslash == \
m^2 ID16\"\>", "True"},
    {"\<\"(pslash - m) w == 0 has 8 linearly independent REAL solutions \
w\"\>", "True"},
    {"\<\"\[CapitalPsi] = w Exp[-I p.x] solves (I \[CapitalGamma]17^A \
\[PartialD]_A - m) \[CapitalPsi] == 0\"\>", "True"},
    {"\<\"the matrices anticommuting with every \[CapitalGamma]17[A] are \
exactly the multiples of \[CapitalGamma]17[8], and (c \[CapitalGamma]17[8])^2 \
== -c^2 ID16: no real J with J.J == +ID16\"\>", "True"},
    {"\<\"null momentum k = (1,1,0,0,0,0,0,0): k.\[Eta]17.k == 0, \
kslash.kslash == 0, and kslash.w == 0 has 8 REAL solutions\"\>", "True"},
    {"\<\"\[CapitalPsi] = w Cos[k.x] is a REAL solution of the real massless \
Dirac equation \[CapitalGamma]17^A \[PartialD]_A \[CapitalPsi] == 0\"\>", 
     "True"},
    {"\<\"(\[CapitalGamma]71R32^A \[PartialD]_A)^2 \[CapitalPsi] == -(\
\[PartialD]0^2 - \[PartialD]1^2 - ... - \[PartialD]7^2) \[CapitalPsi] for 32 \
arbitrary functions of x0..x7\"\>", "True"},
    {"\<\"p.\[Eta]71.p == -m^2 and pslash32.pslash32 == -m^2 ID32\"\>", 
     "True"},
    {"\<\"\[CapitalPsi] = w Cos[p.x] + (pslash32.w/m) Sin[p.x], with 32 \
arbitrary REAL constants w, solves the REAL massive equation \
(\[CapitalGamma]71R32^A \[PartialD]_A - m) \[CapitalPsi] == 0\"\>", "True"},
    {"\<\"... and \[CapitalPsi] obeys the Klein-Gordon equation \
(\[PartialD]0^2 - \[PartialD]1^2 - ... - \[PartialD]7^2 + m^2) \[CapitalPsi] \
== 0\"\>", "True"},
    {"\<\"split analogue: Re(x x) of split octonions == X.\[Eta]53.X, and \
\[CapitalGamma]53 realizes Cl(5,3) with REAL 16\[Times]16 matrices\"\>", 
     "True"},
    {"\<\"\[CapitalGamma]08[A] = T16O[8].T16O[A] realizes Cl(0,8) with REAL \
16\[Times]16 matrices\"\>", "True"},
    {"\<\"gens[p] satisfy the Clifford relation of signature (p, 8-p) for p = \
0..8\"\>", "True"},
    {"\<\"classification: \[DoubleStruckCapitalR](16) for \
(8,0),(5,3),(4,4),(1,7),(0,8); \[DoubleStruckCapitalH](8) for \
(7,1),(6,2),(3,5),(2,6)\"\>", "True"},
    {"\<\"every \[DoubleStruckCapitalR](16) case has explicit REAL \
16\[Times]16 generators in this notebook (T16O, \[CapitalGamma]53, T16, \
\[CapitalGamma]17, \[CapitalGamma]08)\"\>", "True"},
    {"\<\"\[DoubleStruckCapitalC](16) cannot occur: its real dimension 2*16^2 \
= 512 differs from 2^8 = 256\"\>", "True"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellChangeTimes->{4.0020494743548527`*^9},
 CellLabel->
  "Out[287]=",ExpressionUUID->"0e3589f6-1967-6240-8361-c0e65e87b210"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
7. The Dirac equation of the quantized 16-component field dirac16complex\
\>", "Section",ExpressionUUID->"7e426d94-5bc3-d84a-85d0-52f65e62ad43"],

Cell[TextData[{
 StyleBox["About sections 7\[Dash]10. ",
  FontWeight->"Bold"],
 "Sections 7\[Dash]10 were appended to this notebook on 26 October 2026. The \
notebook as it was before the addition (sections 0\[Dash]6, evaluated) is \
kept in the workspace as backups/7+1_2026-10-26_before_dirac16complex.nb; \
that folder is excluded from the repository by .gitignore. Section 6 above \
summarizes the checks of sections 1\[Dash]5 (it is evaluated before sections \
7\[Dash]9); section 10 summarizes all checks of sections 1\[Dash]9. The \
repository is now github.com/once-ere/7plus1."
}], "Text",ExpressionUUID->"e09b1257-8435-0249-aa3f-e8a718c18a8c"],

Cell[TextData[{
 StyleBox["Task of sections 7\[Dash]9. ",
  FontWeight->"Bold"],
 "(i) A valid, checked Dirac equation on the real 7+1 spacetime \[LongDash] \
one time coordinate x0 and seven space coordinates x1 \[Ellipsis] x7 \
\[LongDash] for a 16-component quantized fermion field named dirac16complex, \
whose components are complex-valued Grassmann (anticommuting) operators, with \
eight anticommuting REAL 16\[Times]16 Dirac matrices taken from this \
notebook; (ii) the chiral projections that turn the 16-component equation \
into two 8-component equations, coupled when the mass is not zero; (iii) a \
16-component Kohn\[Dash]Sham theory of the self-coupled field (section 8) and \
(iv) its chiral version built with the chiral projections (section 9)."
}], "Text",ExpressionUUID->"7ba97208-514c-e741-aa39-53d126ba797e"],

Cell[TextData[{
 StyleBox["Units and conventions. ",
  FontWeight->"Bold"],
 "\:0127 = c = 1. Coordinates X = {x0, \[Ellipsis], x7} as everywhere in this \
notebook; \[PartialD]_A = \[PartialD]/\[PartialD]xA. Indices A, B = 0 \
\[Ellipsis] 7 are raised and lowered with \[Eta]17 = diag(+1, \[Minus]1, \
\[Ellipsis], \[Minus]1); i, j = 1 \[Ellipsis] 7 are space indices, and \
repeated indices are summed. A space vector such as the momentum is written ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "fd34325d-558a-3846-b9f6-7f69be4042b5"],
 " = (p1, \[Ellipsis], p7), ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "05f545b2-32c0-f141-9019-853f6408bc3d"],
 "\[CenterDot]",
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "6eeca11f-b11c-3f43-ae05-eff809c03caa"],
 " = p1 x1 + \[Ellipsis] + p7 x7. m is the mass (mD in the code, a positive \
symbol); a symbol that has a value elsewhere in this notebook (mass, \[Beta], \
\[Theta]) is never reused with a different meaning."
}], "Text",ExpressionUUID->"131ab926-2795-5142-a44c-bc52e8a04d8a"],

Cell[CellGroupData[{

Cell["7.1 The eight real Dirac matrices and the Dirac \[Alpha], \[Beta]", \
"Subsection",ExpressionUUID->"c7004e6a-2816-3a41-bd1f-7f83610c2690"],

Cell["\<\
The Dirac matrices are the real matrices \[CapitalGamma]17[0], \[Ellipsis], \
\[CapitalGamma]17[7] of section 4.2 (every entry 0 or \[PlusMinus]1):\
\>", "Text",ExpressionUUID->"05e22fe8-fc40-6740-93cd-6273120919dc"],

Cell["\<\
      \[CapitalGamma]17[A].\[CapitalGamma]17[B] + \[CapitalGamma]17[B].\
\[CapitalGamma]17[A] = 2 \[Eta]17[[A+1,B+1]] ID16,   so \[CapitalGamma]17[0]\
\.b2 = +ID16 (time) and \[CapitalGamma]17[i]\.b2 = \[Minus]ID16 (space).\
\>", "Text",ExpressionUUID->"01c82648-5f9e-a549-b011-5e35561cb561"],

Cell["\<\
They are the only possible choice: section 4.4 proves that the opposite sign \
convention (time squaring to \[Minus]1) has no real 16\[Times]16 realization, \
so \[Eta]17 is the 7+1 convention with real 16\[Times]16 Dirac matrices. With \
the index raised, \[CapitalGamma]17up[A] = \[Eta]17[[A+1,A+1]] \
\[CapitalGamma]17[A] (section 5.3), i.e. \[CapitalGamma]17up[0] = \
\[CapitalGamma]17[0] and \[CapitalGamma]17up[i] = \
\[Minus]\[CapitalGamma]17[i]. Because \[CapitalGamma]17[0] is symmetric and \
the \[CapitalGamma]17[i] are antisymmetric (and all are real), the Hermitian \
conjugate of a Dirac matrix is again a Dirac matrix: \[CapitalGamma]17up[A]\
\[Dagger] = \[CapitalGamma]17[0].\[CapitalGamma]17up[A].\[CapitalGamma]17[0].\
\>", "Text",ExpressionUUID->"ab908f71-c477-bb4e-b641-10a8012d3852"],

Cell["\<\
The Hamiltonian (Dirac) matrices are \[Beta]D = \[CapitalGamma]17up[0] = \
\[CapitalGamma]17[0] and \[Alpha]D[i] = \
\[CapitalGamma]17up[0].\[CapitalGamma]17up[i] = \[Minus]\[CapitalGamma]17[0].\
\[CapitalGamma]17[i]. In 8\[Times]8 blocks\
\>", "Text",ExpressionUUID->"dc92f2b7-d196-064b-aab0-92f102b398f3"],

Cell["\<\
      \[Beta]D = {{0, ID8}, {ID8, 0}},   \[Alpha]D[i] = {{0, \[Tau]O[i]}, {\
\[Minus]\[Tau]O[i], 0}}   (i = 1 \[Ellipsis] 7),\
\>", "Text",ExpressionUUID->"2948814f-f00b-f04c-89ef-61c1e8b005f2"],

Cell["\<\
all real and symmetric, with \[Alpha]D[i].\[Alpha]D[j] + \
\[Alpha]D[j].\[Alpha]D[i] = 2 \[Delta]ij ID16, \[Alpha]D[i].\[Beta]D + \
\[Beta]D.\[Alpha]D[i] = 0, \[Beta]D\.b2 = ID16. The volume element \[Omega]17 \
= \[CapitalGamma]17[8] = \[CapitalGamma]17[0].\[CapitalGamma]17[1] \
\[CenterEllipsis] \[CapitalGamma]17[7] = {{0, \[Minus]ID8}, {ID8, 0}} is \
real, anticommutes with every \[CapitalGamma]17[A] and squares to \
\[Minus]ID16 (section 4.6).\
\>", "Text",ExpressionUUID->"c28c148e-851c-1c45-9162-120434f7998e"],

Cell[CellGroupData[{

Cell["\<\
\[Beta]D = \[CapitalGamma]17up[0];
Do[\[Alpha]D[i] = \[CapitalGamma]17up[0].\[CapitalGamma]17up[i], {i, 1, 7}];
\[Omega]17 = \[CapitalGamma]17[8];
check[\"Dirac matrices: \[CapitalGamma]17up[0] == \[CapitalGamma]17[0], \
\[CapitalGamma]17up[i] == -\[CapitalGamma]17[i]; all REAL, every entry 0 or \
\[PlusMinus]1\",
  \[CapitalGamma]17up[0] == \[CapitalGamma]17[0] && And @@ Table[\
\[CapitalGamma]17up[i] == -\[CapitalGamma]17[i], {i, 1, 7}] &&
  And @@ Table[SubsetQ[{-1, 0, 1}, Union[Flatten[\[CapitalGamma]17up[A]]]], \
{A, 0, 7}]]
check[\"Dirac adjoint: ConjugateTranspose[\[CapitalGamma]17up[A]] == \
\[CapitalGamma]17[0].\[CapitalGamma]17up[A].\[CapitalGamma]17[0] for A = 0..7\
\",
  And @@ Table[ConjugateTranspose[\[CapitalGamma]17up[A]] == \
\[CapitalGamma]17[0].\[CapitalGamma]17up[A].\[CapitalGamma]17[0], {A, 0, 7}]]
check[\"\[Beta]D == {{0,ID8},{ID8,0}} and \[Alpha]D[i] == {{0,\[Tau]O[i]},{-\
\[Tau]O[i],0}}: real and symmetric\",
  \[Beta]D == ArrayFlatten[{{0, ID8}, {ID8, 0}}] &&
  And @@ Table[\[Alpha]D[i] == ArrayFlatten[{{0, \[Tau]O[i]}, {-\[Tau]O[i], \
0}}] && Transpose[\[Alpha]D[i]] == \[Alpha]D[i], {i, 1, 7}]]
check[\"\[Alpha]D[i].\[Alpha]D[j] + \[Alpha]D[j].\[Alpha]D[i] == 2 \[Delta]ij \
ID16, \[Alpha]D[i].\[Beta]D + \[Beta]D.\[Alpha]D[i] == 0, \[Beta]D.\[Beta]D \
== ID16\",
  And @@ Flatten[Table[\[Alpha]D[i].\[Alpha]D[j] + \[Alpha]D[j].\[Alpha]D[i] \
== 2 KroneckerDelta[i, j] ID16, {i, 1, 7}, {j, 1, 7}]] &&
  And @@ Table[\[Alpha]D[i].\[Beta]D + \[Beta]D.\[Alpha]D[i] == Zero16, {i, \
1, 7}] && \[Beta]D.\[Beta]D == ID16]
check[\"\[Omega]17 = \[CapitalGamma]17[8] == {{0,-ID8},{ID8,0}} is real, \
\[Omega]17.\[Omega]17 == -ID16, and \[Omega]17 anticommutes with every \
\[CapitalGamma]17[A]\",
  \[Omega]17 == ArrayFlatten[{{0, -ID8}, {ID8, 0}}] && \[Omega]17.\[Omega]17 \
== -ID16 && And @@ Table[\[Omega]17.\[CapitalGamma]17[A] == \
-\[CapitalGamma]17[A].\[Omega]17, {A, 0, 7}]]\
\>", "Input",
 CellLabel->
  "In[288]:=",ExpressionUUID->"b962354a-3837-3744-b7b3-25d278d2ace3"],

Cell[BoxData[
 RowBox[{"\<\"Dirac matrices: \[CapitalGamma]17up[0] == \[CapitalGamma]17[0], \
\[CapitalGamma]17up[i] == -\[CapitalGamma]17[i]; all REAL, every entry 0 or \
\[PlusMinus]1\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494743799496`*^9},
 CellLabel->
  "Out[291]=",ExpressionUUID->"ad10c695-6aa8-2342-9f45-d023652103b1"],

Cell[BoxData[
 RowBox[{"\<\"Dirac adjoint: ConjugateTranspose[\[CapitalGamma]17up[A]] == \
\[CapitalGamma]17[0].\[CapitalGamma]17up[A].\[CapitalGamma]17[0] for A = 0..7\
\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002049474396805*^9},
 CellLabel->
  "Out[292]=",ExpressionUUID->"8c192c38-d489-c949-ad5e-709e071c768d"],

Cell[BoxData[
 RowBox[{"\<\"\[Beta]D == {{0,ID8},{ID8,0}} and \[Alpha]D[i] == \
{{0,\[Tau]O[i]},{-\[Tau]O[i],0}}: real and symmetric\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020494744027863`*^9},
 CellLabel->
  "Out[293]=",ExpressionUUID->"d68913ca-ce48-e246-bf08-dca3464a7440"],

Cell[BoxData[
 RowBox[{"\<\"\[Alpha]D[i].\[Alpha]D[j] + \[Alpha]D[j].\[Alpha]D[i] == 2 \
\[Delta]ij ID16, \[Alpha]D[i].\[Beta]D + \[Beta]D.\[Alpha]D[i] == 0, \
\[Beta]D.\[Beta]D == ID16\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494744089985`*^9},
 CellLabel->
  "Out[294]=",ExpressionUUID->"7c7849b1-5403-4841-ab22-96f5cb4d0eb2"],

Cell[BoxData[
 RowBox[{"\<\"\[Omega]17 = \[CapitalGamma]17[8] == {{0,-ID8},{ID8,0}} is \
real, \[Omega]17.\[Omega]17 == -ID16, and \[Omega]17 anticommutes with every \
\[CapitalGamma]17[A]\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002049474414263*^9},
 CellLabel->
  "Out[295]=",ExpressionUUID->"5e1f08ce-2b5b-f142-be9d-3606d9a3cde6"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.2 The field dirac16complex and its Dirac equation", "Subsection",ExpressionUUID->"ef705b1f-3133-c142-84d8-9b0f1bf3f25a"],

Cell["The field is the column of 16 components", "Text",ExpressionUUID->"c1ab2b14-147a-e640-b2c4-c27107417c41"],

Cell["\<\
      dirac16complex(x) = \[Psi](x) = (\[Psi]_1(x), \[Ellipsis], \
\[Psi]_16(x)),   x = (x0, x1, \[Ellipsis], x7).\
\>", "Text",ExpressionUUID->"4a225cc7-a566-1040-95c5-f677f6f36cf5"],

Cell[TextData[{
 "Each component is a complex (non-Hermitian, \[Psi]_a\[Dagger] \[NotEqual] \
\[Psi]_a) Grassmann-odd operator field: at equal times \[Psi]_a \[Psi]_b = \
\[Minus]\[Psi]_b \[Psi]_a (so \[Psi]_a\.b2 = 0) and \[Psi]_a \
\[Psi]_b\[Dagger] + \[Psi]_b\[Dagger] \[Psi]_a = \[Delta]_ab \[Delta]\:2077(",
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "be226d0a-f999-604f-a18d-838104c67d6f"],
 " \[Minus] ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["y", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "ec4211e2-1071-9945-9c1b-2fea479c6d2a"],
 ") (section 7.7). The Dirac equation of the field is"
}], "Text",ExpressionUUID->"79451cec-de66-6a47-8207-cb7165ee14e7"],

Cell["\<\
      (i \[CapitalGamma]17up[A] \[PartialD]_A \[Minus] m) \[Psi] = 0,   that \
is   i \[CapitalGamma]17[0] \[PartialD]_0 \[Psi] \[Minus] i \[CapitalSigma]_i \
\[CapitalGamma]17[i] \[PartialD]_i \[Psi] \[Minus] m \[Psi] = 0.\
\>", "Text",ExpressionUUID->"26ccb3a9-03cc-3b4e-b7e7-484e62055cb8"],

Cell["\<\
The matrices are real; the factor i in front of them is unavoidable and \
harmless. With real \[CapitalGamma]17 the first-order operator \
\[CapitalGamma]17up[A] \[PartialD]_A squares to +(\[PartialD]_0\.b2 \[Minus] \
\[PartialD]_1\.b2 \[Minus] \[Ellipsis] \[Minus] \[PartialD]_7\.b2) ID16 \
(section 5.3), hence\
\>", "Text",ExpressionUUID->"292fe093-4903-644f-8cdc-ab3b8acee384"],

Cell["\<\
      (i \[CapitalGamma]17up[A] \[PartialD]_A + m)(i \[CapitalGamma]17up[A] \
\[PartialD]_A \[Minus] m) = \[Minus](\[PartialD]_0\.b2 \[Minus] \[PartialD]_1\
\.b2 \[Minus] \[Ellipsis] \[Minus] \[PartialD]_7\.b2 + m\.b2) ID16:\
\>", "Text",ExpressionUUID->"9d85bbfb-7ef2-ab4f-8fb9-3b43a753542b"],

Cell["\<\
every component of a solution obeys the 7+1 Klein\[Dash]Gordon equation. The \
equation is linear, so it reads the same for operator-valued, \
Grassmann-valued or ordinary complex components; the checks below use 16 \
arbitrary functions \[Psi]16[a](x0, \[Ellipsis], x7) for the components of \
dirac16complex.\
\>", "Text",ExpressionUUID->"ada887bb-187e-ee42-a437-706c5d1d74be"],

Cell[CellGroupData[{

Cell["\<\
dirac16complex = Table[\[Psi]16[a] @@ X, {a, 1, 16}];
DiracEq16[\[Psi]\[Psi]_, mm_] := I DiracOp17[\[Psi]\[Psi]] - mm \[Psi]\[Psi];
check[\"(I \[CapitalGamma]17up[A] \[PartialD]_A + m)(I \[CapitalGamma]17up[A] \
\[PartialD]_A - m) dirac16complex == -(\[PartialD]0^2 - \[PartialD]1^2 - ... \
- \[PartialD]7^2 + m^2) dirac16complex (16 arbitrary functions)\",
  Simplify[I DiracOp17[DiracEq16[dirac16complex, mD]] + mD \
DiracEq16[dirac16complex, mD] + waveOp17[dirac16complex] + mD^2 \
dirac16complex] === ConstantArray[0, 16]]\
\>", "Input",
 CellLabel->
  "In[296]:=",ExpressionUUID->"ce9aab2b-d415-df4b-b938-682af176a75f"],

Cell[BoxData[
 RowBox[{"\<\"(I \[CapitalGamma]17up[A] \[PartialD]_A + m)(I \
\[CapitalGamma]17up[A] \[PartialD]_A - m) dirac16complex == -(\[PartialD]0^2 \
- \[PartialD]1^2 - ... - \[PartialD]7^2 + m^2) dirac16complex (16 arbitrary \
functions)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494744426155`*^9},
 CellLabel->
  "Out[298]=",ExpressionUUID->"87fcc28e-f72c-6341-af5e-6e62ea08cb00"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.3 Hamiltonian form", "Subsection",ExpressionUUID->"6d2349e8-c89a-fc4e-b71f-69d8654ccfda"],

Cell["\<\
Multiplying the Dirac equation from the left by \[CapitalGamma]17[0] (\
\[CapitalGamma]17[0].\[CapitalGamma]17[0] = ID16) gives the \
Schr\[ODoubleDot]dinger form\
\>", "Text",ExpressionUUID->"3c64143a-b88d-6546-b841-18c01e5e4d25"],

Cell["      i \[PartialD]_0 \[Psi] = h \[Psi],   h = \[Minus]i \[Alpha]D[i] \
\[PartialD]_i + \[Beta]D m.", "Text",ExpressionUUID->"40cfca4d-8b26-c241-9bd6-\
0de271e7eec6"],

Cell["\<\
\[Alpha]D[i] and \[Beta]D are real symmetric and \[Minus]i\[PartialD]_i is \
Hermitian, so h is Hermitian: the time evolution is unitary and the charge Q \
= \[Integral] \[Psi]\[Dagger]\[Psi] d\:2077x is conserved.\
\>", "Text",ExpressionUUID->"8514a2b0-457b-1241-8882-78f7960f1bdf"],

Cell[CellGroupData[{

Cell["\<\
hD[\[Psi]\[Psi]_, mm_] := Sum[-I \[Alpha]D[i].D[\[Psi]\[Psi], X[[i + 1]]], \
{i, 1, 7}] + mm \[Beta]D.\[Psi]\[Psi];
check[\"\[CapitalGamma]17[0].(I \[CapitalGamma]17up[A] \[PartialD]_A - m) \
\[Psi] == I \[PartialD]0 \[Psi] - h \[Psi] with h = -I \[Alpha]D[i] \
\[PartialD]_i + \[Beta]D m (16 arbitrary functions)\",
  Simplify[\[CapitalGamma]17[0].DiracEq16[dirac16complex, mD] - (I \
D[dirac16complex, x0] - hD[dirac16complex, mD])] === ConstantArray[0, 16]]\
\>", "Input",
 CellLabel->
  "In[299]:=",ExpressionUUID->"88d971b0-9f41-af49-8a85-4d3d3fe1e67c"],

Cell[BoxData[
 RowBox[{"\<\"\[CapitalGamma]17[0].(I \[CapitalGamma]17up[A] \[PartialD]_A - \
m) \[Psi] == I \[PartialD]0 \[Psi] - h \[Psi] with h = -I \[Alpha]D[i] \
\[PartialD]_i + \[Beta]D m (16 arbitrary functions)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002049474454855*^9},
 CellLabel->
  "Out[300]=",ExpressionUUID->"a0a61204-e6f1-6b4e-a0b0-b680cade9688"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.4 Plane waves and the real spinors u_s, v_s", "Subsection",ExpressionUUID->"fd9228c2-3761-d849-92e9-c7b471c768f3"],

Cell[TextData[{
 "For a plane wave e^{\[Minus]i(E x0 \[Minus] ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "3c339157-fce5-0544-800e-9275530761d2"],
 "\[CenterDot]",
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "4e142287-cc1a-e34f-87d6-8312a949548e"],
 ")} the operator \[Minus]i\[PartialD]_i becomes pi and h becomes the REAL \
symmetric 16\[Times]16 matrix"
}], "Text",ExpressionUUID->"f515ecde-3eba-c049-a8eb-b55070237112"],

Cell[TextData[{
 "      h(",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "9c67adf2-e649-ee4a-962d-2b143766b5b7"],
 ") = pi \[Alpha]D[i] + m \[Beta]D = {{0, M}, {Transpose[M], 0}},   M(",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "08f7860b-30d7-a748-82af-ca061fe638c4"],
 ") = m ID8 + pi \[Tau]O[i]   (a real 8\[Times]8 matrix)."
}], "Text",ExpressionUUID->"2a3bcc22-55aa-9c44-a9d0-f3b78407b1ff"],

Cell[TextData[{
 "The \[Tau]O[i] are antisymmetric and anticommute, so M.Transpose[M] = \
Transpose[M].M = (m\.b2 + ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "1cb557b7-bfde-b14a-9b0c-dd0aa19c3847"],
 "\.b2) ID8 = E\.b2 ID8 with E = \[Sqrt](m\.b2 + ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "bc585356-f738-3f44-8898-c47e6e116073"],
 "\.b2), and h(",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "cff21f6b-9947-8347-bef4-9ef2d60cfc42"],
 ")\.b2 = E\.b2 ID16: the eigenvalues are +E and \[Minus]E, each eight times. \
The eigenvectors are REAL. For s = 1 \[Ellipsis] 8 (e_s = UnitVector[8, s]):"
}], "Text",ExpressionUUID->"075cb079-8096-5e4a-b8a9-18f51ff62900"],

Cell[TextData[{
 "      u_s(",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "949d7cab-d906-de41-8943-84774d2e2fc2"],
 ") = (E e_s, Transpose[M].e_s)/\[Sqrt]E,      h(",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "68da15ee-d5ad-0045-aa64-8e22a65b9b33"],
 ").u_s = +E u_s,"
}], "Text",ExpressionUUID->"dc9f0003-2870-0746-9d05-b07d9633cc59"],

Cell[TextData[{
 "      v_s(",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "3fea4d22-55bb-7f44-82b2-203c0057d4b4"],
 ") = (E e_s, \[Minus]M.e_s)/\[Sqrt]E,                h(\[Minus]",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "e1e15695-a6d5-f24a-bffa-1222b648b6bd"],
 ").v_s = \[Minus]E v_s,"
}], "Text",ExpressionUUID->"1747116b-a041-c04b-b16f-e699dcce5f43"],

Cell[TextData[{
 "normalized as u_s.u_r = v_s.v_r = 2E \[Delta]sr. With the 8-momentum p = \
(E, ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "98fe0684-78f0-d548-a248-b6e4020a0983"],
 ") and the real matrix pslash = E \[CapitalGamma]17[0] + pi \
\[CapitalGamma]17[i] (\[CapitalGamma]17 with lower index, p with upper index) \
these are the Dirac equations in momentum space, (pslash \[Minus] m).u_s = 0 \
and (pslash + m).v_s = 0; the plane waves u_s e^{\[Minus]i(E x0 \[Minus] ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "e479cc00-9b67-014f-a2d5-d0d7d65b907b"],
 "\[CenterDot]",
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "999d293e-07c0-c443-8983-789b7bdec951"],
 ")} and v_s e^{+i(E x0 \[Minus] ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "a16bcafa-55c2-8749-80c8-7ef13dfe5469"],
 "\[CenterDot]",
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "ae3ce1f0-e400-f946-bb8c-ea3de127b608"],
 ")} solve (i \[CapitalGamma]17up[A] \[PartialD]_A \[Minus] m) \[Psi] = 0. M(\
\[Minus]",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "80c4ed60-99c7-314d-88df-ec8b4a694d7e"],
 ") = Transpose[M(",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "78e02dc5-39fc-ea49-a15d-1f5161742b74"],
 ")], so the spinors of \[Minus]",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "d1615cfe-7eb0-d24d-8ccb-f18dedb9fefa"],
 " need no new formula. The checks use a completely symbolic momentum ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "100c97ed-da66-f948-9b5d-a6d7d225428c"],
 " = (p1, \[Ellipsis], p7)."
}], "Text",ExpressionUUID->"342a9e23-69fb-a140-b579-cf3d974d0eac"],

Cell[CellGroupData[{

Cell["\<\
pv7 = {p1, p2, p3, p4, p5, p6, p7};
asm7 = mD > 0 && And @@ (Element[#, Reals] & /@ pv7);
Ep = Sqrt[mD^2 + pv7.pv7];
Mp = mD ID8 + Sum[pv7[[i]] \[Tau]O[i], {i, 1, 7}];
hp[q_List, mm_] := Sum[q[[i]] \[Alpha]D[i], {i, 1, 7}] + mm \[Beta]D;
uS[s_, M_, En_] := Join[En UnitVector[8, s], Transpose[M].UnitVector[8, \
s]]/Sqrt[En];
vS[s_, M_, En_] := Join[En UnitVector[8, s], -M.UnitVector[8, s]]/Sqrt[En];
slash17[En_, q_List] := En \[CapitalGamma]17[0] + Sum[q[[i]] \
\[CapitalGamma]17[i], {i, 1, 7}];
check[\"h(p) == {{0, M}, {Transpose[M], 0}} with the REAL 8\[Times]8 matrix M \
= m ID8 + p_i \[Tau]O[i]\", Expand[hp[pv7, mD] - ArrayFlatten[{{0, Mp}, \
{Transpose[Mp], 0}}]] === Zero16]
check[\"M.Transpose[M] == Transpose[M].M == E^2 ID8 and h(p).h(p) == E^2 \
ID16, E^2 = m^2 + p^2\",
  Expand[Mp.Transpose[Mp] - Ep^2 ID8] === Zero8 && Expand[Transpose[Mp].Mp - \
Ep^2 ID8] === Zero8 && Expand[hp[pv7, mD].hp[pv7, mD] - Ep^2 ID16] === Zero16]
check[\"h(p).u_s == E u_s and h(-p).v_s == -E v_s for s = 1..8\",
  And @@ Table[Simplify[hp[pv7, mD].uS[s, Mp, Ep] - Ep uS[s, Mp, Ep], asm7] \
=== ConstantArray[0, 16] &&
    Simplify[hp[-pv7, mD].vS[s, Mp, Ep] + Ep vS[s, Mp, Ep], asm7] === \
ConstantArray[0, 16], {s, 1, 8}]]
check[\"(pslash - m).u_s == 0 and (pslash + m).v_s == 0, pslash = E \
\[CapitalGamma]17[0] + p_i \[CapitalGamma]17[i]\",
  And @@ Table[Simplify[(slash17[Ep, pv7] - mD ID16).uS[s, Mp, Ep], asm7] === \
ConstantArray[0, 16] &&
    Simplify[(slash17[Ep, pv7] + mD ID16).vS[s, Mp, Ep], asm7] === \
ConstantArray[0, 16], {s, 1, 8}]]
check[\"u_s.u_r == v_s.v_r == 2E \[Delta]sr, and u_s(p).v_r(-p) == 0\",
  Simplify[Table[uS[s, Mp, Ep].uS[r, Mp, Ep] - 2 Ep KroneckerDelta[s, r], {s, \
8}, {r, 8}], asm7] === Zero8 &&
  Simplify[Table[vS[s, Mp, Ep].vS[r, Mp, Ep] - 2 Ep KroneckerDelta[s, r], {s, \
8}, {r, 8}], asm7] === Zero8 &&
  Simplify[Table[uS[s, Mp, Ep].vS[r, Transpose[Mp], Ep], {s, 8}, {r, 8}], \
asm7] === Zero8]
check[\"plane waves: u_s Exp[-I(E x0 - p.x)] and v_s Exp[+I(E x0 - p.x)] \
solve (I \[CapitalGamma]17up[A] \[PartialD]_A - m) \[Psi] == 0\",
  And @@ Table[Simplify[DiracEq16[uS[s, Mp, Ep] Exp[-I (Ep x0 - \
pv7.Rest[X])], mD], asm7] === ConstantArray[0, 16] &&
    Simplify[DiracEq16[vS[s, Mp, Ep] Exp[I (Ep x0 - pv7.Rest[X])], mD], asm7] \
=== ConstantArray[0, 16], {s, 1, 8}]]\
\>", "Input",
 CellLabel->
  "In[301]:=",ExpressionUUID->"b8d16cce-064e-ce4c-81b9-f59afaed4687"],

Cell[BoxData[
 RowBox[{"\<\"h(p) == {{0, M}, {Transpose[M], 0}} with the REAL 8\[Times]8 \
matrix M = m ID8 + p_i \[Tau]O[i]\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002049474471918*^9},
 CellLabel->
  "Out[309]=",ExpressionUUID->"2807b57c-77dc-9349-9a93-d6260e033580"],

Cell[BoxData[
 RowBox[{"\<\"M.Transpose[M] == Transpose[M].M == E^2 ID8 and h(p).h(p) == \
E^2 ID16, E^2 = m^2 + p^2\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494744779167`*^9},
 CellLabel->
  "Out[310]=",ExpressionUUID->"057fbffb-8c4c-8744-8056-b18cbe95b60c"],

Cell[BoxData[
 RowBox[{"\<\"h(p).u_s == E u_s and h(-p).v_s == -E v_s for s = 1..8\"\>", "\[Rule]",
   "True"}]], "Output",
 CellChangeTimes->{4.0020494744951096`*^9},
 CellLabel->
  "Out[311]=",ExpressionUUID->"b88a2657-ff1a-af4b-86db-90c8abfdcda2"],

Cell[BoxData[
 RowBox[{"\<\"(pslash - m).u_s == 0 and (pslash + m).v_s == 0, pslash = E \
\[CapitalGamma]17[0] + p_i \[CapitalGamma]17[i]\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020494745142975`*^9},
 CellLabel->
  "Out[312]=",ExpressionUUID->"124f5c36-7e61-e644-9032-21b9a1389b80"],

Cell[BoxData[
 RowBox[{"\<\"u_s.u_r == v_s.v_r == 2E \[Delta]sr, and u_s(p).v_r(-p) == \
0\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494745438232`*^9},
 CellLabel->
  "Out[313]=",ExpressionUUID->"e7c9f520-7f56-e54f-884e-3d98208bce37"],

Cell[BoxData[
 RowBox[{"\<\"plane waves: u_s Exp[-I(E x0 - p.x)] and v_s Exp[+I(E x0 - \
p.x)] solve (I \[CapitalGamma]17up[A] \[PartialD]_A - m) \[Psi] == 0\"\>", "\[Rule]",
   "True"}]], "Output",
 CellChangeTimes->{4.002049474600878*^9},
 CellLabel->
  "Out[314]=",ExpressionUUID->"4a75a1ea-b7cf-814f-a637-78d9ee3438e2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
(* an explicit example: p = (2, 2, 4, 0, 0, 0, 0), m = 1, E = 5; the eight \
real spinors u_s as the columns of a matrix *)
p0v = {2, 2, 4, 0, 0, 0, 0}; M0 = ID8 + Sum[p0v[[i]] \[Tau]O[i], {i, 1, 7}];
u0Matrix = Transpose[Table[uS[s, M0, 5], {s, 1, 8}]];
check[\"example p = (2,2,4,0,0,0,0), m = 1: E = 5 and the eight u_s are real \
(entries in Sqrt[5] \[DoubleStruckCapitalQ]) and solve h(p).u_s == 5 u_s\",
  Sqrt[1 + p0v.p0v] == 5 && FreeQ[u0Matrix, _Complex] && Simplify[hp[p0v, \
1].u0Matrix - 5 u0Matrix] === ConstantArray[0, {16, 8}]]
MatrixForm[Sqrt[5] u0Matrix]\
\>", "Input",
 CellLabel->
  "In[315]:=",ExpressionUUID->"8a78369c-b780-3543-bfc5-fc6d9366e3d6"],

Cell[BoxData[
 RowBox[{"\<\"example p = (2,2,4,0,0,0,0), m = 1: E = 5 and the eight u_s are \
real (entries in Sqrt[5] \[DoubleStruckCapitalQ]) and solve h(p).u_s == 5 u_s\
\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494746217785`*^9},
 CellLabel->
  "Out[318]=",ExpressionUUID->"80297ee0-56ea-a648-beba-ceddcc5be39d"],

