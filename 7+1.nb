      RowBox[{"eA", "[", "7", "]"}]}], 
     RowBox[{"-", 
      RowBox[{"eA", "[", "2", "]"}]}], 
     RowBox[{"eA", "[", "1", "]"}], 
     RowBox[{"-", 
      RowBox[{"eA", "[", "4", "]"}]}], 
     RowBox[{"eA", "[", "3", "]"}]},
    {
     RowBox[{"eA", "[", "7", "]"}], 
     RowBox[{"eA", "[", "7", "]"}], 
     RowBox[{"-", 
      RowBox[{"eA", "[", "8", "]"}]}], 
     RowBox[{"-", 
      RowBox[{"eA", "[", "5", "]"}]}], 
     RowBox[{"eA", "[", "6", "]"}], 
     RowBox[{"-", 
