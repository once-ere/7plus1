Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Gamma^mu Omega_mu (static radial metric), coefficient of \
Gamma17up[1]\"\>", "\[Rule]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       RowBox[{"12", " ", 
        RowBox[{"fR", "[", "x1", "]"}]}], "+", 
       RowBox[{"x1", " ", 
        RowBox[{
         SuperscriptBox["fR", "\[Prime]",
          MultilineFunction->None], "[", "x1", "]"}]}]}], 
      RowBox[{"4", " ", "x1", " ", 
       RowBox[{"fR", "[", "x1", "]"}], " ", 
       SqrtBox[
        RowBox[{"hR", "[", "x1", "]"}]]}]]}]}], ",", 
   RowBox[{"\<\"Ricci scalar R (static radial metric)\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["x1", "2"]}], " ", 
        RowBox[{"hR", "[", "x1", "]"}], " ", 
        SuperscriptBox[
         RowBox[{
          SuperscriptBox["fR", "\[Prime]",
           MultilineFunction->None], "[", "x1", "]"}], "2"]}], "+", 
       RowBox[{"12", " ", 
        SuperscriptBox[
         RowBox[{"fR", "[", "x1", "]"}], "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"5", " ", 
           RowBox[{"hR", "[", "x1", "]"}]}], "-", 
          RowBox[{"x1", " ", 
           RowBox[{
            SuperscriptBox["hR", "\[Prime]",
             MultilineFunction->None], "[", "x1", "]"}]}]}], ")"}]}], "+", 
       RowBox[{"x1", " ", 
        RowBox[{"fR", "[", "x1", "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "x1"}], " ", 
           RowBox[{
            SuperscriptBox["fR", "\[Prime]",
             MultilineFunction->None], "[", "x1", "]"}], " ", 
           RowBox[{
            SuperscriptBox["hR", "\[Prime]",
             MultilineFunction->None], "[", "x1", "]"}]}], "+", 
          RowBox[{"2", " ", 
           RowBox[{"hR", "[", "x1", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"6", " ", 
              RowBox[{
               SuperscriptBox["fR", "\[Prime]",
                MultilineFunction->None], "[", "x1", "]"}]}], "+", 
             RowBox[{"x1", " ", 
              RowBox[{
               SuperscriptBox["fR", "\[Prime]\[Prime]",
                MultilineFunction->None], "[", "x1", "]"}]}]}], ")"}]}]}], 
         ")"}]}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", 
       SuperscriptBox["x1", "2"], " ", 
       SuperscriptBox[
        RowBox[{"fR", "[", "x1", "]"}], "2"], " ", 
       SuperscriptBox[
        RowBox[{"hR", "[", "x1", "]"}], "2"]}], ")"}]}]}]}], "}"}]], "Output",
 CellChangeTimes->{4.0021244014122562`*^9},
 CellLabel->
  "Out[662]=",ExpressionUUID->"16c0913a-d636-5f4d-92c4-a6c8f918170c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
AG = Table[aGauge[m][x0, x1, x5], {m, 8}]; alphaG = alGauge[x0, x1, x5];
DslA[f_, av_] := Sum[fdCos[\"GamUp\"][[m]].(D[f, X[[m]]] + \
fdCos[\"Om\"][[m]].f - I qG av[[m]] f), {m, 8}];
check[\"U(1) gauge covariance: Gamma^mu (D_mu - i q A'_mu)(e^{i q alpha} psi) \
== e^{i q alpha} Gamma^mu (D_mu - i q A_mu) psi with A'_mu = A_mu + d_mu \
alpha\",
  Together[Expand[Exp[-I qG alphaG] DslA[Exp[I qG alphaG] psiF, AG + \
Table[D[alphaG, X[[m]]], {m, 8}]] - DslA[psiF, AG]]] === ConstantArray[0, 16]]
DpsiA = Table[DpsiCos[[m]] - I qG AG[[m]] psiF, {m, 8}]; DpsibA = \
Table[DpsibCos[[m]] + I qG AG[[m]] psibF, {m, 8}];
check[\"current identity with the gauge field: d_mu(sqrt|g| psibar Gamma^mu \
psi) == sqrt|g| [(D_mu psibar) Gamma^mu psi + psibar Gamma^mu D_mu psi], D \
including -i q A_mu\",
  Together[Sum[D[sqgCos psibF.fdCos[\"GamUp\"][[m]].psiF, X[[m]]], {m, 8}] - \
sqgCos Sum[DpsibA[[m]].fdCos[\"GamUp\"][[m]].psiF + \
psibF.fdCos[\"GamUp\"][[m]].DpsiA[[m]], {m, 8}]] === 0]\
\>", "Input",
 CellLabel->
  "In[663]:=",ExpressionUUID->"6ffc5b27-c678-8f40-8348-967bf2b14de0"],

Cell[BoxData[
 RowBox[{"\<\"U(1) gauge covariance: Gamma^mu (D_mu - i q A'_mu)(e^{i q \
alpha} psi) == e^{i q alpha} Gamma^mu (D_mu - i q A_mu) psi with A'_mu = A_mu \
+ d_mu alpha\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021244014694633`*^9},
 CellLabel->
  "Out[665]=",ExpressionUUID->"22d5c706-8f70-924c-b71b-196a79ec1a47"],

Cell[BoxData[
 RowBox[{"\<\"current identity with the gauge field: d_mu(sqrt|g| psibar \
Gamma^mu psi) == sqrt|g| [(D_mu psibar) Gamma^mu psi + psibar Gamma^mu D_mu \
psi], D including -i q A_mu\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021244015380383`*^9},
 CellLabel->
  "Out[667]=",ExpressionUUID->"5fc3825a-6073-5847-bb1f-345c3f631d22"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
14. The three epochs: primordial (near x0 = 0), modern, far future\
\>", "Section",ExpressionUUID->"a395954d-64ab-ed42-9d73-2cf6c98fc0ae"],

Cell["\<\
For the cosmological metric with a homogeneous source T^\[Mu]_\[Nu] = diag(\
\[Epsilon], \[Minus]pa, \[Minus]pa, \[Minus]pa, \[Minus]pb, \[Minus]pb, \
\[Minus]pb, \[Minus]pb) (energy density \[Epsilon], pressure pa along \
ordinary space and pb along the auxiliary space) the Einstein\[Dash]Lovelock \
equations of section 12 are three ordinary differential equations,\
\>", "Text",ExpressionUUID->"20d52fb2-6708-ad42-9459-a41e55bdfa99"],

Cell["\<\
      \[CapitalSigma]_k \[Alpha]_k E^(k)0_0 = \[Kappa] \[Epsilon],    \
\[CapitalSigma]_k \[Alpha]_k E^(k)1_1 = \[Minus]\[Kappa] pa,    \
\[CapitalSigma]_k \[Alpha]_k E^(k)4_4 = \[Minus]\[Kappa] pb,\
\>", "Text",ExpressionUUID->"675bfd3b-6a71-7b46-8718-740fa38d2a44"],

Cell["\<\
with the closed forms of section 12.6, and the conservation law \[Epsilon]\
\[Prime] + 3Ha (\[Epsilon] + pa) + 4Hb (\[Epsilon] + pb) = 0 follows from \
them. The three epochs of this notebook are exact solutions or limits of \
these equations.\
\>", "Text",ExpressionUUID->"1583a4fb-d570-104a-87fa-e68bfbf5fe0f"],

Cell[CellGroupData[{

Cell["14.1 Primordial epoch near x0 = 0: Kasner solutions", "Subsection",ExpressionUUID->"d20da900-5c47-8244-8253-651262fd49a9"],

Cell["\<\
Near x0 = 0 a power law a = x0^p, b = x0^q is the natural ansatz. Every term \
of E^(k) then scales as x0^(\[Minus]2k), so for x0 \[RightArrow] 0 the \
highest Lovelock order with a non-zero coupling dominates (the cubic one if \
\[Alpha]_3 \[NotEqual] 0), and matter with \[Epsilon] growing more slowly \
than x0^(\[Minus]2k) can be neglected. The vacuum solutions of each order \
separately are:\
\>", "Text",ExpressionUUID->"ea022e4a-cdc6-0840-9d61-7f02a209c7cb"],

Cell["\<\
Einstein (k = 1): 3p + 4q = 1 and 3p\.b2 + 4q\.b2 = 1, i.e. p = (1 \
\[PlusMinus] 2\[Sqrt]2)/7, q = (2 \[MinusPlus] 3\[Sqrt]2)/14. On the branch p \
= 0.547, q = \[Minus]0.160 ordinary space expands while the auxiliary space \
contracts: dynamical compactification of x4 \[Ellipsis] x7.\
\>", "Item",ExpressionUUID->"1ec753c0-42f5-e740-a4f8-e8647dd9c804"],

Cell["\<\
Gauss\[Dash]Bonnet (k = 2): 3p + 4q = 3 and a cubic equation for p with three \
real roots.\
\>", "Item",ExpressionUUID->"b7f81734-ca84-b14b-abf7-70402826b481"],

Cell[CellGroupData[{

Cell["\<\
Cubic Lovelock (k = 3): the non-degenerate solution (p, q) = (\[Minus]15/7, \
20/7) with 3p + 4q = 5, and the degenerate families q = 0 (static auxiliary \
space) and p = 0, for which E^(3) vanishes identically.\
\>", "Item",ExpressionUUID->"4c8f9d30-23bc-7149-abf2-397b5380d8a0"],

Cell[CellGroupData[{

Cell["\<\
(* a = x0^pK, b = x0^qK: Ha = pK/x0, Hb = qK/x0, Ha' = -pK/x0^2, Hb' = \
-qK/x0^2 in the closed forms of section 12.6 *)
EKas = Table[Factor[Expand[x0^(2 k) toH[ECos[[k + 1, c, c]]] /. {Ha -> pK/x0, \
Hb -> qK/x0, dHa -> -pK/x0^2, dHb -> -qK/x0^2}]], {k, 1, 3}, {c, {1, 2, 5}}];
gKas = DiagonalMatrix[{1, -x0^(2 pK), -x0^(2 pK), -x0^(2 pK), -x0^(2 qK), \
-x0^(2 qK), -x0^(2 qK), -x0^(2 qK)}];
check[\"Kasner metric: the Einstein tensor computed directly from the metric \
equals the closed form (x0^2 G^mu_mu, mu = 0, 1, 4)\",
  Simplify[x0^2 Diagonal[curvature[gKas, PowerExpand[Together[#]] \
&][\"G\"]][[{1, 2, 5}]] - EKas[[1]]] === {0, 0, 0}]
check[\"Einstein Kasner: (p, q) = ((1+2Sqrt[2])/7, (2-3Sqrt[2])/14) and \
((1-2Sqrt[2])/7, (2+3Sqrt[2])/14) solve E^(1) == 0\",
  And @@ Flatten[Table[Simplify[EKas[[1]] /. {pK -> s[[1]], qK -> s[[2]]}] == \
{0, 0, 0}, {s, {{(1 + 2 Sqrt[2])/7, (2 - 3 Sqrt[2])/14}, {(1 - 2 Sqrt[2])/7, \
(2 + 3 Sqrt[2])/14}}}]]]
gbCubic = Expand[64 (4 pK^3 + 18 pK^2 qK + 12 pK qK^2 + qK^3) /. qK -> (3 - 3 \
pK)/4];
gbRoots = Sort[pK /. NSolve[gbCubic == 0, pK, Reals, WorkingPrecision -> 30]];
check[\"Gauss-Bonnet Kasner: 3 real roots of the cubic; (p, (3-3p)/4) solve \
E^(2) == 0\",
  Length[gbRoots] == 3 && And @@ Table[Max[Abs[N[EKas[[2]] /. {pK -> r, qK -> \
(3 - 3 r)/4}, 25]]] < 10^-18, {r, gbRoots}]]
check[\"cubic Lovelock Kasner: (p, q) = (-15/7, 20/7) solves E^(3) == 0; \
E^(3) == 0 identically for q = 0 and for p = 0\",
  Simplify[EKas[[3]] /. {pK -> -15/7, qK -> 20/7}] == {0, 0, 0} && \
Simplify[EKas[[3]] /. qK -> 0] == {0, 0, 0} && Simplify[EKas[[3]] /. pK -> 0] \
== {0, 0, 0}]
{\"x0^2 E^(1) (00, 11, 44)\" -> EKas[[1]], \"Gauss-Bonnet cubic\" -> gbCubic, \
\"Gauss-Bonnet Kasner p\" -> N[gbRoots, 15], \"Einstein Kasner p, q\" -> \
N[{(1 + 2 Sqrt[2])/7, (2 - 3 Sqrt[2])/14}, 15]}\
\>", "Input",
 CellLabel->
  "In[668]:=",ExpressionUUID->"963e36f8-8c11-c94c-b97c-b75e682178b1"],

Cell[BoxData[
 RowBox[{"\<\"Kasner metric: the Einstein tensor computed directly from the \
metric equals the closed form (x0^2 G^mu_mu, mu = 0, 1, 4)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0021244018670635`*^9},
 CellLabel->
  "Out[671]=",ExpressionUUID->"6475703f-d5dc-a54c-b391-68119e29e03c"],

Cell[BoxData[
 RowBox[{"\<\"Einstein Kasner: (p, q) = ((1+2Sqrt[2])/7, (2-3Sqrt[2])/14) and \
((1-2Sqrt[2])/7, (2+3Sqrt[2])/14) solve E^(1) == 0\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002124401886423*^9},
 CellLabel->
  "Out[672]=",ExpressionUUID->"3c01ae2b-9d05-3c40-8392-f3367f6c2daa"],

Cell[BoxData[
 RowBox[{"\<\"Gauss-Bonnet Kasner: 3 real roots of the cubic; (p, (3-3p)/4) \
solve E^(2) == 0\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021244018887672`*^9},
 CellLabel->
  "Out[675]=",ExpressionUUID->"7e6b7967-bda2-a648-bc45-da84a5d749f0"],

Cell[BoxData[
 RowBox[{"\<\"cubic Lovelock Kasner: (p, q) = (-15/7, 20/7) solves E^(3) == \
0; E^(3) == 0 identically for q = 0 and for p = 0\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0021244018887672`*^9},
 CellLabel->
  "Out[676]=",ExpressionUUID->"b93b3b70-a3ba-5644-9db6-38f9e7399ced"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"x0^2 E^(1) (00, 11, 44)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"3", " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["pK", "2"], "+", 
         RowBox[{"4", " ", "pK", " ", "qK"}], "+", 
         RowBox[{"2", " ", 
          SuperscriptBox["qK", "2"]}]}], ")"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", "pK"}], "+", 
       RowBox[{"3", " ", 
        SuperscriptBox["pK", "2"]}], "-", 
       RowBox[{"4", " ", "qK"}], "+", 
       RowBox[{"8", " ", "pK", " ", "qK"}], "+", 
       RowBox[{"10", " ", 
        SuperscriptBox["qK", "2"]}]}], ",", 
      RowBox[{"3", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "pK"}], "+", 
         RowBox[{"2", " ", 
          SuperscriptBox["pK", "2"]}], "-", "qK", "+", 
         RowBox[{"3", " ", "pK", " ", "qK"}], "+", 
         RowBox[{"2", " ", 
          SuperscriptBox["qK", "2"]}]}], ")"}]}]}], "}"}]}], ",", 
   RowBox[{"\<\"Gauss-Bonnet cubic\"\>", "\[Rule]", 
    RowBox[{"27", "+", 
     RowBox[{"351", " ", "pK"}], "+", 
     RowBox[{"81", " ", 
      SuperscriptBox["pK", "2"]}], "-", 
     RowBox[{"203", " ", 
      SuperscriptBox["pK", "3"]}]}]}], ",", 
   RowBox[{"\<\"Gauss-Bonnet Kasner p\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.08350178761210574242397629473091052463`15."}], ",", 
      RowBox[{"-", "0.07863105841892776622786105210992226309`15."}], ",", 
      "1.56114762435615666136119695275213025816`15."}], "}"}]}], ",", 
   RowBox[{"\<\"Einstein Kasner p, q\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.54691816067802715680048249263134230817`15.", ",", 
      RowBox[{"-", "0.16018862050852036760036186947350673112`15."}]}], 
     "}"}]}]}], "}"}]], "Output",
 CellChangeTimes->{4.0021244018887672`*^9},
 CellLabel->
  "Out[677]=",ExpressionUUID->"5f3688e1-171a-894c-9850-fdce433694f7"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["14.2 The mode equation in two dimensions", "Subsection",ExpressionUUID->"8fe8bfcc-a4bd-f94b-b648-c66298e58a6f"],

Cell[TextData[{
 "With unit vectors ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["n", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "602349a8-eaf2-194a-bdd7-3e8dd6cc5ce3"],
 "a (in ordinary space) and ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["n", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "bc78e920-347b-fd4e-90f3-43405c492c7a"],
 "b (in the auxiliary space) along ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "b092c909-2245-e44f-9670-d5775c8cffcc"],
 " and ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "9970080e-b85f-ae42-b62f-ce3f9df253ff"],
 ", h(x0) = |",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "6f78a99c-67be-c145-8b52-03e58d293618"],
 "|/a A + |",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "1493ad2e-3184-fa42-bd57-999bd2a0bab1"],
 "|/b B + m \[Beta]D with the CONSTANT real matrices A = \
\[Alpha]D\[CenterDot]",
 Cell[BoxData[
  FormBox[
   OverscriptBox["n", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "a922d0ea-cb7f-1e44-8892-914cde7bfc21"],
 "a, B = \[Alpha]D\[CenterDot]",
 Cell[BoxData[
  FormBox[
   OverscriptBox["n", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "cd59e9ba-5289-ee47-b750-b4a4b9b95f60"],
 "b. A, B and \[Beta]D square to ID16 and anticommute, and Zc = A.B.\[Beta]D \
squares to \[Minus]ID16, is antisymmetric and commutes with all three and \
with h(x0), so its eigenvalue \[PlusMinus]i is conserved. On the eigenspace \
Zc = +i (eight dimensions) A, B, \[Beta]D act like the Pauli matrices \
\[Sigma]1, \[Sigma]2, \[Sigma]3 (\[Sigma]1\[Sigma]2\[Sigma]3 = +i), on Zc = \
\[Minus]i like \[Sigma]1, \[Sigma]2, \[Minus]\[Sigma]3, so the 16-component \
mode equation is four copies of each of"
}], "Text",ExpressionUUID->"43577ad5-d3bd-9142-9e09-fa1401ea0983"],

Cell[TextData[{
 "      i dc/dx0 = (|",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "429cb706-e061-c541-b3e5-23ef05f41800"],
 "|/a \[Sigma]1 + |",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "a501489b-e502-7043-9a6f-99c0bce8dc67"],
 "|/b \[Sigma]2 \[PlusMinus] m \[Sigma]3) c,     c \[Element] \
\[DoubleStruckCapitalC]\.b2."
}], "Text",ExpressionUUID->"2ff5d261-9b14-524f-a203-51a7b33533d8"],

Cell["\<\
For m = 0 the two signs give the same evolution; for m \[NotEqual] 0 they do \
not, and the anisotropic expansion creates the two classes of states at \
different rates.\
\>", "Text",ExpressionUUID->"552b39e0-2d6a-3046-95cb-e9718b21517c"],

Cell[TextData[{
 "The direction of the physical momentum (|",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "4cb10f96-9732-4b43-b06f-63a8b53194d0"],
 "|/a, |",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "38b5a4ea-29ff-6f42-8b2c-3f78eb71771d"],
 "|/b) turns as the two spaces expand at different rates. Pairs are created \
when the turning is not slow compared with the frequency \[Omega] = \[Sqrt](|",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "80609503-f570-704a-b229-596af036dee0"],
 "|\.b2/a\.b2 + |",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "df763f00-f3ca-714f-9fc0-fd6e449db3e5"],
 "|\.b2/b\.b2 + m\.b2): the Bogoliubov coefficient |\[Beta]|\.b2 of a mode is \
the probability that a particle (positive-energy state) at the initial time \
ends in a negative-energy state at the final time."
}], "Text",ExpressionUUID->"ef0bea77-0956-4c4e-9a34-23a697bdeef1"],

Cell[CellGroupData[{

Cell["\<\
naVec = {1, 2, 2}/3; nbVec = {1, -1, 1, 1}/2;
Aop = Sum[naVec[[i]] \[Alpha]D[i], {i, 1, 3}]; Bop2 = Sum[nbVec[[k - 3]] \
\[Alpha]D[k], {k, 4, 7}]; Zc = Aop.Bop2.\[Beta]D;
check[\"2x2 reduction: A, B, betaD square to ID16 and anticommute; Zc = \
A.B.betaD: Zc.Zc == -ID16, Transpose[Zc] == -Zc, Zc commutes with A, B, betaD\
\",
  Aop.Aop == ID16 && Bop2.Bop2 == ID16 && Aop.Bop2 + Bop2.Aop == Zero16 && \
Aop.\[Beta]D + \[Beta]D.Aop == Zero16 && Bop2.\[Beta]D + \[Beta]D.Bop2 == \
Zero16 &&
  Zc.Zc == -ID16 && Transpose[Zc] == -Zc && Zc.Aop == Aop.Zc && Zc.Bop2 == \
Bop2.Zc && Zc.\[Beta]D == \[Beta]D.Zc]
pauli = {{{0, 1}, {1, 0}}, {{0, -I}, {I, 0}}, {{1, 0}, {0, -1}}};
bogoliubov[hf_, t0_, t1_, n_: 2] := Module[{e0, v0, e1, v1, half = n/2, sol, \
cc, tt, b2 = 0, a2 = 0, ord0, ord1},
  {e0, v0} = Eigensystem[N[hf[t0]]]; ord0 = Ordering[Re[e0]]; v0 = Normalize \
/@ v0[[ord0]];
  {e1, v1} = Eigensystem[N[hf[t1]]]; ord1 = Ordering[Re[e1]]; v1 = Normalize \
/@ v1[[ord1]];
  Do[sol = NDSolveValue[{cc'[tt] == -I hf[tt].cc[tt], cc[t0] == v0[[j]]}, \
cc[t1], {tt, t0, t1}, Method -> {\"ExplicitRungeKutta\", \"DifferenceOrder\" \
-> 8},
     PrecisionGoal -> 12, AccuracyGoal -> 14, MaxSteps -> Infinity];
   b2 += Total[Abs[Conjugate[v1[[1 ;; half]]].sol]^2]; a2 += \
Total[Abs[Conjugate[v1[[half + 1 ;; n]]].sol]^2], {j, half + 1, n}];
  {b2, a2}/half];\
\>", "Input",
 CellLabel->
  "In[678]:=",ExpressionUUID->"cdc3627c-94c3-ac4e-a99d-085220517922"],

Cell[BoxData[
 RowBox[{"\<\"2x2 reduction: A, B, betaD square to ID16 and anticommute; Zc = \
A.B.betaD: Zc.Zc == -ID16, Transpose[Zc] == -Zc, Zc commutes with A, B, betaD\
\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021244019046345`*^9},
 CellLabel->
  "Out[680]=",ExpressionUUID->"5934bf65-6b6e-724e-8bdb-831dbafe948d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
14.3 Pair creation in the primordial epoch (Einstein\[Dash]Kasner branch p = \
0.547, q = \[Minus]0.160)\
\>", "Subsection",ExpressionUUID->"55a00402-0c68-1840-a385-a18aa1a30bb6"],

Cell[TextData[{
 "For a massless mode, x0 \[RightArrow] \[Lambda] x0 maps the problem with \
momenta (|",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "306e1ece-8856-684e-92a2-1beec9827e41"],
 "|, |",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "9ffecd82-9aac-5b40-8d9e-6a57319c52df"],
 "|) onto one with the single scaling variable K = |",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "e3c5489d-7568-9148-a14a-0b83fe508d33"],
 "| \[Lambda]^(1\[Minus]p), \[Lambda] = (|",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "2f95bdbb-1f93-5c42-ae3e-ff8fdd0c4c4f"],
 "|/|",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "dc190ef6-84f0-be48-b51e-c388b25067e4"],
 "|)^(1/(q\[Minus]p)), so |\[Beta]|\.b2 depends on K only. Creation happens \
around the time at which |",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "dd222f44-9357-fb47-85f4-abbef067a9d1"],
 "|/a \[TildeTilde] |",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "f4d57026-af8e-7446-bee2-80f843ff4d6f"],
 "|/b; the evolution is adiabatic before and after, so the integration runs \
from 10\:207b\.b9\:2075 \[Lambda] to 300 \[Lambda] (or wider). An isotropic \
expansion (a = b) creates no massless pairs (section 13.4); the anisotropy of \
the primordial epoch does."
}], "Text",ExpressionUUID->"298b4bed-25c0-304e-b728-28ea75f83d96"],

Cell[CellGroupData[{

Cell["\<\
pKE = N[(1 + 2 Sqrt[2])/7, 20]; qKE = N[(2 - 3 Sqrt[2])/14, 20];
hKas[ka_, kb_][t_] := ka t^-pKE pauli[[1]] + kb t^-qKE pauli[[2]];
kasData = Table[With[{ka = kk[[1]], kb = kk[[2]], lam = \
(kk[[2]]/kk[[1]])^(1/(qKE - pKE))},
    Join[{ka, kb, ka lam^(1 - pKE)}, bogoliubov[hKas[ka, kb], 10^-15 Min[1, \
lam], 300 Max[1, lam]]]], {kk, {{1., 1.}, {2., 1.}, {1., 3.}}}];
check[\"Kasner pair creation: |alpha|^2 + |beta|^2 == 1 (to 10^-8) for (|p|, \
|q|) = (1,1), (2,1), (1,3)\", And @@ Table[Abs[r[[4]] + r[[5]] - 1] < 10^-8, \
{r, kasData}]]
exK = (1 - pKE)/(qKE - pKE); kaSc = (1/2.5^exK)^(1/(1 - exK)); lamSc = \
(2.5/kaSc)^(1/(qKE - pKE));
check[\"Kasner scaling: (|p|, |q|) = (1.4302.., 2.5) has K = 1 and the same \
|beta|^2 as (1, 1) (to 10^-6)\",
  Abs[bogoliubov[hKas[kaSc, 2.5], 10^-15 Min[1, lamSc], 300 Max[1, \
lamSc]][[1]] - kasData[[1, 4]]] < 10^-6]
mK16 = 0.3; pv16 = {0.6, 0., 0.8}; qv16 = 1.5 {0.5, 0.5, -0.5, 0.5};
h16Kas[t_] := Sum[pv16[[i]] t^-pKE \[Alpha]D[i], {i, 1, 3}] + Sum[qv16[[k - \
3]] t^-qKE \[Alpha]D[k], {k, 4, 7}] + mK16 \[Beta]D;
h2Kas[sg_][t_] := Norm[pv16] t^-pKE pauli[[1]] + Norm[qv16] t^-qKE pauli[[2]] \
+ sg mK16 pauli[[3]];
b16Kas = bogoliubov[h16Kas, 0.05, 40., 16]; b2Kas = bogoliubov[h2Kas[1], \
0.05, 40.]; b2KasM = bogoliubov[h2Kas[-1], 0.05, 40.];
check[\"16x16 evolution == 4 copies of the 2x2 evolution with +m sigma3 and 4 \
with -m sigma3 (Kasner, m = 0.3, |p| = 1, |q| = 1.5, x0 from 0.05 to 40): \
average |beta|^2 agrees to 10^-8; unitarity; the two classes differ\",
  Abs[b16Kas[[1]] - (b2Kas[[1]] + b2KasM[[1]])/2] < 10^-8 && \
Abs[Total[b16Kas] - 1] < 10^-8 && Abs[b2Kas[[1]] - b2KasM[[1]]] > 10^-4]
check[\"isotropic expansion, massless: no pair creation (|beta|^2 < \
10^-20)\", bogoliubov[Function[t, t^-0.4 (0.6 pauli[[1]] + 0.8 pauli[[2]])], \
10^-6, 100.][[1]] < 10^-20]
{\"Kasner beta2 (1,1)\" -> kasData[[1, 4]], \"Kasner beta2 (2,1)\" -> \
kasData[[2, 4]], \"Kasner beta2 (1,3)\" -> kasData[[3, 4]],
 \"Kasner K (1,1)\" -> kasData[[1, 3]], \"Kasner K (2,1)\" -> kasData[[2, \
3]], \"Kasner K (1,3)\" -> kasData[[3, 3]], \"beta2 16x16\" -> b16Kas[[1]], \
\"beta2 2x2 +m\" -> b2Kas[[1]], \"beta2 2x2 -m\" -> b2KasM[[1]]}\
\>", "Input",
 CellLabel->
  "In[683]:=",ExpressionUUID->"b9c1cd55-3e7b-4e43-b1ae-490df12d700a"],

Cell[BoxData[
 RowBox[{"\<\"Kasner pair creation: |alpha|^2 + |beta|^2 == 1 (to 10^-8) for \
(|p|, |q|) = (1,1), (2,1), (1,3)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021244022928066`*^9},
 CellLabel->
  "Out[686]=",ExpressionUUID->"d6721a5e-e7e3-3e4a-bb3b-152b68a91c27"],

Cell[BoxData[
 RowBox[{"\<\"Kasner scaling: (|p|, |q|) = (1.4302.., 2.5) has K = 1 and the \
same |beta|^2 as (1, 1) (to 10^-6)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021244024191647`*^9},
 CellLabel->
  "Out[688]=",ExpressionUUID->"33ba8662-7304-0a4a-9e19-e03563405b21"],

Cell[BoxData[
 RowBox[{"\<\"16x16 evolution == 4 copies of the 2x2 evolution with +m sigma3 \
and 4 with -m sigma3 (Kasner, m = 0.3, |p| = 1, |q| = 1.5, x0 from 0.05 to \
40): average |beta|^2 agrees to 10^-8; unitarity; the two classes differ\"\>",
   "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002124402600807*^9},
 CellLabel->
  "Out[693]=",ExpressionUUID->"c10d11a3-f252-6643-951c-c79dc54c0da0"],

Cell[BoxData[
 RowBox[{"\<\"isotropic expansion, massless: no pair creation (|beta|^2 < \
10^-20)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.00212440260532*^9},
 CellLabel->
  "Out[694]=",ExpressionUUID->"82045983-5d8c-4943-9e8e-70242e5ad9b7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Kasner beta2 (1,1)\"\>", "\[Rule]", "0.010749346168829065`"}],
    ",", 
   RowBox[{"\<\"Kasner beta2 (2,1)\"\>", "\[Rule]", 
    "0.00013294108223524522`"}], ",", 
   RowBox[{"\<\"Kasner beta2 (1,3)\"\>", "\[Rule]", "0.06744202229908397`"}], 
   ",", 
   RowBox[{"\<\"Kasner K (1,1)\"\>", "\[Rule]", "1.`"}], ",", 
   RowBox[{"\<\"Kasner K (2,1)\"\>", "\[Rule]", "3.1182886546569804`"}], ",", 
   RowBox[{"\<\"Kasner K (1,3)\"\>", "\[Rule]", "0.494632237057103`"}], ",", 
   RowBox[{"\<\"beta2 16x16\"\>", "\[Rule]", "0.02705264715696215`"}], ",", 
   RowBox[{"\<\"beta2 2x2 +m\"\>", "\[Rule]", "0.025286592751328656`"}], ",", 
   RowBox[{"\<\"beta2 2x2 -m\"\>", "\[Rule]", "0.028818701562601173`"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{4.00212440260532*^9},
 CellLabel->
  "Out[695]=",ExpressionUUID->"6d41acb8-bb0b-c842-95dc-4e60352b5049"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["14.4 Modern epoch: a static auxiliary space", "Subsection",ExpressionUUID->"064eb6de-5958-4241-9499-1e778890ad34"],

Cell[TextData[{
 "When the auxiliary space has stopped evolving (b = b0, Hb = 0) the Lovelock \
tensors reduce to E^(1) = diag(3Ha\.b2, 2Ha\[Prime] + 3Ha\.b2, 3Ha\[Prime] + \
6Ha\.b2), E^(2) = diag(0, 0, \[Minus]12 Ha\.b2(Ha\[Prime] + Ha\.b2)), E^(3) = \
0 (entries 00, 11, 44). The 00 and 11 equations are the Friedmann equations \
of ordinary cosmology, 3Ha\.b2 = \[Kappa] \[Epsilon] + \[CapitalLambda], 2Ha\
\[Prime] + 3Ha\.b2 = \[Minus]\[Kappa] pa + \[CapitalLambda], with the \
four-dimensional Newton constant G4 = G8/V\[UpTee], where V\[UpTee] = \
b0\:2074 Vc is the proper volume of the auxiliary space (Vc its coordinate \
volume; \[Epsilon]8 = \[Epsilon]4/V\[UpTee] for matter confined to, or \
smeared over, ordinary space). The 44 equation then FIXES the stress that \
must hold b constant: \[Kappa] pb = \[CapitalLambda] \[Minus] 3Ha\[Prime] \
\[Minus] 6Ha\.b2 + 12 \[Alpha]_2 Ha\.b2(Ha\[Prime] + Ha\.b2). A field of \
momentum ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "22be9dda-77dc-b14c-8c7c-203039ddb53e"],
 " along the auxiliary space behaves in ordinary space as a particle of mass \
\[Sqrt](m\.b2 + |",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "de322ab8-ef01-9145-98c0-ed20ba239551"],
 "|\.b2/b0\.b2) (a Kaluza\[Dash]Klein tower when the auxiliary space is a \
torus of coordinate period Lc, ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "c58afd7b-8779-8c43-af0d-014aade80d8e"],
 " = 2\[Pi] ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["n", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "840274e1-cd09-ef4a-8b3c-59fbec4cf52f"],
 "/Lc). The present expansion rate H0 \[TildeTilde] 1.4 \[Times] 10\:207b\
\:2074\.b2 GeV is so small that pair creation today is suppressed by exp(\
\[Minus]2\[Pi]m/H0) (section 14.5)."
}], "Text",ExpressionUUID->"2194d127-57a5-2645-97c4-4916b06875fa"],

Cell[CellGroupData[{

Cell["\<\
modH = Table[Simplify[toH[ECos[[k + 1, c, c]]] /. {Hb -> 0, dHb -> 0}], {k, \
1, 3}, {c, {1, 2, 5}}];
check[\"static auxiliary space (Hb = 0): E^(1) = (3Ha^2, 2Ha' + 3Ha^2, 3Ha' + \
6Ha^2), E^(2) = (0, 0, -12 Ha^2 (Ha' + Ha^2)), E^(3) = 0\",
  Expand[modH - {{3 Ha^2, 2 dHa + 3 Ha^2, 3 dHa + 6 Ha^2}, {0, 0, -12 Ha^2 \
(dHa + Ha^2)}, {0, 0, 0}}] == ConstantArray[0, {3, 3}]]\
\>", "Input",
 CellLabel->
  "In[696]:=",ExpressionUUID->"cf8823da-507c-9c45-84e7-23dc2102e85a"],

Cell[BoxData[
 RowBox[{"\<\"static auxiliary space (Hb = 0): E^(1) = (3Ha^2, 2Ha' + 3Ha^2, \
3Ha' + 6Ha^2), E^(2) = (0, 0, -12 Ha^2 (Ha' + Ha^2)), E^(3) = 0\"\>", "\[Rule]",
   "True"}]], "Output",
 CellChangeTimes->{4.002124402658573*^9},
 CellLabel->
  "Out[697]=",ExpressionUUID->"78cbf236-86d2-df47-9f1f-99b86feb2a53"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
14.5 Far future: de Sitter expansion and thermal pair creation\
\>", "Subsection",ExpressionUUID->"0e5d3845-a83b-f045-b7b5-e98d50c9e1cb"],

Cell[TextData[{
 "Two de Sitter solutions: (a) eight-dimensional de Sitter a = b = e^{H x0}, \
an exact VACUUM solution of the Einstein\[Dash]Lovelock equations when 21 \
\[Alpha]_1 H\.b2 \[Minus] 420 \[Alpha]_2 H\:2074 + 2520 \[Alpha]_3 H\:2076 = \
\[CapitalLambda] (all E^(k) are then proportional to \[Delta]^\[Mu]_\[Nu]); \
(b) de Sitter expansion of ordinary space over a static auxiliary space, a = \
e^{H x0}, b = b0, with E^(1) = diag(3, 3, 6) H\.b2, E^(2) = diag(0, 0, \
\[Minus]12) H\:2074, E^(3) = 0. In both, a mode of dirac16complex obeys i \
dc/dx0 = (k e^{\[Minus]H x0} \[Sigma]1 + M \[Sigma]3) c with M = m in (a) and \
the Kaluza\[Dash]Klein mass M = \[Sqrt](m\.b2 + |",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "e1bb5893-ca5d-fe44-a587-bfb32da4313d"],
 "|\.b2/b0\.b2) in (b). Starting from the adiabatic vacuum at early times, \
the number of created pairs per mode is EXACTLY the Fermi\[Dash]Dirac \
occupation at the Gibbons\[Dash]Hawking temperature H/(2\[Pi]):"
}], "Text",ExpressionUUID->"b3025c52-26c5-a547-b19d-ebb0c7d9b293"],

Cell["      |\[Beta]|\.b2 = 1/(exp(2\[Pi] M/H) + 1),", "Text",ExpressionUUID->"28affdf6-bb14-b445-82bf-300b807148d0"],

Cell["\<\
independent of the momentum k. The check integrates the mode equation \
numerically (H = 1).\
\>", "Text",ExpressionUUID->"0661b47b-2115-e547-bc04-850affdb98fd"],

Cell[CellGroupData[{

Cell["\<\
dS8H = Table[Simplify[toH[ECos[[k + 1, c, c]]] /. {Ha -> hdS, Hb -> hdS, dHa \
-> 0, dHb -> 0}], {k, 1, 3}, {c, {1, 2, 5}}];
check[\"8D de Sitter: E^(1) = 21 H^2, E^(2) = -420 H^4, E^(3) = 2520 H^6 (all \
diagonal entries)\", dS8H == {{21, 21, 21} hdS^2, {-420, -420, -420} hdS^4, \
{2520, 2520, 2520} hdS^6}]
dS4H = Table[Simplify[toH[ECos[[k + 1, c, c]]] /. {Ha -> hdS, Hb -> 0, dHa -> \
0, dHb -> 0}], {k, 1, 3}, {c, {1, 2, 5}}];
check[\"de Sitter over a static auxiliary space: E^(1) = (3, 3, 6) H^2, E^(2) \
= (0, 0, -12) H^4, E^(3) = 0\", dS4H == {{3, 3, 6} hdS^2, {0, 0, -12} hdS^4, \
{0, 0, 0}}]
dSbeta = Table[bogoliubov[Function[t, Exp[-t] pauli[[1]] + mH pauli[[3]]], \
-Log[2000.], Log[10.^6/mH^2]][[1]], {mH, {0.25, 0.5, 1.}}];
check[\"de Sitter pair creation: |beta|^2 == 1/(Exp[2 Pi M/H] + 1) to 10^-7, \
M/H = 0.25, 0.5, 1\",
  And @@ MapThread[Abs[#1 - 1/(Exp[2 Pi #2] + 1)] < 10^-7 &, {dSbeta, {0.25, \
0.5, 1.}}]]
lzBeta = Table[bogoliubov[Function[t, Sqrt[k2] pauli[[1]] + t pauli[[3]]], \
-150., 150.][[1]], {k2, {0.1, 0.5, 1.}}];
check[\"integrator benchmark (Landau-Zener): |beta|^2 == Exp[-Pi kappa^2] to \
10^-6\", And @@ MapThread[Abs[#1 - Exp[-Pi #2]] < 10^-6 &, {lzBeta, {0.1, \
0.5, 1.}}]]
{\"dS beta2 M/H=0.25\" -> dSbeta[[1]], \"dS beta2 M/H=0.5\" -> dSbeta[[2]], \
\"dS beta2 M/H=1\" -> dSbeta[[3]], \"FD 0.25\" -> N[1/(Exp[2 Pi 0.25] + 1)],
 \"Landau-Zener\" -> lzBeta}\
\>", "Input",
 CellLabel->
  "In[698]:=",ExpressionUUID->"845678e5-7629-ad47-a6d4-cb0eda244bdc"],

Cell[BoxData[
 RowBox[{"\<\"8D de Sitter: E^(1) = 21 H^2, E^(2) = -420 H^4, E^(3) = 2520 \
H^6 (all diagonal entries)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002124402678623*^9},
 CellLabel->
  "Out[699]=",ExpressionUUID->"e3b4ffcd-4043-394e-92a2-7a3b97bb9d95"],

Cell[BoxData[
 RowBox[{"\<\"de Sitter over a static auxiliary space: E^(1) = (3, 3, 6) H^2, \
E^(2) = (0, 0, -12) H^4, E^(3) = 0\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002124402678623*^9},
 CellLabel->
  "Out[701]=",ExpressionUUID->"7282524b-30a4-6b4a-9cb2-08b2fa171c21"],

Cell[BoxData[
 RowBox[{"\<\"de Sitter pair creation: |beta|^2 == 1/(Exp[2 Pi M/H] + 1) to \
10^-7, M/H = 0.25, 0.5, 1\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002124403058996*^9},
 CellLabel->
  "Out[703]=",ExpressionUUID->"9126220c-e813-404e-8c22-beea9279eadb"],

Cell[BoxData[
 RowBox[{"\<\"integrator benchmark (Landau-Zener): |beta|^2 == Exp[-Pi \
kappa^2] to 10^-6\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021244071547337`*^9},
 CellLabel->
  "Out[705]=",ExpressionUUID->"4583828e-dae4-1243-9862-bf443af31969"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"dS beta2 M/H=0.25\"\>", "\[Rule]", "0.17210291921007925`"}], ",", 
   RowBox[{"\<\"dS beta2 M/H=0.5\"\>", "\[Rule]", "0.0414238844788973`"}], ",", 
   RowBox[{"\<\"dS beta2 M/H=1\"\>", "\[Rule]", "0.0018639774636152915`"}], ",", 
   RowBox[{"\<\"FD 0.25\"\>", "\[Rule]", "0.1721028986836638`"}], ",", 
   RowBox[{"\<\"Landau-Zener\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "0.7304027306401534`", ",", "0.20787954528124913`", ",", 
      "0.043213919275807096`"}], "}"}]}]}], "}"}]], "Output",
 CellChangeTimes->{4.0021244071633186`*^9},
 CellLabel->
  "Out[706]=",ExpressionUUID->"aa3c988a-f13a-744e-8351-03d800a71937"]
}, Open  ]]
}, Open  ]]
