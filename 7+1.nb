Cell[CellGroupData[{

Cell["\<\
(* energy per particle E/A - m in units of m, Hartree (saturating) and \
Hartree-Fock *)
eAcurve[g_, gv_] := Table[N[{kF, eps7[g, gv, kF]/rho7[kF] - 1}], {kF, 3/10, \
1, 1/40}];
ListLinePlot[{eAcurve[gS0, gV0], eAcurve[GS1, GV1]},
 PlotLegends -> {\"Hartree (gS = -10^5, gV = 10^4)\", \"Hartree-Fock (G_S = \
-98750, G_V = 20000)\"}, AxesLabel -> {\"kF\", \"E/A - m\"},
 Epilog -> {Red, PointSize[Medium], Point[{N[kF0], N[eps0/rho0 - 1]}]}, \
PlotRange -> {-0.06, 0.25}, ImageSize -> 600, GridLines -> {None, {0}}]\
\>", "Input",
 CellLabel->
  "In[440]:=",ExpressionUUID->"66de94b8-7dcd-1546-b15b-9442e3910b76"],

