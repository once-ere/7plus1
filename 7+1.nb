      RowBox[{"10", " ", 
       SuperscriptBox["Hb", "2"]}]}], 
     RowBox[{
      RowBox[{"3", " ", "dHa"}], "+", 
      RowBox[{"3", " ", "dHb"}], "+", 
      RowBox[{"6", " ", 
       SuperscriptBox["Ha", "2"]}], "+", 
      RowBox[{"9", " ", "Ha", " ", "Hb"}], "+", 
