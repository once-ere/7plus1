Cell[CellGroupData[{

Cell["9. The chiral Kohn\[Dash]Sham theory (8 + 8 components)", "Section",ExpressionUUID->"5f72075d-be9c-3f46-89ce-78174b43dd5e"],

Cell[CellGroupData[{

Cell["9.1 Chiral densities", "Subsection",ExpressionUUID->"1f2d579c-fc54-4146-b8d8-4aa328fa953e"],

Cell["\<\
With the chiral components \[Phi]_kL = EL\[Dagger].\[Phi]_k and \[Phi]_kR = \
ER\[Dagger].\[Phi]_k of the KS orbitals (section 7.10) the 18 densities \
become one complex scalar density and two 8-currents:\
\>", "Text",ExpressionUUID->"04c50e48-0bca-3a46-8889-d65ef96b3840"],

Cell["\<\
      \[Kappa] = \[CapitalSigma]_k \[Phi]_kL\[Dagger] \[Phi]_kR,      j_L^A = \
\[CapitalSigma]_k \[Phi]_kL\[Dagger] \[Sigma]bar^A \[Phi]_kL,      j_R^A = \
\[CapitalSigma]_k \[Phi]_kR\[Dagger] \[Sigma]^A \[Phi]_kR,\
\>", "Text",ExpressionUUID->"005e2e83-d944-ae41-bd8e-fa1dc686c65a"],

Cell["\<\
      \[Rho]S = \[Kappa] + \[Kappa]* = 2 Re \[Kappa],   \[Rho]P = i (\[Kappa] \
\[Minus] \[Kappa]*) = \[Minus]2 Im \[Kappa],   j^A = j_L^A + j_R^A,   j5^A = \
j_R^A \[Minus] j_L^A,\
\>", "Text",ExpressionUUID->"cd63fe09-b807-1046-8f9b-0bb17b0dc9a6"],

Cell["\<\
with \[Sigma]^A = (ID8, \[Sigma]W[i]) and \[Sigma]bar^A = (ID8, \[Minus]\
\[Sigma]W[i]) as in section 7.11. The scalar and pseudoscalar densities pair \
the two chiralities; the currents do not. The sources become a complex scalar \
source \[Mu] = s + i p and two chiral vector sources: s \[Rho]S + p \[Rho]P = \
\[Mu] \[Kappa] + \[Mu]* \[Kappa]*,   v_A j^A + a_A j5^A = (v \[Minus] a)_A \
j_L^A + (v + a)_A j_R^A.\
\>", "Text",ExpressionUUID->"3ebf348b-c096-1740-81f9-7f2f4d6d35b6"],

Cell[CellGroupData[{

Cell["\<\
orbLV = Array[orbL, 8]; orbLcV = Array[orbLc, 8]; orbRV = Array[orbR, 8]; \
orbRcV = Array[orbRc, 8];   (* phi_L, phi_L^*, phi_R, phi_R^* *)
psiChi = EL.orbLV + ER.orbRV; psiChiDag = orbLcV.ConjugateTranspose[EL] + \
orbRcV.ConjugateTranspose[ER];
densChi[M_] := Expand[psiChiDag.M.psiChi];
\[Kappa]c = Expand[orbLcV.orbRV]; \[Kappa]cc = Expand[orbRcV.orbLV];          \
                         (* kappa and kappa^* *)
\[Sigma]Up = Join[{ID8}, Table[\[Sigma]W[i], {i, 1, 7}]]; \[Sigma]barUp = \
Join[{ID8}, Table[-\[Sigma]W[i], {i, 1, 7}]];
jLc = Table[Expand[orbLcV.\[Sigma]barUp[[A + 1]].orbLV], {A, 0, 7}]; jRc = \
Table[Expand[orbRcV.\[Sigma]Up[[A + 1]].orbRV], {A, 0, 7}];
check[\"chiral densities: \[Rho]S == \[Kappa] + \[Kappa]^*, \[Rho]P == I(\
\[Kappa] - \[Kappa]^*), j^A == jL^A + jR^A, j5^A == jR^A - jL^A (symbolic \
chiral orbitals)\",
  Expand[densChi[\[CapitalGamma]17[0]] - \[Kappa]c - \[Kappa]cc] === 0 && \
Expand[densChi[\[CapitalGamma]17[0].(I \[Chi]17)] - I (\[Kappa]c - \
\[Kappa]cc)] === 0 &&
  And @@ Table[Expand[densChi[\[CapitalGamma]17[0].\[CapitalGamma]17up[A]] - \
jLc[[A + 1]] - jRc[[A + 1]]] === 0 &&
    Expand[densChi[\[CapitalGamma]17[0].\[CapitalGamma]17up[A].\[Chi]17] - \
jRc[[A + 1]] + jLc[[A + 1]]] === 0, {A, 0, 7}]]
check[\"the chiral blocks behind these densities: EL^\[Dagger].\[Beta]D.ER == \
ID8, EL^\[Dagger].\[Beta]D.EL == 0, EL^\[Dagger].\[Alpha]D[i].EL == \
-\[Sigma]W[i], ER^\[Dagger].\[Alpha]D[i].ER == \[Sigma]W[i], EL^\[Dagger].\
\[Alpha]D[i].ER == 0\",
  ConjugateTranspose[EL].\[Beta]D.ER == ID8 && \
ConjugateTranspose[EL].\[Beta]D.EL == Zero8 &&
  And @@ Table[ConjugateTranspose[EL].\[Alpha]D[i].EL == -\[Sigma]W[i] && \
ConjugateTranspose[ER].\[Alpha]D[i].ER == \[Sigma]W[i] && \
ConjugateTranspose[EL].\[Alpha]D[i].ER == Zero8, {i, 1, 7}]]\
\>", "Input",
 CellLabel->
  "In[443]:=",ExpressionUUID->"a2bdad58-4b34-6a47-b7c5-a78b2aa9d778"],

Cell[BoxData[
 RowBox[{"\<\"chiral densities: \[Rho]S == \[Kappa] + \[Kappa]^*, \[Rho]P == \
I(\[Kappa] - \[Kappa]^*), j^A == jL^A + jR^A, j5^A == jR^A - jL^A (symbolic \
chiral orbitals)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494821593533`*^9},
 CellLabel->
  "Out[449]=",ExpressionUUID->"4d008193-ffd8-ef4b-9364-15d1805529d4"],

Cell[BoxData[
 RowBox[{"\<\"the chiral blocks behind these densities: \
EL^\[Dagger].\[Beta]D.ER == ID8, EL^\[Dagger].\[Beta]D.EL == 0, EL^\[Dagger].\
\[Alpha]D[i].EL == -\[Sigma]W[i], ER^\[Dagger].\[Alpha]D[i].ER == \
\[Sigma]W[i], EL^\[Dagger].\[Alpha]D[i].ER == 0\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020494821741447`*^9},
 CellLabel->
  "Out[450]=",ExpressionUUID->"7867e7b9-eeea-e744-9f1f-b3395daef8f2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.2 The Hartree energy in chiral variables", "Subsection",ExpressionUUID->"6a01e599-72b1-894a-a318-679e94df0990"],

Cell["In chiral variables the Hartree energy density is", "Text",ExpressionUUID->"d53aa057-56e1-324e-89c8-3478bd62ac35"],

Cell["\<\
      e_H = (gS/2)(\[Kappa] + \[Kappa]*)\.b2 \[Minus] (gP/2)(\[Kappa] \
\[Minus] \[Kappa]*)\.b2 + ((gV + gA)/2)(j_L^A j_LA + j_R^A j_RA) + (gV \
\[Minus] gA) j_L^A j_RA\
\>", "Text",ExpressionUUID->"7431ff72-ef9c-9240-9786-ec76bce3754b"],

Cell["          = ((gS \[Minus] gP)/2)(\[Kappa]\.b2 + \[Kappa]*\.b2) + (gS + \
gP) \[Kappa] \[Kappa]* + \[Ellipsis] .", "Text",ExpressionUUID->"4f64c232-\
a47d-2542-8e6c-20edc0c84717"],

Cell["\<\
The scalar\[Dash]pseudoscalar part depends on \[Kappa] only through \
|\[Kappa]|\.b2 exactly when gP = gS; then it is 2 gS |\[Kappa]|\.b2, the \
Nambu\[Dash]Jona-Lasinio form. The vector\[Dash]axial part couples the two \
currents only through gV \[Minus] gA.\
\>", "Text",ExpressionUUID->"9042ef1d-4c78-b64f-8aeb-43eb60c78e65"],

Cell[CellGroupData[{

Cell["\<\
EHchiAbs[k_, kc_, jl_List, jr_List] := gS/2 (k + kc)^2 - gP/2 (k - kc)^2 +
   (gV + gA)/2 Sum[\[Eta]17[[A + 1, A + 1]] (jl[[A + 1]]^2 + jr[[A + 1]]^2), \
{A, 0, 7}] + (gV - gA) Sum[\[Eta]17[[A + 1, A + 1]] jl[[A + 1]] jr[[A + 1]], \
{A, 0, 7}];
EHchi = Expand[EHchiAbs[\[Kappa]c, \[Kappa]cc, jLc, jRc]];
check[\"E_H (16-component form, chiral orbitals) == gS/2 (\[Kappa] + \
\[Kappa]^*)^2 - gP/2 (\[Kappa] - \[Kappa]^*)^2 + (gV + gA)/2 (jL.jL + jR.jR) \
+ (gV - gA) jL.jR\",
  Expand[EHfun[densChi] - EHchi] === 0]\
\>", "Input",
 CellLabel->
  "In[451]:=",ExpressionUUID->"422b6ec0-ad3a-3646-8d66-f5d96df1a627"],

Cell[BoxData[
 RowBox[{"\<\"E_H (16-component form, chiral orbitals) == gS/2 (\[Kappa] + \
\[Kappa]^*)^2 - gP/2 (\[Kappa] - \[Kappa]^*)^2 + (gV + gA)/2 (jL.jL + jR.jR) \
+ (gV - gA) jL.jR\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494822105503`*^9},
 CellLabel->
  "Out[453]=",ExpressionUUID->"825e6a3e-c3ac-8343-9f12-3abfdd86488c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.3 The chiral Kohn\[Dash]Sham equations", "Subsection",ExpressionUUID->"982603a5-6be3-b445-8ddf-672d2cf42544"],

Cell["\<\
In chiral components the Kohn\[Dash]Sham equation h_KS \[Phi] = \[Epsilon] \
\[Phi] becomes the 8 + 8 block system (W\[Dagger].h_KS.W):\
\>", "Text",ExpressionUUID->"d55fc497-8af8-9e4a-a12c-11f9c45f0bc5"],

Cell["      [V^L_0 \[Minus] \[Sigma]W[i] (\[Minus]i \[PartialD]_i + V^L_i)] \
\[Phi]L + M \[Phi]R = \[Epsilon] \[Phi]L,", "Text",ExpressionUUID->"2ee9a6e2-\
52d6-3347-8dd6-b5eb8150939c"],

Cell["      M* \[Phi]L + [V^R_0 + \[Sigma]W[i] (\[Minus]i \[PartialD]_i + \
V^R_i)] \[Phi]R = \[Epsilon] \[Phi]R,", "Text",ExpressionUUID->"a2acccf4-6eae-\
b64d-8605-b940d2250043"],

Cell["\<\
with the complex Kohn\[Dash]Sham mass M = m + S + i P and the chiral vector \
potentials V^L_A = V_A \[Minus] A_A, V^R_A = V_A + A_A. Since \[Sigma]W[i](\
\[Minus]i\[PartialD]_i) = \[Tau]O[i] \[PartialD]_i, the derivative terms \
contain only the real \[Tau]O[i], exactly as in section 7.11; the mass M \
couples the two chiralities. The potentials are Wirtinger derivatives of the \
energy:\
\>", "Text",ExpressionUUID->"1423c550-32a7-b24a-b1f3-9993f36f9868"],

Cell["\<\
      M \[Minus] m = \[Mu] + \[PartialD](E_H + E_xc)/\[PartialD]\[Kappa],   \
V^L_A = (v \[Minus] a)_A + \[PartialD](E_H + E_xc)/\[PartialD]j_L^A,   V^R_A \
= (v + a)_A + \[PartialD](E_H + E_xc)/\[PartialD]j_R^A;\
\>", "Text",ExpressionUUID->"0d77c3f4-1b13-3e46-949d-f696b4afcad2"],

Cell["\<\
Hartree:   M \[Minus] m \[Minus] \[Mu] = gS (\[Kappa] + \[Kappa]*) \[Minus] \
gP (\[Kappa] \[Minus] \[Kappa]*) = gS \[Rho]S + i gP \[Rho]P,   V^L_A \
\[Minus] (v \[Minus] a)_A = (gV + gA) j_LA + (gV \[Minus] gA) j_RA,   V^R_A \
\[Minus] (v + a)_A = (gV + gA) j_RA + (gV \[Minus] gA) j_LA.\
\>", "Text",ExpressionUUID->"f98b911d-3ea8-5348-acd4-d12ac5485ca2"],

Cell["\<\
The densities \[Kappa], j_L, j_R are computed from the occupied chiral \
orbitals (no sea, as in section 8.4), and the total energy is\
\>", "Text",ExpressionUUID->"605480be-1e66-f54d-8e45-7789b559403e"],

Cell["\<\
      E = \[CapitalSigma]_k \[Epsilon]_k \[Minus] \[Integral] [ 2 Re((M \
\[Minus] m \[Minus] \[Mu]) \[Kappa]) + (V^L \[Minus] v + a)_A j_L^A + (V^R \
\[Minus] v \[Minus] a)_A j_R^A ] d\:2077x + E_H + E_xc.\
\>", "Text",ExpressionUUID->"b005665c-4574-f347-88f5-0dfa92a27cc1"],

Cell[CellGroupData[{

Cell["\<\
VLks = VKS - AKS; VRks = VKS + AKS; Mks = mD + Sks + I Pks;
hChiKS[q_List] := ArrayFlatten[{{VLks[[1]] ID8 - Sum[\[Sigma]W[i] (q[[i]] + \
VLks[[i + 1]]), {i, 1, 7}], Mks ID8},
    {(mD + Sks - I Pks) ID8, VRks[[1]] ID8 + Sum[\[Sigma]W[i] (q[[i]] + \
VRks[[i + 1]]), {i, 1, 7}]}}];
check[\"chiral KS Hamiltonian: W^\[Dagger].h_KS(p).W == {{V^L_0 - \
\[Sigma]W.(p + V^L), M}, {M^*, V^R_0 + \[Sigma]W.(p + V^R)}}, M = m + S + I \
P, V^L = V - A, V^R = V + A\",
  Expand[ConjugateTranspose[Wch].hKS[pv7].Wch - hChiKS[pv7]] === Zero16]
VLc = Table[(gV + gA) \[Eta]17[[A + 1, A + 1]] jLc[[A + 1]] + (gV - gA) \
\[Eta]17[[A + 1, A + 1]] jRc[[A + 1]], {A, 0, 7}];   (* V^L_A, lower index *)
VRc = Table[(gV + gA) \[Eta]17[[A + 1, A + 1]] jRc[[A + 1]] + (gV - gA) \
\[Eta]17[[A + 1, A + 1]] jLc[[A + 1]], {A, 0, 7}];
dEHdk = gS (\[Kappa]c + \[Kappa]cc) - gP (\[Kappa]c - \[Kappa]cc); dEHdkc = \
gS (\[Kappa]c + \[Kappa]cc) + gP (\[Kappa]c - \[Kappa]cc);
check[\"Hartree (Wirtinger): M - m == \[PartialD]e_H/\[PartialD]\[Kappa] == \
gS \[Rho]S + I gP \[Rho]P, V^L_A == \[PartialD]e_H/\[PartialD]jL^A; V^L_A == \
V_A - A_A and V^R_A == V_A + A_A with V_A = gV j_A, A_A = gA j5_A\",
  With[{jlA = Array[jl, 8, 0], jrA = Array[jr, 8, 0]},
    Expand[D[EHchiAbs[kk, kkc, jlA, jrA], kk] - (gS (kk + kkc) - gP (kk - \
kkc))] === 0 &&
    And @@ Table[Expand[D[EHchiAbs[kk, kkc, jlA, jrA], jl[A]] - ((gV + gA) \
\[Eta]17[[A + 1, A + 1]] jl[A] + (gV - gA) \[Eta]17[[A + 1, A + 1]] jr[A])] \
=== 0, {A, 0, 7}]] &&
  Expand[dEHdk - (gS densChi[\[CapitalGamma]17[0]] + I gP densChi[\
\[CapitalGamma]17[0].(I \[Chi]17)])] === 0 &&
  And @@ Table[Expand[VLc[[A + 1]] - (gV \[Eta]17[[A + 1, A + 1]] densChi[\
\[CapitalGamma]17[0].\[CapitalGamma]17up[A]] - gA \[Eta]17[[A + 1, A + 1]] \
densChi[\[CapitalGamma]17[0].\[CapitalGamma]17up[A].\[Chi]17])] === 0 &&
    Expand[VRc[[A + 1]] - (gV \[Eta]17[[A + 1, A + 1]] \
densChi[\[CapitalGamma]17[0].\[CapitalGamma]17up[A]] + gA \[Eta]17[[A + 1, A \
+ 1]] densChi[\[CapitalGamma]17[0].\[CapitalGamma]17up[A].\[Chi]17])] === 0, \
{A, 0, 7}]]
check[\"chiral KS potentials are derivatives: \
\[PartialD]E_H/\[PartialD]\[Phi]L^* == (V^L_0 - \[Sigma]W[i] V^L_i) \[Phi]L + \
(M - m) \[Phi]R and \[PartialD]E_H/\[PartialD]\[Phi]R^* == (V^R_0 + \
\[Sigma]W[i] V^R_i) \[Phi]R + (M - m)^* \[Phi]L\",
  And @@ Table[Expand[D[EHchi, orbLc[a]] - (Sum[VLc[[A + 1]] \[Sigma]barUp[[A \
+ 1]], {A, 0, 7}].orbLV + dEHdk orbRV)[[a]]] === 0 &&
    Expand[D[EHchi, orbRc[a]] - (Sum[VRc[[A + 1]] \[Sigma]Up[[A + 1]], {A, 0, \
7}].orbRV + dEHdkc orbLV)[[a]]] === 0, {a, 1, 8}]]\
\>", "Input",
 CellLabel->
  "In[454]:=",ExpressionUUID->"223d25f8-a2f1-7d4e-b8f0-86416cc39f20"],

Cell[BoxData[
 RowBox[{"\<\"chiral KS Hamiltonian: W^\[Dagger].h_KS(p).W == {{V^L_0 - \
\[Sigma]W.(p + V^L), M}, {M^*, V^R_0 + \[Sigma]W.(p + V^R)}}, M = m + S + I \
P, V^L = V - A, V^R = V + A\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002049482246071*^9},
 CellLabel->
  "Out[456]=",ExpressionUUID->"5d2a9177-ec3c-5a4c-87d3-c71b546c6b7b"],

Cell[BoxData[
 RowBox[{"\<\"Hartree (Wirtinger): M - m == \
\[PartialD]e_H/\[PartialD]\[Kappa] == gS \[Rho]S + I gP \[Rho]P, V^L_A == \
\[PartialD]e_H/\[PartialD]jL^A; V^L_A == V_A - A_A and V^R_A == V_A + A_A \
with V_A = gV j_A, A_A = gA j5_A\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.00204948228446*^9},
 CellLabel->
  "Out[460]=",ExpressionUUID->"a7aa7959-ac09-8041-ad9a-19143cc58e1e"],

Cell[BoxData[
 RowBox[{"\<\"chiral KS potentials are derivatives: \
\[PartialD]E_H/\[PartialD]\[Phi]L^* == (V^L_0 - \[Sigma]W[i] V^L_i) \[Phi]L + \
(M - m) \[Phi]R and \[PartialD]E_H/\[PartialD]\[Phi]R^* == (V^R_0 + \
\[Sigma]W[i] V^R_i) \[Phi]R + (M - m)^* \[Phi]L\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020494823182507`*^9},
 CellLabel->
  "Out[461]=",ExpressionUUID->"ee0e31b3-e5b6-194b-947e-39d95a53866a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.4 Chiral symmetry", "Subsection",ExpressionUUID->"ad385555-73ba-1b46-8fdd-69ade505bbf0"],

Cell["\<\
Because \[Chi]17 = i \[Omega]17, the chiral transformation \[Psi] \
\[RightArrow] e^{i\[Theta]\[Chi]17} \[Psi] = (cos \[Theta] ID16 \[Minus] sin \
\[Theta] \[Omega]17) \[Psi] is a REAL rotation of the 16 components. It acts \
as \[Phi]L \[RightArrow] e^{\[Minus]i\[Theta]} \[Phi]L, \[Phi]R \[RightArrow] \
e^{i\[Theta]} \[Phi]R and \[Kappa] \[RightArrow] e^{2i\[Theta]} \[Kappa]; the \
currents j_L and j_R (hence j and j5) are invariant, while (\[Rho]S, \[Rho]P) \
rotate by the angle 2\[Theta]. Therefore\
\>", "Text",ExpressionUUID->"b8e49dff-9822-1e4f-9f77-f85e393ae750"],

Cell["\<\
      E_H(e^{i\[Theta]\[Chi]17} \[Psi]) \[Minus] E_H(\[Psi]) = ((gS \[Minus] \
gP)/2) [ (e^{4i\[Theta]} \[Minus] 1) \[Kappa]\.b2 + (e^{\[Minus]4i\[Theta]} \
\[Minus] 1) \[Kappa]*\.b2 ]:\
\>", "Text",ExpressionUUID->"53c88696-7a07-b04c-b399-535ab7d340fb"],

Cell["\<\
the interaction is chirally (U(1)_A) symmetric if and only if gP = gS. The \
mass term m(\[Kappa] + \[Kappa]*) in T_s breaks the symmetry explicitly. For \
m = 0, gP = gS and \[Mu] = 0 the whole chiral KS theory is invariant: with \
\[Kappa] = 0 the chiral KS equations decouple into separate 8-component \
equations for \[Phi]L and \[Phi]R, while a self-consistent solution with \
\[Kappa] \[NotEqual] 0 breaks the symmetry spontaneously (section 9.6). The \
check uses cos \[Theta] = 3/5, sin \[Theta] = 4/5.\
\>", "Text",ExpressionUUID->"da3af996-eeb2-9c4d-9e4d-bea0fbae7872"],

Cell[CellGroupData[{

Cell["\<\
U\[Theta] = 3/5 ID16 + I 4/5 \[Chi]17; e2\[Theta] = (3/5 + 4/5 I)^2;
check[\"e^(I\[Theta]\[Chi]17) == cos\[Theta] ID16 - sin\[Theta] \[Omega]17 is \
REAL and orthogonal; U.EL == e^(-I\[Theta]) EL, U.ER == e^(I\[Theta]) ER\",
  U\[Theta] == 3/5 ID16 - 4/5 \[Omega]17 && FreeQ[U\[Theta], Complex] && \
Transpose[U\[Theta]].U\[Theta] == ID16 &&
  U\[Theta].EL == (3/5 - 4/5 I) EL && U\[Theta].ER == (3/5 + 4/5 I) ER]
check[\"U^\[Dagger].\[Beta]D.U == \[Beta]D.(cos 2\[Theta] ID16 + I sin 2\
\[Theta] \[Chi]17); vector and axial densities invariant\",
  ConjugateTranspose[U\[Theta]].\[Beta]D.U\[Theta] == \
\[Beta]D.(Re[e2\[Theta]] ID16 + I Im[e2\[Theta]] \[Chi]17) &&
  And @@ Table[ConjugateTranspose[U\[Theta]].\[CapitalGamma]17[0].\
\[CapitalGamma]17up[A].U\[Theta] == \
\[CapitalGamma]17[0].\[CapitalGamma]17up[A] &&
    ConjugateTranspose[U\[Theta]].\[CapitalGamma]17[0].\[CapitalGamma]17up[A].\
\[Chi]17.U\[Theta] == \[CapitalGamma]17[0].\[CapitalGamma]17up[A].\[Chi]17, \
{A, 0, 7}]]
EHrot = Expand[EHfun[dens16[ConjugateTranspose[U\[Theta]].#.U\[Theta]] &]];
\[Kappa]16 = dens16[EL.ConjugateTranspose[ER]]; \[Kappa]16c = \
dens16[ER.ConjugateTranspose[EL]];
check[\"E_H(e^(I\[Theta]\[Chi]17) \[Psi]) - E_H(\[Psi]) == (gS - gP)/2 \
[(e^(4I\[Theta]) - 1) \[Kappa]^2 + (e^(-4I\[Theta]) - 1) \[Kappa]^*2]: U(1)_A \
symmetric iff gP == gS\",
  Expand[EHrot - EH16 - (gS - gP)/2 ((e2\[Theta]^2 - 1) \[Kappa]16^2 + \
(Conjugate[e2\[Theta]]^2 - 1) \[Kappa]16c^2)] === 0 &&
  Expand[(EHrot - EH16) /. gP -> gS] === 0 && Expand[EHrot - EH16] =!= 0]\
\>", "Input",
 CellLabel->
  "In[462]:=",ExpressionUUID->"1530f467-8ab6-ab40-99f2-484552db4948"],

Cell[BoxData[
 RowBox[{"\<\"e^(I\[Theta]\[Chi]17) == cos\[Theta] ID16 - sin\[Theta] \
\[Omega]17 is REAL and orthogonal; U.EL == e^(-I\[Theta]) EL, U.ER == e^(I\
\[Theta]) ER\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494823349705`*^9},
 CellLabel->
  "Out[463]=",ExpressionUUID->"c6e37ada-be75-4c42-ace6-e23bc777715e"],

Cell[BoxData[
 RowBox[{"\<\"U^\[Dagger].\[Beta]D.U == \[Beta]D.(cos 2\[Theta] ID16 + I sin \
2\[Theta] \[Chi]17); vector and axial densities invariant\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002049482348976*^9},
 CellLabel->
  "Out[464]=",ExpressionUUID->"d6b7c63d-cbe4-fa40-9e38-c4f2fc5866c5"],

Cell[BoxData[
 RowBox[{"\<\"E_H(e^(I\[Theta]\[Chi]17) \[Psi]) - E_H(\[Psi]) == (gS - gP)/2 \
[(e^(4I\[Theta]) - 1) \[Kappa]^2 + (e^(-4I\[Theta]) - 1) \[Kappa]^*2]: U(1)_A \
symmetric iff gP == gS\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002049482355156*^9},
 CellLabel->
  "Out[467]=",ExpressionUUID->"b3246270-1d34-2041-9485-8ad404a09121"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.5 Uniform matter in chiral form", "Subsection",ExpressionUUID->"a862112e-bdc3-f149-bc93-c3d07235229a"],

Cell[TextData[{
 "For the uniform matter of section 8.7 the chiral densities are \[Kappa] = \
\[Rho]S/2 (real), j_L^0 = j_R^0 = \[Rho]/2 and j_L^i = j_R^i = 0; the chiral \
KS potentials are M = m* (real) and V^L_0 = V^R_0 = V_0. The chiral KS \
Hamiltonian {{V_0 \[Minus] \[Sigma]W\[CenterDot]",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "68f8476a-0b9f-5a4e-b100-40b2a80ed79d"],
 ", m*}, {m*, V_0 + \[Sigma]W\[CenterDot]",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "3430bd7d-c679-8246-be2a-bfad85a6d88a"],
 "}} has the eigenvalues V_0 \[PlusMinus] \[Sqrt](",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "80f6221f-77d0-7445-97cd-37cad44aa0e3"],
 "\.b2 + m*\.b2), each eight times \[LongDash] the spectrum of the \
16-component form, as it must be."
}], "Text",ExpressionUUID->"5013c51c-6fa8-8144-a2ec-c74a795ad101"],

Cell[CellGroupData[{

Cell["\<\
kappaUni = Tr[EL.ConjugateTranspose[ER].Runi.\[CapitalGamma]17[0]];          \
(* kappa = tr(EL.ER^dagger.sum psi psi^dagger), sum psi psi^dagger = \
R.Gamma17[0] *)
jLUni = Table[Tr[EL.\[Sigma]barUp[[A + 1]].ConjugateTranspose[EL].Runi.\
\[CapitalGamma]17[0]], {A, 0, 7}];
jRUni = Table[Tr[ER.\[Sigma]Up[[A + 1]].ConjugateTranspose[ER].Runi.\
\[CapitalGamma]17[0]], {A, 0, 7}];
check[\"uniform matter in chiral form: \[Kappa] == \[Rho]S/2, jL^0 == jR^0 == \
\[Rho]/2, jL^i == jR^i == 0\",
  Expand[kappaUni - \[Rho]Ssym/2] === 0 && Expand[jLUni - Join[{\[Rho]sym/2}, \
ConstantArray[0, 7]]] === ConstantArray[0, 8] &&
  Expand[jRUni - Join[{\[Rho]sym/2}, ConstantArray[0, 7]]] === \
ConstantArray[0, 8]]
hChiUni = ArrayFlatten[{{V0s ID8 - \[Sigma]Wp[pv7], mst ID8}, {mst ID8, V0s \
ID8 + \[Sigma]Wp[pv7]}}];
check[\"(h_\[Chi] - V_0)^2 == (p^2 + m*^2) ID16: eigenvalues V_0 \[PlusMinus] \
Sqrt[p^2 + m*^2], eight times each\",
  Expand[(hChiUni - V0s ID16).(hChiUni - V0s ID16) - (pv7.pv7 + mst^2) ID16] \
=== Zero16 && Tr[hChiUni - V0s ID16] === 0]
chiralUniform = {\"kappa = rhoS/2\" -> N[rhoS0/2, 20], \"jL^0 = jR^0 = \
rho/2\" -> N[rho0/2, 20], \"M = m*\" -> N[ms0, 20], \"V^L_0 = V^R_0 = V0\" -> \
N[V00, 20]}\
\>", "Input",
 CellLabel->
  "In[468]:=",ExpressionUUID->"4b6876b5-0fd2-ba4e-9f91-125d460ff02e"],

Cell[BoxData[
 RowBox[{"\<\"uniform matter in chiral form: \[Kappa] == \[Rho]S/2, jL^0 == \
jR^0 == \[Rho]/2, jL^i == jR^i == 0\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494823901463`*^9},
 CellLabel->
  "Out[471]=",ExpressionUUID->"c0cfaff4-b365-584f-a644-aae05114f4ff"],

Cell[BoxData[
 RowBox[{"\<\"(h_\[Chi] - V_0)^2 == (p^2 + m*^2) ID16: eigenvalues V_0 \
\[PlusMinus] Sqrt[p^2 + m*^2], eight times each\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020494823961487`*^9},
 CellLabel->
  "Out[473]=",ExpressionUUID->"1b893543-dfa4-7640-b599-a0a031cfa0dd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"kappa = rhoS/2\"\>", "\[Rule]", 
    "3.25951329926878367430635869893021`20.*^-6"}], ",", 
   RowBox[{"\<\"jL^0 = jR^0 = rho/2\"\>", "\[Rule]", 
    "6.94050106615843859866668730354489`20.*^-6"}], ",", 
   RowBox[{"\<\"M = m*\"\>", "\[Rule]", 
    "0.34809734014624326513872826021395797875`20."}], ",", 
   RowBox[{"\<\"V^L_0 = V^R_0 = V0\"\>", "\[Rule]", 
    "0.13881002132316877197333374607089775761`20."}]}], "}"}]], "Output",
 CellChangeTimes->{4.00204948240114*^9},
 CellLabel->
  "Out[474]=",ExpressionUUID->"a2bbe618-a93b-b844-85f3-507dd8638295"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
9.6 The chiral vacuum with the Dirac sea: spontaneous chiral symmetry breaking\
\>", "Subsection",ExpressionUUID->"31826fee-6ea9-8044-90ed-b038d1962a03"],

Cell[TextData[{
 "Now keep the Dirac sea \[LongDash] all negative-energy KS orbitals \
occupied, with a momentum cutoff |",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "0f925967-6e2d-d04a-ba44-a3b82eed5488"],
 "| < \[CapitalLambda] \[LongDash] and take gP = gS = g, \[Mu] = 0, V = A = 0 \
and no matter (the vacuum). With a uniform complex KS mass M the chiral KS \
Hamiltonian h_\[Chi](",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "dedcfc3d-1eaa-5141-aa25-2f3abf95e3c6"],
 ") = {{\[Minus]\[Sigma]W\[CenterDot]",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "f22816ea-bacf-f345-a60d-27d20f663ce4"],
 ", M ID8}, {M* ID8, \[Sigma]W\[CenterDot]",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "72bfa9a4-8c0f-b947-8b16-0a033a127b95"],
 "}} (plus m on the off-diagonal blocks when m \[NotEqual] 0, absorbed in M) \
satisfies h_\[Chi]\.b2 = (",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "39bc101f-c6e2-9141-b224-1fe9675c0114"],
 "\.b2 + |M|\.b2) ID16. Its eigenvalues are \[PlusMinus]E, E = \[Sqrt](",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "f2bef4f0-0266-f546-9efe-8b17a308fad2"],
 "\.b2 + |M|\.b2), and the projector on the filled sea is \
\[CapitalPi]\[Minus](",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "8ea083a0-bdf7-7f49-8d74-322b48baef5a"],
 ") = (ID16 \[Minus] h_\[Chi](",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "31c9ce92-4b8e-af4e-a3c3-51a059d21ae8"],
 ")/E)/2, whose RL block is \[Minus]M*/(2E) ID8. Hence"
}], "Text",ExpressionUUID->"093f09ff-87eb-7a47-9ff4-95c295f8b98a"],

Cell[TextData[{
 "      \[Kappa] = \[Minus]4 M* J(|M|),   J(M) = \[Integral]_{|",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "0e56101e-fc0c-4b43-86e3-463b3bc021c5"],
 "|<\[CapitalLambda]} d\:2077p/(2\[Pi])\:2077 1/\[Sqrt](p\.b2 + M\.b2) = \
(1/(120 \[Pi]\:2074)) \[Integral]_0^\[CapitalLambda] p\:2076/\[Sqrt](p\.b2 + \
M\.b2) dp"
}], "Text",ExpressionUUID->"3ae56f83-9650-9843-b058-b3a6508b2758"],

Cell["\<\
(the angular integral gives |S\:2076|/(2\[Pi])\:2077 = 1/(120 \[Pi]\:2074)). \
The Hartree KS mass M = m + 2g \[Kappa]* gives the gap equation\
\>", "Text",ExpressionUUID->"dc6b67d5-9683-f94e-ac97-83860cd706e9"],

Cell["      M = m \[Minus] 8 g J(|M|) M.", "Text",ExpressionUUID->"ae5e03b2-a1c6-1148-99e7-1426ae4dd96b"],

Cell["\<\
For m = 0 a solution M \[NotEqual] 0 exists if and only if 1 + 8 g J(|M|) = 0 \
has a root, i.e. iff g < g_c = \[Minus]1/(8 J(0)) = \[Minus]90 \[Pi]\:2074/\
\[CapitalLambda]\:2076. The vacuum energy density of the KS state (sum of the \
sea eigenvalues minus double counting) is\
\>", "Text",ExpressionUUID->"a8c80066-bfd1-1946-bed2-8f506acafd33"],

Cell["\<\
      E(M) = \[Minus]8 K(|M|) + 8 J(|M|) Re[(M \[Minus] m) M*] + 32 g |M|\.b2 \
J(|M|)\.b2,   K(M) = (1/(120 \[Pi]\:2074)) \[Integral]_0^\[CapitalLambda] p\
\:2076 \[Sqrt](p\.b2 + M\.b2) dp,\
\>", "Text",ExpressionUUID->"7d28efc7-6743-164b-b929-16c18db6bf10"],

Cell["\<\
and its stationarity condition is the gap equation (for m = 0: dE/d|M| = 8|M| \
(1 + 8gJ)(J + |M| J\[Prime])). For m = 0, E depends only on |M|: the broken \
vacua M = |M| e^{i\[Phi]} are degenerate and related by chiral rotations; the \
phase \[Phi] is the Goldstone direction. A small explicit mass m > 0 selects \
the real positive M. Example: \[CapitalLambda] = 1, g = (6/5) g_c; for m > 0, \
m = 1/100.\
\>", "Text",ExpressionUUID->"172d7bf4-0bf6-4e41-8cfb-2c202d71c533"],

Cell[CellGroupData[{

Cell["\<\
\[CapitalLambda]c = 1;
Jsea[M_] = Integrate[q^6/Sqrt[q^2 + M^2], {q, 0, \[CapitalLambda]c}, \
Assumptions -> M > 0]/(120 Pi^4);
Ksea[M_] = Integrate[q^6 Sqrt[q^2 + M^2], {q, 0, \[CapitalLambda]c}, \
Assumptions -> M > 0]/(120 Pi^4);
J0sea = Integrate[q^5, {q, 0, \[CapitalLambda]c}]/(120 Pi^4); K0sea = \
Integrate[q^7, {q, 0, \[CapitalLambda]c}]/(120 Pi^4);
gcrit = -1/(8 J0sea);
check[\"|S^6|/(2 Pi)^7 == 1/(120 Pi^4); J(0) == \[CapitalLambda]^6/(720 \
Pi^4); g_c == -1/(8 J(0)) == -90 Pi^4/\[CapitalLambda]^6; J(M) -> J(0) and \
K(M) -> K(0) as M -> 0\",
  (16 Pi^3/15)/(2 Pi)^7 == 1/(120 Pi^4) && J0sea == 1/(720 Pi^4) && gcrit == \
-90 Pi^4 &&
  Limit[Jsea[M], M -> 0, Direction -> \"FromAbove\"] == J0sea && \
Limit[Ksea[M], M -> 0, Direction -> \"FromAbove\"] == K0sea]
Esea[Mz_, mq_, g_] := -8 Ksea[Abs[Mz]] + 8 Jsea[Abs[Mz]] Re[(Mz - mq) \
Conjugate[Mz]] + 32 g Abs[Mz]^2 Jsea[Abs[Mz]]^2;
E0sea = -8 K0sea;                                              (* E(M = 0), m \
= 0 *)
gNJL = 6/5 gcrit;
gapNJL[M_?NumericQ, mq_] := With[{M1 = SetPrecision[M, 60]}, M1 - mq + 8 gNJL \
Jsea[M1] M1];     (* M - m + 8 g J(M) M, real M > 0 *)
M0NJL = SetPrecision[M /. FindRoot[gapNJL[M, 0]/M, {M, 1/10, 1}, Method -> \
\"Brent\", WorkingPrecision -> 40, AccuracyGoal -> 32, PrecisionGoal -> 32], \
60];
check[\"m = 0, g = 6/5 g_c: the gap equation 1 + 8 g J(|M|) == 0 has the root \
|M| (32 digits); M == 2 g \[Kappa]^* with \[Kappa] == -4 M J; E is stationary \
there and lower than E(0)\",
  Abs[1 + 8 gNJL Jsea[M0NJL]] < 10^-25 && Abs[M0NJL - 2 gNJL (-4 M0NJL \
Jsea[M0NJL])] < 10^-25 &&
  Abs[D[-8 Ksea[M] + 8 Jsea[M] M^2 + 32 gNJL M^2 Jsea[M]^2, M] /. M -> M0NJL] \
< 10^-25 && Esea[M0NJL, 0, gNJL] < E0sea]
check[\"degenerate chiral vacua for m = 0: E(|M| e^(I \[CurlyPhi])) == E(|M|) \
for \[CurlyPhi] = 1, 2, 4 (the phase is the Goldstone direction)\",
  And @@ Table[Abs[Esea[M0NJL Exp[I phi], 0, gNJL] - Esea[M0NJL, 0, gNJL]] < \
10^-25, {phi, {1, 2, 4}}]]
mq0 = 1/100;
MmNJL = SetPrecision[M /. FindRoot[gapNJL[M, mq0], {M, 1/10, 1}, Method -> \
\"Brent\", WorkingPrecision -> 40, AccuracyGoal -> 32, PrecisionGoal -> 32], \
60];
check[\"explicit breaking m = 1/100: the real M == m - 8 g J(M) M solves the \
gap equation, E is stationary there, and every complex phase raises E\",
  Abs[MmNJL - mq0 + 8 gNJL Jsea[MmNJL] MmNJL] < 10^-25 && Abs[D[-8 Ksea[M] + \
8 Jsea[M] (M^2 - mq0 M) + 32 gNJL M^2 Jsea[M]^2, M] /. M -> MmNJL] < 10^-25 &&
  And @@ Table[Esea[MmNJL Exp[I phi], mq0, gNJL] > Esea[MmNJL, mq0, gNJL], \
{phi, {1/50, 1/2, 1, 3}}]]
njlVacuum = {\"g_c\" -> N[gcrit, 20], \"g\" -> N[gNJL, 20], \"|M| (m = 0)\" \
-> N[M0NJL, 20], \"kappa (m = 0, M real)\" -> N[-4 M0NJL Jsea[M0NJL], 20],
  \"E(M) - E(0)\" -> N[Esea[M0NJL, 0, gNJL] - E0sea, 20], \"M (m = 1/100)\" \
-> N[MmNJL, 20]}\
\>", "Input",
 CellLabel->
  "In[475]:=",ExpressionUUID->"2183e8a9-f631-0740-b4ad-88756bf0b6a6"],

Cell[BoxData[
 RowBox[{"\<\"|S^6|/(2 Pi)^7 == 1/(120 Pi^4); J(0) == \[CapitalLambda]^6/(720 \
Pi^4); g_c == -1/(8 J(0)) == -90 Pi^4/\[CapitalLambda]^6; J(M) -> J(0) and \
K(M) -> K(0) as M -> 0\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494847042007`*^9},
 CellLabel->
  "Out[480]=",ExpressionUUID->"234a3efd-bec0-3c4f-ae72-21719546ad98"],

Cell[BoxData[
 RowBox[{"\<\"m = 0, g = 6/5 g_c: the gap equation 1 + 8 g J(|M|) == 0 has \
the root |M| (32 digits); M == 2 g \[Kappa]^* with \[Kappa] == -4 M J; E is \
stationary there and lower than E(0)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494847052*^9},
 CellLabel->
  "Out[486]=",ExpressionUUID->"35010c07-f90b-ba4b-94fa-77633e46a112"],

Cell[BoxData[
 RowBox[{"\<\"degenerate chiral vacua for m = 0: E(|M| e^(I \[CurlyPhi])) == \
E(|M|) for \[CurlyPhi] = 1, 2, 4 (the phase is the Goldstone direction)\"\>", 
  "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494847052*^9},
 CellLabel->
  "Out[487]=",ExpressionUUID->"fd936145-43ff-af49-b841-33e745829432"],

Cell[BoxData[
 RowBox[{"\<\"explicit breaking m = 1/100: the real M == m - 8 g J(M) M \
solves the gap equation, E is stationary there, and every complex phase \
raises E\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494847052*^9},
 CellLabel->
  "Out[490]=",ExpressionUUID->"6e3d9e81-ace1-bd4d-a309-c493e50381c6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"g_c\"\>", "\[Rule]", 
    RowBox[{"-", "8766.81819306021935127962994198346001247551`20."}]}], ",", 
   RowBox[{"\<\"g\"\>", "\[Rule]", 
    RowBox[{"-", "10520.18183167226322153555593038015201497062`20."}]}], ",", 
   RowBox[{"\<\"|M| (m = 0)\"\>", "\[Rule]", 
    "0.55369385182924169122138104183174453015`20."}], ",", 
   RowBox[{"\<\"kappa (m = 0, M real)\"\>", "\[Rule]", 
    RowBox[{"-", "0.00002631579285836487419990714178227495`20."}]}], ",", 
   RowBox[{"\<\"E(M) - E(0)\"\>", "\[Rule]", 
    RowBox[{"-", "1.31024496290100224732783025255284`20.*^-6"}]}], ",", 
   RowBox[{"\<\"M (m = 1/100)\"\>", "\[Rule]", 
    "0.58531284674622051122833082214556460331`20."}]}], "}"}]], "Output",
 CellChangeTimes->{4.002049484723543*^9},
 CellLabel->
  "Out[491]=",ExpressionUUID->"1663af7d-8bed-224b-a2f2-2cc1a5bd9ea3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
(* the filled sea at one momentum, with a complex M: an explicit check of \
kappa_p and of the sea energy *)
pS = {3/10, -1/5, 1/10, 1/4, 0, -3/20, 1/20}; Mz7 = M0NJL Exp[7 I/10];
hChiSea = ArrayFlatten[{{-\[Sigma]Wp[pS], Mz7 ID8}, {Conjugate[Mz7] ID8, \
\[Sigma]Wp[pS]}}];
Esp = Sqrt[pS.pS + Abs[Mz7]^2]; PiMinus = (ID16 - hChiSea/Esp)/2;
h0Chi = ArrayFlatten[{{-\[Sigma]Wp[pS], Zero8}, {Zero8, \[Sigma]Wp[pS]}}];    \
   (* m = 0 *)
check[\"the sea at one momentum: h_\[Chi]^2 == E^2 ID16; \[CapitalPi]_- is a \
projector of rank 8; \[Kappa]_p == tr(\[CapitalPi]_- RL block) == -4 M^*/E; \
tr(\[CapitalPi]_-.h0) == -8E + 8 Re[(M - m) M^*]/E\",
  Max[Abs[hChiSea.hChiSea - Esp^2 ID16]] < 10^-20 && Max[Abs[PiMinus.PiMinus \
- PiMinus]] < 10^-20 && Abs[Tr[PiMinus] - 8] < 10^-20 &&
  Abs[Tr[PiMinus[[9 ;; 16, 1 ;; 8]]] + 4 Conjugate[Mz7]/Esp] < 10^-20 && \
Abs[Tr[PiMinus.h0Chi] - (-8 Esp + 8 Abs[Mz7]^2/Esp)] < 10^-20]
Plot[{Esea[Mx, 0, gNJL] - E0sea, Esea[Mx, 0, gcrit] - E0sea, Esea[Mx, 0, 4/5 \
gcrit] - E0sea}, {Mx, 0.001, 0.9},
 PlotLegends -> {\"g = 6/5 g_c (broken)\", \"g = g_c\", \"g = 4/5 g_c \
(symmetric)\"}, AxesLabel -> {\"|M|\", \"E(M) - E(0)\"},
 Epilog -> {Red, PointSize[Medium], Point[{N[M0NJL], N[Esea[M0NJL, 0, gNJL] - \
E0sea]}]}, ImageSize -> 600]\
\>", "Input",
 CellLabel->
  "In[492]:=",ExpressionUUID->"de11490d-fe9d-d145-8baf-441860f9d7ad"],

Cell[BoxData[
 RowBox[{"\<\"the sea at one momentum: h_\[Chi]^2 == E^2 ID16; \[CapitalPi]_- \
is a projector of rank 8; \[Kappa]_p == tr(\[CapitalPi]_- RL block) == -4 \
M^*/E; tr(\[CapitalPi]_-.h0) == -8E + 8 Re[(M - m) M^*]/E\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002049484735016*^9},
 CellLabel->
  "Out[497]=",ExpressionUUID->"f34258d5-2be0-604c-adbf-ee09fcc6ba83"],

