Cell[CellGroupData[{

Cell["\<\
Alternativity, Moufang identities, norm, conjugation, inverse (symbolic \
proofs)\
\>", "Subsubsection",ExpressionUUID->"cb54ae63-97c7-3a4b-a21d-3b839df50405"],

Cell["\<\
xs, ys, zs are general octonions with symbolic components a[0..7], b[0..7], \
c[0..7]. Identities that are linear in some arguments (Moufang) are proven by \
letting those arguments run over the basis, which is enough by linearity.\
\>", "Text",ExpressionUUID->"f15a4638-3451-b947-97f8-335faf8f4ad9"],

Cell[CellGroupData[{

Cell["\<\
check[\"left alternative: x(xy) == (xx)y (symbolic)\", Expand[oMul[xs, \
oMul[xs, ys]] - oMul[oMul[xs, xs], ys]] === zero8]
check[\"right alternative: (yx)x == y(xx) (symbolic)\", Expand[oMul[oMul[ys, \
xs], xs] - oMul[ys, oMul[xs, xs]]] === zero8]
check[\"flexible: (xy)x == x(yx) (symbolic)\", Expand[oMul[oMul[xs, ys], xs] \
- oMul[xs, oMul[ys, xs]]] === zero8]
check[\"associator is alternating: [x,y,z] == -[y,x,z] == -[x,z,y] (symbolic)\
\",
  Expand[oAssoc[xs, ys, zs] + oAssoc[ys, xs, zs]] === zero8 && \
Expand[oAssoc[xs, ys, zs] + oAssoc[xs, zs, ys]] === zero8]
check[\"power associativity: x(xx) == (xx)x (symbolic)\", Expand[oMul[xs, \
oMul[xs, xs]] - oMul[oMul[xs, xs], xs]] === zero8]
check[\"Moufang: z(x(zy)) == ((zx)z)y, x(z(yz)) == ((xz)y)z, (zx)(yz) == \
(z(xy))z (x, y basis units, z symbolic)\",
  And @@ Flatten[Table[With[{xx = ev[A], yy = ev[K]},
      Expand[oMul[zs, oMul[xx, oMul[zs, yy]]] - oMul[oMul[oMul[zs, xx], zs], \
yy]] === zero8 &&
      Expand[oMul[xx, oMul[zs, oMul[yy, zs]]] - oMul[oMul[oMul[xx, zs], yy], \
zs]] === zero8 &&
      Expand[oMul[oMul[zs, xx], oMul[yy, zs]] - oMul[oMul[zs, oMul[xx, yy]], \
zs]] === zero8], {A, 0, 7}, {K, 0, 7}]]]
check[\"x x\:0304 == x\:0304 x == N(x) e[0] (symbolic)\",
  Expand[oMul[xs, oConj[xs]] - oNorm2[xs] ev[0]] === zero8 && \
Expand[oMul[oConj[xs], xs] - oNorm2[xs] ev[0]] === zero8]
check[\"conjugation is an anti-automorphism: conj(xy) == conj(y) conj(x) \
(symbolic)\",
  Expand[oConj[oMul[xs, ys]] - oMul[oConj[ys], oConj[xs]]] === zero8]
check[\"Re(x) == (x + x\:0304)/2 == x0\", (xs + oConj[xs])/2 == oRe[xs] ev[0] \
&& oRe[xs] === a[0]]
check[\"norm is multiplicative: N(xy) == N(x) N(y) (symbolic; Degen's \
eight-square identity)\",
  Expand[oNorm2[oMul[xs, ys]] - oNorm2[xs] oNorm2[ys]] === 0]
check[\"inverse x^-1 = x\:0304/N(x): x x^-1 == x^-1 x == e[0] (symbolic)\",
  Simplify[oMul[xs, oInv[xs]] - ev[0]] === zero8 && Simplify[oMul[oInv[xs], \
xs] - ev[0]] === zero8]
check[\"every x satisfies x x - 2 Re(x) x + N(x) e[0] == 0, so the subalgebra \
generated by x is \[DoubleStruckCapitalR] or \[DoubleStruckCapitalC]\",
  Expand[oMul[xs, xs] - 2 oRe[xs] xs + oNorm2[xs] ev[0]] === zero8]\
\>", "Input",
 CellLabel->
  "In[122]:=",ExpressionUUID->"9e31ec19-7a01-684c-aa3a-eeedd522e546"],

Cell[BoxData[
 RowBox[{"\<\"left alternative: x(xy) == (xx)y (symbolic)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020494702215214`*^9},
 CellLabel->
  "Out[122]=",ExpressionUUID->"c2984edf-8e70-cb45-bf6c-144ca4b99780"],

Cell[BoxData[
 RowBox[{"\<\"right alternative: (yx)x == y(xx) (symbolic)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020494702265205`*^9},
 CellLabel->
  "Out[123]=",ExpressionUUID->"6b2dcd45-4b2e-564d-8587-c92c47c2270d"],

Cell[BoxData[
 RowBox[{"\<\"flexible: (xy)x == x(yx) (symbolic)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002049470231785*^9},
 CellLabel->
  "Out[124]=",ExpressionUUID->"006771af-6a68-5847-b958-28288b4acc2d"],

Cell[BoxData[
 RowBox[{"\<\"associator is alternating: [x,y,z] == -[y,x,z] == -[x,z,y] \
(symbolic)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002049470243786*^9},
 CellLabel->
  "Out[125]=",ExpressionUUID->"e55962bd-f043-9846-8a64-3143bded4d5a"],

Cell[BoxData[
 RowBox[{"\<\"power associativity: x(xx) == (xx)x (symbolic)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020494702497864`*^9},
 CellLabel->
  "Out[126]=",ExpressionUUID->"dc998afa-eca7-bf49-bc2c-1e3a319a5293"],

Cell[BoxData[
 RowBox[{"\<\"Moufang: z(x(zy)) == ((zx)z)y, x(z(yz)) == ((xz)y)z, (zx)(yz) \
== (z(xy))z (x, y basis units, z symbolic)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020494703997726`*^9},
 CellLabel->
  "Out[127]=",ExpressionUUID->"c5d283fb-a070-b24c-854b-f288128a9ac5"],

Cell[BoxData[
 RowBox[{"\<\"x x\:0304 == x\:0304 x == N(x) e[0] (symbolic)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020494704048347`*^9},
 CellLabel->
  "Out[128]=",ExpressionUUID->"290c4f17-45c0-a24b-ae1c-afa34aaa3055"],

Cell[BoxData[
 RowBox[{"\<\"conjugation is an anti-automorphism: conj(xy) == conj(y) \
conj(x) (symbolic)\"\>", "\[Rule]", "True"}]], "Output",
