        SuperscriptBox["qH", "4"], " ", "w1"}], "-", "\[CapitalLambda]", "-", 
       RowBox[{"6", " ", "qH", " ", "\[CapitalLambda]"}], "-", 
       RowBox[{"3", " ", 
        SuperscriptBox["qH", "2"], " ", "\[CapitalLambda]"}]}], 
