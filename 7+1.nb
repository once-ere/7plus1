   RowBox[{"\<\"G_0\"\>", "\[Rule]", 
    RowBox[{
     FractionBox[
      RowBox[{"15", " ", 
       RowBox[{"gg", "[", "0", "]"}]}], "16"], "-", 
     FractionBox[
      RowBox[{"gg", "[", "1", "]"}], "2"], "-", 
     FractionBox[
      RowBox[{"7", " ", 
       RowBox[{"gg", "[", "2", "]"}]}], "4"], "-", 
     FractionBox[
      RowBox[{"7", " ", 
