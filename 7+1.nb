     FractionBox[
      RowBox[{"7", " ", 
       RowBox[{"gg", "[", "6", "]"}]}], "4"], "-", 
     FractionBox[
      RowBox[{"gg", "[", "7", "]"}], "2"], "-", 
     FractionBox[
