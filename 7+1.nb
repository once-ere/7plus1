Cell[CellGroupData[{

Cell["\<\
Alternativity, Moufang identities, norm, conjugation, inverse (symbolic \
proofs)\
\>", "Subsubsection",ExpressionUUID->"b0d06ece-f84b-4d4b-b626-90aa1b71a586"],

Cell["\<\
xs, ys, zs are general octonions with symbolic components a[0..7], b[0..7], \
c[0..7]. Identities that are linear in some arguments (Moufang) are proven by \
letting those arguments run over the basis, which is enough by linearity.\
\>", "Text",ExpressionUUID->"57efc279-5c7d-8a4e-a8ce-b967990c35e9"],

Cell[CellGroupData[{

Cell["\<\
check[\"left alternative: x(xy) == (xx)y (symbolic)\", Expand[oMul[xs, \
oMul[xs, ys]] - oMul[oMul[xs, xs], ys]] === zero8]
check[\"right alternative: (yx)x == y(xx) (symbolic)\", Expand[oMul[oMul[ys, \
xs], xs] - oMul[ys, oMul[xs, xs]]] === zero8]
check[\"flexible: (xy)x == x(yx) (symbolic)\", Expand[oMul[oMul[xs, ys], xs] \
- oMul[xs, oMul[ys, xs]]] === zero8]
check[\"associator is alternating: [x,y,z] == -[y,x,z] == -[x,z,y] (symbolic)\
\",
  Expand[oAssoc[xs, ys, zs] + oAssoc[ys, xs, zs]] === zero8 && \
Expand[oAssoc[xs, ys, zs] + oAssoc[xs, zs, ys]] === zero8]
check[\"power associativity: x(xx) == (xx)x (symbolic)\", Expand[oMul[xs, \
oMul[xs, xs]] - oMul[oMul[xs, xs], xs]] === zero8]
check[\"Moufang: z(x(zy)) == ((zx)z)y, x(z(yz)) == ((xz)y)z, (zx)(yz) == \
(z(xy))z (x, y basis units, z symbolic)\",
  And @@ Flatten[Table[With[{xx = ev[A], yy = ev[K]},
      Expand[oMul[zs, oMul[xx, oMul[zs, yy]]] - oMul[oMul[oMul[zs, xx], zs], \
yy]] === zero8 &&
      Expand[oMul[xx, oMul[zs, oMul[yy, zs]]] - oMul[oMul[oMul[xx, zs], yy], \
zs]] === zero8 &&
      Expand[oMul[oMul[zs, xx], oMul[yy, zs]] - oMul[oMul[zs, oMul[xx, yy]], \
zs]] === zero8], {A, 0, 7}, {K, 0, 7}]]]
check[\"x x\:0304 == x\:0304 x == N(x) e[0] (symbolic)\",
  Expand[oMul[xs, oConj[xs]] - oNorm2[xs] ev[0]] === zero8 && \
Expand[oMul[oConj[xs], xs] - oNorm2[xs] ev[0]] === zero8]
check[\"conjugation is an anti-automorphism: conj(xy) == conj(y) conj(x) \
(symbolic)\",
  Expand[oConj[oMul[xs, ys]] - oMul[oConj[ys], oConj[xs]]] === zero8]
check[\"Re(x) == (x + x\:0304)/2 == x0\", (xs + oConj[xs])/2 == oRe[xs] ev[0] \
&& oRe[xs] === a[0]]
check[\"norm is multiplicative: N(xy) == N(x) N(y) (symbolic; Degen's \
eight-square identity)\",
  Expand[oNorm2[oMul[xs, ys]] - oNorm2[xs] oNorm2[ys]] === 0]
check[\"inverse x^-1 = x\:0304/N(x): x x^-1 == x^-1 x == e[0] (symbolic)\",
  Simplify[oMul[xs, oInv[xs]] - ev[0]] === zero8 && Simplify[oMul[oInv[xs], \
xs] - ev[0]] === zero8]
check[\"every x satisfies x x - 2 Re(x) x + N(x) e[0] == 0, so the subalgebra \
generated by x is \[DoubleStruckCapitalR] or \[DoubleStruckCapitalC]\",
  Expand[oMul[xs, xs] - 2 oRe[xs] xs + oNorm2[xs] ev[0]] === zero8]\
\>", "Input",
 CellLabel->
  "In[122]:=",ExpressionUUID->"fc60e740-a9b2-3a40-aa43-2a8978f307cd"],

Cell[BoxData[
 RowBox[{"\<\"left alternative: x(xy) == (xx)y (symbolic)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020404796650696`*^9},
 CellLabel->
  "Out[122]=",ExpressionUUID->"211e2078-2360-a447-987b-5db17de99c08"],

Cell[BoxData[
 RowBox[{"\<\"right alternative: (yx)x == y(xx) (symbolic)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002040479669073*^9},
 CellLabel->
  "Out[123]=",ExpressionUUID->"6f10e8e6-8b72-8f4f-9429-ef45f418b0ed"],

Cell[BoxData[
 RowBox[{"\<\"flexible: (xy)x == x(yx) (symbolic)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020404796708164`*^9},
 CellLabel->
  "Out[124]=",ExpressionUUID->"16ac3007-ffde-dc4e-b6fb-697cc1492ffb"],

Cell[BoxData[
 RowBox[{"\<\"associator is alternating: [x,y,z] == -[y,x,z] == -[x,z,y] \
(symbolic)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020404796860523`*^9},
 CellLabel->
  "Out[125]=",ExpressionUUID->"bc7fa373-c250-8548-ad7a-d48df26c9dca"],

Cell[BoxData[
 RowBox[{"\<\"power associativity: x(xx) == (xx)x (symbolic)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020404796900578`*^9},
 CellLabel->
  "Out[126]=",ExpressionUUID->"71b68082-fecb-aa4a-9b5c-df9dc2fad1e2"],

Cell[BoxData[
 RowBox[{"\<\"Moufang: z(x(zy)) == ((zx)z)y, x(z(yz)) == ((xz)y)z, (zx)(yz) \
== (z(xy))z (x, y basis units, z symbolic)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020404798372173`*^9},
 CellLabel->
  "Out[127]=",ExpressionUUID->"254aa7c7-1341-d74f-8557-419b11896b84"],

Cell[BoxData[
 RowBox[{"\<\"x x\:0304 == x\:0304 x == N(x) e[0] (symbolic)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002040479843157*^9},
 CellLabel->
  "Out[128]=",ExpressionUUID->"c2bd6347-a520-ba44-85ea-eeef8d646afb"],

Cell[BoxData[
 RowBox[{"\<\"conjugation is an anti-automorphism: conj(xy) == conj(y) \
conj(x) (symbolic)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002040479843157*^9},
 CellLabel->
  "Out[129]=",ExpressionUUID->"8bb4957f-ba0d-9741-8ef8-94aafb493432"],

Cell[BoxData[
 RowBox[{"\<\"Re(x) == (x + x\:0304)/2 == x0\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002040479843157*^9},
 CellLabel->
  "Out[130]=",ExpressionUUID->"df5c651f-db98-d74a-baae-3adf26065c85"],

Cell[BoxData[
 RowBox[{"\<\"norm is multiplicative: N(xy) == N(x) N(y) (symbolic; Degen's \
eight-square identity)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020404798587875`*^9},
 CellLabel->
  "Out[131]=",ExpressionUUID->"38fec87c-662d-5143-a3e1-ec9dd2970239"],

Cell[BoxData[
 RowBox[{"\<\"inverse x^-1 = x\:0304/N(x): x x^-1 == x^-1 x == e[0] \
(symbolic)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020404798587875`*^9},
 CellLabel->
  "Out[132]=",ExpressionUUID->"eee531f9-f620-1241-86e7-0260822152a7"],

Cell[BoxData[
 RowBox[{"\<\"every x satisfies x x - 2 Re(x) x + N(x) e[0] == 0, so the \
subalgebra generated by x is \[DoubleStruckCapitalR] or \
\[DoubleStruckCapitalC]\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020404798587875`*^9},
 CellLabel->
  "Out[133]=",ExpressionUUID->"11e519e7-0f91-6948-be98-0c3695559281"]
}, Open  ]],

Cell["\<\
Degen\[CloseCurlyQuote]s eight-square identity, explicitly: the eight \
components of x y are bilinear forms, and the sum of their squares equals (a0\
\.b2 + \[Ellipsis] + a7\.b2)(b0\.b2 + \[Ellipsis] + b7\.b2). Hence N(x) = 0 \
forces x = 0, and xy = 0 forces x = 0 or y = 0: unlike the split octonions, \
the octonions have no zero divisors (a division algebra).\
\>", "Text",ExpressionUUID->"91b0cf79-14a4-bb4a-82c0-9250b9c99fa3"],

Cell[CellGroupData[{

