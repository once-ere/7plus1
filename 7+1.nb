Cell[CellGroupData[{

Cell["\<\
check[\"4+4: \[Zeta][7] == diag(-1,-1,-1,-1,1,1,1,1)\", \[Zeta][7] == \
DiagonalMatrix[{-1, -1, -1, -1, 1, 1, 1, 1}]]
check[\"4+4: \[Sigma] == \[Zeta][1].\[Zeta][2].\[Zeta][3]\", \[Sigma] == \
\[Zeta][1].\[Zeta][2].\[Zeta][3]]
check[\"4+4: (\[Zeta][A].\[Zeta][B] + \[Zeta][B].\[Zeta][A])/2 == \
-\[Eta]4488[[A+1,B+1]] ID8 (A,B = 1..7)\",
  And @@ Flatten[Table[(\[Zeta][A].\[Zeta][B] + \[Zeta][B].\[Zeta][A])/2 == -\
\[Eta]4488[[A + 1, B + 1]] ID8, {A, 1, 7}, {B, 1, 7}]]]
check[\"4+4: -\[Eta]4488[[A+1,A+1]] \[Zeta][A] == Transpose[\[Zeta][A]] (A = \
1..7)\",
  And @@ Table[-\[Eta]4488[[A + 1, A + 1]] \[Zeta][A] == \
Transpose[\[Zeta][A]], {A, 1, 7}]]
check[\"4+4: (\[Tau][A].\[Tau]bar[B] + \[Tau][B].\[Tau]bar[A])/2 == \
\[Eta]4488[[A+1,B+1]] ID8\",
  And @@ Flatten[Table[(\[Tau][A].\[Tau]bar[B] + \[Tau][B].\[Tau]bar[A])/2 == \
\[Eta]4488[[A + 1, B + 1]] ID8, {A, 0, 7}, {B, 0, 7}]]]
check[\"4+4: (\[Tau]bar[A].\[Tau][B] + \[Tau]bar[B].\[Tau][A])/2 == \
\[Eta]4488[[A+1,B+1]] ID8\",
  And @@ Flatten[Table[(\[Tau]bar[A].\[Tau][B] + \[Tau]bar[B].\[Tau][A])/2 == \
\[Eta]4488[[A + 1, B + 1]] ID8, {A, 0, 7}, {B, 0, 7}]]]
check[\"4+4: \[Tau][1].\[Tau][2]...\[Tau][7] == ID8\", Dot @@ \
Table[\[Tau][A], {A, 1, 7}] == ID8]
check[\"4+4: \[Sigma] == \[Tau][1].\[Tau][2].\[Tau][3] == \
\[Tau][4].\[Tau][5].\[Tau][6].\[Tau][7]\",
  \[Sigma] == \[Tau][1].\[Tau][2].\[Tau][3] == \[Tau][4].\[Tau][5].\[Tau][6].\
\[Tau][7]]
check[\"4+4: \[Sigma] commutes with \[Tau][1..3] and anticommutes with \
\[Tau][4..7]; \[Sigma].\[Sigma] == ID8\",
  And @@ Table[\[Sigma].\[Tau][A] == \[Tau][A].\[Sigma], {A, 1, 3}] && And @@ \
Table[\[Sigma].\[Tau][A] == -\[Tau][A].\[Sigma], {A, 4, 7}] && \[Sigma].\
\[Sigma] == ID8]\
\>", "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"5244bc78-0a1b-f24b-a940-0962be167274"],

