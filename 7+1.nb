    {"\<\"scalar curvature R = -2 (3Ha' + 6Ha^2 + 4Hb' + 10Hb^2 + 12 Ha Hb)\"\
\>", "True"},
    {"\<\"inhomogeneous metric, exactly at (x0, x4) = (1/2, 1/3): R_rsmn = \
