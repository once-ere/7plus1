  "Out[130]=",ExpressionUUID->"3c5df8b6-421e-bb48-be81-49b991eb95c7"],

Cell[BoxData[
 RowBox[{"\<\"norm is multiplicative: N(xy) == N(x) N(y) (symbolic; Degen's \
eight-square identity)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002050911565052*^9},
 CellLabel->
  "Out[131]=",ExpressionUUID->"cd031ebd-ab1f-3140-a90a-2fbe10793561"],

