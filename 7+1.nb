    {"\<\"isotropic expansion, massless: no pair creation (|beta|^2 < 10^-20)\
\"\>", "True"},
    {"\<\"static auxiliary space (Hb = 0): E^(1) = (3Ha^2, 2Ha' + 3Ha^2, 3Ha' \
