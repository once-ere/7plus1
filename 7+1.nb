Cell[BoxData[
 RowBox[{"\<\"every x satisfies x x - 2 Re(x) x + N(x) e[0] == 0, so the \
subalgebra generated by x is \[DoubleStruckCapitalR] or \
\[DoubleStruckCapitalC]\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002050911588255*^9},
 CellLabel->
  "Out[133]=",ExpressionUUID->"70532919-91a5-504d-8b04-022d85fee26f"]
}, Open  ]],

Cell["\<\
Degen\[CloseCurlyQuote]s eight-square identity, explicitly: the eight \
components of x y are bilinear forms, and the sum of their squares equals (a0\
\.b2 + \[Ellipsis] + a7\.b2)(b0\.b2 + \[Ellipsis] + b7\.b2). Hence N(x) = 0 \
forces x = 0, and xy = 0 forces x = 0 or y = 0: unlike the split octonions, \
the octonions have no zero divisors (a division algebra).\
\>", "Text",ExpressionUUID->"977152f7-ad5c-114c-bdee-f8b737685fd4"],

Cell[CellGroupData[{

