    {"\<\"the couplings of section 8 are four of the nine: I_0 == (psibar \
psi)^2, I_1 == (psibar Gamma^A psi)(psibar Gamma_A psi), I_8 == -(psibar i \
chi17 psi)^2, I_7 == -(axial invariant)\"\>", "True"},
    {"\<\"local Lorentz invariance: I_r(S psi, psibar S^-1) == I_r(psi, \
psibar) for r = 0..8 (random finite Lorentz transformation), and S^-1 == \
Gamma17[0].S^dagger.Gamma17[0]\"\>", "True"},
    {"\<\"Fierz matrix: closed form == (1/256) Sum_{K in r} \
