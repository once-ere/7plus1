Cell[CellGroupData[{

Cell["\<\
GS1 = GSeff[gS0, 0, gV0, 0]; GV1 = GVeff[gS0, 0, gV0, 0];
msHF = gap7[GS1, 3/4]; rhoHF = rho7[3/4]; rhoSHF = c7 iS7[msHF, 3/4];
check[\"Hartree-Fock at kF = 3/4 (gP = gA = 0): G_S == -98750, G_V == 20000; \
m* - m == gS \[Rho]S + S_x, V_0 == gV \[Rho] + V_x; \[Mu] == \[Epsilon]_F\",
  GS1 == -98750 && GV1 == 20000 && Abs[msHF - 1 - (gS0 rhoSHF + rhoSHF/16 \
(-gS0 - 8 gV0))] < 10^-30 &&
  Abs[GV1 rhoHF - (gV0 rhoHF + rhoHF/16 (-gS0 + 6 gV0))] < 10^-30 && \
Abs[dEdrho7[GS1, GV1, 3/4] - fermi7[GS1, GV1, 3/4]] < 10^-15]
hartreeFock34 = {\"G_S\" -> GS1, \"G_V\" -> GV1, \"HF mstar\" -> N[msHF, 20], \
\"HF V0\" -> N[GV1 rhoHF, 20], \"HF E/A - m\" -> N[eps7[GS1, GV1, 3/4]/rhoHF \
- 1, 20],
  \"Hartree mstar\" -> N[gap7[gS0, 3/4], 20], \"Hartree E/A - m\" -> \
N[eps7[gS0, gV0, 3/4]/rhoHF - 1, 20]}\
\>", "Input",
 CellLabel->
  "In[436]:=",ExpressionUUID->"a79e6d2b-1459-4c4c-8950-8aa65e2a9585"],

Cell[BoxData[
 RowBox[{"\<\"Hartree-Fock at kF = 3/4 (gP = gA = 0): G_S == -98750, G_V == \
20000; m* - m == gS \[Rho]S + S_x, V_0 == gV \[Rho] + V_x; \[Mu] == \
\[Epsilon]_F\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494820338535`*^9},
