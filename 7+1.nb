Cell[CellGroupData[{

Cell["\<\
25.7 dirac16complex at the brane: brane spinor \[CircleTimes] transverse \
spinor\
\>", "Subsection",ExpressionUUID->"5aff0bf2-92f8-0543-8f0a-0fbe0196cf92"],

Cell["\<\
At the brane the eight Dirac matrices of dirac16complex split into four along \
W and four transverse to it (section 18): \[CapitalGamma]17[A].U = U.R_A with \
R_\[Mu] = \[Gamma]_\[Mu] \[CircleTimes] 1_4, R_k = \[Gamma]5 \[CircleTimes] \
\[Rho]_k, so \[Psi] = U.(\[CapitalSigma]_a \[Psi]_a \[CircleTimes] e_a) is \
four brane Dirac spinors \[Psi]_a, and the index a is a spinor index of the \
four transverse directions. Products of two Dirac matrices generate the \
rotations: \[CapitalGamma]_\[Mu]\[CapitalGamma]_\[Nu] (the Lorentz group of \
the brane) act on the brane spinor index only, \[CapitalGamma]_k\
\[CapitalGamma]_l (the rotations about the brane) on the transverse index \
only, and \[CapitalGamma]_\[Mu]\[CapitalGamma]_k, which would turn the brane \
into the transverse directions, mix the two: the brane breaks the Lorentz \
group of the bulk to SO(1,3) \[Times] SO(4) (on the torus only the 384 signed \
permutations of section 25.1 remain of SO(4)). On the transverse index the \
rotations form Spin(4) = SU(2) \[Times] SU(2): \[Rho]4567 = \[Rho]4\[Rho]5\
\[Rho]6\[Rho]7 (as a 4\[Times]4 matrix equal to \[Minus]\[Gamma]5) commutes \
with every \[Rho]_k\[Rho]_l, and on its eigenspace s = \[PlusMinus]1 the \
combinations \[Rho]_k\[Rho]_l + s \[Rho]_m\[Rho]_n ((k, l, m, n) an even \
permutation of (4, 5, 6, 7)) vanish, so only one SU(2) acts there: the four \
values of a form the representation (2, 1) \[CirclePlus] (1, 2). Every \
\[CapitalGamma]17[A] is a signed permutation matrix, and 2\[Sqrt]2 U has only \
the entries 0, \[PlusMinus]1, \[PlusMinus]i; both are printed below.\
\>", "Text",ExpressionUUID->"acf1b96f-f13c-1546-944b-e1572ad67398"],

Cell[CellGroupData[{

Cell["\<\
tbSPermQ[m_] := SubsetQ[{-1, 0, 1}, Union[Flatten[m]]] && AllTrue[m, Count[#, \
0] == 15 &] && AllTrue[Transpose[m], Count[#, 0] == 15 &];
tbU8 = Simplify[2 Sqrt[2] uInt];
check[\"explicit forms: every Gamma17[A] is a signed permutation matrix (one \
entry +-1 in each row and column), and 2 Sqrt[2] U has only the entries 0, \
+-1, +-I, eight non-zero ones in each row and in each column\",
  AllTrue[Table[\[CapitalGamma]17[A], {A, 0, 7}], tbSPermQ] && SubsetQ[{0, 1, \
-1, I, -I}, Union[Flatten[tbU8]]] &&
  AllTrue[tbU8, Count[#, 0] == 8 &] && AllTrue[Transpose[tbU8], Count[#, 0] \
== 8 &]]
tbUd = ConjugateTranspose[uInt]; tbKp = KroneckerProduct; tbZ16 = \
ConstantArray[0, {16, 16}];
check[\"brane spinor (x) transverse spinor: Gamma17[mu].Gamma17[nu] == \
U.(gamma_mu.gamma_nu (x) 1_4).U^dag, Gamma17[k].Gamma17[l] == U.(1_4 (x) \
rho_k.rho_l).U^dag and Gamma17[mu].Gamma17[k] == U.(gamma_mu.gamma5 (x) \
rho_k).U^dag (mu, nu = 0..3, k, l = 4..7): the Lorentz group of the brane \
acts on the brane spinor index, the rotations about the brane on the \
transverse index, and the generators that mix them are broken by the brane\",
  And @@ Flatten[Table[Simplify[\[CapitalGamma]17[mu].\[CapitalGamma]17[nu] - \
uInt.tbKp[g4D[[mu + 1]].g4D[[nu + 1]], ID4].tbUd] == tbZ16, {mu, 0, 3}, {nu, \
0, 3}]] &&
  And @@ Flatten[Table[Simplify[\[CapitalGamma]17[k + 3].\[CapitalGamma]17[l \
+ 3] - uInt.tbKp[ID4, rhoK[[k]].rhoK[[l]]].tbUd] == tbZ16, {k, 4}, {l, 4}]] &&
  And @@ Flatten[Table[Simplify[\[CapitalGamma]17[mu].\[CapitalGamma]17[k + \
3] - uInt.tbKp[g4D[[mu + 1]].g5D, rhoK[[k]]].tbUd] == tbZ16, {mu, 0, 3}, {k, \
4}]]]
tbPs[s_] := (ID4 + s rho4567)/2; tbEven = {{1, 2, 3, 4}, {1, 3, 4, 2}, {1, 4, \
2, 3}};       (* (4,5,6,7), (4,6,7,5), (4,7,5,6) *)
check[\"the transverse index carries Spin(4) = SU(2) x SU(2): rho4567 == \
-gamma5 (4 x 4), it commutes with every rho_k.rho_l and anticommutes with \
every rho_k; for each even permutation (k, l, m, n) of (4, 5, 6, 7) the \
combination rho_k.rho_l + s rho_m.rho_n vanishes on the eigenspace rho4567 = \
s, and rho_k.rho_l - s rho_m.rho_n acts there with rank 2: the four values of \
a form (2, 1) + (1, 2)\",
  rho4567 == -g5D && And @@ Flatten[Table[rho4567.rhoK[[k]].rhoK[[l]] == \
rhoK[[k]].rhoK[[l]].rho4567, {k, 4}, {l, 4}]] &&
  And @@ Table[rho4567.rhoK[[k]] == -rhoK[[k]].rho4567, {k, 4}] &&
  And @@ Flatten[Table[(rhoK[[p[[1]]]].rhoK[[p[[2]]]] + s \
rhoK[[p[[3]]]].rhoK[[p[[4]]]]).tbPs[s] == ConstantArray[0, {4, 4}], {p, \
tbEven}, {s, {1, -1}}]] &&
  And @@ Flatten[Table[MatrixRank[(rhoK[[p[[1]]]].rhoK[[p[[2]]]] - s \
rhoK[[p[[3]]]].rhoK[[p[[4]]]]).tbPs[s]] == 2, {p, tbEven}, {s, {1, -1}}]]]
check[\"chirality at the brane: PL17 == U.(P_L (x) P_+ + P_R (x) P_-).U^dag \
with P_L,R = (1 -+ gamma5)/2 and P_+- = (1 +- rho4567)/2: the left-handed \
half psi_L (chi17 = -1, 8 components) is two brane-left-handed Weyl spinors \
with rho4567 = +1 and two brane-right-handed ones with rho4567 = -1 (each \
part of rank 4)\",
  Simplify[PL17 - uInt.(tbKp[(ID4 - g5D)/2, tbPs[1]] + tbKp[(ID4 + g5D)/2, \
tbPs[-1]]).tbUd] == tbZ16 &&
  MatrixRank[tbKp[(ID4 - g5D)/2, tbPs[1]]] == 4 && MatrixRank[tbKp[(ID4 + \
g5D)/2, tbPs[-1]]] == 4]
tbu = {1, 2, 0, -1}; tbPsi = uInt.Flatten[Outer[Times, tbu, UnitVector[4, 1]]];
tbBil = Table[Simplify[Conjugate[tbPsi].\[CapitalGamma]17[0].\[CapitalGamma]\
17up[mu].tbPsi], {mu, 0, 3}];
check[\"an explicit spinor: psi = U.(u (x) e_1) with the brane spinor u = (1, \
2, 0, -1): psibar psi == ubar u == 4 and psibar Gamma^mu psi == ubar gamma^mu \
u (mu = 0..3)\",
  Simplify[Conjugate[tbPsi].\[CapitalGamma]17[0].tbPsi] == 4 == \
Conjugate[tbu].g4D[[1]].tbu &&
  tbBil == Table[Conjugate[tbu].g4D[[1]].(\[Eta]17[[mu + 1, mu + 1]] g4D[[mu \
+ 1]]).tbu, {mu, 0, 3}]]
{\"Gamma17[A] as signed permutations: column j has the entry sign(c) in row \
|c|, c listed for A = 0..7\" -> Table[Total[\[CapitalGamma]17[A][[All, j]] \
Range[16]], {A, 0, 7}, {j, 16}],
 \"Re(2 Sqrt[2] U)\" -> Re[tbU8], \"Im(2 Sqrt[2] U)\" -> Im[tbU8],
 \"example psi = U.(u (x) e_1), u = (1, 2, 0, -1): psibar psi, psibar \
Gamma^mu psi (mu = 0..3)\" -> \
Join[{Simplify[Conjugate[tbPsi].\[CapitalGamma]17[0].tbPsi]}, tbBil]}\
\>", "Input",
 CellLabel->
  "In[1240]:=",ExpressionUUID->"5ac3613f-1a7d-0b4e-bf1d-9bbd2759dd6a"],

Cell[BoxData[
 RowBox[{"\<\"explicit forms: every Gamma17[A] is a signed permutation matrix \
(one entry +-1 in each row and column), and 2 Sqrt[2] U has only the entries \
0, +-1, +-I, eight non-zero ones in each row and in each column\"\>", "\[Rule]",
   "True"}]], "Output",
