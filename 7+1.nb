Cell[CellGroupData[{

Cell["\<\
(* the same table, computed independently by the Python program \
tools/ref71.py *)
gridOExpected = {{x, e[0], e[1], e[2], e[3], e[4], e[5], e[6], e[7]},
   {e[0], e[0], e[1], e[2], e[3], e[4], e[5], e[6], e[7]},
   {e[1], e[1], -e[0], -e[3], e[2], -e[5], e[4], e[7], -e[6]},
   {e[2], e[2], e[3], -e[0], -e[1], -e[6], -e[7], e[4], e[5]},
   {e[3], e[3], -e[2], e[1], -e[0], -e[7], e[6], -e[5], e[4]},
   {e[4], e[4], e[5], e[6], e[7], -e[0], -e[1], -e[2], -e[3]},
   {e[5], e[5], -e[4], e[7], -e[6], e[1], -e[0], e[3], -e[2]},
   {e[6], e[6], -e[7], -e[4], e[5], e[2], -e[3], -e[0], e[1]},
   {e[7], e[7], e[6], -e[5], -e[4], e[3], e[2], -e[1], -e[0]}};
check[\"gridO equals the octonion table computed independently in Python\", \
First[gridO] === gridOExpected]
check[\"LO[A] are signed permutation matrices (all multiplication constants \
are 0, \[PlusMinus]1)\",
  And @@ Table[MatrixQ[LO[A], IntegerQ] && LO[A].Transpose[LO[A]] == ID8, {A, \
0, 7}]]\
\>", "Input",
 CellLabel->"In[97]:=",ExpressionUUID->"72b9dcc3-05a1-1542-bf36-823184b5e58b"],

Cell[BoxData[
 RowBox[{"\<\"gridO equals the octonion table computed independently in \
Python\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494699544888`*^9},
 CellLabel->"Out[99]=",ExpressionUUID->"295e4546-6226-314b-a0ff-c6e0089d3977"],

Cell[BoxData[
 RowBox[{"\<\"LO[A] are signed permutation matrices (all multiplication \
constants are 0, \[PlusMinus]1)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002049469970213*^9},
 CellLabel->
  "Out[100]=",ExpressionUUID->"48f321ba-e5b5-5442-a60b-be8af5f2b7e2"]
}, Open  ]],

Cell["\<\
Octonions as coefficient lists. An octonion x = x0 e[0] + \[Ellipsis] + x7 \
e[7] is stored as the list {x0, \[Ellipsis], x7}. Because LO[A] is the matrix \
of left multiplication by e[A], the product of x and y is (\[CapitalSigma]_A \
x^A LO[A]).y.\
\>", "Text",ExpressionUUID->"604297ee-8d45-184b-ac52-2b3871cfa3c2"],

Cell[CellGroupData[{

Cell["\<\
oMul[xx_List, yy_List] := Sum[xx[[A + 1]] LO[A], {A, 0, 7}].yy;
oConj[xx_List] := Join[{xx[[1]]}, -Rest[xx]];
oNorm2[xx_List] := xx.gO.xx;
oRe[xx_List] := xx[[1]];
oInv[xx_List] := oConj[xx]/oNorm2[xx];
oAssoc[xx_List, yy_List, zz_List] := oMul[oMul[xx, yy], zz] - oMul[xx, \
oMul[yy, zz]];
toE[xx_List] := xx.eList;
ev[A_] := UnitVector[8, A + 1];
check[\"oMul reproduces gridO on all 64 pairs of basis units\",
  And @@ Flatten[Table[toE[oMul[ev[A], ev[K]]] === First[gridO][[A + 2, K + \
2]], {A, 0, 7}, {K, 0, 7}]]]\
\>", "Input",
 CellLabel->
  "In[101]:=",ExpressionUUID->"91a55a61-2bee-384a-bbd4-4aa20aef3068"],

Cell[BoxData[
 RowBox[{"\<\"oMul reproduces gridO on all 64 pairs of basis units\"\>", "\[Rule]",
   "True"}]], "Output",
 CellChangeTimes->{4.0020494699795723`*^9},
 CellLabel->
  "Out[109]=",ExpressionUUID->"26ca5895-50cd-814d-af56-15ee0ca4594c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.4 The properties listed in [1A], verified", "Subsection",ExpressionUUID->"1d1a39d2-0bb5-a249-b63a-52ed065cb7b1"],

Cell[CellGroupData[{

Cell["Units, squares and anticommutation", "Subsubsection",ExpressionUUID->"9cdb4626-691e-cf43-880b-7ba931b75386"],

Cell[CellGroupData[{

Cell["\<\
check[\"e[0] is a two-sided identity\", And @@ Table[oMul[ev[0], ev[A]] == \
ev[A] && oMul[ev[A], ev[0]] == ev[A], {A, 0, 7}]]
check[\"e[i] e[i] == -e[0] (i = 1..7)\", And @@ Table[oMul[ev[i], ev[i]] == \
-ev[0], {i, 1, 7}]]
check[\"e[i] e[j] == -e[j] e[i] (i != j, i,j = 1..7): non-commutative\",
  And @@ Flatten[Table[If[i != j, oMul[ev[i], ev[j]] == -oMul[ev[j], ev[i]], \
True], {i, 1, 7}, {j, 1, 7}]]]\
\>", "Input",
 CellLabel->
  "In[110]:=",ExpressionUUID->"5a2eb90b-20eb-3d46-9ace-ae17fb0a0891"],

Cell[BoxData[
 RowBox[{"\<\"e[0] is a two-sided identity\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020494699966087`*^9},
 CellLabel->
  "Out[110]=",ExpressionUUID->"57c48c13-0842-0f46-827c-400964b0fcd0"],

Cell[BoxData[
 RowBox[{"\<\"e[i] e[i] == -e[0] (i = 1..7)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020494700026073`*^9},
 CellLabel->
  "Out[111]=",ExpressionUUID->"3f0c2b50-22b6-bb40-8e79-7d92f6db075f"],

Cell[BoxData[
 RowBox[{"\<\"e[i] e[j] == -e[j] e[i] (i != j, i,j = 1..7): non-commutative\"\
\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002049470006727*^9},
 CellLabel->
  "Out[112]=",ExpressionUUID->"95a63da3-c88d-5942-9b8a-af3b64f19143"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Fano plane", "Subsubsection",ExpressionUUID->"b464b50a-cbce-5d4f-91fa-3de2dc9a83ad"],

Cell["\<\
Every product of two distinct imaginary units is \[PlusMinus] a third one. \
The 7 triples {i, j, k} with e[i]e[j] = \[PlusMinus]e[k] are the 7 lines of \
the Fano plane; on each line the order (a, b, c) with e[a]e[b] = +e[c] is \
cyclic, and each line together with e[0] spans a copy of the quaternions.\
\>", "Text",ExpressionUUID->"3681b61e-cd3f-cb4e-b65e-c17eceb97336"],

Cell[CellGroupData[{

Cell["\<\
fanoLines = Union[Flatten[Table[Sort[{i, j, \
First[Flatten[Position[Abs[oMul[ev[i], ev[j]]], 1]]] - 1}], {i, 1, 7}, {j, i \
+ 1, 7}], 1]];
orientedLines = Table[First[Select[Permutations[l], oMul[ev[#[[1]]], \
ev[#[[2]]]] == ev[#[[3]]] &]], {l, fanoLines}];
{fanoLines, orientedLines}\
\>", "Input",
 CellLabel->
  "In[113]:=",ExpressionUUID->"ff73cdfc-3c08-4941-b6aa-3e257f29cec8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "4", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "6", ",", "7"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4", ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "5", ",", "7"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4", ",", "7"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "5", ",", "6"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "3", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "5", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "6", ",", "7"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "6", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "7", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "7", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "5", ",", "6"}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{4.002049470019724*^9},
 CellLabel->
  "Out[115]=",ExpressionUUID->"9a48f35b-f927-ad4d-a4d9-a963e8ef52dd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"7 Fano lines; every pair of distinct imaginary units lies on exactly \
one line\",
  Length[fanoLines] == 7 && Sort[Flatten[Subsets[#, {2}] & /@ fanoLines, 1]] \
== Subsets[Range[7], {2}]]
check[\"each oriented line (a,b,c) is cyclic: e[a]e[b] == e[c], e[b]e[c] == \
e[a], e[c]e[a] == e[b]\",
  And @@ Table[oMul[ev[t[[1]]], ev[t[[2]]]] == ev[t[[3]]] && oMul[ev[t[[2]]], \
ev[t[[3]]]] == ev[t[[1]]] && oMul[ev[t[[3]]], ev[t[[1]]]] == ev[t[[2]]], {t, \
orientedLines}]]
check[\"each line spans a quaternion subalgebra: {e[0], e[a], e[b], e[c]} \
closed and associative\",
  And @@ Table[With[{s = Prepend[l, 0]}, And @@ Flatten[Table[SubsetQ[s, \
Flatten[Position[Abs[oMul[ev[u], ev[v]]], 1]] - 1] && oAssoc[ev[u], ev[v], \
ev[w]] == zero8, {u, s}, {v, s}, {w, s}]]], {l, fanoLines}]]\
\>", "Input",
 CellLabel->
  "In[116]:=",ExpressionUUID->"c10746ce-0cdb-6548-b472-df95f9a3ae5b"],

Cell[BoxData[
 RowBox[{"\<\"7 Fano lines; every pair of distinct imaginary units lies on \
exactly one line\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494700339794`*^9},
 CellLabel->
  "Out[116]=",ExpressionUUID->"8a6c6e25-e5f7-7946-ab9d-0ce4831449c4"],

Cell[BoxData[
 RowBox[{"\<\"each oriented line (a,b,c) is cyclic: e[a]e[b] == e[c], \
e[b]e[c] == e[a], e[c]e[a] == e[b]\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494700399876`*^9},
 CellLabel->
  "Out[117]=",ExpressionUUID->"741e8038-2a0c-d346-8568-7002dfb9a984"],

Cell[BoxData[
 RowBox[{"\<\"each line spans a quaternion subalgebra: {e[0], e[a], e[b], \
e[c]} closed and associative\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020494701552334`*^9},
 CellLabel->
  "Out[118]=",ExpressionUUID->"d09461d4-3d97-684e-b70f-7512bd137f41"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
fanoPicture = Module[{pos, lines},
   pos = <|1 -> {0, 0}, 2 -> {0, 2}, 4 -> {-Sqrt[3], -1}, 7 -> {Sqrt[3], -1}, \
6 -> {-Sqrt[3]/2, 1/2}, 5 -> {Sqrt[3]/2, 1/2}, 3 -> {0, -1}|>;
   Graphics[{Thickness[0.004], Gray,
     Line[{pos[2], pos[4]}], Line[{pos[4], pos[7]}], Line[{pos[7], pos[2]}],
     Line[{pos[2], pos[3]}], Line[{pos[4], pos[5]}], Line[{pos[7], pos[6]}], \
Circle[{0, 0}, 1],
     Table[{White, EdgeForm[Black], Disk[pos[k], 0.2], Black, \
Text[Style[\"e\" <> ToString[k], 13, Bold], pos[k]]}, {k, 1, 7}]},
    ImageSize -> 320, PlotLabel -> Style[\"Fano plane of gridO (lines = \
sides, medians, circle)\", 12]]];
check[\"the picture's 7 lines are exactly fanoLines\", Sort[Sort /@ {{2, 6, \
4}, {4, 3, 7}, {7, 5, 2}, {2, 1, 3}, {4, 1, 5}, {7, 1, 6}, {6, 5, 3}}] == \
fanoLines]
fanoPicture\
\>", "Input",
 CellLabel->
  "In[119]:=",ExpressionUUID->"fcbafd18-3705-fc42-9332-ec3ade98fa93"],

Cell[BoxData[
 RowBox[{"\<\"the picture's 7 lines are exactly fanoLines\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002049470179365*^9},
 CellLabel->
  "Out[120]=",ExpressionUUID->"71a8a1a7-9c64-7646-a382-4f1632b091a0"],

