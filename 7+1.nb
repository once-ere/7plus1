       SuperscriptBox["Hb", "2"]}], "-", 
      RowBox[{"180", " ", 
       SuperscriptBox["Ha", "2"], " ", 
       SuperscriptBox["Hb", "2"]}], "-", 
      RowBox[{"108", " ", "Ha", " ", 
       SuperscriptBox["Hb", "3"]}], "-", 
      RowBox[{"12", " ", 
       SuperscriptBox["Hb", "4"]}]}]},
    {"3", 
     RowBox[{
      RowBox[{"1440", " ", 
       SuperscriptBox["Ha", "3"], " ", 
       SuperscriptBox["Hb", "3"]}], "+", 
      RowBox[{"1080", " ", 
       SuperscriptBox["Ha", "2"], " ", 
       SuperscriptBox["Hb", "4"]}]}], 
     RowBox[{
      RowBox[{"864", " ", "dHb", " ", 
       SuperscriptBox["Ha", "2"], " ", 
       SuperscriptBox["Hb", "2"]}], "+", 
      RowBox[{"576", " ", "dHa", " ", "Ha", " ", 
       SuperscriptBox["Hb", "3"]}], "+", 
      RowBox[{"576", " ", "dHb", " ", "Ha", " ", 
       SuperscriptBox["Hb", "3"]}], "+", 
