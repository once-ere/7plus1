Cell[CellGroupData[{

Cell["10. Summary of all checks (sections 1\[Dash]9)", "Section",ExpressionUUID->"e28634bd-b786-134f-a728-ded183416b09"],

Cell["\<\
The four cells below repeat the summary of section 6 after sections 7\[Dash]9 \
have been evaluated, so they cover every check of the notebook.\
\>", "Text",ExpressionUUID->"a307b0fb-6537-f14b-a854-91d72c0209ac"],

