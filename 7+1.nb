Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Kasner beta2 (1,1)\"\>", "\[Rule]", "0.010749346168829065`"}],
    ",", 
   RowBox[{"\<\"Kasner beta2 (2,1)\"\>", "\[Rule]", 
    "0.00013294108223524522`"}], ",", 
