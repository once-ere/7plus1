           Part[#, 1]], 
          (Identity[#]& )[
           Part[#, 2]]}& )}}, PlotInteractivity :> True, 
    PlotRange -> {{0.2854166666666675, 1.}, {-0.06, 0.25}}, PlotRangeClipping -> 
    True, PlotRangePadding -> {{
       Scaled[0.02], 
       Scaled[0.02]}, {None, None}}, Ticks -> {Automatic, Automatic}], 
   FormBox[
    FormBox[
     TemplateBox[{
      "\"Hartree (gS = -10^5, gV = 10^4)\"", 
       "\"Hartree-Fock (G_S = -98750, G_V = 20000)\""}, "LineLegend", 
      DisplayFunction -> (FormBox[
