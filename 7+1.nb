Cell[CellGroupData[{

Cell["allChecksPassed = AllTrue[Values[checks], TrueQ]", "Input",
 CellLabel->
  "In[286]:=",ExpressionUUID->"7f06fdd5-34fe-cc43-af41-5111ffde2749"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{4.002040483584526*^9},
