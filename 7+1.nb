Cell[CellGroupData[{

Cell["21.4 Pair creation in the primordial regime and the brane", "Subsection",ExpressionUUID->"d8588840-3121-c14b-80a1-392f7086d80b"],

Cell["\<\
Section 14.3 computed the Bogoliubov coefficient |\[Beta]|\.b2 of a massless \
mode on the Einstein\[Dash]Kasner background as a function F(K) of the \
scaling variable K. For large K, F does NOT fall exponentially, as it would \
for a smooth expansion history, but as a power,\
\>", "Text",ExpressionUUID->"620150bb-e377-3b4d-bd6b-daa6d53f3bfd"],

Cell["\<\
      F(K) \[Proportional] K^(\[Minus]2(p1 \[Minus] q1)/(1 \[Minus] p1)) = \
K^(\[Minus](3\[Sqrt]2 + 2)/2) = K^(\[Minus]3.121\[Ellipsis]),\
\>", "Text",ExpressionUUID->"23a65991-37f1-8248-ad97-89202fd185fe"],

Cell["\<\
because near x0 = 0 the phase \[Integral]\[Omega] d\[Tau] \[Proportional] K \
\[Tau]^(1\[Minus]p1) while the direction of the mode Hamiltonian turns like \
\[Tau]^(p1\[Minus]q1): the non-adiabaticity comes from the singularity \
itself. The comoving number of pairs created in each logarithmic interval of \
crossing time therefore grows toward \[Tau] = 0 (\[Proportional] \[Tau]\:207b\
\:2076 in the Kasner phase): the primordial production of dirac16complex is \
dominated by the earliest, Planckian times and gives a gas fraction of order \
one there \[LongDash] the gas used in section 21.3.\
\>", "Text",ExpressionUUID->"d56b9c60-4084-9b43-81a1-853afabf9e3b"],

Cell["\<\
The Standard Model plasma on the brane can only matter in the bulk when its \
smeared density \[Rho]_4/V\[UpTee] is comparable to the curvature terms. At T \
= M8 and H = M8 its fraction is (\[Pi]\.b2 g*/30) M8\:2074/(3 M_Pl\.b2 \
M8\.b2) \[TildeTilde] 2 \[Times] 10\:207b\.b2\:2078 (M8 = 10 TeV, M_Pl = \
2.435 \[Times] 10\.b9\:2078 GeV, g* = 106.75): the brane is gravitationally \
negligible in the whole primordial regime.\
\>", "Text",ExpressionUUID->"f8bb20d2-f29d-b34f-90f6-db9119fd2bdf"],

Cell[CellGroupData[{

Cell["\<\
rIsg1 = {{0, 1}, {1, 0}}; rIsg2 = {{0, -I}, {I, 0}};
rIbog[k_, p_, q_] := Module[{c, sol, t0 = 10^-15, t1 = 300, v0, v1, h0m, h1m},
   h0m = N[k t0^-p rIsg1 + k t0^-q rIsg2, 30]; h1m = N[k t1^-p rIsg1 + k \
t1^-q rIsg2, 30];
   v0 = Normalize[Eigenvectors[h0m][[Ordering[Eigenvalues[h0m]]]][[2]]]; v1 = \
Normalize[Eigenvectors[h1m][[Ordering[Eigenvalues[h1m]]]][[1]]];
   sol = NDSolveValue[{c'[sB] == -I Exp[sB] (k Exp[-p sB] rIsg1 + k Exp[-q \
sB] rIsg2).c[sB], c[Log[t0]] == N[v0]}, c[Log[t1]], {sB, Log[t0], Log[t1]},
     Method -> {\"ExplicitRungeKutta\", \"DifferenceOrder\" -> 8}, \
PrecisionGoal -> 11, AccuracyGoal -> 13, MaxSteps -> Infinity];
   Abs[Conjugate[N[v1]].sol]^2];
rIFk = {rIbog[1, N[rIp1], N[rIq1]], rIbog[8, N[rIp1], N[rIq1]], rIbog[16, \
N[rIp1], N[rIq1]]};
rItail = Log[rIFk[[3]]/rIFk[[2]]]/Log[2];
check[\"Einstein-Kasner pair creation: F(1) == 0.0107493 (section 14.3) and \
the tail F ~ K^(-(3 Sqrt[2] + 2)/2) (exponent between K = 8 and 16 to 2 \
10^-2)\",
  Abs[rIFk[[1]] - 0.0107493] < 10^-6 && Abs[rItail + (3 Sqrt[2] + 2)/2] < 2 \
10^-2 && Simplify[2 (rIp1 - rIq1)/(1 - rIp1) - (3 Sqrt[2] + 2)/2] === 0]
rIbrane = (Pi^2 106.75/30) (10.^4)^4/(3 (2.435 10^18)^2 (10.^4)^2);
check[\"brane plasma at T = M8, H = M8: fraction (Pi^2 g*/30) M8^4/(3 M_Pl^2 \
M8^2) < 10^-27\", rIbrane < 10^-27]
{\"F(1), F(8), F(16)\" -> rIFk, \"tail exponent (K = 8 .. 16), -(3 Sqrt[2] + \
2)/2\" -> {rItail, N[-(3 Sqrt[2] + 2)/2]}, \"brane fraction at T = H = M8\" \
-> rIbrane}\
\>", "Input",
 CellLabel->
  "In[1009]:=",ExpressionUUID->"12fade12-ccf1-3c48-8394-3e79d3de377a"],

Cell[BoxData[
 RowBox[{"\<\"Einstein-Kasner pair creation: F(1) == 0.0107493 (section 14.3) \
and the tail F ~ K^(-(3 Sqrt[2] + 2)/2) (exponent between K = 8 and 16 to 2 \
10^-2)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002143463122917*^9},
 CellLabel->
  "Out[1013]=",ExpressionUUID->"bd7d5ad6-f255-9a43-9c2d-c0821ea7de21"],

Cell[BoxData[
 RowBox[{"\<\"brane plasma at T = M8, H = M8: fraction (Pi^2 g*/30) M8^4/(3 \
M_Pl^2 M8^2) < 10^-27\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021434631259136`*^9},
 CellLabel->
  "Out[1015]=",ExpressionUUID->"4a238ebf-0d90-234d-b473-438a868bb908"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"F(1), F(8), F(16)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "0.010749346168749063`", ",", "7.104066468619476`*^-6", ",", 
      "8.157299142798138`*^-7"}], "}"}]}], ",", 
   RowBox[{"\<\"tail exponent (K = 8 .. 16), -(3 Sqrt[2] + 2)/2\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "3.1224816158271573`"}], ",", 
      RowBox[{"-", "3.121320343559643`"}]}], "}"}]}], ",", 
   RowBox[{"\<\"brane fraction at T = H = M8\"\>", "\[Rule]", 
    "1.9743638405361934`*^-28"}]}], "}"}]], "Output",
 CellChangeTimes->{4.002143463127619*^9},
 CellLabel->
  "Out[1016]=",ExpressionUUID->"c2e2c3b6-1f5c-934e-b1ba-915e3fe6bb98"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
22. Regime II: the modern regime (a stabilized auxiliary space, \
four-dimensional gravity on the brane)\
\>", "Section",ExpressionUUID->"cd825b0d-1eed-7e41-a749-02716d6a3f62"],

Cell[CellGroupData[{

Cell["\<\
22.1 The stabilizing potential catches the auxiliary space: radion \
oscillations\
\>", "Subsection",ExpressionUUID->"e27f69ac-ccb5-f24d-aa44-838a1f8bdff2"],

Cell[TextData[{
 "Section 21.3 showed that the auxiliary space must be held. Add the \
stabilizing potential U(b) = (K_U/2) (ln(b/b0))\.b2 (U_0 = 0, \[Kappa]K_U = \
12 m_r\.b2, m_r = 10\:207b\.b3/",
 StyleBox["\[ScriptL]",
  FontFamily->"Cambria Math"],
 "2) to the coupled solution of section 21.3 at Ha = 10\:207b\.b2 (Einstein\
\[Dash]Kasner regime, \[Tau] \[TildeTilde] 57), with b0 where the Kasner \
contraction would arrive at \[Tau] = 1/m_r. The equations are integrated in \
x0 (Ha now oscillates). When the expansion rate falls below m_r the radion \
\[Beta] = ln(b/b0) is caught and oscillates about 0; its energy then behaves \
like four-dimensional matter, and the exact solution of \[Beta]\[DoublePrime] \
+ (2/\[Tau])\[Beta]\[Prime] + m_r\.b2\[Beta] = 0 (the radion equation of \
section 20.3 in a matter-dominated universe, H_E = 2/(3\[Tau])) is the \
accurate approximate solution"
}], "Text",ExpressionUUID->"0a69137f-77c9-294a-b825-60916fde5bdf"],

Cell["\<\
      \[Beta] \[TildeTilde] A sin(m_r \[Tau] + \[CurlyTheta])/(m_r (\[Tau] \
\[Minus] \[Tau]_E)),   H_E = Ha + 2Hb \[TildeTilde] 2/(3(\[Tau] \[Minus] \
\[Tau]_E)),   corrections O(1/(m_r \[Tau]))   (amplitude A, phase \
\[CurlyTheta]).\
\>", "Text",ExpressionUUID->"bfc745d6-f4b5-ef40-ab24-6b6a6d26c390"],

Cell["\<\
The dirac16complex gas (frozen auxiliary momenta = Kaluza\[Dash]Klein masses) \
is then also four-dimensional matter: its share of the energy stays constant, \
and the radion carries the rest (99%): this is the cosmological moduli \
problem of the minimal model.\
\>", "Text",ExpressionUUID->"d361f6e3-35a9-1e45-a424-7ffc5d0b458c"],

Cell[CellGroupData[{

Cell["\<\
rIIm = 1/1000;
{rIIhb0, rIIla0, rIIlb0, rIIx0} = rIcplF[-Log[1/100]]; rIItau0 = rIIx0 - rIxs;
rIIlnb0 = rIIlb0 + rIq1 Log[1/(rIIm rIItau0)];
rIIrhs[tt_?NumericQ, yy_?VectorQ] := Module[{ha, hb, la, lb, g, bet, kU, d}, \
{ha, hb, la, lb} = yy; g = rIgas[la, lb]; bet = lb - rIIlnb0; kU = 6 rIIm^2 \
bet^2;
   d = rIsolve2[rIlinMf[ha, hb], -rIlinBf[ha, hb] - {rICg g[[2]] - kU, rICg \
g[[3]] - kU - 3 rIIm^2 bet}]; {d[[1]], d[[2]], ha, hb}];
rIIha0 = 1/100;
rIIhbC = Hb /. FindRoot[rIC00[rIIha0, Hb] == rICg rIgas[rIIla0, rIIlb0][[1]] \
+ 6 rIIm^2 (rIIlb0 - rIIlnb0)^2, {Hb, rIIhb0}];
rIIcap = NDSolveValue[{rIIyK'[tt] == rIIrhs[tt, rIIyK[tt]], rIIyK[rIItau0] == \
N[{rIIha0, rIIhbC, rIIla0, rIIlb0}]}, rIIyK, {tt, rIItau0, 3 10^5},
    Method -> {\"ExplicitRungeKutta\", \"DifferenceOrder\" -> 8, \
\"StiffnessTest\" -> False}, PrecisionGoal -> 11, AccuracyGoal -> 16, \
MaxSteps -> 10^7, MaxStepSize -> 50];
rIIHEavg[t1_] := {Mean[Table[rIIcap[tt][[1]] + 2 rIIcap[tt][[2]], {tt, t1, t1 \
+ 2 Pi/rIIm, 2 Pi/rIIm/2000}]], t1 + Pi/rIIm};
rIItE = With[{h = rIIHEavg[2.9 10^5]}, h[[2]] - 2/(3 h[[1]])];          (* \
H_E = 2/(3 (tau - tau_E)) over the last period *)
rIIdata = Table[{tt, rIIcap[tt][[4]] - rIIlnb0}, {tt, 10^5, 3 10^5, 50}];
rIIcs = LeastSquares[Table[{Sin[rIIm d[[1]]], Cos[rIIm d[[1]]]}, {d, \
rIIdata}], Table[d[[2]] rIIm (d[[1]] - rIItE), {d, rIIdata}]];
rIIfit = {rIIaF -> Norm[rIIcs], rIIphF -> ArcTan[rIIcs[[1]], rIIcs[[2]]], \
rIItEF -> rIItE};
rIIres = Max[Abs[rIIdata[[All, 2]] - ((rIIaF Sin[rIIm # + rIIphF]/(rIIm (# - \
rIItEF))) & /@ rIIdata[[All, 1]] /. rIIfit)]]/Max[Abs[rIIdata[[All, 2]]]];
rIIHE[t1_] := With[{h = rIIHEavg[t1]}, h[[1]] (h[[2]] - rIItE)];
rIIfr[tt_] := With[{y = rIIcap[tt]}, rICg rIgas[y[[3]], y[[4]]][[1]]/(3 \
(y[[1]] + 2 y[[2]])^2)];
rIIheVals = {rIIHE[10^5], rIIHE[2 10^5]}; rIIfrVals = {rIIfr[10^5], rIIfr[3 \
10^5]};
check[\"capture: the radion oscillates like a four-dimensional massive field \
in a matter-dominated universe: with tau_E from <H_E> = 2/(3 (tau - tau_E)) \
over the last period, beta = A sin(m_r tau + vartheta)/(m_r (tau - tau_E)) to \
2 10^-2, <H_E>(tau - tau_E) = 2/3 to 10^-2 at tau = 10^5 and 2 10^5, the gas \
share constant to 2 10^-2\",
  rIIres < 2 10^-2 && AllTrue[rIIheVals, Abs[# - 2/3] < 10^-2 &] && \
Abs[rIIfrVals[[2]]/rIIfrVals[[1]] - 1] < 2 10^-2]
{\"start tau, beta(start)\" -> {rIItau0, rIIlb0 - rIIlnb0}, \"fit A, \
vartheta, tau_E; max residual/amplitude\" -> {rIIaF, rIIphF, rIItEF, rIIres} \
/. rIIfit,
 \"<H_E>(tau - tau_E) at tau = 10^5, 2 10^5\" -> rIIheVals, \"gas share at \
tau = 10^5, 3 10^5\" -> rIIfrVals, \"radion share 1 - gas share\" -> 1 - \
rIIfrVals[[2]]}\
\>", "Input",
 CellLabel->
  "In[1017]:=",ExpressionUUID->"1a6af7d6-5a33-aa41-8c06-d804e29e0a31"],

