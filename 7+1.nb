Cell[CellGroupData[{

Cell["\<\
check[\"exponential vacuum solutions: (w2, w3) solve all 64 components for \
every qH (generic qH) and every Lambda\",
  Length[wsExp] == 1 && Simplify[fieldEqsExp /. First[wsExp]] == \
ConstantArray[0, {8, 8}]]
wsInfDef = Simplify[wsExp /. qH -> -1]
check[\"eternal inflation (a = e^{H x0}) with deflation (b = e^{-H x0}): w2 \
== Lambda/4 - w1/2, w3 == w1/24 - Lambda/36; for Lambda = 0: w2/w1 == -1/2, \
w3/w1 == 1/24\",
  Simplify[({w2, w3} /. First[wsInfDef]) - {\[CapitalLambda]/4 - w1/2, w1/24 \
- \[CapitalLambda]/36}] == {0, 0} &&
  Simplify[({w2, w3}/w1 /. First[wsInfDef]) /. \[CapitalLambda] -> 0] == \
{-1/2, 1/24}]
{\"eq00, eq11, eq44 (qH = -1)\" -> Expand[{fieldEqsExp[[1, 1]], \
fieldEqsExp[[2, 2]], fieldEqsExp[[5, 5]]} /. qH -> -1],
 \"alpha_2, alpha_3 for Lambda = 0, qH = -1\" -> ({w2/(w1 H^2), w3/(w1 H^4)} \
/. First[wsInfDef] /. \[CapitalLambda] -> 0)}\
\>", "Input",
 CellLabel->
  "In[607]:=",ExpressionUUID->"9ce694e5-e79f-244c-a9fe-48bca74764cb"],

