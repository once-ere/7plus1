Cell[CellGroupData[{

Cell["\<\
check[\"numerical example: N(x y) == N(x) N(y) == 15*6 == 90 and x x^-1 == \
e[0]\",
  oNorm2[oMul[xNum, yNum]] == oNorm2[xNum] oNorm2[yNum] == 90 && oMul[xNum, \
oInv[xNum]] == ev[0]]
check[\"numerical example: x y != y x and (x y) z != x (y z)\", oMul[xNum, \
yNum] != oMul[yNum, xNum] && oAssoc[xNum, yNum, zNum] != zero8]\
\>", "Input",
 CellLabel->
  "In[140]:=",ExpressionUUID->"feb5b7f0-8afa-6743-b72e-20d29992df18"],

