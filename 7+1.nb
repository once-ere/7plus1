    PlotRange -> {{0.001, 0.9}, {-1.3102449541289472`*^-6, 
     8.456023230470975*^-6}}, PlotRangeClipping -> True, PlotRangePadding -> {{
       Scaled[0.02], 
       Scaled[0.02]}, {
