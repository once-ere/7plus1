Cell[CellGroupData[{

Cell["\<\
15. The generalized self-coupling of dirac16complex: all nine ranks\
\>", "Section",ExpressionUUID->"fb839436-6dfd-ec4d-9ddc-b4997182b654"],

Cell[TextData[{
 StyleBox["About sections 15\[Dash]16. ",
  FontWeight->"Bold"],
 "Section 8 coupled dirac16complex to itself through four contact \
interactions (scalar, pseudoscalar, vector, axial). The 256 products of \
section 8.6 contain nine Lorentz-invariant classes, one for each rank r = 0, \
1, \[Ellipsis], 8 (the number of different Dirac matrices in the product), so \
the most general contact self-coupling without derivatives has nine couplings \
g0, \[Ellipsis], g8. Section 15 builds it, shows that the four couplings of \
section 8 are four of the nine, and computes the 9\[Times]9 Fierz matrix that \
turns every exchange (Fock) term into direct terms. Section 16 writes the \
Kohn\[Dash]Sham theory of the self-coupled field in a gravitational field \
(using the spin connection of section 13) and solves it in the three epochs \
of section 14, including the back-reaction of the Kohn\[Dash]Sham matter on \
the expansion through the Einstein\[Dash]Lovelock equations."
}], "Text",ExpressionUUID->"b64aed72-07dd-0045-869d-eb6d968e0e1e"],

Cell[CellGroupData[{

Cell["15.1 The nine channels", "Subsection",ExpressionUUID->"db4ec047-aeae-1f4d-8daf-b64cdc185e13"],

Cell["\<\
For a strictly increasing multi-index K = (A1 < A2 < \[Ellipsis] < Ar) of \
rank r let \[CapitalGamma]^K = \[CapitalGamma]17up[A1].\[Ellipsis].\
\[CapitalGamma]17up[Ar] (\[CapitalGamma]^() = ID16) and\
\>", "Text",ExpressionUUID->"1cf7cff9-a131-6746-bc53-8b78e83c07c9"],

Cell["\<\
      \[CapitalTheta]^K = i^\[Sigma]r \[CapitalGamma]^K,   \[Sigma]r = (r(r\
\[Minus]1)/2) mod 2,      \[CapitalTheta]_K = \[Eta]K \[CapitalTheta]^K,   \
\[Eta]K = \[Eta]17_A1A1 \[CenterEllipsis] \[Eta]17_ArAr.\
\>", "Text",ExpressionUUID->"0bb39449-b204-9143-b9d8-722f799decb4"],

Cell["\<\
The phase makes every bilinear \[Psi]bar \[CapitalTheta]^K \[Psi] real (\
\[CapitalGamma]17[0].\[CapitalTheta]^K is Hermitian), and \[CapitalTheta]_K.\
\[CapitalTheta]^K = ID16, tr(\[CapitalTheta]_K.\[CapitalTheta]^J) = 16 \
\[Delta]KJ. The invariant of rank r and the general self-coupling are\
\>", "Text",ExpressionUUID->"c38a79fc-7c03-3d4c-a6da-859ecc0d00b8"],

Cell["\<\
      I_r = \[CapitalSigma]_{|K| = r} (\[Psi]bar \[CapitalTheta]_K \[Psi])(\
\[Psi]bar \[CapitalTheta]^K \[Psi]) = \[CapitalSigma]_{|K| = r} \[Eta]K (\
\[Psi]bar \[CapitalTheta]^K \[Psi])\.b2,      L_self = \[Minus](1/2) \
\[CapitalSigma]_{r=0}^{8} g_r I_r.\
\>", "Text",ExpressionUUID->"5e1bf140-65a1-e24a-9f78-530eeee93044"],

Cell["\<\
The ranks have 1, 8, 28, 56, 70, 56, 28, 8, 1 members. The couplings of \
section 8 are g0 = gS, g1 = gV, g7 = \[Minus]gA, g8 = \[Minus]gP (I_8 = \
\[Minus](\[Psi]bar i\[Chi]17 \[Psi])\.b2, I_7 = \[Minus](axial invariant)); \
g2 \[Ellipsis] g6 are new (tensor channels of ranks 2 to 6). Each I_r is \
invariant under every local Lorentz transformation \[Psi] \[RightArrow] S \
\[Psi], \[Psi]bar \[RightArrow] \[Psi]bar S\:207b\.b9, so in a gravitational \
field it is written with the frame matrices exactly as in flat spacetime; \
\[CapitalTheta]^K \[Omega]17 is, up to a phase, \[CapitalTheta] of the \
complementary multi-index (Hodge duality).\
\>", "Text",ExpressionUUID->"cc2207e6-07d0-c44a-a364-bb145b9c21b7"],

Cell[CellGroupData[{

Cell["\<\
mIdx = Flatten[Table[Subsets[Range[0, 7], {r}], {r, 0, 8}], 1];
rk[K_] := Length[K];
\[CapitalTheta]up[K_List] := \[CapitalTheta]up[K] = I^Mod[rk[K] (rk[K] - \
1)/2, 2] (Dot @@ Join[{ID16}, Table[\[CapitalGamma]17up[A], {A, K}]]);
\[Eta]K[K_List] := Product[\[Eta]17[[A + 1, A + 1]], {A, K}];
\[CapitalTheta]dn[K_List] := \[CapitalTheta]dn[K] = \[Eta]K[K] \
\[CapitalTheta]up[K];
check[\"256 multi-indices in 9 ranks with 1, 8, 28, 56, 70, 56, 28, 8, 1 \
members\", Length[mIdx] == 256 && Table[Count[mIdx, K_ /; rk[K] == r], {r, 0, \
8}] == {1, 8, 28, 56, 70, 56, 28, 8, 1}]
check[\"every bilinear psibar Theta^K psi is real: Gamma17[0].Theta^K \
Hermitian for all 256 K\",
  AllTrue[mIdx, ConjugateTranspose[\[CapitalGamma]17[0].\[CapitalTheta]up[#]] \
== \[CapitalGamma]17[0].\[CapitalTheta]up[#] &]]
check[\"Theta_K.Theta^K == ID16 and Tr[Theta_K.Theta^J] == 16 delta_KJ\",
  AllTrue[mIdx, \[CapitalTheta]dn[#].\[CapitalTheta]up[#] == ID16 &] && \
Table[Tr[\[CapitalTheta]dn[K].\[CapitalTheta]up[J]], {K, mIdx}, {J, mIdx}] == \
16 IdentityMatrix[256]]
check[\"Hodge duality: Theta^K.omega17 == (phase) Theta^(complement of K), \
|phase| = 1\",
  AllTrue[mIdx, \
Abs[Tr[ConjugateTranspose[\[CapitalTheta]up[Complement[Range[0, 7], #]]].\
\[CapitalTheta]up[#].\[Omega]17]]/16 == 1 &]]
SeedRandom[1508];
rndSpinor[] := RandomInteger[{-4, 4}, 16] + I RandomInteger[{-4, 4}, 16];
{psR, pbR} = {rndSpinor[], rndSpinor[]};
Ichan[r_, pb_, ps_] := Sum[\[Eta]K[K] (pb.\[CapitalTheta]up[K].ps)^2, {K, \
Select[mIdx, rk[#] == r &]}];
bilR[o_] := pbR.o.psR;
check[\"the couplings of section 8 are four of the nine: I_0 == (psibar \
psi)^2, I_1 == (psibar Gamma^A psi)(psibar Gamma_A psi), I_8 == -(psibar i \
chi17 psi)^2, I_7 == -(axial invariant)\",
  Ichan[0, pbR, psR] == bilR[ID16]^2 && Ichan[1, pbR, psR] == Sum[bilR[\
\[CapitalGamma]17up[A]] bilR[\[CapitalGamma]17[A]], {A, 0, 7}] &&
  Ichan[8, pbR, psR] == -bilR[I \[Chi]17]^2 && Ichan[7, pbR, psR] == \
-Sum[bilR[\[CapitalGamma]17up[A].\[Chi]17] \
bilR[\[CapitalGamma]17[A].\[Chi]17], {A, 0, 7}]]
wLL = RandomReal[{-1, 1}, {8, 8}]; wLL = wLL - Transpose[wLL];
sLL = MatrixExp[0.3 Sum[wLL[[A + 1, B + 1]] (\[CapitalGamma]17up[A].\
\[CapitalGamma]17up[B] - \[CapitalGamma]17up[B].\[CapitalGamma]17up[A])/4, \
{A, 0, 7}, {B, 0, 7}]/2];
sLLi = Inverse[sLL];
check[\"local Lorentz invariance: I_r(S psi, psibar S^-1) == I_r(psi, psibar) \
for r = 0..8 (random finite Lorentz transformation), and S^-1 == \
Gamma17[0].S^dagger.Gamma17[0]\",
  And @@ Table[Abs[Ichan[r, pbR.sLLi, sLL.psR] - Ichan[r, pbR, psR]] < 10^-8 \
Abs[Ichan[r, pbR, psR]] + 10^-8, {r, 0, 8}] &&
  Norm[sLLi - \
\[CapitalGamma]17[0].ConjugateTranspose[sLL].\[CapitalGamma]17[0]] < 10^-10]\
\>", "Input",
 CellLabel->
  "In[707]:=",ExpressionUUID->"7eac18e2-dc0c-f34e-be3b-b80144614761"],

Cell[BoxData[
 RowBox[{"\<\"256 multi-indices in 9 ranks with 1, 8, 28, 56, 70, 56, 28, 8, \
1 members\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021244071740913`*^9},
 CellLabel->
  "Out[712]=",ExpressionUUID->"10176d4e-337e-1744-9d24-a96b1d667b29"],

Cell[BoxData[
 RowBox[{"\<\"every bilinear psibar Theta^K psi is real: Gamma17[0].Theta^K \
Hermitian for all 256 K\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002124407202202*^9},
 CellLabel->
  "Out[713]=",ExpressionUUID->"ca8add4b-5df7-1240-80b2-a5c6e314a317"],

Cell[BoxData[
 RowBox[{"\<\"Theta_K.Theta^K == ID16 and Tr[Theta_K.Theta^J] == 16 \
delta_KJ\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021244095913715`*^9},
 CellLabel->
  "Out[714]=",ExpressionUUID->"18c15ef9-2883-4645-a06d-f491275f0c99"],

Cell[BoxData[
 RowBox[{"\<\"Hodge duality: Theta^K.omega17 == (phase) Theta^(complement of \
K), |phase| = 1\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002124409607462*^9},
 CellLabel->
  "Out[715]=",ExpressionUUID->"223c83aa-2a6d-5940-90f3-2b1fbdfd9902"],

Cell[BoxData[
 RowBox[{"\<\"the couplings of section 8 are four of the nine: I_0 == (psibar \
psi)^2, I_1 == (psibar Gamma^A psi)(psibar Gamma_A psi), I_8 == -(psibar i \
chi17 psi)^2, I_7 == -(axial invariant)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021244096232033`*^9},
 CellLabel->
  "Out[721]=",ExpressionUUID->"4ab103d5-d061-d447-b97e-d5908a31946a"],

Cell[BoxData[
 RowBox[{"\<\"local Lorentz invariance: I_r(S psi, psibar S^-1) == I_r(psi, \
psibar) for r = 0..8 (random finite Lorentz transformation), and S^-1 == \
Gamma17[0].S^dagger.Gamma17[0]\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021244096232033`*^9},
 CellLabel->
  "Out[725]=",ExpressionUUID->"43f6dcd3-860d-ba44-82a0-7e6844bb0121"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
15.2 The 9\[Times]9 Fierz matrix and Hartree\[Dash]Fock with nine channels\
\>", "Subsection",ExpressionUUID->"4a907939-3793-8d40-a813-2b54eee64dd1"],

Cell["\<\
The completeness of the 256 matrices, \[CapitalSigma]_K \
(\[CapitalTheta]_K)_cd (\[CapitalTheta]^K)_ab = 16 \[Delta]ad \[Delta]bc, \
rearranges every product of two bilinears. For commuting spinors a, b, c, d \
(for anticommuting fields an extra minus sign appears)\
\>", "Text",ExpressionUUID->"913dbf4b-003a-be4a-8797-047f644d2f3a"],

Cell["\<\
      \[CapitalSigma]_{K\[Element]r} (a \[CapitalTheta]_K b)(c \
\[CapitalTheta]^K d) = \[CapitalSigma]_s F_rs \[CapitalSigma]_{J\[Element]s} \
(a \[CapitalTheta]_J d)(c \[CapitalTheta]^J b),     F_rs = (1/16) \
\[CapitalSigma]_l (\[Minus]1)^(rs\[Minus]l) C(s, l) C(8\[Minus]s, r\[Minus]l),\
\>", "Text",ExpressionUUID->"86445ab0-0b18-ea44-9fb5-b45314c8210b"],

Cell["\<\
with the binomial coefficients C. F_rs = (1/256) \
\[CapitalSigma]_{K\[Element]r} tr(\[CapitalTheta]_K \[CapitalTheta]_J \
\[CapitalTheta]^K \[CapitalTheta]^J) for any J of rank s, F.F = 1 (five \
eigenvalues +1, four \[Minus]1). With a density matrix R the direct (Hartree) \
energy is \[CapitalSigma]_s (g_s/2) D_s, D_s = \[CapitalSigma]_{J\[Element]s} \
tr(\[CapitalTheta]_J R) tr(\[CapitalTheta]^J R), and the exchange (Fock) \
energy is \[Minus]\[CapitalSigma]_r (g_r/2) \[CapitalSigma]_{K\[Element]r} \
tr(\[CapitalTheta]_K R \[CapitalTheta]^K R) = \[Minus]\[CapitalSigma]_{r,s} \
(g_r/2) F_rs D_s. Hartree\[Dash]Fock is therefore Hartree with the \
Fierz-transformed couplings\
\>", "Text",ExpressionUUID->"cfda0c7b-988f-6a4f-9056-a3bf844fb6c9"],

Cell["\<\
      G = (1 \[Minus] Transpose[F]) g,     G_s = g_s \[Minus] \
\[CapitalSigma]_r F_rs g_r.\
\>", "Text",ExpressionUUID->"942f551a-a2f5-3845-be01-c6c818a86347"],

Cell["\<\
For uniform spin-saturated matter R = (\[Rho]S ID16 + \[Rho] \
\[CapitalGamma]17[0])/16 only D_0 = \[Rho]S\.b2 and D_1 = \[Rho]\.b2 survive, \
so only G_0 and G_1 matter; with the couplings of section 8 (gS = \
\[Minus]100000, gV = 10000, all others 0) G_0 = \[Minus]98750 and G_1 = \
20000, the Hartree\[Dash]Fock couplings of section 8.7.\
\>", "Text",ExpressionUUID->"a23841ef-8541-8441-a743-d504a31f4788"],

Cell[CellGroupData[{

Cell["\<\
fierzF = Table[Sum[(-1)^(r s - l) Binomial[s, l] Binomial[8 - s, r - l], {l, \
0, Min[r, s]}]/16, {r, 0, 8}, {s, 0, 8}];
fierzFromTraces[r_, J_] := Sum[Tr[\[CapitalTheta]dn[K].\[CapitalTheta]dn[J].\
\[CapitalTheta]up[K].\[CapitalTheta]up[J]], {K, Select[mIdx, rk[#] == r \
&]}]/256;
check[\"Fierz matrix: closed form == (1/256) Sum_{K in r} \
Tr[Theta_K.Theta_J.Theta^K.Theta^J] for the first and last J of every rank s\",
  And @@ Flatten[Table[With[{Js = Select[mIdx, rk[#] == s &]}, \
fierzFromTraces[r, First[Js]] == fierzF[[r + 1, s + 1]] && fierzFromTraces[r, \
Last[Js]] == fierzF[[r + 1, s + 1]]], {r, 0, 8}, {s, 0, 8}]]]
check[\"F.F == IdentityMatrix[9]; eigenvalues: five +1 and four -1\", \
fierzF.fierzF == IdentityMatrix[9] && Sort[Eigenvalues[fierzF]] == {-1, -1, \
-1, -1, 1, 1, 1, 1, 1}]
{aR, bR, cR, dR} = Table[rndSpinor[], {4}];
check[\"Fierz identity for commuting spinors (random): Sum_{K in r} (a \
Theta_K b)(c Theta^K d) == Sum_s F_rs Sum_{J in s} (a Theta_J d)(c Theta^J \
b), r = 0..8\",
  And @@ Table[Sum[(aR.\[CapitalTheta]dn[K].bR) (cR.\[CapitalTheta]up[K].dR), \
{K, Select[mIdx, rk[#] == r &]}] ==
     Sum[fierzF[[r + 1, s + 1]] Sum[(aR.\[CapitalTheta]dn[J].dR) (cR.\
\[CapitalTheta]up[J].bR), {J, Select[mIdx, rk[#] == s &]}], {s, 0, 8}], {r, \
0, 8}]]
RrF = RandomInteger[{-3, 3}, {16, 16}] + I RandomInteger[{-3, 3}, {16, 16}]; \
grF = RandomInteger[{-5, 5}, 9];
dS9[R_] := Table[Sum[Tr[\[CapitalTheta]dn[J].R] Tr[\[CapitalTheta]up[J].R], \
{J, Select[mIdx, rk[#] == s &]}], {s, 0, 8}];
check[\"Hartree-Fock energy E_H + E_x == Sum_s (G_s/2) D_s with G = (1 - \
Transpose[F]) g (random density matrix and couplings)\",
  grF.dS9[RrF]/2 - Sum[grF[[r + 1]]/2 Sum[Tr[\[CapitalTheta]dn[K].RrF.\
\[CapitalTheta]up[K].RrF], {K, Select[mIdx, rk[#] == r &]}], {r, 0, 8}] ==
   ((IdentityMatrix[9] - Transpose[fierzF]).grF).dS9[RrF]/2]
gSymb = Array[gg, 9, 0]; Geff = Expand[(IdentityMatrix[9] - \
Transpose[fierzF]).gSymb];
check[\"uniform density matrix (rhoS ID16 + rho Gamma17[0])/16: D_0 == \
rhoS^2, D_1 == rho^2, D_2 .. D_8 == 0\",
  Simplify[dS9[(rhoSs ID16 + rhos \[CapitalGamma]17[0])/16]] == \
Join[{rhoSs^2, rhos^2}, ConstantArray[0, 7]]]
check[\"section 8 recovered: with g = (gS, gV, 0, 0, 0, 0, 0, -gA, -gP) the \
exchange energy of uniform matter is that of section 8.7\",
  Expand[Sum[(Geff[[s + 1]] - gSymb[[s + 1]])/2 {rhoSs^2, rhos^2, 0, 0, 0, 0, \
0, 0, 0}[[s + 1]], {s, 0, 8}] /. {gg[0] -> gS, gg[1] -> gV, gg[7] -> -gA, \
gg[8] -> -gP, gg[_] -> 0}] ==
   Expand[-(gS/32) (rhoSs^2 + rhos^2) + (gP/32) (rhoSs^2 - rhos^2) - (gV/32) \
(8 rhoSs^2 - 6 rhos^2) + (gA/32) (8 rhoSs^2 + 6 rhos^2)]]
check[\"the Hartree-Fock couplings of section 8.7: gS = -100000, gV = 10000 \
give G_0 = -98750, G_1 = 20000\",
  (Geff[[{1, 2}]] /. {gg[0] -> -100000, gg[1] -> 10000, gg[_] -> 0}) == \
{-98750, 20000}]
{\"16 F\" -> 16 fierzF, \"G_0\" -> Geff[[1]], \"G_1\" -> Geff[[2]], \"example \
g = (-100000, 10000, 3000, 0, ...): {G_0, G_1}\" -> (Geff[[{1, 2}]] /. {gg[0] \
-> -100000, gg[1] -> 10000, gg[2] -> 3000, gg[_] -> 0})}\
\>", "Input",
 CellLabel->
  "In[726]:=",ExpressionUUID->"c3468847-55d7-ff43-8299-42fc6739b191"],

Cell[BoxData[
 RowBox[{"\<\"Fierz matrix: closed form == (1/256) Sum_{K in r} \
Tr[Theta_K.Theta_J.Theta^K.Theta^J] for the first and last J of every rank \
s\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021244101252823`*^9},
