Cell[CellGroupData[{

Cell["16.2 The three epochs", "Subsection",ExpressionUUID->"20604173-0d7e-ae41-8309-70321e8ec331"],

Cell["\<\
Primordial: the Einstein\[Dash]Kasner background a = x0^0.547, b = x0^(\
\[Minus]0.160) of section 14.1, normalized so that a = b = 1 at x0 = 1. The \
density grows like 1/x0 (a\.b3b\:2074 = x0), but the ordinary momenta are \
blue-shifted (p/a \[RightArrow] \[Infinity]), so the scalar density per \
particle M/\[Omega] falls and the attractive scalar coupling drives the \
effective mass toward zero: chiral symmetry is effectively restored near x0 = \
0. Modern: a static auxiliary space (b = 1) and growing a: the ordinary \
momenta redshift, M \[RightArrow] m, \[Epsilon] a\.b3 \[RightArrow] constant \
and pa/\[Epsilon] \[RightArrow] 0 \[LongDash] dirac16complex behaves as cold \
(pressureless) matter in ordinary space, while a stress pb remains along the \
auxiliary space, which the stabilizing stress of section 14.4 must balance. \
Far future: de Sitter a = e^{0.1 x0}, b = 1: \[Rho] = \[Rho]0 e^{\[Minus]0.3 \
x0} and 1 \[Minus] M decays like \[Rho].\
\>", "Text",ExpressionUUID->"2e1721f6-a945-a243-82ff-ba41ae0c1b41"],

Cell[CellGroupData[{

Cell["\<\
pKs = N[(1 + 2 Sqrt[2])/7, 20]; qKs = N[(2 - 3 Sqrt[2])/14, 20];
primKS = Table[x -> ksStress[x^pKs, x^qKs, kFsat], {x, {10.^-4, 10.^-3, \
10.^-2, 10.^-1, 1., 10.}}];
check[\"primordial: rho x0 == kFsat^7/(105 Pi^4) at every x0, and m* \
decreases monotonically to below 0.05 at x0 = 10^-4\",
  And @@ Table[Abs[(r[[2]][\"rho\"]) r[[1]] - kFsat^7/(105 Pi^4)] < 10^-12, \
{r, primKS}] && OrderedQ[primKS[[All, 2]][[All, Key[\"M\"]]]] && primKS[[1, \
2]][\"M\"] < 0.05]
modKS = Table[aa -> ksStress[aa, 1., kFsat], {aa, {1., 2., 4., 10., 100.}}];
check[\"modern (b = 1): eps a^3 tends to a constant and pa/eps -> 0 \
(pressureless in ordinary space)\",
  Abs[(modKS[[5, 2]][\"eps\"] 100.^3)/(modKS[[4, 2]][\"eps\"] 10.^3) - 1] < \
0.05 && modKS[[5, 2]][\"pa\"]/modKS[[5, 2]][\"eps\"] < 10^-3]
futKS = Table[x -> ksStress[Exp[0.1 x], 1., kFsat], {x, {0., 10., 20., 40., \
80.}}];
check[\"far future (de Sitter, H = 0.1): rho == rho0 e^{-3 H x0} and 1 - m* \
decays like rho\",
  Abs[futKS[[4, 2]][\"rho\"]/futKS[[1, 2]][\"rho\"] - Exp[-12.]] < 10^-12 && \
Abs[(1 - futKS[[5, 2]][\"M\"])/(1 - futKS[[4, 2]][\"M\"])/Exp[-12.] - 1] < \
0.05]
{\"primordial m*(x0), x0 = 1e-4 .. 10\" -> primKS[[All, 2]][[All, \
Key[\"M\"]]], \"primordial pa/pb at x0 = 1e-3, 1e-1, 10\" -> \
(#[\"pa\"]/#[\"pb\"] & /@ primKS[[{2, 4, 6}, 2]]),
 \"modern m*(a), a = 1, 2, 4, 10, 100\" -> modKS[[All, 2]][[All, \
Key[\"M\"]]], \"modern pb/eps at a = 100\" -> modKS[[5, 2]][\"pb\"]/modKS[[5, \
2]][\"eps\"],
 \"far future m*(x0), x0 = 0, 10, 20, 40, 80\" -> futKS[[All, 2]][[All, \
Key[\"M\"]]]}\
\>", "Input",
 CellLabel->
  "In[768]:=",ExpressionUUID->"12c769ef-d450-104a-8464-2483cecf4b73"],

Cell[BoxData[
 RowBox[{"\<\"primordial: rho x0 == kFsat^7/(105 Pi^4) at every x0, and m* \
decreases monotonically to below 0.05 at x0 = 10^-4\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0021244120606556`*^9},
 CellLabel->
  "Out[770]=",ExpressionUUID->"25f2dfac-90c8-1648-a49d-b2b5aa020781"],

Cell[BoxData[
 RowBox[{"\<\"modern (b = 1): eps a^3 tends to a constant and pa/eps -> 0 \
(pressureless in ordinary space)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002124412407852*^9},
 CellLabel->
  "Out[772]=",ExpressionUUID->"64e1a671-5e8a-a347-9cee-d2ebd5fc6546"],

Cell[BoxData[
 RowBox[{"\<\"far future (de Sitter, H = 0.1): rho == rho0 e^{-3 H x0} and 1 \
- m* decays like rho\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002124412709324*^9},
 CellLabel->
  "Out[774]=",ExpressionUUID->"6f24534f-d003-0a47-8c23-9793d23ab885"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"primordial m*(x0), x0 = 1e-4 .. 10\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "0.003824179379430471`", ",", "0.010783989711922494`", ",", 
      "0.03023851961204259`", ",", "0.08844464116180194`", ",", 
      "0.3480973401462433`", ",", "0.8917637493589151`"}], "}"}]}], ",", 
   RowBox[{"\<\"primordial pa/pb at x0 = 1e-3, 1e-1, 10\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.0868869169150368`", ",", "1.6461737747098397`", ",", 
      RowBox[{"-", "0.4036333858521349`"}]}], "}"}]}], ",", 
   RowBox[{"\<\"modern m*(a), a = 1, 2, 4, 10, 100\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "0.3480973401462433`", ",", "0.85354080904854`", ",", 
      "0.9807410717586907`", ",", "0.9987576007278518`", ",", 
      "0.9999987563024887`"}], "}"}]}], ",", 
   RowBox[{"\<\"modern pb/eps at a = 100\"\>", "\[Rule]", 
    "0.04977351208721611`"}], ",", 
   RowBox[{"\<\"far future m*(x0), x0 = 0, 10, 20, 40, 80\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "0.3480973401462433`", ",", "0.9395796910293628`", ",", 
      "0.996923581335845`", ",", "0.9999923586141617`", ",", 
      "0.9999999999530483`"}], "}"}]}]}], "}"}]], "Output",
 CellChangeTimes->{4.0021244127252865`*^9},
 CellLabel->
  "Out[775]=",ExpressionUUID->"f3438c1d-9fd0-5641-ac80-078c376e848a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
16.3 Self-consistent evolution: Einstein\[Dash]Lovelock gravity driven by the \
Kohn\[Dash]Sham matter\
\>", "Subsection",ExpressionUUID->"0048917f-5eb7-e64d-bec8-e17c0d51c370"],

Cell["\<\
With T^\[Mu]_\[Nu] of the Kohn\[Dash]Sham matter the field equations of \
section 14 are a closed system for a, b. The 11 and 44 equations are LINEAR \
in Ha\[Prime] and Hb\[Prime] (Lovelock equations are quasi-linear), so they \
are solved for (Ha\[Prime], Hb\[Prime]) at every step; the 00 equation \
contains no second derivatives and is a CONSTRAINT, imposed on the initial \
data (Hb(0) from Ha(0)) and then preserved by the evolution because both \
sides are conserved (Bianchi identity of section 12, conservation law of \
section 16.1). The runs below (\[Kappa] = 1000, \[CapitalLambda] = 0, Ha(0) = \
0.05, a(0) = b(0) = 1, x0 from 0 to 20) check that preservation for Einstein \
gravity and for Einstein\[Dash]Lovelock gravity with \[Alpha]_2 = 20, \
\[Alpha]_3 = 500.\
\>", "Text",ExpressionUUID->"0e0eb27f-0deb-c242-9a37-2dde68e07e53"],

Cell[CellGroupData[{

Cell["\<\
eTot[c_] := Sum[alf[k] toH[ECos[[k + 1, c, c]]], {k, 1, 3}] - lamb;
coefLin[c_] := {Coefficient[eTot[c], dHa], Coefficient[eTot[c], dHb], eTot[c] \
/. {dHa -> 0, dHb -> 0}};
check[\"the 11 and 44 Einstein-Lovelock equations are linear in (Ha', Hb'); \
the 00 equation contains neither (constraint)\",
  Exponent[eTot[2], dHa] <= 1 && Exponent[eTot[2], dHb] <= 1 && \
Exponent[eTot[5], dHa] <= 1 && Exponent[eTot[5], dHb] <= 1 && FreeQ[eTot[1], \
dHa | dHb]]
cl11 = coefLin[2]; cl44 = coefLin[5]; con00 = eTot[1];
dHsol[al2_?NumericQ, al3_?NumericQ, kap_?NumericQ, a_?NumericQ, b_?NumericQ, \
ha_?NumericQ, hb_?NumericQ] := dHsol[al2, al3, kap, a, b, ha, hb] =
   Module[{st = ksStress[a, b, kFsat], rule = {alf[1] -> 1, alf[2] -> al2, \
alf[3] -> al3, lamb -> 0, Ha -> ha, Hb -> hb}},
    LinearSolve[{cl11[[1 ;; 2]], cl44[[1 ;; 2]]} /. rule, {-kap st[\"pa\"] - \
(cl11[[3]] /. rule), -kap st[\"pb\"] - (cl44[[3]] /. rule)}]];
dHaF[al2_?NumericQ, al3_?NumericQ, kap_?NumericQ, a_?NumericQ, b_?NumericQ, \
ha_?NumericQ, hb_?NumericQ] := dHsol[al2, al3, kap, a, b, ha, hb][[1]];
dHbF[al2_?NumericQ, al3_?NumericQ, kap_?NumericQ, a_?NumericQ, b_?NumericQ, \
ha_?NumericQ, hb_?NumericQ] := dHsol[al2, al3, kap, a, b, ha, hb][[2]];
evolveEL[al2_, al3_, kap_, ha0_] := Module[{st = ksStress[1., 1., kFsat], \
cpol, hb0, sol, rule, viol},
   cpol = con00 /. {alf[1] -> 1, alf[2] -> al2, alf[3] -> al3, lamb -> 0, Ha \
-> ha0};
   hb0 = Hb /. First[SortBy[NSolve[cpol == kap st[\"eps\"], Hb, Reals], \
Abs[Hb /. #] &]];
   sol = NDSolve[{aE'[x] == hE[x] aE[x], bE'[x] == kE[x] bE[x],
       hE'[x] == dHaF[al2, al3, kap, aE[x], bE[x], hE[x], kE[x]], kE'[x] == \
dHbF[al2, al3, kap, aE[x], bE[x], hE[x], kE[x]],
       aE[0] == 1, bE[0] == 1, hE[0] == ha0, kE[0] == N[hb0]}, {aE, bE, hE, \
kE}, {x, 0, 20},
      Method -> {\"ExplicitRungeKutta\", \"DifferenceOrder\" -> 8}, \
PrecisionGoal -> 10, AccuracyGoal -> 13, MaxSteps -> 10^6,
      InterpolationOrder -> All][[1]];      (* InterpolationOrder -> All: the \
dense output has the order of the method between the steps *)
   viol = Max[Table[With[{aa = aE[x] /. sol, bb = bE[x] /. sol, ha = hE[x] /. \
sol, hb = kE[x] /. sol},
       Abs[((con00 /. {alf[1] -> 1, alf[2] -> al2, alf[3] -> al3, lamb -> 0, \
Ha -> ha, Hb -> hb}) - kap ksStress[aa, bb, kFsat][\"eps\"])/(kap \
ksStress[aa, bb, kFsat][\"eps\"])]], {x, 0, 20, 4}]];
   {N[hb0], {aE[20], bE[20], hE[20], kE[20]} /. sol, viol}];
runE = evolveEL[0., 0., 1000., 0.05];
runL = evolveEL[20., 500., 1000., 0.05];
check[\"self-consistent evolution: the constraint Sum alpha_k E^(k)0_0 - \
Lambda == kappa eps is preserved to 10^-7 (relative) for Einstein and for \
Einstein-Lovelock (alpha2 = 20, alpha3 = 500)\",
  runE[[3]] < 10^-7 && runL[[3]] < 10^-7]
{\"Einstein: Hb(0), {a, b, Ha, Hb}(20), violation\" -> runE, \
\"Einstein-Lovelock: Hb(0), {a, b, Ha, Hb}(20), violation\" -> runL}\
\>", "Input",
 CellLabel->
  "In[776]:=",ExpressionUUID->"bd3b5205-2f75-e24f-920b-fcc384da3a6f"],

Cell[BoxData[
 RowBox[{"\<\"the 11 and 44 Einstein-Lovelock equations are linear in (Ha', \
Hb'); the 00 equation contains neither (constraint)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002124412773468*^9},
 CellLabel->
  "Out[778]=",ExpressionUUID->"d183ac78-3a9f-f64f-8c72-eb9a98485fa9"],

Cell[BoxData[
 RowBox[{"\<\"self-consistent evolution: the constraint Sum alpha_k E^(k)0_0 \
- Lambda == kappa eps is preserved to 10^-7 (relative) for Einstein and for \
Einstein-Lovelock (alpha2 = 20, alpha3 = 500)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002124521185871*^9},
 CellLabel->
  "Out[786]=",ExpressionUUID->"5f195dc1-6f58-6b45-9cba-2614075290fb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Einstein: Hb(0), {a, b, Ha, Hb}(20), violation\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.009143712444558975`", ",", 
      RowBox[{"{", 
       RowBox[{
       "1.5817386798481468`", ",", "1.1975585618423619`", ",", 
        "0.011877999367551987`", ",", "0.007419107766692174`"}], "}"}], ",", 
      "1.9727626114021923`*^-14"}], "}"}]}], ",", 
   RowBox[{"\<\"Einstein-Lovelock: Hb(0), {a, b, Ha, Hb}(20), violation\"\>", 
    "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.014980703942304672`", ",", 
      RowBox[{"{", 
       RowBox[{
       "1.4773514780944115`", ",", "1.276084053398622`", ",", 
        "0.010175914492202693`", ",", "0.008488764693550076`"}], "}"}], ",", 
      "2.377784774179952`*^-14"}], "}"}]}]}], "}"}]], "Output",
 CellChangeTimes->{4.002124521185871*^9},
 CellLabel->
  "Out[787]=",ExpressionUUID->"7e9d48e6-6d79-374c-b293-6ebe5fde56d7"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["17. The Standard Model on the world brane of 7+1 spacetime", "Section",ExpressionUUID->"70d6f2ba-e714-d845-b002-07d5bbbeffa8"],

Cell[TextData[{
 StyleBox["About sections 17\[Dash]19. ",
  FontWeight->"Bold"],
 "Dirac_claude places the Standard Model on a seven-dimensional fold of its \
4+4 spacetime. Here the same idea is rebuilt for 7+1: the four auxiliary \
coordinates x4 \[Ellipsis] x7 form a torus T\:2074 (x_k \[TildeEqual] x_k + \
Lc, coordinate period Lc, proper size b\[CenterDot]Lc), and the Standard \
Model lives on the 3+1-dimensional WORLD BRANE W = {x4 = x5 = x6 = x7 = 0}, \
spanned by the time x0 and ordinary space x1, x2, x3. Gravity (sections 11\
\[Dash]14) and dirac16complex (sections 7\[Dash]10, 13, 15\[Dash]16) live in \
the whole 7+1 spacetime (the bulk); every Standard Model field lives on W and \
feels gravity through the induced metric h_\[Mu]\[Nu] = g_\[Mu]\[Nu](x, y = \
0) (\[Mu], \[Nu] = 0 \[Ellipsis] 3). The two sectors meet at W through \
portals. The total action is"
}], "Text",ExpressionUUID->"00d0b866-2968-7c40-9812-b7b211af675d"],

Cell["\<\
      S = S_EL[g] + S_dirac16complex[\[Psi], g] + \[Integral]_W d\:2074x \
\[Sqrt]|h| (L_SM + L_portal) + S_stab,\
\>", "Text",ExpressionUUID->"8c5c0d49-be20-4946-8b23-4280240cd727"],

Cell["\<\
with S_EL the Einstein\[Dash]Lovelock action of section 12, the self-coupled \
covariant dirac16complex action of sections 13 and 15, L_SM the complete \
Standard Model Lagrangian below (gauge fields, Higgs doublet, three \
generations of quarks and leptons including right-handed neutrinos, Yukawa \
couplings), L_portal the couplings of section 18, and S_stab the stabilizing \
stress of section 14.4 that keeps b constant in the modern epoch. In \
eight-dimensional form \[Integral]_W d\:2074x \[Sqrt]|h| (\[Ellipsis]) = \
\[Integral] d\:2078X \[Sqrt]|g| \[Delta]\:2074(y)/b\:2074 (\[Ellipsis]).\
\>", "Text",ExpressionUUID->"7113c1ed-6fe0-e44a-b0e2-1a567950319d"],

Cell[CellGroupData[{

Cell["\<\
17.1 The fields, their quantum numbers, and anomaly cancellation\
\>", "Subsection",ExpressionUUID->"1596c8d4-44df-9a4d-b6b1-0d2aa1b8f774"],

Cell["\<\
Gauge group SU(3)_C \[Times] SU(2)_L \[Times] U(1)_Y with gauge fields G^a_\
\[Mu] (a = 1 \[Ellipsis] 8), W^I_\[Mu] (I = 1, 2, 3), B_\[Mu] and couplings \
gs, g, g\[Prime]. Matter in each of three generations (Weyl fields; Q = T3 + \
Y):\
\>", "Text",ExpressionUUID->"080923ab-bfe4-6649-815e-32a5521456bf"],

Cell["\<\
Q_L = (u_L, d_L): (3, 2, 1/6);  u_R: (3, 1, 2/3);  d_R: (3, 1, \[Minus]1/3);  \
L_L = (\[Nu]_L, e_L): (1, 2, \[Minus]1/2);  e_R: (1, 1, \[Minus]1);  \[Nu]_R: \
(1, 1, 0).\
\>", "Item",ExpressionUUID->"9001c6c9-c2b1-ec4d-8da2-6dc925cb2eda"],

Cell["Higgs doublet \[CapitalPhi]: (1, 2, 1/2), \[CapitalPhi]\:0303 = i\
\[Sigma]2 \[CapitalPhi]*.", "Item",ExpressionUUID->"2450ee27-0af1-394f-81dc-\
0d860a5ee087"],

Cell["\<\
The gauge anomalies (with left-handed fields counted +, right-handed \
\[Minus]) cancel generation by generation, with or without \[Nu]_R, and the \
number of SU(2) doublets per generation is even (no Witten anomaly). The \
relativistic degrees of freedom of the fields above, without \[Nu]_R, give g* \
= 28 + (7/8)\[CenterDot]90 = 106.75.\
\>", "Text",ExpressionUUID->"de84a7d3-600c-4c44-8549-0d789021579f"],

Cell[CellGroupData[{

Cell["\<\
smF = {{\"Q\", 3, 2, 1/6, 1}, {\"uR\", 3, 1, 2/3, -1}, {\"dR\", 3, 1, -1/3, \
-1}, {\"L\", 1, 2, -1/2, 1}, {\"eR\", 1, 1, -1, -1}, {\"nuR\", 1, 1, 0, -1}};
anom = <|\"SU(3)^2 U(1)\" -> Total[(#[[5]] #[[3]] #[[4]]) & /@ Select[smF, \
#[[2]] == 3 &]],
   \"SU(2)^2 U(1)\" -> Total[(#[[5]] #[[2]] #[[4]]) & /@ Select[smF, #[[3]] \
== 2 &]],
   \"U(1)^3\" -> Total[(#[[5]] #[[2]] #[[3]] #[[4]]^3) & /@ smF], \"grav^2 \
U(1)\" -> Total[(#[[5]] #[[2]] #[[3]] #[[4]]) & /@ smF],
   \"SU(3)^3\" -> Total[(#[[5]] #[[3]]) & /@ Select[smF, #[[2]] == 3 &]]|>;
check[\"anomaly cancellation per generation (with nu_R): SU(3)^2U(1), \
SU(2)^2U(1), U(1)^3, grav^2U(1), SU(3)^3 all vanish; doublets per generation \
even\",
  Values[anom] == {0, 0, 0, 0, 0} && EvenQ[Total[Select[smF, #[[3]] == 2 \
&][[All, 2]]]]]
check[\"electric charges Q = T3 + Y: (u, d) = (2/3, -1/3), (nu, e) = (0, -1), \
u_R 2/3, d_R -1/3, e_R -1, nu_R 0\",
  ({1/6 + 1/2, 1/6 - 1/2, -1/2 + 1/2, -1/2 - 1/2} == {2/3, -1/3, 0, -1})]
gStar = (8 2 + 3 2 + 2 + 4) + 7/8 3 Total[(2 #[[2]] #[[3]]) & /@ Select[smF, \
#[[1]] != \"nuR\" &]];
check[\"g* = 28 + (7/8) 90 = 106.75 for the Standard Model fields (without \
nu_R)\", gStar == 427/4]\
\>", "Input",
 CellLabel->
  "In[788]:=",ExpressionUUID->"0f70b8ea-88db-194a-af12-b5b12013709d"],

Cell[BoxData[
 RowBox[{"\<\"anomaly cancellation per generation (with nu_R): SU(3)^2U(1), \
SU(2)^2U(1), U(1)^3, grav^2U(1), SU(3)^3 all vanish; doublets per generation \
even\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002124521201702*^9},
 CellLabel->
  "Out[790]=",ExpressionUUID->"61f66c04-a2db-d742-89c0-e489e706a0a6"],

Cell[BoxData[
 RowBox[{"\<\"electric charges Q = T3 + Y: (u, d) = (2/3, -1/3), (nu, e) = \
(0, -1), u_R 2/3, d_R -1/3, e_R -1, nu_R 0\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002124521201702*^9},
 CellLabel->
  "Out[791]=",ExpressionUUID->"9c93f585-67b1-524d-a94f-4d2d74c06988"],

Cell[BoxData[
 RowBox[{"\<\"g* = 28 + (7/8) 90 = 106.75 for the Standard Model fields \
(without nu_R)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002124521201702*^9},
 CellLabel->
  "Out[793]=",ExpressionUUID->"fbc3754c-8bfc-9c4a-9673-09f29bb85ed3"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["17.2 The Lagrangian on the brane, in the gravitational field", \
"Subsection",ExpressionUUID->"1470e404-4de0-bc44-ae84-be1eb2a2ab68"],

Cell["\<\
With the induced metric h_\[Mu]\[Nu], its frame (tetrad) and spin connection, \
complex 4\[Times]4 Dirac matrices \[Gamma]^\[Mu](x) of the brane ({\[Gamma]^\
\[Mu], \[Gamma]^\[Nu]} = 2 h^\[Mu]\[Nu]) and the gauge-covariant derivatives \
D_\[Mu] = \[Del]_\[Mu] \[Minus] i gs G^a_\[Mu] T^a \[Minus] i g W^I_\[Mu] \
\[Tau]^I/2 \[Minus] i g\[Prime] Y B_\[Mu]:\
\>", "Text",ExpressionUUID->"0d371175-2e43-f446-8bd3-b3334703a0c7"],

Cell["\<\
      L_SM = \[Minus](1/4) G^a_\[Mu]\[Nu] G^a\[Mu]\[Nu] \[Minus] (1/4) W^I_\
\[Mu]\[Nu] W^I\[Mu]\[Nu] \[Minus] (1/4) B_\[Mu]\[Nu] B^\[Mu]\[Nu] + (D_\[Mu]\
\[CapitalPhi])\[Dagger](D^\[Mu]\[CapitalPhi]) \[Minus] \[Mu]\.b2 \
\[CapitalPhi]\[Dagger]\[CapitalPhi] \[Minus] \[Lambda] \
(\[CapitalPhi]\[Dagger]\[CapitalPhi])\.b2\
\>", "Text",ExpressionUUID->"a2fcb1e6-3030-c241-9241-4863d8eec698"],

Cell["\<\
            + \[CapitalSigma]_f fbar i \[Gamma]^\[Mu] D_\[Mu] f \[Minus] [Q\
\:0304_L Y_u \[CapitalPhi]\:0303 u_R + Q\:0304_L Y_d \[CapitalPhi] d_R + L\
\:0304_L Y_e \[CapitalPhi] e_R + L\:0304_L Y_\[Nu] \[CapitalPhi]\:0303 \
\[Nu]_R + h.c.],\
\>", "Text",ExpressionUUID->"3c4d37a0-3d83-6845-98d6-912c3c0479e0"],

Cell["\<\
with G^a_\[Mu]\[Nu] = \[PartialD]_\[Mu]G^a_\[Nu] \[Minus] \
\[PartialD]_\[Nu]G^a_\[Mu] + gs f^abc G^b_\[Mu] G^c_\[Nu], W^I_\[Mu]\[Nu] = \
\[PartialD]_\[Mu]W^I_\[Nu] \[Minus] \[PartialD]_\[Nu]W^I_\[Mu] + g \
\[Epsilon]^IJK W^J_\[Mu] W^K_\[Nu], B_\[Mu]\[Nu] = \[PartialD]_\[Mu]B_\[Nu] \
\[Minus] \[PartialD]_\[Nu]B_\[Mu], f summing over all Weyl fields of the \
three generations, and 3\[Times]3 Yukawa matrices Y_u, Y_d, Y_e, Y_\[Nu]. Its \
field equations (\[Del]_\[Mu] G^a\[Mu]\[Nu] = gs \[CapitalSigma]_q q\:0304\
\[Gamma]^\[Nu] T^a q + gauge self-coupling, and so on) are the ordinary ones \
with \[PartialD] \[RightArrow] \[Del] (Levi-Civita connection of h).\
\>", "Text",ExpressionUUID->"272a939f-1454-a047-9faf-0cefcfd28651"]
}, Open  ]],

Cell[CellGroupData[{

Cell["17.3 Electroweak symmetry breaking", "Subsection",ExpressionUUID->"3e917f38-e497-3843-8d08-ea8e87344f59"],

Cell["\<\
With \[LeftAngleBracket]\[CapitalPhi]\[RightAngleBracket] = (0, v/\[Sqrt]2) \
the term |D_\[Mu]\[LeftAngleBracket]\[CapitalPhi]\[RightAngleBracket]|\.b2 is \
a mass matrix for (W\.b9, W\.b2, W\.b3, B) with eigenvalues g\.b2v\.b2/4 (W\
\[PlusMinus], twice), (g\.b2 + g\[Prime]\.b2)v\.b2/4 (Z) and 0 (photon). The \
inputs G_F = 1.1663788 \[Times] 10\:207b\:2075 GeV\:207b\.b2, m_W = 80.3692 \
GeV, m_Z = 91.1880 GeV, m_H = 125.20 GeV (PDG 2025) fix v = (\[Sqrt]2 G_F)^(\
\[Minus]1/2), g = 2m_W/v, cos\[Theta]_W = m_W/m_Z (on shell), g\[Prime] = g \
tan\[Theta]_W, e = g sin\[Theta]_W and \[Lambda] = m_H\.b2/(2v\.b2) at tree \
level.\
\>", "Text",ExpressionUUID->"97e42242-f76c-3c4c-815a-29b980efe5a2"],

Cell[CellGroupData[{

Cell["\<\
wF = {wW1, wW2, wW3, bB};       (* the components W^1, W^2, W^3 and B of the \
electroweak gauge fields *) tauP = {PauliMatrix[1], PauliMatrix[2], \
PauliMatrix[3]};
dPhi = -I (gW Sum[wF[[i]] tauP[[i]]/2, {i, 3}] + gY/2 bB \
IdentityMatrix[2]).{0, vH/Sqrt[2]};
massTerm = Expand[ComplexExpand[Conjugate[dPhi].dPhi]];
mGB = Table[D[massTerm, wF[[i]], wF[[j]]], {i, 4}, {j, 4}];
check[\"gauge-boson mass matrix: eigenvalues g^2 v^2/4 (twice), (g^2 + g'^2) \
v^2/4 and 0 (photon)\",
  Sort[Expand[Eigenvalues[mGB]]] == Sort[Expand[{gW^2 vH^2/4, gW^2 vH^2/4, \
(gW^2 + gY^2) vH^2/4, 0}]]]
gFermi = 1.1663788*^-5; mWb = 80.3692; mZb = 91.1880; mHb = 125.20;
vEW = (Sqrt[2] gFermi)^(-1/2); gEW = 2 mWb/vEW; cW = mWb/mZb; sW2 = 1 - cW^2; \
gpEW = gEW Sqrt[sW2]/cW; eEW = gEW Sqrt[sW2]; lamH = mHb^2/(2 vEW^2);
check[\"tree level: m_W == g v/2, m_Z == Sqrt[g^2 + g'^2] v/2, rho == \
m_W^2/(m_Z^2 cos^2 theta_W) == 1, m_H^2 == 2 lambda v^2\",
  Abs[gEW vEW/2 - mWb] < 10^-12 && Abs[Sqrt[gEW^2 + gpEW^2] vEW/2 - mZb] < \
10^-10 && Abs[mWb^2/(mZb^2 cW^2) - 1] < 10^-14 && Abs[2 lamH vEW^2 - mHb^2] < \
10^-9]
{\"v\" -> vEW, \"g\" -> gEW, \"g'\" -> gpEW, \"sin^2 thetaW\" -> sW2, \"e\" \
-> eEW, \"1/alpha tree\" -> 4 Pi/eEW^2, \"lambda\" -> lamH}\
\>", "Input",
 CellLabel->
  "In[794]:=",ExpressionUUID->"c72f1ce5-3bf5-324e-ac98-8c64607de360"],

Cell[BoxData[
 RowBox[{"\<\"gauge-boson mass matrix: eigenvalues g^2 v^2/4 (twice), (g^2 + \
g'^2) v^2/4 and 0 (photon)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002124521217476*^9},
 CellLabel->
  "Out[798]=",ExpressionUUID->"bda1248b-db7c-884d-9bf9-0e2c339b5936"],

Cell[BoxData[
 RowBox[{"\<\"tree level: m_W == g v/2, m_Z == Sqrt[g^2 + g'^2] v/2, rho == \
m_W^2/(m_Z^2 cos^2 theta_W) == 1, m_H^2 == 2 lambda v^2\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002124521217476*^9},
 CellLabel->
  "Out[801]=",ExpressionUUID->"351b8717-b461-2e41-81a1-0f52e4f6b165"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"v\"\>", "\[Rule]", "246.21964023926205`"}], ",", 
   RowBox[{"\<\"g\"\>", "\[Rule]", "0.6528252573344827`"}], ",", 
   RowBox[{"\<\"g'\"\>", "\[Rule]", "0.3499462340122371`"}], ",", 
   RowBox[{"\<\"sin^2 thetaW\"\>", "\[Rule]", "0.22320949284344327`"}], ",", 
   RowBox[{"\<\"e\"\>", "\[Rule]", "0.3084276316025824`"}], ",", 
   RowBox[{"\<\"1/alpha tree\"\>", "\[Rule]", "132.10014858375337`"}], ",", 
   RowBox[{"\<\"lambda\"\>", "\[Rule]", "0.12928057566123533`"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{4.002124521217476*^9},
 CellLabel->
  "Out[802]=",ExpressionUUID->"839cc114-0a62-cf49-a036-dba16062b2e7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["17.4 Quark and lepton masses; CKM and PMNS mixing", "Subsection",ExpressionUUID->"4fa55aec-832d-b943-9427-e040ebf33e91"],

Cell["\<\
Fermion masses are m = y v/\[Sqrt]2 for the singular values y of the Yukawa \
matrices; the mixing matrices are V_CKM = U_uL\[Dagger] U_dL and U_PMNS = \
U_eL\[Dagger] U_\[Nu]L. Both are written in the standard parametrization \
U(s12, s13, s23, \[Delta]) = R23 \[CenterDot] U13(\[Delta]) \[CenterDot] R12. \
Inputs: PDG 2024 (s12 = 0.22501, s13 = 0.003732, s23 = 0.04183, \[Delta] = \
1.147); PDG 2025 quark masses (m_u = 2.16 MeV, m_d = 4.70 MeV, m_s = 93.5 \
MeV, m_c = 1.2730 GeV, m_b = 4.183 GeV, m_t = 172.56 GeV); NuFit-6.0, normal \
ordering, without Super-Kamiokande atmospheric data (sin\.b2\[Theta]12 = \
0.307, sin\.b2\[Theta]23 = 0.561, sin\.b2\[Theta]13 = 0.02195, \[Delta] = 177\
\[Degree], \[CapitalDelta]m\.b221 = 7.49 \[Times] 10\:207b\:2075 eV\.b2, \
\[CapitalDelta]m\.b231 = 2.534 \[Times] 10\:207b\.b3 eV\.b2). With \[Nu]_R \
the neutrinos are Dirac particles; with the lightest mass m1 = 0: m2 = \
\[Sqrt]\[CapitalDelta]m\.b221, m3 = \[Sqrt]\[CapitalDelta]m\.b231.\
\>", "Text",ExpressionUUID->"1c3385de-2a8d-0340-812d-69e70781b28f"],

Cell[CellGroupData[{

Cell["\<\
mixU[s12_, s13_, s23_, d_] := Module[{c12 = Sqrt[1 - s12^2], c13 = Sqrt[1 - \
s13^2], c23 = Sqrt[1 - s23^2]},
   {{1, 0, 0}, {0, c23, s23}, {0, -s23, c23}}.{{c13, 0, s13 Exp[-I d]}, {0, \
1, 0}, {-s13 Exp[I d], 0, c13}}.{{c12, s12, 0}, {-s12, c12, 0}, {0, 0, 1}}];
vCKM = mixU[0.22501, 0.003732, 0.04183, 1.147];
jCKM = Im[vCKM[[1, 2]] vCKM[[2, 3]] Conjugate[vCKM[[1, 3]]] \
Conjugate[vCKM[[2, 2]]]];
rbCKM = -vCKM[[1, 1]] Conjugate[vCKM[[1, 3]]]/(vCKM[[2, 1]] \
Conjugate[vCKM[[2, 3]]]);
check[\"CKM: unitary; Jarlskog invariant J = 3.12 x 10^-5 (PDG 2024: 3.12 \
+0.13 -0.12 x 10^-5); A, rhobar, etabar within the PDG uncertainties\",
  Norm[vCKM.ConjugateTranspose[vCKM] - IdentityMatrix[3]] < 10^-15 && \
Abs[jCKM - 3.12*^-5] < 0.01*^-5 &&
  Abs[0.04183/0.22501^2 - 0.826] < 0.016 && Abs[Re[rbCKM] - 0.1591] < 0.0094 \
&& Abs[Im[rbCKM] - 0.3523] < 0.0073]
mUp = {2.16*^-3, 1.2730, 172.56}; mDown = {4.70*^-3, 93.5*^-3, 4.183};
yU = Sqrt[2] DiagonalMatrix[mUp]/vEW; yD = Sqrt[2] \
vCKM.DiagonalMatrix[mDown]/vEW;
{uuL, suY, uuR} = SingularValueDecomposition[yU]; {udL, sdY, udR} = \
SingularValueDecomposition[yD];
check[\"Yukawa matrices: singular values x v/Sqrt[2] are the quark masses and \
|U_uL^dag.U_dL| == |V_CKM|\",
  Norm[Sort[Diagonal[suY]] vEW/Sqrt[2] - Sort[mUp]] < 10^-12 && \
Norm[Sort[Diagonal[sdY]] vEW/Sqrt[2] - Sort[mDown]] < 10^-12 &&
  Norm[Abs[Reverse[Reverse /@ (ConjugateTranspose[uuL].udL)]] - Abs[vCKM]] < \
10^-9]
uPMNS = mixU[Sqrt[0.307], Sqrt[0.02195], Sqrt[0.561], 177 Degree]; dm21 = \
7.49*^-5; dm31 = 2.534*^-3;
mNu = {0, Sqrt[dm21], Sqrt[dm31]};
jPMNS = Im[uPMNS[[1, 2]] uPMNS[[2, 3]] Conjugate[uPMNS[[1, 3]]] \
Conjugate[uPMNS[[2, 2]]]];
check[\"PMNS unitary; Dirac neutrino Yukawa Sqrt[2] U.diag(m)/v reproduces \
the masses (singular values)\",
  Norm[uPMNS.ConjugateTranspose[uPMNS] - IdentityMatrix[3]] < 10^-15 &&
  Norm[Sort[Diagonal[SingularValueDecomposition[Sqrt[2] \
uPMNS.DiagonalMatrix[mNu 10^-9]/vEW][[2]]]] vEW/Sqrt[2] 10^9 - Sort[mNu]] < \
10^-15]
{\"|V_CKM|\" -> Abs[vCKM], \"J_CKM\" -> jCKM, \"rhobar + i etabar\" -> rbCKM, \
\"|U_PMNS|\" -> Abs[uPMNS], \"J_PMNS\" -> jPMNS, \"neutrino masses (eV)\" -> \
N[mNu], \"y_t\" -> Sqrt[2] 172.56/vEW}\
\>", "Input",
 CellLabel->
  "In[803]:=",ExpressionUUID->"094095f2-367e-714d-952e-54caf5a888e7"],

Cell[BoxData[
 RowBox[{"\<\"CKM: unitary; Jarlskog invariant J = 3.12 x 10^-5 (PDG 2024: \
3.12 +0.13 -0.12 x 10^-5); A, rhobar, etabar within the PDG \
uncertainties\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002124521217476*^9},
 CellLabel->
  "Out[807]=",ExpressionUUID->"1e870974-4252-e74d-8bba-37bc6392aa94"],

Cell[BoxData[
 RowBox[{"\<\"Yukawa matrices: singular values x v/Sqrt[2] are the quark \
masses and |U_uL^dag.U_dL| == |V_CKM|\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002124521217476*^9},
 CellLabel->
  "Out[811]=",ExpressionUUID->"b386952c-3ac9-5542-91e2-e0d4ca743800"],

Cell[BoxData[
 RowBox[{"\<\"PMNS unitary; Dirac neutrino Yukawa Sqrt[2] U.diag(m)/v \
reproduces the masses (singular values)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002124521217476*^9},
 CellLabel->
  "Out[815]=",ExpressionUUID->"06b78a6f-410d-2748-a855-983abdbbc5eb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"|V_CKM|\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "0.9743496688739451`", ",", "0.22500843304470478`", ",", 
        "0.0037319999999999996`"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "0.2248756508240272`", ",", "0.9734891972367566`", ",", 
        "0.041829708698546735`"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "0.008582798593907648`", ",", "0.0411094626832034`", ",", 
        "0.9991177846711541`"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"J_CKM\"\>", "\[Rule]", "0.0000311699352875547`"}], ",", 
   RowBox[{"\<\"rhobar + i etabar\"\>", "\[Rule]", 
    RowBox[{"0.1591844359424716`", "\[VeryThinSpace]", "+", 
     RowBox[{"0.35227461890586964`", " ", "\[ImaginaryI]"}]}]}], ",", 
   RowBox[{"\<\"|U_PMNS|\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "0.823279205373244`", ",", "0.5479610843846485`", ",", 
        "0.14815532390029054`"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "0.27490622951857774`", ",", "0.6129767654421161`", ",", 
        "0.740733454084531`"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "0.4966265347037742`", ",", "0.5692083406171428`", ",", 
        "0.655258689373899`"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"J_PMNS\"\>", "\[Rule]", "0.0017359130944756356`"}], ",", 
   RowBox[{"\<\"neutrino masses (eV)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "0.`", ",", "0.008654478609367522`", ",", "0.05033885179461287`"}], 
     "}"}]}], ",", 
   RowBox[{"\<\"y_t\"\>", "\[Rule]", "0.9911341438317453`"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{4.002124521217476*^9},
 CellLabel->
  "Out[816]=",ExpressionUUID->"1105771b-52cc-9b4f-b41e-74f2da248f34"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["17.5 The modern epoch on the brane", "Subsection",ExpressionUUID->"0113d16a-527c-314a-878b-e01ac41eaf88"],

Cell["\<\
With b = b0 the 00 equation of section 14.4 is the Friedmann equation of the \
brane, 3Ha\.b2 = 8\[Pi] G4 \[Rho]4 + \[CapitalLambda]4 with G4 = \
G8/V\[UpTee], V\[UpTee] = b0\:2074 Lc\:2074 (for matter on the brane, \
\[Epsilon]8 = \[Rho]4/V\[UpTee]). Integrating it with the Planck 2018 \
parameters (H0 = 67.4 km/s/Mpc, \[CapitalOmega]_m = 0.315, \[CapitalOmega]_r \
= 9.14 \[Times] 10\:207b\:2075, \[CapitalOmega]_\[CapitalLambda] = 1 \[Minus] \
\[CapitalOmega]_m \[Minus] \[CapitalOmega]_r) gives the age of the universe. \
With a reduced eight-dimensional Planck mass M8 (8\[Pi]G8 = M8\:207b\:2076) \
the reduced four-dimensional one is MPl\.b2 = M8\:2076 V\[UpTee] (2.435 \
\[Times] 10\.b9\:2078 GeV); for M8 = 10 TeV this fixes V\[UpTee] and the \
lowest Kaluza\[Dash]Klein mass 2\[Pi]/V\[UpTee]^(1/4) of a field on the \
auxiliary torus.\
\>", "Text",ExpressionUUID->"e163c190-3bcc-5245-aa2f-1e0e86a2d132"],

Cell[CellGroupData[{

Cell["\<\
mpcKm = 3.0856775814913673*^19; gyrS = 3.15576*^16; h0P = 67.4; omM = 0.315; \
omR = 9.14*^-5; omL = 1 - omM - omR;
ageU = NIntegrate[1/(aa Sqrt[omR/aa^4 + omM/aa^3 + omL]), {aa, 0, 1}, \
PrecisionGoal -> 12]/(h0P/mpcKm)/gyrS;
check[\"age of the universe from the brane Friedmann equation: 13.79 Gyr \
(Planck 2018: 13.787 +- 0.020 Gyr)\", Abs[ageU - 13.79] < 0.03]
check[\"ADD relation: kappa8 rho4/V_perp == 8 Pi G4 rho4 with G4 = G8/V_perp \
(kappa8 = 8 Pi G8)\", Simplify[k8 r4/vP - 8 Pi (k8/(8 Pi)/vP) r4] === 0]
vPerp = (2.435*^18)^2/(1.0*^4)^6; hbarcGeVm = 1.973269804*^-16;
{\"age (Gyr)\" -> ageU, \"V_perp (GeV^-4)\" -> vPerp, \"V_perp^(1/4) (m)\" -> \
vPerp^(1/4) hbarcGeVm, \"lowest KK mass (MeV)\" -> 2 Pi/vPerp^(1/4) 10^3}\
\>", "Input",
 CellLabel->
  "In[817]:=",ExpressionUUID->"7b66d888-3fa4-c648-aeaf-c31b705ec367"],

Cell[BoxData[
 RowBox[{"\<\"age of the universe from the brane Friedmann equation: 13.79 \
Gyr (Planck 2018: 13.787 +- 0.020 Gyr)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002124521249361*^9},
 CellLabel->
  "Out[819]=",ExpressionUUID->"9295a264-3c54-004d-ad85-ef44010eba6a"],

Cell[BoxData[
 RowBox[{"\<\"ADD relation: kappa8 rho4/V_perp == 8 Pi G4 rho4 with G4 = \
G8/V_perp (kappa8 = 8 Pi G8)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002124521249361*^9},
 CellLabel->
  "Out[820]=",ExpressionUUID->"8efa1bc2-0da7-e543-a53f-9d6553725ced"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"age (Gyr)\"\>", "\[Rule]", "13.79072812640924`"}], ",", 
   RowBox[{"\<\"V_perp (GeV^-4)\"\>", "\[Rule]", "5.929225000000001`*^12"}], ",", 
   RowBox[{"\<\"V_perp^(1/4) (m)\"\>", "\[Rule]", 
    "3.0791862085112547`*^-13"}], ",", 
   RowBox[{"\<\"lowest KK mass (MeV)\"\>", "\[Rule]", 
    "4.026524867292261`"}]}], "}"}]], "Output",
 CellChangeTimes->{4.002124521249361*^9},
 CellLabel->
