Cell[CellGroupData[{

Cell["\<\
15.2 The 9\[Times]9 Fierz matrix and Hartree\[Dash]Fock with nine channels\
\>", "Subsection",ExpressionUUID->"cab17af2-bf07-7446-a620-b8f7bef63643"],

Cell["\<\
The completeness of the 256 matrices, \[CapitalSigma]_K \
(\[CapitalTheta]_K)_cd (\[CapitalTheta]^K)_ab = 16 \[Delta]ad \[Delta]bc, \
rearranges every product of two bilinears. For commuting spinors a, b, c, d \
(for anticommuting fields an extra minus sign appears)\
\>", "Text",ExpressionUUID->"683a04e9-f0db-9a40-b58e-bbcb27558f18"],

Cell["\<\
      \[CapitalSigma]_{K\[Element]r} (a \[CapitalTheta]_K b)(c \
\[CapitalTheta]^K d) = \[CapitalSigma]_s F_rs \[CapitalSigma]_{J\[Element]s} \
(a \[CapitalTheta]_J d)(c \[CapitalTheta]^J b),     F_rs = (1/16) \
\[CapitalSigma]_l (\[Minus]1)^(rs\[Minus]l) C(s, l) C(8\[Minus]s, r\[Minus]l),\
\>", "Text",ExpressionUUID->"09a54232-6951-6441-9b44-8adeb2858787"],

Cell["\<\
with the binomial coefficients C. F_rs = (1/256) \
\[CapitalSigma]_{K\[Element]r} tr(\[CapitalTheta]_K \[CapitalTheta]_J \
\[CapitalTheta]^K \[CapitalTheta]^J) for any J of rank s, F.F = 1 (five \
eigenvalues +1, four \[Minus]1). With a density matrix R the direct (Hartree) \
energy is \[CapitalSigma]_s (g_s/2) D_s, D_s = \[CapitalSigma]_{J\[Element]s} \
tr(\[CapitalTheta]_J R) tr(\[CapitalTheta]^J R), and the exchange (Fock) \
energy is \[Minus]\[CapitalSigma]_r (g_r/2) \[CapitalSigma]_{K\[Element]r} \
tr(\[CapitalTheta]_K R \[CapitalTheta]^K R) = \[Minus]\[CapitalSigma]_{r,s} \
(g_r/2) F_rs D_s. Hartree\[Dash]Fock is therefore Hartree with the \
Fierz-transformed couplings\
\>", "Text",ExpressionUUID->"d09d7b26-9c25-3e4a-a548-281ef0d95959"],

Cell["\<\
      G = (1 \[Minus] Transpose[F]) g,     G_s = g_s \[Minus] \
\[CapitalSigma]_r F_rs g_r.\
\>", "Text",ExpressionUUID->"b4ed1c8d-1282-c449-a90e-abdf433f9b66"],

Cell["\<\
For uniform spin-saturated matter R = (\[Rho]S ID16 + \[Rho] \
\[CapitalGamma]17[0])/16 only D_0 = \[Rho]S\.b2 and D_1 = \[Rho]\.b2 survive, \
so only G_0 and G_1 matter; with the couplings of section 8 (gS = \
\[Minus]100000, gV = 10000, all others 0) G_0 = \[Minus]98750 and G_1 = \
20000, the Hartree\[Dash]Fock couplings of section 8.7.\
\>", "Text",ExpressionUUID->"e94ecbf0-933d-4045-aaad-302e9da59812"],

Cell[CellGroupData[{

Cell["\<\
fierzF = Table[Sum[(-1)^(r s - l) Binomial[s, l] Binomial[8 - s, r - l], {l, \
0, Min[r, s]}]/16, {r, 0, 8}, {s, 0, 8}];
fierzFromTraces[r_, J_] := Sum[Tr[\[CapitalTheta]dn[K].\[CapitalTheta]dn[J].\
\[CapitalTheta]up[K].\[CapitalTheta]up[J]], {K, Select[mIdx, rk[#] == r \
&]}]/256;
check[\"Fierz matrix: closed form == (1/256) Sum_{K in r} \
Tr[Theta_K.Theta_J.Theta^K.Theta^J] for the first and last J of every rank s\",
  And @@ Flatten[Table[With[{Js = Select[mIdx, rk[#] == s &]}, \
fierzFromTraces[r, First[Js]] == fierzF[[r + 1, s + 1]] && fierzFromTraces[r, \
Last[Js]] == fierzF[[r + 1, s + 1]]], {r, 0, 8}, {s, 0, 8}]]]
check[\"F.F == IdentityMatrix[9]; eigenvalues: five +1 and four -1\", \
fierzF.fierzF == IdentityMatrix[9] && Sort[Eigenvalues[fierzF]] == {-1, -1, \
-1, -1, 1, 1, 1, 1, 1}]
{aR, bR, cR, dR} = Table[rndSpinor[], {4}];
check[\"Fierz identity for commuting spinors (random): Sum_{K in r} (a \
Theta_K b)(c Theta^K d) == Sum_s F_rs Sum_{J in s} (a Theta_J d)(c Theta^J \
b), r = 0..8\",
  And @@ Table[Sum[(aR.\[CapitalTheta]dn[K].bR) (cR.\[CapitalTheta]up[K].dR), \
{K, Select[mIdx, rk[#] == r &]}] ==
     Sum[fierzF[[r + 1, s + 1]] Sum[(aR.\[CapitalTheta]dn[J].dR) (cR.\
\[CapitalTheta]up[J].bR), {J, Select[mIdx, rk[#] == s &]}], {s, 0, 8}], {r, \
0, 8}]]
RrF = RandomInteger[{-3, 3}, {16, 16}] + I RandomInteger[{-3, 3}, {16, 16}]; \
grF = RandomInteger[{-5, 5}, 9];
dS9[R_] := Table[Sum[Tr[\[CapitalTheta]dn[J].R] Tr[\[CapitalTheta]up[J].R], \
{J, Select[mIdx, rk[#] == s &]}], {s, 0, 8}];
check[\"Hartree-Fock energy E_H + E_x == Sum_s (G_s/2) D_s with G = (1 - \
Transpose[F]) g (random density matrix and couplings)\",
  grF.dS9[RrF]/2 - Sum[grF[[r + 1]]/2 Sum[Tr[\[CapitalTheta]dn[K].RrF.\
\[CapitalTheta]up[K].RrF], {K, Select[mIdx, rk[#] == r &]}], {r, 0, 8}] ==
   ((IdentityMatrix[9] - Transpose[fierzF]).grF).dS9[RrF]/2]
gSymb = Array[gg, 9, 0]; Geff = Expand[(IdentityMatrix[9] - \
Transpose[fierzF]).gSymb];
check[\"uniform density matrix (rhoS ID16 + rho Gamma17[0])/16: D_0 == \
rhoS^2, D_1 == rho^2, D_2 .. D_8 == 0\",
  Simplify[dS9[(rhoSs ID16 + rhos \[CapitalGamma]17[0])/16]] == \
Join[{rhoSs^2, rhos^2}, ConstantArray[0, 7]]]
check[\"section 8 recovered: with g = (gS, gV, 0, 0, 0, 0, 0, -gA, -gP) the \
exchange energy of uniform matter is that of section 8.7\",
  Expand[Sum[(Geff[[s + 1]] - gSymb[[s + 1]])/2 {rhoSs^2, rhos^2, 0, 0, 0, 0, \
0, 0, 0}[[s + 1]], {s, 0, 8}] /. {gg[0] -> gS, gg[1] -> gV, gg[7] -> -gA, \
gg[8] -> -gP, gg[_] -> 0}] ==
   Expand[-(gS/32) (rhoSs^2 + rhos^2) + (gP/32) (rhoSs^2 - rhos^2) - (gV/32) \
(8 rhoSs^2 - 6 rhos^2) + (gA/32) (8 rhoSs^2 + 6 rhos^2)]]
check[\"the Hartree-Fock couplings of section 8.7: gS = -100000, gV = 10000 \
give G_0 = -98750, G_1 = 20000\",
  (Geff[[{1, 2}]] /. {gg[0] -> -100000, gg[1] -> 10000, gg[_] -> 0}) == \
{-98750, 20000}]
{\"16 F\" -> 16 fierzF, \"G_0\" -> Geff[[1]], \"G_1\" -> Geff[[2]], \"example \
g = (-100000, 10000, 3000, 0, ...): {G_0, G_1}\" -> (Geff[[{1, 2}]] /. {gg[0] \
-> -100000, gg[1] -> 10000, gg[2] -> 3000, gg[_] -> 0})}\
\>", "Input",
 CellLabel->
  "In[730]:=",ExpressionUUID->"de192058-a7f0-2c47-95b6-7a46a288c6a8"],

Cell[BoxData[
 RowBox[{"\<\"Fierz matrix: closed form == (1/256) Sum_{K in r} \
Tr[Theta_K.Theta_J.Theta^K.Theta^J] for the first and last J of every rank \
s\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002143330005085*^9},
 CellLabel->
  "Out[732]=",ExpressionUUID->"a4f476f3-82a9-0d49-8303-a4f6656b43f4"],

Cell[BoxData[
 RowBox[{"\<\"F.F == IdentityMatrix[9]; eigenvalues: five +1 and four -1\"\>",
   "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021433300171165`*^9},
 CellLabel->
  "Out[733]=",ExpressionUUID->"fc5e183d-cfcf-0447-9899-9eee4ee986f7"],

Cell[BoxData[
 RowBox[{"\<\"Fierz identity for commuting spinors (random): Sum_{K in r} (a \
Theta_K b)(c Theta^K d) == Sum_s F_rs Sum_{J in s} (a Theta_J d)(c Theta^J \
b), r = 0..8\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021433300710087`*^9},
 CellLabel->
  "Out[735]=",ExpressionUUID->"3e4d7958-bef3-d546-9f7e-ad54c674431c"],

Cell[BoxData[
 RowBox[{"\<\"Hartree-Fock energy E_H + E_x == Sum_s (G_s/2) D_s with G = (1 \
- Transpose[F]) g (random density matrix and couplings)\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0021433302989063`*^9},
 CellLabel->
  "Out[738]=",ExpressionUUID->"23485796-77d0-6744-a016-762772519620"],

Cell[BoxData[
 RowBox[{"\<\"uniform density matrix (rhoS ID16 + rho Gamma17[0])/16: D_0 == \
rhoS^2, D_1 == rho^2, D_2 .. D_8 == 0\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002143330460554*^9},
 CellLabel->
  "Out[740]=",ExpressionUUID->"3d0f6c4a-eb87-7140-b03e-dd9aedad5166"],

Cell[BoxData[
 RowBox[{"\<\"section 8 recovered: with g = (gS, gV, 0, 0, 0, 0, 0, -gA, -gP) \
the exchange energy of uniform matter is that of section 8.7\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002143330463564*^9},
 CellLabel->
  "Out[741]=",ExpressionUUID->"554bd50a-20cd-c148-b369-2eb9109687de"],

Cell[BoxData[
 RowBox[{"\<\"the Hartree-Fock couplings of section 8.7: gS = -100000, gV = \
10000 give G_0 = -98750, G_1 = 20000\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021433304645634`*^9},
 CellLabel->
  "Out[742]=",ExpressionUUID->"2f21a5f7-a584-af45-a689-e9409c5b967f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"16 F\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "1", ",", "1", ",", "1", ",", "1", ",", "1", ",", "1", ",", "1", ",", 
        "1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"8", ",", 
        RowBox[{"-", "6"}], ",", "4", ",", 
        RowBox[{"-", "2"}], ",", "0", ",", "2", ",", 
        RowBox[{"-", "4"}], ",", "6", ",", 
        RowBox[{"-", "8"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"28", ",", "14", ",", "4", ",", 
