Cell[CellGroupData[{

Cell["\<\
8.7 Example: uniform matter (no sea), Hartree and Hartree\[Dash]Fock\
\>", "Subsection",ExpressionUUID->"4c8a107e-1c3e-f746-ba9b-499d6b849872"],

Cell[TextData[{
 "Static, uniform, spin-saturated matter at rest, no external sources. By \
symmetry the KS potentials are constants, S = m* \[Minus] m and V_0, with P = \
A_A = V_i = 0; the orbitals are plane waves u_s(",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "66fec148-5fb0-fb46-81e8-425854dec165"],
 ") e^{i ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "a1cf4821-f797-a246-8229-268374593303"],
 "\[CenterDot]",
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "73662658-4bb9-3c42-a018-7339e643932b"],
 "}/\[Sqrt](2E* V) with the effective mass m* (E* = \[Sqrt](",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "be7a7d24-5e3e-4042-b3d8-e08ff0b999f4"],
 "\.b2 + m*\.b2)), eigenvalues \[Epsilon] = V_0 + E*, all 8 spin states \
filled up to the Fermi momentum kF. With the area of the unit sphere S\:2076 \
\[Subset] \[DoubleStruckCapitalR]\:2077, |S\:2076| = 2\[Pi]^(7/2)/\
\[CapitalGamma](7/2) = 16\[Pi]\.b3/15, and 8 spin states, 8 \[Integral] d\
\:2077k/(2\[Pi])\:2077 f(|",
 Cell[BoxData[
  FormBox[
   OverscriptBox["k", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "4db12ac9-5851-ce45-95fe-b913a4192c61"],
 "|) = c7 \[Integral]_0^\[Infinity] k\:2076 f(k) dk with c7 = \
1/(15\[Pi]\:2074):"
}], "Text",ExpressionUUID->"b7d611ba-8ec3-a342-b0cb-27e4cce95f31"],

Cell["\<\
      \[Rho] = j^0 = c7 kF\:2077/7 = kF\:2077/(105 \[Pi]\:2074),   \[Rho]S = \
c7 \[Integral]_0^kF k\:2076 m*/\[Sqrt](k\.b2 + m*\.b2) dk,   \[Epsilon]_kin = \
c7 \[Integral]_0^kF k\:2076 \[Sqrt](k\.b2 + m*\.b2) dk,\
\>", "Text",ExpressionUUID->"6d276575-d320-d141-9d2e-d7ad78c3eb47"],

Cell["\<\
(\[Rho]P = 0, j5 = 0, j^i = 0), and the KS density matrix is R = (\[Rho]S \
ID16 + \[Rho] \[CapitalGamma]17[0])/16. The Hartree self-consistency \
conditions and the energy density are\
\>", "Text",ExpressionUUID->"0f386480-64d4-ae4b-8678-1e6c4a191c7d"],

Cell["\<\
      m* = m + gS \[Rho]S(m*),   V_0 = gV \[Rho],   \[Epsilon] = \
\[Epsilon]_kin(m*) \[Minus] (m* \[Minus] m) \[Rho]S + (gS/2) \[Rho]S\.b2 + \
(gV/2) \[Rho]\.b2 = \[Epsilon]_kin(m*) \[Minus] (m* \[Minus] m)\.b2/(2 gS) + \
(gV/2) \[Rho]\.b2,\
\>", "Text",ExpressionUUID->"66ab9e89-e24b-cc49-8fe9-2f03120be58e"],

Cell["\<\
and the Fermi energy is \[Epsilon]_F = V_0 + \[Sqrt](kF\.b2 + m*\.b2). \
\[Epsilon] is stationary in m* (\[PartialD]\[Epsilon]/\[PartialD]m* = \[Rho]S \
\[Minus] (m* \[Minus] m)/gS = 0 is the gap equation), so d\[Epsilon]/dkF = \
\[PartialD]\[Epsilon]/\[PartialD]kF, which gives the Hugenholtz\[Dash]Van \
Hove theorem: the chemical potential \[Mu] = d\[Epsilon]/d\[Rho] equals \
\[Epsilon]_F at every density, and at the saturation point (the minimum of \
the energy per particle \[Epsilon]/\[Rho]) \[Epsilon]/\[Rho] = \[Epsilon]_F.\
\>", "Text",ExpressionUUID->"101292c5-9da5-8d42-98b3-ce970b0185be"],

Cell["\<\
With the exchange (Fock) term of section 8.5 the uniform density matrix gives\
\>", "Text",ExpressionUUID->"a0fc899a-9eab-af4e-a406-b90e9e2dd769"],

Cell["\<\
      E_x = \[Minus](gS/32)(\[Rho]S\.b2 + \[Rho]\.b2) + (gP/32)(\[Rho]S\.b2 \
\[Minus] \[Rho]\.b2) \[Minus] (gV/32)(8\[Rho]S\.b2 \[Minus] 6\[Rho]\.b2) + \
(gA/32)(8\[Rho]S\.b2 + 6\[Rho]\.b2),\
\>", "Text",ExpressionUUID->"30fb8d2f-c6e4-414b-8c64-35b074a3b997"],

Cell["\<\
      \[CapitalSigma]_x = S_x ID16 + V_x \[CapitalGamma]17[0],   S_x = \
(\[Rho]S/16)(\[Minus]gS + gP \[Minus] 8gV + 8gA),   V_x = \
(\[Rho]/16)(\[Minus]gS \[Minus] gP + 6gV + 6gA),\
\>", "Text",ExpressionUUID->"0f2503e9-8f26-4d48-ada5-94dc5e63c8b0"],

Cell["\<\
so uniform Hartree\[Dash]Fock is Hartree with the Fierz-transformed couplings \
G_S = gS + (\[Minus]gS + gP \[Minus] 8gV + 8gA)/16 and G_V = gV + (\[Minus]gS \
\[Minus] gP + 6gV + 6gA)/16. Example in units m = 1: gS = \[Minus]10^5, gV = \
10^4 (gP = gA = 0). In the Hartree approximation this matter is bound and \
saturates; Hartree\[Dash]Fock is evaluated at kF = 3/4.\
\>", "Text",ExpressionUUID->"32ddc1bb-7385-5d45-9e95-bd2ecf953643"],

Cell[CellGroupData[{

Cell["\<\
Runi = (\[Rho]Ssym ID16 + \[Rho]sym \[CapitalGamma]17[0])/16;
check[\"uniform matter: tr R == \[Rho]S, tr(\[CapitalGamma]17up[0].R) == \
\[Rho], and the densities \[Rho]P, j^i, j5^A vanish\",
  Tr[Runi] == \[Rho]Ssym && Tr[\[CapitalGamma]17up[0].Runi] == \[Rho]sym && \
Tr[I \[Chi]17.Runi] === 0 &&
  And @@ Table[Tr[\[CapitalGamma]17up[i].Runi] === 0, {i, 1, 7}] && And @@ \
Table[Tr[\[CapitalGamma]17up[A].\[Chi]17.Runi] === 0, {A, 0, 7}]]
check[\"the occupied plane waves give this R: (1/2) \[Sum]_s [u_s(p) \
ubar_s(p) + u_s(-p) ubar_s(-p)]/(2E) == (E \[CapitalGamma]17[0] + m \
ID16)/(2E)\",
  Simplify[(USmat.Transpose[USmat].\[CapitalGamma]17[0] + \
Transpose[Table[uS[s, Transpose[Mp], Ep], {s, 1, 8}]].Table[uS[s, \
Transpose[Mp], Ep], {s, 1, 8}].\[CapitalGamma]17[0])/(4 Ep) -
     (Ep \[CapitalGamma]17[0] + mD ID16)/(2 Ep), asm7] === Zero16]
ExUni = -gS/32 (\[Rho]Ssym^2 + \[Rho]sym^2) + gP/32 (\[Rho]Ssym^2 - \
\[Rho]sym^2) - gV/32 (8 \[Rho]Ssym^2 - 6 \[Rho]sym^2) + gA/32 (8 \[Rho]Ssym^2 \
+ 6 \[Rho]sym^2);
check[\"uniform exchange energy: E_x(R) == -gS/32 (\[Rho]S^2 + \[Rho]^2) + \
gP/32 (\[Rho]S^2 - \[Rho]^2) - gV/32 (8\[Rho]S^2 - 6\[Rho]^2) + gA/32 \
(8\[Rho]S^2 + 6\[Rho]^2)\",
  Expand[Exfun[Runi] - ExUni] === 0]
check[\"uniform exchange self-energy: \[CapitalSigma]_x == S_x ID16 + V_x \
\[CapitalGamma]17[0] with S_x == \[PartialD]E_x/\[PartialD]\[Rho]S and V_x == \
\[PartialD]E_x/\[PartialD]\[Rho]\",
  Expand[Sigmax[Runi] - (D[ExUni, \[Rho]Ssym] ID16 + D[ExUni, \[Rho]sym] \
\[CapitalGamma]17[0])] === Zero16 &&
  Expand[D[ExUni, \[Rho]Ssym] - \[Rho]Ssym/16 (-gS + gP - 8 gV + 8 gA)] === 0 \
&& Expand[D[ExUni, \[Rho]sym] - \[Rho]sym/16 (-gS - gP + 6 gV + 6 gA)] === 0]
GSeff[gs_, gp_, gv_, ga_] := gs + (-gs + gp - 8 gv + 8 ga)/16; GVeff[gs_, \
gp_, gv_, ga_] := gv + (-gs - gp + 6 gv + 6 ga)/16;
check[\"uniform Hartree-Fock == Hartree with the Fierz-transformed couplings: \
gS/2 \[Rho]S^2 + gV/2 \[Rho]^2 + E_x == G_S/2 \[Rho]S^2 + G_V/2 \[Rho]^2 (gP, \
gA arbitrary)\",
  Expand[gS/2 \[Rho]Ssym^2 + gV/2 \[Rho]sym^2 + ExUni - GSeff[gS, gP, gV, \
gA]/2 \[Rho]Ssym^2 - GVeff[gS, gP, gV, gA]/2 \[Rho]sym^2] === 0]\
\>", "Input",
 CellLabel->
  "In[408]:=",ExpressionUUID->"e5239cd0-e5ad-ab40-8f84-c97920f72528"],

Cell[BoxData[
 RowBox[{"\<\"uniform matter: tr R == \[Rho]S, tr(\[CapitalGamma]17up[0].R) \
== \[Rho], and the densities \[Rho]P, j^i, j5^A vanish\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020509191274776`*^9},
 CellLabel->
  "Out[409]=",ExpressionUUID->"b8a18020-a2c4-da48-9cc0-a98a83e62850"],

Cell[BoxData[
 RowBox[{"\<\"the occupied plane waves give this R: (1/2) \[Sum]_s [u_s(p) \
ubar_s(p) + u_s(-p) ubar_s(-p)]/(2E) == (E \[CapitalGamma]17[0] + m \
ID16)/(2E)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020509191418953`*^9},
 CellLabel->
  "Out[410]=",ExpressionUUID->"6f10f77d-346e-1f4a-9eaa-18398316eba6"],

Cell[BoxData[
 RowBox[{"\<\"uniform exchange energy: E_x(R) == -gS/32 (\[Rho]S^2 + \
\[Rho]^2) + gP/32 (\[Rho]S^2 - \[Rho]^2) - gV/32 (8\[Rho]S^2 - 6\[Rho]^2) + \
gA/32 (8\[Rho]S^2 + 6\[Rho]^2)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020509191602917`*^9},
 CellLabel->
  "Out[412]=",ExpressionUUID->"c9aef822-eb5f-454b-890c-a5a43c922065"],

Cell[BoxData[
 RowBox[{"\<\"uniform exchange self-energy: \[CapitalSigma]_x == S_x ID16 + \
V_x \[CapitalGamma]17[0] with S_x == \[PartialD]E_x/\[PartialD]\[Rho]S and \
V_x == \[PartialD]E_x/\[PartialD]\[Rho]\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002050919168865*^9},
 CellLabel->
  "Out[413]=",ExpressionUUID->"07232ac1-55b1-4441-b134-877593d23bd8"],

Cell[BoxData[
 RowBox[{"\<\"uniform Hartree-Fock == Hartree with the Fierz-transformed \
couplings: gS/2 \[Rho]S^2 + gV/2 \[Rho]^2 + E_x == G_S/2 \[Rho]S^2 + G_V/2 \
\[Rho]^2 (gP, gA arbitrary)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020509191844883`*^9},
 CellLabel->
  "Out[415]=",ExpressionUUID->"d8276b39-7d04-b344-9ec6-bad8635de1b0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
c7 = 1/(15 Pi^4);
rho7[kF_] := kF^7/(105 Pi^4);
iS7[ms_, kF_] = Integrate[k^6 ms/Sqrt[k^2 + ms^2], {k, 0, kF}, Assumptions -> \
ms > 0 && kF > 0];
iE7[ms_, kF_] = Integrate[k^6 Sqrt[k^2 + ms^2], {k, 0, kF}, Assumptions -> ms \
> 0 && kF > 0];
check[\"c7 == 8 |S^6|/(2 Pi)^7 == 1/(15 Pi^4), |S^6| == 2 Pi^(7/2)/Gamma[7/2] \
== 16 Pi^3/15, and \[Rho] == c7 kF^7/7 == kF^7/(105 Pi^4)\",
  2 Pi^(7/2)/Gamma[7/2] == 16 Pi^3/15 && 8 (16 Pi^3/15)/(2 Pi)^7 == c7 && \
Integrate[c7 k^6, {k, 0, kF}] == rho7[kF]]
check[\"closed forms: d/dkF of the integrals gives the integrands, both \
vanish at kF = 0, and d\[Epsilon]_kin/dm* == \[Rho]S\",
  Simplify[D[iS7[ms, kF], kF] - kF^6 ms/Sqrt[kF^2 + ms^2], ms > 0 && kF > 0] \
=== 0 && Simplify[D[iE7[ms, kF], kF] - kF^6 Sqrt[kF^2 + ms^2], ms > 0 && kF > \
0] === 0 &&
  Simplify[iS7[ms, kF] /. kF -> 0] === 0 && Simplify[iE7[ms, kF] /. kF -> 0] \
=== 0 && Simplify[D[iE7[ms, kF], ms] - iS7[ms, kF], ms > 0 && kF > 0] === 0]
{iS7[ms, kF], iE7[ms, kF]}\
\>", "Input",
 CellLabel->
  "In[416]:=",ExpressionUUID->"a9627de0-bb93-5544-bedd-6f00e48af59d"],

Cell[BoxData[
 RowBox[{"\<\"c7 == 8 |S^6|/(2 Pi)^7 == 1/(15 Pi^4), |S^6| == 2 \
Pi^(7/2)/Gamma[7/2] == 16 Pi^3/15, and \[Rho] == c7 kF^7/7 == kF^7/(105 Pi^4)\
\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020509231228867`*^9},
 CellLabel->
  "Out[420]=",ExpressionUUID->"6e134068-81ae-0d4b-8f34-26d23c8f6569"],

Cell[BoxData[
 RowBox[{"\<\"closed forms: d/dkF of the integrals gives the integrands, both \
vanish at kF = 0, and d\[Epsilon]_kin/dm* == \[Rho]S\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002050923128891*^9},
 CellLabel->
  "Out[421]=",ExpressionUUID->"b2af78f4-10a0-b546-9535-e5efe982dbdd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    FractionBox["1", "48"], " ", "ms", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"kF", " ", 
       SqrtBox[
        RowBox[{
         SuperscriptBox["kF", "2"], "+", 
         SuperscriptBox["ms", "2"]}]], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"8", " ", 
          SuperscriptBox["kF", "4"]}], "-", 
         RowBox[{"10", " ", 
          SuperscriptBox["kF", "2"], " ", 
          SuperscriptBox["ms", "2"]}], "+", 
         RowBox[{"15", " ", 
          SuperscriptBox["ms", "4"]}]}], ")"}]}], "-", 
      RowBox[{"15", " ", 
       SuperscriptBox["ms", "6"], " ", 
       RowBox[{"ArcTanh", "[", 
        FractionBox["kF", 
         SqrtBox[
          RowBox[{
           SuperscriptBox["kF", "2"], "+", 
           SuperscriptBox["ms", "2"]}]]], "]"}]}]}], ")"}]}], ",", 
   RowBox[{
    FractionBox["1", "384"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"kF", " ", 
       SqrtBox[
        RowBox[{
         SuperscriptBox["kF", "2"], "+", 
         SuperscriptBox["ms", "2"]}]], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"48", " ", 
          SuperscriptBox["kF", "6"]}], "+", 
         RowBox[{"8", " ", 
          SuperscriptBox["kF", "4"], " ", 
          SuperscriptBox["ms", "2"]}], "-", 
         RowBox[{"10", " ", 
          SuperscriptBox["kF", "2"], " ", 
          SuperscriptBox["ms", "4"]}], "+", 
         RowBox[{"15", " ", 
          SuperscriptBox["ms", "6"]}]}], ")"}]}], "-", 
      RowBox[{"15", " ", 
       SuperscriptBox["ms", "8"], " ", 
       RowBox[{"ArcTanh", "[", 
        FractionBox["kF", 
         SqrtBox[
          RowBox[{
           SuperscriptBox["kF", "2"], "+", 
           SuperscriptBox["ms", "2"]}]]], "]"}]}]}], ")"}]}]}], 
  "}"}]], "Output",
 CellChangeTimes->{4.002050923134535*^9},
 CellLabel->
  "Out[422]=",ExpressionUUID->"825f6790-5f50-7f4e-8bc8-94c2a41e2a43"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
gS0 = -10^5; gV0 = 10^4; wp = 50;          (* the inner root-finding works \
with 50 digits *)
gap7[g_?NumericQ, kF_?NumericQ] := With[{k1 = SetPrecision[kF, wp + 10]},
   ms /. FindRoot[ms - 1 - g c7 iS7[ms, k1], {ms, 10^-8, 1}, Method -> \
\"Brent\", WorkingPrecision -> wp, AccuracyGoal -> wp - 5, PrecisionGoal -> \
wp - 5]];
eps7[g_?NumericQ, gv_?NumericQ, kF_?NumericQ] := With[{m1 = gap7[g, kF], k1 = \
SetPrecision[kF, wp + 10]}, c7 iE7[m1, k1] - (m1 - 1)^2/(2 g) + gv/2 \
rho7[k1]^2];
fermi7[g_?NumericQ, gv_?NumericQ, kF_?NumericQ] := With[{k1 = \
SetPrecision[kF, wp + 10]}, gv rho7[k1] + Sqrt[k1^2 + gap7[g, kF]^2]];
dEdrho7[g_, gv_, k0_] := With[{h = 10^-12}, (eps7[g, gv, k0 + h] - eps7[g, \
gv, k0 - h])/(rho7[k0 + h] - rho7[k0 - h])];
kF0 = SetPrecision[kF /. FindRoot[eps7[gS0, gV0, kF]/rho7[kF] - fermi7[gS0, \
gV0, kF], {kF, 7/10, 8/10}, Method -> \"Brent\",
     WorkingPrecision -> 40, AccuracyGoal -> 32, PrecisionGoal -> 32], wp + \
10];
ms0 = gap7[gS0, kF0]; rho0 = rho7[kF0]; rhoS0 = c7 iS7[ms0, kF0]; V00 = gV0 \
rho0; eps0 = eps7[gS0, gV0, kF0];
hartreeSaturation = {\"kF0\" -> N[kF0, 20], \"rho0\" -> N[rho0, 20], \
\"mstar\" -> N[ms0, 20], \"rhoS\" -> N[rhoS0, 20], \"V0\" -> N[V00, 20],
  \"E/A - m\" -> N[eps0/rho0 - 1, 20], \"epsF\" -> N[fermi7[gS0, gV0, kF0], \
20]}\
\>", "Input",
 CellLabel->
  "In[423]:=",ExpressionUUID->"96699b76-b454-5448-8c4a-e0b6a32494a5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"kF0\"\>", "\[Rule]", 
    "0.75663615070149289468898518333686779943`20."}], ",", 
   RowBox[{"\<\"rho0\"\>", "\[Rule]", 
    "0.00001388100213231687719733337460708977`20."}], ",", 
   RowBox[{"\<\"mstar\"\>", "\[Rule]", 
    "0.34809734014624326513872826021395797875`20."}], ",", 
   RowBox[{"\<\"rhoS\"\>", "\[Rule]", 
    "6.51902659853756734861271739786042`20.*^-6"}], ",", 
   RowBox[{"\<\"V0\"\>", "\[Rule]", 
    "0.13881002132316877197333374607089775761`20."}], ",", 
   RowBox[{"\<\"E/A - m\"\>", "\[Rule]", 
    RowBox[{"-", "0.02832142796473857585395910920624966016`20."}]}], ",", 
   RowBox[{"\<\"epsF\"\>", "\[Rule]", 
    "0.97167857203526142414604089079375033984`20."}]}], "}"}]], "Output",
 CellChangeTimes->{4.0020509231487465`*^9},
 CellLabel->
  "Out[430]=",ExpressionUUID->"503344b3-870a-894f-8dc8-ab560c2b5ff4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Hartree gap equation m* == m + gS \[Rho]S(m*) solved to 45 digits; m* \
is a stationary point of \[Epsilon](m*) at fixed kF\",
  Abs[ms0 - 1 - gS0 rhoS0] < 10^-30 && Abs[D[c7 iE7[ms, kF0] - (ms - 1)^2/(2 \
gS0), ms] /. ms -> ms0] < 10^-30]
check[\"total energy == sum of KS eigenvalues - E_H (double counting) == \
\[Epsilon]_kin - (m* - m) \[Rho]S + E_H\",
  Abs[eps0 - (V00 rho0 + c7 iE7[ms0, kF0] - gS0/2 rhoS0^2 - gV0/2 rho0^2)] < \
10^-30 &&
  Abs[eps0 - (c7 iE7[ms0, kF0] - (ms0 - 1) rhoS0 + gS0/2 rhoS0^2 + gV0/2 \
rho0^2)] < 10^-30]
check[\"Hugenholtz-Van Hove at saturation: E/A == \[Epsilon]_F == \
d\[Epsilon]/d\[Rho]; E/A - m < 0 and E/A at 0.95 kF0 and 1.05 kF0 is higher\",
  Abs[eps0/rho0 - fermi7[gS0, gV0, kF0]] < 10^-25 && Abs[dEdrho7[gS0, gV0, \
kF0] - fermi7[gS0, gV0, kF0]] < 10^-15 && eps0/rho0 - 1 < 0 &&
  eps7[gS0, gV0, 95/100 kF0]/rho7[95/100 kF0] > eps0/rho0 && eps7[gS0, gV0, \
105/100 kF0]/rho7[105/100 kF0] > eps0/rho0]
check[\"Hugenholtz-Van Hove away from saturation: \[Mu] == \
d\[Epsilon]/d\[Rho] == \[Epsilon]_F at kF = 1\", Abs[dEdrho7[gS0, gV0, 1] - \
fermi7[gS0, gV0, 1]] < 10^-15]
hartreeKF1 = {\"mstar\" -> N[gap7[gS0, 1], 20], \"E/A - m\" -> N[eps7[gS0, \
gV0, 1]/rho7[1] - 1, 20], \"epsF\" -> N[fermi7[gS0, gV0, 1], 20]}\
\>", "Input",
 CellLabel->
  "In[431]:=",ExpressionUUID->"ab23db69-ccdc-7344-b472-191798135d75"],

Cell[BoxData[
 RowBox[{"\<\"Hartree gap equation m* == m + gS \[Rho]S(m*) solved to 45 \
digits; m* is a stationary point of \[Epsilon](m*) at fixed kF\"\>", "\[Rule]",
   "True"}]], "Output",
 CellChangeTimes->{4.0020509231649475`*^9},
 CellLabel->
  "Out[431]=",ExpressionUUID->"4a6ff19b-bca1-9146-8d10-3a969aedfa93"],

