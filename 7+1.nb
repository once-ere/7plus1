Cell[CellGroupData[{

Cell["\<\
products256 = Table[Dot @@ Prepend[\[CapitalGamma]17 /@ s, ID16], {s, \
Subsets[Range[0, 7]]}];
check[\"the 256 products \[CapitalGamma]17[A1]...\[CapitalGamma]17[Ak] (A1 < \
... < Ak) are linearly independent: Cl(1,7) \[TildeFullEqual] \
\[DoubleStruckCapitalR](16)\",
  Length[products256] == 256 && MatrixRank[Flatten /@ products256] == 256]
check[\"grades: binomial(8,k) == {1,8,28,56,70,56,28,8,1}, total 256 \
(binomial(8,4) == 70, not 72)\",
  Table[Binomial[8, k], {k, 0, 8}] == {1, 8, 28, 56, 70, 56, 28, 8, 1} && \
Total[Table[Binomial[8, k], {k, 0, 8}]] == 256 &&
  Table[Count[Subsets[Range[0, 7]], s_ /; Length[s] == k], {k, 0, 8}] == \
Table[Binomial[8, k], {k, 0, 8}]]
check[\"Tr[product] == 0 for every non-empty product, so Tr[M]/16 is the \
scalar part of M\", And @@ Table[Tr[products256[[k]]] == 0, {k, 2, 256}]]
check[\"irreducible over \[DoubleStruckCapitalR]: only multiples of ID16 \
commute with all \[CapitalGamma]17[A] (Schur; real commutant of dimension 1)\",
  With[{ns = NullSpace[Join @@ Table[KroneckerProduct[ID16, Transpose[\
\[CapitalGamma]17[A]]] - KroneckerProduct[\[CapitalGamma]17[A], ID16], {A, 0, \
7}]]},
   Length[ns] == 1 && MatrixRank[{First[ns], Flatten[ID16]}] == 1]]
check[\"universal property: \[CapitalGamma]17(v).\[CapitalGamma]17(v) == (v.\
\[Eta]17.v) ID16 for a symbolic vector v = X\",
  Expand[Sum[X[[A + 1]] \[CapitalGamma]17[A], {A, 0, 7}].Sum[X[[A + 1]] \
\[CapitalGamma]17[A], {A, 0, 7}] - (X.\[Eta]17.X) ID16] === Zero16]\
\>", "Input",
 CellLabel->
  "In[180]:=",ExpressionUUID->"c0215861-c94f-3f4d-95d6-a846267939fe"],

Cell[BoxData[
 RowBox[{"\<\"the 256 products \[CapitalGamma]17[A1]...\[CapitalGamma]17[Ak] \
(A1 < ... < Ak) are linearly independent: Cl(1,7) \[TildeFullEqual] \
\[DoubleStruckCapitalR](16)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020509121289463`*^9},
 CellLabel->
  "Out[181]=",ExpressionUUID->"0b22fcb2-a9d9-6642-9b86-82a3041e951b"],

Cell[BoxData[
 RowBox[{"\<\"grades: binomial(8,k) == {1,8,28,56,70,56,28,8,1}, total 256 \
(binomial(8,4) == 70, not 72)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002050912134945*^9},
 CellLabel->
  "Out[182]=",ExpressionUUID->"7914dc80-4d51-5345-acbb-e5e78c4e086c"],

Cell[BoxData[
 RowBox[{"\<\"Tr[product] == 0 for every non-empty product, so Tr[M]/16 is \
the scalar part of M\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002050912140047*^9},
 CellLabel->
  "Out[183]=",ExpressionUUID->"7d88c20b-0263-8846-80b0-9ffa1376d363"],

Cell[BoxData[
 RowBox[{"\<\"irreducible over \[DoubleStruckCapitalR]: only multiples of \
ID16 commute with all \[CapitalGamma]17[A] (Schur; real commutant of \
dimension 1)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020509121974583`*^9},
 CellLabel->
  "Out[184]=",ExpressionUUID->"1f4c3dfe-8c2e-7247-a032-75d8613dded6"],

Cell[BoxData[
 RowBox[{"\<\"universal property: \[CapitalGamma]17(v).\[CapitalGamma]17(v) \
== (v.\[Eta]17.v) ID16 for a symbolic vector v = X\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020509122039776`*^9},
 CellLabel->
  "Out[185]=",ExpressionUUID->"3e88c093-b61f-bb4f-89a4-6dcfcf2a7a61"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
4.3 The complexified 7+1 realization in the exact block form of 4+4.nb: \
\[CapitalGamma]71\
\>", "Subsection",ExpressionUUID->"e03e612c-9db5-ab41-ae6d-4923e0202eb8"],

Cell["\<\
If one insists on the 4+4.nb sign convention, \[CapitalGamma]71[A].\
\[CapitalGamma]71[B] + \[CapitalGamma]71[B].\[CapitalGamma]71[A] = 2 \
\[Eta]71[[A+1,B+1]] ID16, complex numbers are unavoidable (section 4.4). The \
complexification needed is minimal: multiply the time block by i. With \
\[Tau]C[0] = \[Tau]Cbar[0] = i ID8 and \[Tau]C[i] = \[Tau]O[i], \[Tau]Cbar[i] \
= \[Tau]Obar[i] (i = 1 \[Ellipsis] 7),\
\>", "Text",ExpressionUUID->"39e81887-0fcf-c644-9d3e-c082945107c3"],

Cell["      \[CapitalGamma]71[A] = {{0, \[Tau]Cbar[A]}, {\[Tau]C[A], 0}},", \
"Text",ExpressionUUID->"925b4fc6-3e95-ce4a-96c5-0e67f9bac9c9"],

Cell["\<\
which is literally the formula T16[A] = {{0, \[Tau]bar[A]}, {\[Tau][A], 0}} \
of 4+4.nb. Equivalently \[CapitalGamma]71[0] = i T16[0] and \
\[CapitalGamma]71[k] = T16O[k] (k = 1 \[Ellipsis] 7). \[CapitalGamma]71 is \
equivalent to i \[CapitalGamma]17: \[CapitalGamma]71[A] = S.(i \
\[CapitalGamma]17[A]).S\:207b\.b9 with the unitary matrix S = (ID16 \[Minus] \
i \[CapitalGamma]17[0])/\[Sqrt]2.\
\>", "Text",ExpressionUUID->"a099eba4-7902-1341-81ca-6dcc5e74d5b3"],

Cell[CellGroupData[{

Cell["\<\
\[Tau]C[0] = I ID8; \[Tau]Cbar[0] = I ID8;
Do[\[Tau]C[i] = \[Tau]O[i]; \[Tau]Cbar[i] = \[Tau]Obar[i], {i, 1, 7}];
Do[\[CapitalGamma]71[A] = ArrayFlatten[{{0, \[Tau]Cbar[A]}, {\[Tau]C[A], \
0}}], {A, 0, 7}];
\[CapitalGamma]71[8] = Dot @@ Table[\[CapitalGamma]71[A], {A, 0, 7}];
check[\"7+1 COMPLEX Clifford relation, 4+4.nb sign: (\[CapitalGamma]71[A].\
\[CapitalGamma]71[B] + \[CapitalGamma]71[B].\[CapitalGamma]71[A])/2 == \
\[Eta]71[[A+1,B+1]] ID16\",
  And @@ Flatten[Table[(\[CapitalGamma]71[A].\[CapitalGamma]71[B] + \
\[CapitalGamma]71[B].\[CapitalGamma]71[A])/2 == \[Eta]71[[A + 1, B + 1]] \
ID16, {A, 0, 7}, {B, 0, 7}]]]
check[\"\[CapitalGamma]71[0] == I T16[0] and \[CapitalGamma]71[k] == T16O[k] \
(k = 1..7): only the time component is complex\",
  \[CapitalGamma]71[0] == I T16[0] && And @@ Table[\[CapitalGamma]71[k] == \
T16O[k], {k, 1, 7}]]
Ssim = (ID16 - I \[CapitalGamma]17[0])/Sqrt[2];
check[\"S = (ID16 - I \[CapitalGamma]17[0])/Sqrt[2] is unitary and \
\[CapitalGamma]71[A] == S.(I \[CapitalGamma]17[A]).Inverse[S]\",
  Simplify[Ssim.ConjugateTranspose[Ssim]] == ID16 && And @@ \
Table[Simplify[Ssim.(I \[CapitalGamma]17[A]).Inverse[Ssim] - \
\[CapitalGamma]71[A]] == Zero16, {A, 0, 7}]]\
\>", "Input",
 CellLabel->
  "In[186]:=",ExpressionUUID->"fbc1c95d-b519-4d45-9b12-bee294dd7637"],

Cell[BoxData[
 RowBox[{"\<\"7+1 COMPLEX Clifford relation, 4+4.nb sign: \
(\[CapitalGamma]71[A].\[CapitalGamma]71[B] + \[CapitalGamma]71[B].\
\[CapitalGamma]71[A])/2 == \[Eta]71[[A+1,B+1]] ID16\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020509122187805`*^9},
 CellLabel->
  "Out[190]=",ExpressionUUID->"30b17181-53d5-5d40-b09c-146bad2457e7"],

Cell[BoxData[
 RowBox[{"\<\"\[CapitalGamma]71[0] == I T16[0] and \[CapitalGamma]71[k] == \
T16O[k] (k = 1..7): only the time component is complex\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002050912223774*^9},
 CellLabel->
  "Out[191]=",ExpressionUUID->"17c94a07-32d8-2549-b2a7-88ce4c136ee7"],

Cell[BoxData[
 RowBox[{"\<\"S = (ID16 - I \[CapitalGamma]17[0])/Sqrt[2] is unitary and \
\[CapitalGamma]71[A] == S.(I \[CapitalGamma]17[A]).Inverse[S]\"\>", "\[Rule]",
   "True"}]], "Output",
 CellChangeTimes->{4.0020509122297783`*^9},
 CellLabel->
  "Out[193]=",ExpressionUUID->"3204049d-9cd4-6f4e-ba1f-bfc3477e247d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
4.4 Theorem: with \[Eta]71 there is no real 16\[Times]16 realization, because \
Cl(7,1) \[TildeFullEqual] \[DoubleStruckCapitalH](8)\
\>", "Subsection",ExpressionUUID->"826a76bd-7f01-d74d-81ef-71b1fd12b727"],

Cell[TextData[{
 StyleBox["Theorem. ",
  FontWeight->"Bold"],
 "There are no real 16\[Times]16 matrices R[0], \[Ellipsis], R[7] with \
R[A].R[B] + R[B].R[A] = 2 \[Eta]71[[A+1,B+1]] ID16. Reordering, renaming or \
re-signing the indices does not help, because none of these changes the \
signature (7,1)."
}], "Text",ExpressionUUID->"26a89133-4376-0249-aaa6-152264395d1a"],

Cell[TextData[{
 StyleBox["Proof. ",
  FontWeight->"Bold"],
 "The complexified Clifford algebra is Cl_8(\[DoubleStruckCapitalC]) \
\[TildeFullEqual] \[DoubleStruckCapitalC](16), which has exactly one \
irreducible module, \[DoubleStruckCapitalC]^16. If real R[A] existed, they \
and the complex \[CapitalGamma]71[A] of section 4.3 would both be \
16-dimensional modules, so R[A] = T.\[CapitalGamma]71[A].T\:207b\.b9 for some \
invertible complex T. Complex conjugation of this equation (R is real) gives \
M.Conjugate[\[CapitalGamma]71[A]] = \[CapitalGamma]71[A].M with M = T\:207b\
\.b9.Conjugate[T], and then M.Conjugate[M] = ID16. By \
Schur\[CloseCurlyQuote]s lemma all such intertwiners M form a one-dimensional \
space; the computation below shows that it is spanned by M0 = \
\[CapitalGamma]17[8] (the volume element) and that M0.Conjugate[M0] = \
\[Minus]ID16. Hence M = c M0 and M.Conjugate[M] = \[Minus]|c|\.b2 ID16 \
\[NotEqual] ID16, a contradiction. \:220e"
}], "Text",ExpressionUUID->"19b6c1b0-5d6e-f848-a7db-caf9b194b311"],

Cell["\<\
The sign of M.Conjugate[M] is a Frobenius\[Dash]Schur-type indicator: +1 \
means the complex 16-dimensional module has a real form (the algebra is \
\[DoubleStruckCapitalR](16)), \[Minus]1 means it is quaternionic (the algebra \
is \[DoubleStruckCapitalH](8), whose smallest real module is \
\[DoubleStruckCapitalH]^8 = \[DoubleStruckCapitalR]^32). For \[Eta]17 the \
indicator is +1, in agreement with the real matrices \[CapitalGamma]17 of \
section 4.2.\
\>", "Text",ExpressionUUID->"c798b4d1-55f0-1d41-b227-678d07cd5c65"],

Cell[CellGroupData[{

Cell["\<\
intertwiners[gs_List] := Module[{n = Length[First[gs]], sys},
   sys = Join @@ Table[KroneckerProduct[IdentityMatrix[n], \
Transpose[Conjugate[g]]] - KroneckerProduct[g, IdentityMatrix[n]], {g, gs}];
   Partition[#, n] & /@ NullSpace[sys]];       (* all M with M.Conjugate[g] \
== g.M for every g in gs *)
indicator[gs_List] := Module[{M = First[intertwiners[gs]], P}, P = \
M.Conjugate[M];
   If[P == P[[1, 1]] IdentityMatrix[Length[P]], Sign[P[[1, 1]]], \"not scalar\
\"]];
M71 = intertwiners[Table[\[CapitalGamma]71[A], {A, 0, 7}]];
check[\"Schur: the intertwiners M with M.Conjugate[\[CapitalGamma]71[A]] == \
\[CapitalGamma]71[A].M form a 1-dimensional space\", Length[M71] == 1]
check[\"... spanned by the volume element \[CapitalGamma]17[8] == \
{{0,-ID8},{ID8,0}}, and \[CapitalGamma]17[8].\[CapitalGamma]17[8] == -ID16\",
  \[CapitalGamma]17[8] == ArrayFlatten[{{0, -ID8}, {ID8, 0}}] &&
  MatrixRank[{Flatten[First[M71]], Flatten[\[CapitalGamma]17[8]]}] == 1 && \
\[CapitalGamma]17[8].\[CapitalGamma]17[8] == -ID16 &&
  And @@ Table[\[CapitalGamma]17[8].Conjugate[\[CapitalGamma]71[A]] == \
\[CapitalGamma]71[A].\[CapitalGamma]17[8], {A, 0, 7}]]
check[\"indicator(\[CapitalGamma]71) == -1: Cl(7,1) \[TildeFullEqual] \
\[DoubleStruckCapitalH](8), NO real 16\[Times]16 realization of the \[Eta]71 \
relation\",
  indicator[Table[\[CapitalGamma]71[A], {A, 0, 7}]] == -1]
check[\"indicator(\[CapitalGamma]17) == +1: Cl(1,7) \[TildeFullEqual] \
\[DoubleStruckCapitalR](16), real realization exists (\[CapitalGamma]17)\",
  indicator[Table[\[CapitalGamma]17[A], {A, 0, 7}]] == 1]\
\>", "Input",
 CellLabel->
  "In[194]:=",ExpressionUUID->"13fffb76-4961-9447-b8e0-73289d4a4e2d"],

Cell[BoxData[
 RowBox[{"\<\"Schur: the intertwiners M with \
M.Conjugate[\[CapitalGamma]71[A]] == \[CapitalGamma]71[A].M form a \
1-dimensional space\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002050912265484*^9},
 CellLabel->
  "Out[197]=",ExpressionUUID->"d681a9d2-2f64-5e45-b6a2-beb0b1e19c27"],

Cell[BoxData[
 RowBox[{"\<\"... spanned by the volume element \[CapitalGamma]17[8] == \
{{0,-ID8},{ID8,0}}, and \[CapitalGamma]17[8].\[CapitalGamma]17[8] == \
-ID16\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002050912265484*^9},
 CellLabel->
  "Out[198]=",ExpressionUUID->"16975bf6-da80-c84e-a8e9-f87f0fae3d72"],

Cell[BoxData[
 RowBox[{"\<\"indicator(\[CapitalGamma]71) == -1: Cl(7,1) \[TildeFullEqual] \
\[DoubleStruckCapitalH](8), NO real 16\[Times]16 realization of the \[Eta]71 \
relation\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020509123005905`*^9},
 CellLabel->
  "Out[199]=",ExpressionUUID->"797e2adc-56ca-8449-be67-4d2ee56e70f2"],

Cell[BoxData[
 RowBox[{"\<\"indicator(\[CapitalGamma]17) == +1: Cl(1,7) \[TildeFullEqual] \
\[DoubleStruckCapitalR](16), real realization exists (\[CapitalGamma]17)\"\>",
   "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0020509123652554`*^9},
 CellLabel->
  "Out[200]=",ExpressionUUID->"f29361ad-484c-c845-ad1d-daff8144080b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.5 A real realization of Cl(7,1) needs 32\[Times]32 matrices", \
"Subsection",ExpressionUUID->"00daa11c-f44e-b84b-849b-83b370d0de95"],

Cell["\<\
With \[Epsilon] = {{0, 1}, {\[Minus]1, 0}} (real, \[Epsilon].\[Epsilon] = \
\[Minus]ID2), \[CapitalGamma]71R32[A] = \[Epsilon] \[CircleTimes] \
\[CapitalGamma]17[A] are real 32\[Times]32 matrices satisfying the \[Eta]71 \
relation. Their commutant (all matrices commuting with every \
\[CapitalGamma]71R32[A]) is spanned by ID32, Qi = \
\[Epsilon]\[CircleTimes]ID16, Qj = \
\[Sigma]\:2081\[CircleTimes]\[CapitalGamma]17[8], Qk = \[Sigma]\:2083\
\[CircleTimes]\[CapitalGamma]17[8], with Qi\.b2 = Qj\.b2 = Qk\.b2 = \
\[Minus]ID32 and Qi.Qj = Qk: the quaternions. This is Cl(7,1) \
\[TildeFullEqual] \[DoubleStruckCapitalH](8) acting on \
\[DoubleStruckCapitalR]^32 = \[DoubleStruckCapitalH]^8.\
\>", "Text",ExpressionUUID->"668348ef-660b-bd48-a55d-c6283f014af1"],

Cell[CellGroupData[{

Cell["\<\
\[Epsilon]2 = {{0, 1}, {-1, 0}};
Do[\[CapitalGamma]71R32[A] = KroneckerProduct[\[Epsilon]2, \
\[CapitalGamma]17[A]], {A, 0, 7}];
check[\"REAL 32\[Times]32 realization of the \[Eta]71 relation: (\
\[CapitalGamma]71R32[A].\[CapitalGamma]71R32[B] + \[CapitalGamma]71R32[B].\
\[CapitalGamma]71R32[A])/2 == \[Eta]71[[A+1,B+1]] ID32\",
  And @@ Flatten[Table[(\[CapitalGamma]71R32[A].\[CapitalGamma]71R32[B] + \
\[CapitalGamma]71R32[B].\[CapitalGamma]71R32[A])/2 == \[Eta]71[[A + 1, B + \
1]] ID32, {A, 0, 7}, {B, 0, 7}]] &&
  And @@ Table[SubsetQ[{-1, 0, 1}, Union[Flatten[\[CapitalGamma]71R32[A]]]], \
{A, 0, 7}]]
Qi = KroneckerProduct[\[Epsilon]2, ID16]; Qj = KroneckerProduct[{{0, 1}, {1, \
0}}, \[CapitalGamma]17[8]]; Qk = KroneckerProduct[{{1, 0}, {0, -1}}, \
\[CapitalGamma]17[8]];
check[\"Qi, Qj, Qk commute with every \[CapitalGamma]71R32[A]; Qi.Qi == Qj.Qj \
== Qk.Qk == -ID32; Qi.Qj == Qk == -Qj.Qi\",
  And @@ Flatten[Table[q.\[CapitalGamma]71R32[A] == \
\[CapitalGamma]71R32[A].q, {q, {Qi, Qj, Qk}}, {A, 0, 7}]] &&
  Qi.Qi == -ID32 && Qj.Qj == -ID32 && Qk.Qk == -ID32 && Qi.Qj == Qk && Qj.Qi \
== -Qk]
{commutantTime, commutantBasis} = AbsoluteTiming[NullSpace[Join @@ Table[
       KroneckerProduct[SparseArray[ID32], SparseArray[Transpose[\
\[CapitalGamma]71R32[A]]]] - \
KroneckerProduct[SparseArray[\[CapitalGamma]71R32[A]], SparseArray[ID32]], \
{A, 0, 7}]]];
check[\"the commutant of {\[CapitalGamma]71R32[A]} has dimension exactly 4 \
and is spanned by ID32, Qi, Qj, Qk: it is \[DoubleStruckCapitalH]\",
  Length[commutantBasis] == 4 && MatrixRank[Join[Normal[commutantBasis], \
Flatten /@ {ID32, Qi, Qj, Qk}]] == 4]
commutantTime\
\>", "Input",
 CellLabel->
  "In[201]:=",ExpressionUUID->"28950a79-cbbf-014f-b99f-878b42167059"],

Cell[BoxData[
 RowBox[{"\<\"REAL 32\[Times]32 realization of the \[Eta]71 relation: (\
\[CapitalGamma]71R32[A].\[CapitalGamma]71R32[B] + \[CapitalGamma]71R32[B].\
\[CapitalGamma]71R32[A])/2 == \[Eta]71[[A+1,B+1]] ID32\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.002050912387268*^9},
 CellLabel->
  "Out[203]=",ExpressionUUID->"cabb4a64-c156-7845-bc30-52a4fb417498"],

Cell[BoxData[
 RowBox[{"\<\"Qi, Qj, Qk commute with every \[CapitalGamma]71R32[A]; Qi.Qi == \
Qj.Qj == Qk.Qk == -ID32; Qi.Qj == Qk == -Qj.Qi\"\>", "\[Rule]", 
  "True"}]], "Output",
 CellChangeTimes->{4.0020509123925686`*^9},
 CellLabel->
  "Out[205]=",ExpressionUUID->"072628b4-27e7-8240-9968-a53ce115afd2"],

Cell[BoxData[
 RowBox[{"\<\"the commutant of {\[CapitalGamma]71R32[A]} has dimension \
exactly 4 and is spanned by ID32, Qi, Qj, Qk: it is \[DoubleStruckCapitalH]\"\
\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.002050913442568*^9},
 CellLabel->
  "Out[207]=",ExpressionUUID->"5efec46f-2036-4d4e-a4a0-bebefd95485a"],

Cell[BoxData["1.0547124`"], "Output",
 CellChangeTimes->{4.0020509134485683`*^9},
 CellLabel->
  "Out[208]=",ExpressionUUID->"f4093c45-5fbd-6b46-9ab1-44367d5c6eac"]
}, Open  ]]
