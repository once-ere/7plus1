    {"\<\"uniform density matrix (rhoS ID16 + rho Gamma17[0])/16: D_0 == \
rhoS^2, D_1 == rho^2, D_2 .. D_8 == 0\"\>", "True"},
    {"\<\"section 8 recovered: with g = (gS, gV, 0, 0, 0, 0, 0, -gA, -gP) the \
