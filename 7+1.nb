Cell[CellGroupData[{

Cell["10. Summary of all checks (sections 1\[Dash]9)", "Section",ExpressionUUID->"dd167351-3498-5b4e-9d20-26a47391ec34"],

Cell["\<\
The four cells below repeat the summary of section 6 after sections 7\[Dash]9 \
have been evaluated, so they cover every check of the notebook.\
\>", "Text",ExpressionUUID->"edbd230f-c497-fe47-85b2-df46a757edff"],

