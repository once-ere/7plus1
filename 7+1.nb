Cell[CellGroupData[{

Cell["\<\
21.2 Accurate approximate solutions in the three Lovelock regimes\
\>", "Subsection",ExpressionUUID->"80179682-9fc9-ee4f-af9b-9a59aad45d8c"],

Cell[TextData[{
 StyleBox["Cubic regime (\[Tau] \[RightArrow] 0). ",
  FontWeight->"Bold"],
 "The series Ha = 1/\[Tau] + A0 + A1 \[Tau] + \[Ellipsis], Hb = h0 + h1 \
\[Tau] + h2 \[Tau]\.b2 + \[Ellipsis] solves the three equations order by \
order with"
}], "Text",ExpressionUUID->"dd30458e-8071-814e-9993-2b3f03b60005"],

Cell["\<\
      h0 = \[Minus]\[Sqrt](\[Alpha]_2/(30\[Alpha]_3)),   h1 = \[Alpha]_2/(16\
\[Alpha]_3) \[Minus] 1/(32\[Alpha]_2),   A0 = \[Sqrt]30 (58\[Alpha]_2\.b2 \
\[Minus] 45\[Alpha]_3)/(1920 \[Alpha]_2^(3/2) \[Alpha]_3^(1/2)),\
\>", "Text",ExpressionUUID->"b6cf541a-e110-1b47-b4f2-d65c5abe0db1"],

Cell["\<\
      A1 = \[Minus]3647\[Alpha]_2/(92160\[Alpha]_3) \[Minus] \
223/(6144\[Alpha]_2) + 645\[Alpha]_3/(8192\[Alpha]_2\.b3),   h2 = \[Sqrt]30 (\
\[Minus]1212\[Alpha]_2\:2074 + 1180\[Alpha]_2\.b2\[Alpha]_3 + 225\[Alpha]_3\
\.b2)/(307200 \[Alpha]_2^(5/2) \[Alpha]_3^(3/2)).\
\>", "Text",ExpressionUUID->"c91d2172-87a7-d948-a21f-432b4313fc7f"],

Cell["\<\
So a \[Proportional] \[Tau] (ordinary space expands like a Milne universe) \
while b stays finite: the auxiliary space contracts at the finite rate |h0| \
\[LongDash] here the cubic and Gauss\[Dash]Bonnet terms balance (\[Alpha]_3 \
E^(3) \[TildeTilde] \[Minus]\[Alpha]_2 E^(2)) and the Einstein term is \
negligible.\
\>", "Text",ExpressionUUID->"4a7c8b1e-556f-604c-9f2e-911d477515ff"],

Cell[TextData[{
 StyleBox["Gauss\[Dash]Bonnet regime. ",
  FontWeight->"Bold"],
 "Expanding the curve about u2 gives p_eff = p2 + f1/Ha\.b2 + f2 \[Xi] Ha\.b2 \
+ \[Ellipsis] (f1 and f2 are computed below), so that"
}], "Text",ExpressionUUID->"d8aaf239-059a-9943-acd8-d10756461f23"],

Cell["\<\
      \[Tau] = p2/Ha + f1/(3Ha\.b3) \[Minus] f2 \[Xi] Ha + s2,   a \
\[Proportional] (\[Tau] \[Minus] s2)^p2,   b \[Proportional] (\[Tau] \[Minus] \
s2)^q2   (p2 = 1.5611\[Ellipsis], q2 = \[Minus]0.42086\[Ellipsis]),\
\>", "Text",ExpressionUUID->"3ace2a21-d18d-274f-b50d-2b3a8284aea4"],

Cell["\<\
with the time shift s2 fixed at the middle of the regime, Ha_mid = (f1/(f2 \
\[Xi]))^(1/4).\
\>", "Text",ExpressionUUID->"a326669f-410c-7443-b99d-eb17b391207a"],

Cell[TextData[{
 StyleBox["Einstein regime (Ha \[RightArrow] 0). ",
  FontWeight->"Bold"],
 "Expanding about u1: u = u1 + d1 Ha\.b2 + \[Ellipsis], d1 = \[Alpha]_2 (16 \
\[Minus] 11\[Sqrt]2)/4, and p_eff = p1 + e1 Ha\.b2 + \[Ellipsis], e1 = \
\[Alpha]_2 (1 + 9\[Sqrt]2)/7, so"
}], "Text",ExpressionUUID->"a8220b66-02db-c54a-b911-f1c046df9c4c"],

Cell["\<\
      \[Tau] = p1/Ha \[Minus] e1 Ha + s1,   Ha = p1/(\[Tau] \[Minus] s1) \
\[Minus] e1 p1\.b2/(\[Tau] \[Minus] s1)\.b3 + \[Ellipsis],   a \
\[Proportional] (\[Tau] \[Minus] s1)^p1,   b \[Proportional] (\[Tau] \[Minus] \
s1)^q1,\
\>", "Text",ExpressionUUID->"180abf30-97cc-fb4a-86c7-02f46d71dab7"],

Cell[TextData[{
 "with s1 = \[Tau](u2) \[Minus] p1/Ha(u2) + \[Integral]_0^Ha(u2) (1/F \
\[Minus] p1/H\.b2) dH from the exact quadrature along the curve. The \
crossovers are at \[Tau]_32 \[TildeTilde] |q2|/|h0| = |q2| \[Sqrt](30\[Xi]) ",
 StyleBox["\[ScriptL]",
  FontFamily->"Cambria Math"],
 "2 (cubic \[RightArrow] Gauss\[Dash]Bonnet) and \[Tau]_21 \[TildeTilde] ",
 StyleBox["\[ScriptL]",
  FontFamily->"Cambria Math"],
 "2 (Gauss\[Dash]Bonnet \[RightArrow] Einstein)."
}], "Text",ExpressionUUID->"42568885-426f-1c41-8385-2d6400f45365"],

Cell["\<\
The checks below derive the coefficients, integrate the vacuum equations from \
cubic-series data at \[Tau] = 10\:207b\:2078 (in the variable \[Sigma] = \
\[Minus]ln Ha, with x0 as a dependent variable), and compare: each regime \
formula is accurate to better than 10\:207b\.b3 inside its regime; across the \
two crossover windows the exact curve-plus-quadrature solution takes over.\
\>", "Text",ExpressionUUID->"b3d3be69-8565-dd4b-93df-fbe62bbe845f"],

Cell[CellGroupData[{

Cell["\<\
rIc = Expand[{feTot[1], feTot[2], feTot[5]} /. lamb -> 0];
rIser = Expand[Expand[rIc /. {Ha -> 1/tS + cA0 + cA1 tS + cA2 tS^2, Hb -> \
-Sqrt[alf[2]/(30 alf[3])] + ch1 tS + ch2 tS^2 + ch3 tS^3,
        dHa -> -1/tS^2 + cA1 + 2 cA2 tS, dHb -> ch1 + 2 ch2 tS + 3 ch3 tS^2}] \
tS^4];
rIco = Table[Simplify[Coefficient[rIser[[c]], tS, n], alf[2] > 0 && alf[3] > \
0], {c, 3}, {n, 0, 3}];
rIs1 = First[Solve[{rIco[[1, 3]] == 0, rIco[[3, 2]] == 0}, {ch1, cA0}]];
rIs2 = First[Solve[{(rIco[[1, 4]] /. rIs1) == 0, (rIco[[3, 3]] /. rIs1) == \
0}, {ch2, cA1}]];
rIsame[e1_, e2_] := AllTrue[{{1, 10^-6}, {7/3, 2/5}, {1/2, 3}}, \
RootReduce[Together[(e1 - e2) /. {alf[2] -> #[[1]], alf[3] -> #[[2]]}]] === 0 \
&];      (* exact *)
check[\"cubic regime: Ha = 1/tau + A0 + A1 tau, Hb = h0 + h1 tau + h2 tau^2 \
solves the 00, 11, 44 equations through order tau^-1 (11: checked, not used)\",
  AllTrue[rIco[[All, 1]], # === 0 &] && Simplify[rIco[[1, 2]]] === 0 && \
Simplify[rIco[[2, 2]]] === 0 &&
  rIsame[rIco[[2, 3]] /. rIs1, 0] && rIsame[(rIco[[2, 4]] /. rIs1) /. rIs2, 0]]
check[\"cubic regime coefficients: h1 == alpha2/(16 alpha3) - 1/(32 alpha2), \
A0 == Sqrt[30](58 alpha2^2 - 45 alpha3)/(1920 alpha2^(3/2) alpha3^(1/2)), A1 \
and h2 as in the text\",
  rIsame[ch1 /. rIs1, alf[2]/(16 alf[3]) - 1/(32 alf[2])] && rIsame[cA0 /. \
rIs1, Sqrt[30] (58 alf[2]^2 - 45 alf[3])/(1920 alf[2]^(3/2) Sqrt[alf[3]])] &&
  rIsame[cA1 /. rIs2, -3647 alf[2]/(92160 alf[3]) - 223/(6144 alf[2]) + 645 \
alf[3]/(8192 alf[2]^3)] &&
  rIsame[ch2 /. rIs2, Sqrt[30] (-1212 alf[2]^4 + 1180 alf[2]^2 alf[3] + 225 \
alf[3]^2)/(307200 alf[2]^(5/2) alf[3]^(3/2))]]
rIcub = N[{-Sqrt[alf[2]/(30 alf[3])], ch1 /. rIs1, ch2 /. rIs2, cA0 /. rIs1, \
cA1 /. rIs2} /. {alf[2] -> 1, alf[3] -> rIxi}, 20];   (* h0, h1, h2, A0, A1 *)
rIeSer = Normal[Series[(rIc[[1]] /. {Hb -> (rIu1 + cd1 eS^2 + cd2 eS^4) Ha} \
/. Ha -> eS), {eS, 0, 6}]];
rId1 = cd1 /. First[Solve[Coefficient[rIeSer, eS, 4] == 0, cd1]];
rId2 = cd2 /. First[Solve[(Coefficient[rIeSer, eS, 6] /. cd1 -> rId1) == 0, \
cd2]];
rIdHsolG = First[Solve[{rIc[[2]] == 0, rIc[[3]] == 0}, {dHa, dHb}]];
rIpeE = Normal[Series[-eS^2/((dHa /. rIdHsolG) /. {Hb -> (rIu1 + rId1 eS^2 + \
rId2 eS^4) Ha} /. Ha -> eS), {eS, 0, 2}]];
rIe1 = Simplify[Coefficient[rIpeE, eS, 2]];
check[\"Einstein regime: u = u1 + d1 Ha^2, d1 == alpha2 (16 - 11 Sqrt[2])/4; \
p_eff = p1 + e1 Ha^2, e1 == alpha2 (1 + 9 Sqrt[2])/7\",
  Simplify[rIeSer /. {eS -> 0}] === 0 && Simplify[Coefficient[rIeSer, eS, 2]] \
=== 0 && Simplify[rId1 - alf[2] (16 - 11 Sqrt[2])/4] === 0 &&
  Simplify[rIe1 - alf[2] (1 + 9 Sqrt[2])/7] === 0 && \
Simplify[Coefficient[rIpeE, eS, 0] - (1 + 2 Sqrt[2])/7] === 0]
rIe1v = N[rIe1 /. alf[2] -> 1, 20];
rIuOn[h_, xi_] := u /. FindRoot[rIpEf[u] + h^2 rIpGf[u] + xi h^4 rIpCf[u] == \
0, {u, N[rIu2, 40]}, WorkingPrecision -> 40];
rIpeH[h_, xi_] := With[{uu = rIuOn[h, xi]}, -h^2/rIdHa[h, uu h, xi]];
rIf1 = (rIpeH[10^5, 0] - N[rIp2, 40]) 10^10; rIf2 = (rIpeH[10^8, 10^-24] - \
N[rIp2, 40]) 10^8;
check[\"Gauss-Bonnet regime: p_eff = p2 + f1/Ha^2 + f2 xi Ha^2 with f1 = \
-0.69887346..., f2 = -0.7853407... (differences give the same values at Ha = \
10^4 and 10^-6 xi Ha^2 to 10^-5)\",
  Abs[(rIpeH[10^4, 0] - N[rIp2, 40]) 10^8 - rIf1] < 10^-5 && Abs[(rIpeH[10^8, \
10^-22] - N[rIp2, 40]) 10^6 - rIf2] < 10^-5]
{\"cubic: h0, h1, h2, A0, A1 (xi = 10^-6)\" -> rIcub, \"Einstein: d1, e1 \
(alpha2 = 1)\" -> N[{rId1, rIe1} /. alf[2] -> 1, 16], \"Gauss-Bonnet: f1, \
f2\" -> N[{rIf1, rIf2}, 12]}\
\>", "Input",
 CellLabel->
  "In[936]:=",ExpressionUUID->"d5b1ee1a-6c29-9d43-9bc5-5c8093391e5d"],

Cell[BoxData[
 RowBox[{"\<\"cubic regime: Ha = 1/tau + A0 + A1 tau, Hb = h0 + h1 tau + h2 \
tau^2 solves the 00, 11, 44 equations through order tau^-1 (11: checked, not \
used)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021434556976814`*^9},
 CellLabel->
  "Out[942]=",ExpressionUUID->"4afa285a-37c1-2145-bf62-326edea8e14e"],

Cell[BoxData[
 RowBox[{"\<\"cubic regime coefficients: h1 == alpha2/(16 alpha3) - 1/(32 \
alpha2), A0 == Sqrt[30](58 alpha2^2 - 45 alpha3)/(1920 alpha2^(3/2) \
alpha3^(1/2)), A1 and h2 as in the text\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021434556976814`*^9},
 CellLabel->
  "Out[943]=",ExpressionUUID->"242eb215-2ffe-7942-b670-e9b56f15842f"],

Cell[BoxData[
 RowBox[{"\<\"Einstein regime: u = u1 + d1 Ha^2, d1 == alpha2 (16 - 11 \
Sqrt[2])/4; p_eff = p1 + e1 Ha^2, e1 == alpha2 (1 + 9 Sqrt[2])/7\"\>", "\[Rule]",
   "True"}]], "Output",
 CellChangeTimes->{4.0021434561056957`*^9},
 CellLabel->
  "Out[951]=",ExpressionUUID->"c200b8ed-ecd5-fc46-b351-214c8446688a"],

Cell[BoxData[
 RowBox[{"\<\"Gauss-Bonnet regime: p_eff = p2 + f1/Ha^2 + f2 xi Ha^2 with f1 \
= -0.69887346..., f2 = -0.7853407... (differences give the same values at Ha \
= 10^4 and 10^-6 xi Ha^2 to 10^-5)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021434561076984`*^9},
 CellLabel->
  "Out[956]=",ExpressionUUID->"b85d8111-f3a9-be45-8124-696d76ba30c1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"cubic: h0, h1, h2, A0, A1 (xi = 10^-6)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "182.57418583505537115232326093360071131743`20."}], ",", 
      "62499.96875`20.", ",", 
      RowBox[{"-", "2.160934548774479934369774854019207888039480996`20.*^7"}],
       ",", "165.45772754054451483348511374378280056912`20.", ",", 
      RowBox[{"-", "39572.51893438307020399305555555555555555555`20."}]}], 
     "}"}]}], ",", 
   RowBox[{"\<\"Einstein: d1, e1 (alpha2 = 1)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "0.11091270347398861579535600842333028393`16.", ",", 
      "1.96113172305112220560217121684104038672`16."}], "}"}]}], ",", 
   RowBox[{"\<\"Gauss-Bonnet: f1, f2\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "0.69887346763555431532675451446110066438`12."}], ",", 
      RowBox[{"-", "0.78534071418759873033688909577885971033`12."}]}], 
     "}"}]}]}], "}"}]], "Output",
 CellChangeTimes->{4.0021434561096954`*^9},
 CellLabel->
  "Out[957]=",ExpressionUUID->"289344da-7c96-9d4f-af46-842974045190"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
rIrhs[sg_?NumericQ, yy_?VectorQ] := With[{ha = Exp[-sg]}, With[{dha = \
rIdHa[ha, yy[[1]], rIxi], dhb = rIdHb[ha, yy[[1]], rIxi]}, {dhb (-ha/dha), \
-ha/dha}]];
rItau0 = 10^-8; rIHa0 = 1/rItau0 + rIcub[[4]] + rIcub[[5]] rItau0; rIHb0 = \
rIcub[[1]] + rIcub[[2]] rItau0 + rIcub[[3]] rItau0^2;
check[\"cubic-series data at tau = 10^-8 satisfy the vacuum constraint to < \
10^-12 (relative to 48 Ha^3 |Hb|)\",
  Abs[(rIc[[1]] /. {alf[2] -> 1, alf[3] -> rIxi, Ha -> rIHa0, Hb -> \
rIHb0})]/(48 rIHa0^3 Abs[rIHb0]) < 10^-12]
rIvacY = NDSolveValue[{rIyV'[sV] == rIrhs[sV, rIyV[sV]], rIyV[-Log[rIHa0]] == \
{rIHb0, rItau0}}, rIyV, {sV, -Log[rIHa0], -Log[10^-4]},
    Method -> {\"ExplicitRungeKutta\", \"DifferenceOrder\" -> 8}, \
PrecisionGoal -> 13, AccuracyGoal -> 40, MaxSteps -> 10^6, InterpolationOrder \
-> All];
rIvacAt[h_] := rIvacY[-Log[h]];          (* {Hb, tau} on the vacuum solution \
at Ha = h *)
rIdHdu[u_, xi_] := With[{x = rIX[u, xi]}, -(rIpEf'[u] + x rIpGf'[u] + xi x^2 \
rIpCf'[u])/(rIpGf[u] + 2 xi x rIpCf[u])/(2 Sqrt[x])];
rIF[u_, xi_] := With[{h = Sqrt[rIX[u, xi]]}, -rIdHa[h, u h, xi]];
rItauU2 = NIntegrate[rIdHdu[-v^2, rIxi]/rIF[-v^2, rIxi] 2 v, {v, 0, 10^-3, \
3/100, 3/10, Sqrt[-rIu2]}, WorkingPrecision -> 30, PrecisionGoal -> 16];
rIHu2 = Sqrt[rIX[N[rIu2, 40], rIxi]];
rIJ = NIntegrate[(1/rIF[rIu1 + w^2, rIxi] - rIp1/rIX[rIu1 + w^2, rIxi]) \
rIdHdu[rIu1 + w^2, rIxi] 2 w,
    {w, 0, Sqrt[N[rIu2 - rIu1, 40]] 10^-3, Sqrt[N[rIu2 - rIu1, 40]]/10, \
Sqrt[N[rIu2 - rIu1, 40]]}, WorkingPrecision -> 30, PrecisionGoal -> 16];
rIs1v = rItauU2 - rIp1/rIHu2 + rIJ;
rIHmid = (rIf1/(rIf2 rIxi))^(1/4);
rIs2v = rIvacAt[rIHmid][[2]] - rIp2/rIHmid - rIf1/(3 rIHmid^3) + rIf2 rIxi \
rIHmid;
check[\"the ODE solution agrees with the exact quadrature: tau at Ha(u2) to \
10^-10, and tau - p1/Ha + e1 Ha at Ha = 3 10^-3 equals s1 to 10^-6\",
  Abs[rIvacAt[rIHu2][[2]] - rItauU2] < 10^-10 && Abs[rIvacAt[3/1000][[2]] - \
rIp1/(3/1000) + rIe1v 3/1000 - rIs1v] < 10^-6]
rItauCub[h_] := Nest[1/(h - rIcub[[4]] - rIcub[[5]] #) &, 1/h, 60];
rIacc = Table[With[{h = 10.^lh}, With[{tv = rIvacAt[h][[2]]},
     {lh, tv, Abs[rItauCub[h]/tv - 1], Abs[(rIp2/h + rIf1/(3 h^3) - rIf2 rIxi \
h + rIs2v)/tv - 1], Abs[(rIp1/h - rIe1v h + rIs1v)/tv - 1]}]], {lh, 8, -3.5, \
-0.25}];
rIbest[lo_, hi_, col_] := Max[Select[rIacc, lo <= #[[1]] <= hi &][[All, col]]];
check[\"regime approximations: cubic error < 10^-5 for Ha >= 10^4, \
Gauss-Bonnet < 10^-3 for 3 <= Ha <= 300, Einstein < 10^-3 for Ha <= 0.1\",
  rIbest[4, 8, 3] < 10^-5 && rIbest[0.5, 2.5, 4] < 10^-3 && rIbest[-3.5, -1, \
5] < 10^-3]
{\"tau(u2), Ha(u2), s1, s2, Ha_mid\" -> N[{rItauU2, rIHu2, rIs1v, rIs2v, \
rIHmid}, 13],
 \"max errors: cubic (Ha >= 10^4), GB (3 .. 300), Einstein (<= 0.1); worst of \
the best approximation in the crossovers\" -> {rIbest[4, 8, 3], rIbest[0.5, \
2.5, 4], rIbest[-3.5, -1, 5], Max[Min /@ rIacc[[All, 3 ;; 5]]]},
 \"tau at Ha = 10^3 (cubic -> GB) and Ha = 1 (GB -> Einstein)\" -> \
{rIvacAt[10^3][[2]], rIvacAt[1][[2]]}}\
\>", "Input",
 CellLabel->
  "In[958]:=",ExpressionUUID->"fe560ca4-beeb-3d4b-8f20-841676f8f8c8"],

Cell[BoxData[
 RowBox[{"\<\"cubic-series data at tau = 10^-8 satisfy the vacuum constraint \
to < 10^-12 (relative to 48 Ha^3 |Hb|)\"\>", "\[Rule]", "True"}]], "Output",
 CellChangeTimes->{4.0021434561285286`*^9},
 CellLabel->
  "Out[960]=",ExpressionUUID->"72654621-c603-5b4a-bef8-22771ebb5500"],

