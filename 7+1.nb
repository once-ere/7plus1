  "Out[1049]=",ExpressionUUID->"7980aa9f-01b9-2249-88af-a2f70ca7a707"],

Cell[BoxData[
 RowBox[{"\<\"the radion decays into the bulk: the lattice sum over the \
Kaluza-Klein modes of dirac16complex (m << m_r/2) equals its continuum limit \
to 10^-6, the number of momenta to 10^-5, and Gamma_bulk/Gamma_brane > \
10^12\"\>", "\[Rule]", "True"}]], "Output",
