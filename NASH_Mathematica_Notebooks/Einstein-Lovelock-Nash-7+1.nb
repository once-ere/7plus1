Cell["\<\
We define a function to collect and canonicalize equal-order terms:\
\>", "MathCaption",ExpressionUUID->"b5f80c44-8a87-47d5-a6ce-2c53e1c34a28"],

Cell[BoxData[
 RowBox[{
  RowBox[{"org", "[", "expr_", "]"}], ":=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{"ContractMetric", "[", "expr", "]"}], ",", 
    "$PerturbationParameter", ",", "ToCanonical"}], "]"}]}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"77d77059-ff4c-4724-aa9c-aee9ad97bffe"],

Cell[TextData[{
 "We change the options of ",
 StyleBox["ToCanonical", "DisplayMath"],
 " to prevent indices inside the derivations from moving up and down."
}], "MathCaption",
 FontFamily->"Arial",ExpressionUUID->"9743c6c0-d1ae-444c-aee5-045e9695d10a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SetOptions", "[", 
  RowBox[{"ToCanonical", ",", 
   RowBox[{"UseMetricOnVBundle", "\[Rule]", "None"}], ",", 
   RowBox[{"Verbose", "->", "False"}]}], "]"}]], "Input",
 CellChangeTimes->{3.869820229733904*^9, 3.869820559737852*^9, 
  3.869820984184108*^9},
 CellLabel->"In[20]:=",ExpressionUUID->"0d370a23-3765-485e-ae3a-6752b62d99d6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Verbose", "\[Rule]", "False"}], ",", 
   RowBox[{"UseMetricOnVBundle", "\[Rule]", "None"}], ",", 
   RowBox[{"Method", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"ChangeCovD", ",", 
      RowBox[{"\<\"ExpandChristoffel\"\>", "\[Rule]", "False"}]}], "}"}]}], ",", 
   RowBox[{"MathLink", "\[RuleDelayed]", "$xpermQ"}], ",", 
   RowBox[{"TimeVerbose", "\[Rule]", "False"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9315999448335257`*^9, 4.002097452233883*^9},
 CellLabel->"Out[20]=",ExpressionUUID->"d214e164-4876-ef45-a7f3-12f0275fe8c1"]
}, Open  ]],

