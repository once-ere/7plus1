Cell[CellGroupData[{

Cell["\<\
Mathematica Lexer and Parser for Maple - like Syntax Supports : Basic \
arithmetic, function calls, lists {}, equations =, and specific Maple \
keywords .\
\>", "Section",
 CellChangeTimes->{{3.973919239585927*^9, 3.973919333276555*^9}, {
   3.97391967578034*^9, 3.973919677630157*^9}, {3.9739198168345613`*^9, 
   3.973919818492487*^9}, 3.9742128616352215`*^9},
 FontSize->24,
 FontColor->RGBColor[
  0.93, 0.27, 0.27],ExpressionUUID->"ee76cba9-0a39-cd41-8e5c-f4fd6b078dd0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", 
      RowBox[{"LEXER", "--"}]}]}], "-"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Helper", ":", 
    RowBox[{
    "Check", " ", "if", " ", "character", " ", "is", " ", "a", " ", 
     "digit"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"IsDigit", "[", "char_", "]"}], ":=", 
     RowBox[{"StringMatchQ", "[", 
      RowBox[{"char", ",", 
       RowBox[{"RegularExpression", "[", "\"\<\\\\d\>\"", "]"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Helper", ":", 
     RowBox[{
     "Check", " ", "if", " ", "character", " ", "is", " ", "a", " ", 
      "letter"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"IsAlpha", "[", "char_", "]"}], ":=", 
     RowBox[{"StringMatchQ", "[", 
      RowBox[{"char", ",", 
       RowBox[{"RegularExpression", "[", "\"\<[a-zA-Z_]\>\"", "]"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Helper", ":", 
     RowBox[{
     "Check", " ", "if", " ", "character", " ", "is", " ", "whitespace"}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"IsSpace", "[", "char_", "]"}], ":=", 
     RowBox[{"StringMatchQ", "[", 
      RowBox[{"char", ",", 
       RowBox[{"RegularExpression", "[", "\"\<\\\\s\>\"", "]"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Main", " ", "Lexer", " ", "Function"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"GetTokens", "[", "str_String", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"chars", ",", "len", ",", "i", ",", "char", ",", 
         RowBox[{"tokens", "=", 
          RowBox[{"{", "}"}]}], ",", "token", ",", "numStr", ",", "idStr"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"chars", "=", 
         RowBox[{"Characters", "[", "str", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"len", "=", 
         RowBox[{"Length", "[", "chars", "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"i", "=", "1"}], ";", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"i", "<=", "len"}], ",", 
          RowBox[{
           RowBox[{"char", "=", 
            RowBox[{"chars", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Which", "[", 
            RowBox[{"(*", 
             RowBox[{"Skip", " ", "Whitespace"}], "*)"}], 
            RowBox[{
             RowBox[{"IsSpace", "[", "char", "]"}], ",", 
             RowBox[{"i", "++"}], ",", 
             RowBox[{"(*", "Numbers", "*)"}], 
             RowBox[{"IsDigit", "[", "char", "]"}], ",", 
             RowBox[{
              RowBox[{"numStr", "=", "char"}], ";", "\[IndentingNewLine]", 
              RowBox[{"i", "++"}], ";", "\[IndentingNewLine]", 
              RowBox[{"While", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"i", "<=", "len"}], "&&", 
                 RowBox[{"IsDigit", "[", 
                  RowBox[{"chars", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
                RowBox[{
                 RowBox[{"numStr", "=", 
                  RowBox[{"numStr", "<>", 
                   RowBox[{"chars", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"i", "++"}], ";"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<NUMBER\>\"", ",", 
                  RowBox[{"ToExpression", "[", "numStr", "]"}]}], "}"}]}], 
               "]"}]}], ",", 
             RowBox[{"(*", 
              RowBox[{"Identifiers", " ", "and", " ", "Keywords"}], "*)"}], 
             RowBox[{"IsAlpha", "[", "char", "]"}], ",", 
             RowBox[{
              RowBox[{"idStr", "=", "char"}], ";", "\[IndentingNewLine]", 
              RowBox[{"i", "++"}], ";", "\[IndentingNewLine]", 
              RowBox[{"While", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"i", "<=", "len"}], "&&", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"IsAlpha", "[", 
                    RowBox[{"chars", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], "||", 
                   RowBox[{"IsDigit", "[", 
                    RowBox[{"chars", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ")"}]}], ",", 
                RowBox[{
                 RowBox[{"idStr", "=", 
                  RowBox[{"idStr", "<>", 
                   RowBox[{"chars", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"i", "++"}], ";"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{
                "Check", " ", "for", " ", "specific", " ", "keywords", " ", 
                 "if", " ", "needed"}], ",", 
                RowBox[{"otherwise", " ", "IDENTIFIER"}]}], "*)"}], 
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<IDENTIFIER\>\"", ",", "idStr"}], "}"}]}], 
               "]"}]}], ",", 
             RowBox[{"(*", 
              RowBox[{"Operators", " ", "and", " ", "Punctuation"}], "*)"}], 
             RowBox[{"char", "==", "\"\<+\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<PLUS\>\"", ",", "\"\<+\>\""}], "}"}]}], "]"}], ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\<-\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<MINUS\>\"", ",", "\"\<-\>\""}], "}"}]}], "]"}], 
              ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\<*\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<STAR\>\"", ",", "\"\<*\>\""}], "}"}]}], "]"}], ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\</\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<SLASH\>\"", ",", "\"\</\>\""}], "}"}]}], "]"}], 
              ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\<^\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<CARET\>\"", ",", "\"\<^\>\""}], "}"}]}], "]"}], 
              ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\<(\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<LPAREN\>\"", ",", "\"\<(\>\""}], "}"}]}], "]"}],
               ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\<)\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<RPAREN\>\"", ",", "\"\<)\>\""}], "}"}]}], "]"}],
               ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\<{\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<LBRACE\>\"", ",", "\"\<{\>\""}], "}"}]}], "]"}],
               ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\<}\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<RBRACE\>\"", ",", "\"\<}\>\""}], "}"}]}], "]"}],
               ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\<=\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<EQUALS\>\"", ",", "\"\<=\>\""}], "}"}]}], "]"}],
               ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\<,\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<COMMA\>\"", ",", "\"\<,\>\""}], "}"}]}], "]"}], 
              ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\<$\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<DOLLAR\>\"", ",", "\"\<$\>\""}], "}"}]}], "]"}],
               ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"Ellipsis", "..."}], " ", "or", " ", 
               RowBox[{"Dot", "."}]}], "*)"}], 
             RowBox[{"char", "==", "\"\<.\>\""}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"i", "+", "2"}], "<=", "len"}], "&&", 
                RowBox[{
                 RowBox[{"chars", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", "+", "1"}], "]"}], "]"}], "==", "\"\<.\>\""}],
                 "&&", 
                RowBox[{
                 RowBox[{"chars", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", "+", "2"}], "]"}], "]"}], 
                 "==", "\"\<.\>\""}]}], ",", 
               RowBox[{
                RowBox[{"AppendTo", "[", 
                 RowBox[{"tokens", ",", 
                  RowBox[{"{", 
                   RowBox[{"\"\<ELLIPSIS\>\"", ",", "\"\<...\>\""}], "}"}]}], 
                 "]"}], ";", 
                RowBox[{"i", "+=", "3"}]}], ",", 
               RowBox[{
                RowBox[{"AppendTo", "[", 
                 RowBox[{"tokens", ",", 
                  RowBox[{"{", 
                   RowBox[{"\"\<DOT\>\"", ",", "\"\<.\>\""}], "}"}]}], "]"}], 
                ";", 
                RowBox[{"i", "++"}]}]}], "]"}], ",", "True", ",", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"\"\<Unknown character: \>\"", ",", "char"}], "]"}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"i", "++"}]}]}], "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"tokens", ",", 
          RowBox[{"{", 
           RowBox[{"\"\<EOF\>\"", ",", "\"\<EOF\>\""}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "tokens"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.974224533171171*^9, 3.974224533171171*^9}},
 CellLabel->
  "In[182]:=",ExpressionUUID->"386cdb69-4ccf-8c4d-b9e1-ba33473d7305"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", 
      RowBox[{"PARSER", "--"}]}]}], "-"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Grammar", ":", "Expression"}], "->", 
    RowBox[{
     RowBox[{"Equation", " ", "Equation"}], "->", 
     RowBox[{
      RowBox[{
       RowBox[{"AddExp", "[", 
        RowBox[{"\"\<=\>\"", " ", "AddExp"}], "]"}], " ", "AddExp"}], "->", 
      RowBox[{
       RowBox[{"MulExp", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\"\<+\>\"", "|", "\"\<-\>\""}], ")"}], " ", "MulExp"}], 
         "}"}], " ", "MulExp"}], "->", 
       RowBox[{
        RowBox[{"PowerExp", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\"\<*\>\"", "|", "\"\</\>\""}], ")"}], " ", "PowerExp"}],
           "}"}], " ", "PowerExp"}], "->", 
        RowBox[{
         RowBox[{
          RowBox[{"Primary", "[", 
           RowBox[{"\"\<^\>\"", " ", "PowerExp"}], "]"}], " ", 
          RowBox[{"(", 
           RowBox[{"Right", " ", "associative"}], ")"}], " ", "Primary"}], "->", 
         RowBox[{
          RowBox[{"NUMBER", "|", "IDENTIFIER", "|", 
           RowBox[{"\"\<(\>\"", " ", "Expression", " ", "\"\<)\>\""}], "|", 
           RowBox[{
           "IDENTIFIER", " ", "\"\<(\>\"", " ", "ArgList", " ", "\"\<)\>\""}],
            "|", 
           
           RowBox[{"\"\<{\>\"", " ", "ArgList", " ", "\"\<}\>\"", " ", 
            "ArgList"}]}], "->", 
          RowBox[{
           RowBox[{"Expression", " ", 
            RowBox[{"{", 
             RowBox[{"\"\<,\>\"", " ", "Expression"}], "}"}]}], "|", 
           "Empty"}]}]}]}]}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ParseTokens", "[", "tokens_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"pos", "=", "1"}], ",", "currentToken", ",", "eat", ",", 
        "peek", ",", "parseExpression", ",", "parseEquation", ",", 
        "parseAddExp", ",", "parseMulExp", ",", "parsePowerExp", ",", 
        "parseUnaryExp", ",", "parsePrimary", ",", "parseArgs", ",", 
        "parseList"}], "}"}], ",", 
      RowBox[{
       RowBox[{"currentToken", ":=", 
        RowBox[{"tokens", "[", 
         RowBox[{"[", "pos", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"peek", "[", "]"}], ":=", 
        RowBox[{"tokens", "[", 
         RowBox[{"[", "pos", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"eat", "[", "type_", "]"}], ":=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"currentToken", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "==", "type"}], ",", 
          RowBox[{
           RowBox[{"pos", "++"}], ";", "\[IndentingNewLine]", "True"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\<Error: Expected \>\"", ",", "type", 
             ",", "\"\< but found \>\"", ",", 
             RowBox[{"currentToken", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", "False"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Entry", " ", "point"}], "*)"}], 
       RowBox[{
        RowBox[{"parseExpression", "[", "]"}], ":=", 
        RowBox[{"parseEquation", "[", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Equation", ":", "a"}], "=", "b"}], "*)"}], 
       RowBox[{
        RowBox[{"parseEquation", "[", "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"left", ",", "right"}], "}"}], ",", 
          RowBox[{
           RowBox[{"left", "=", 
            RowBox[{"parseAddExp", "[", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"currentToken", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "==", "\"\<EQUALS\>\""}], ",", 
             
             RowBox[{
              RowBox[{"eat", "[", "\"\<EQUALS\>\"", "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"right", "=", 
               RowBox[{"parseAddExp", "[", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"\"\<Equation\>\"", ",", "left", ",", "right"}], 
               "}"}]}], ",", "left"}], "]"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"parseAddExp", "[", "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"node", ",", "right", ",", "op"}], "}"}], ",", 
          RowBox[{
           RowBox[{"node", "=", 
            RowBox[{"parseMulExp", "[", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<PLUS\>\"", ",", "\"\<MINUS\>\""}], "}"}], ",", 
               RowBox[{"currentToken", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
             RowBox[{
              RowBox[{"op", "=", 
               RowBox[{"currentToken", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
              
              RowBox[{"eat", "[", 
               RowBox[{"currentToken", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"right", "=", 
               RowBox[{"parseMulExp", "[", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"node", "=", 
               RowBox[{"{", 
                
                RowBox[{"\"\<BinaryOp\>\"", ",", "op", ",", "node", ",", 
                 "right"}], "}"}]}], ";"}]}], "]"}], ";", 
           "\[IndentingNewLine]", "node"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"parseMulExp", "[", "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"node", ",", "right", ",", "op"}], "}"}], ",", 
          RowBox[{
           RowBox[{"node", "=", 
            RowBox[{"parsePowerExp", "[", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"While", "[", 
            RowBox[{"True", ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"MemberQ", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"\"\<STAR\>\"", ",", "\"\<SLASH\>\""}], "}"}], ",", 
                 
                 RowBox[{"currentToken", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
               RowBox[{
                RowBox[{"op", "=", 
