Cell[TextData[{
 "In the spinor Lagrangian Lg[], below, M is the mass of the \[CapitalPsi]16 \
field [A.K.A., wave function characterizing the Universe(s) of  masses  \
\[PlusMinus]M ];  \n",
 StyleBox["TODO:  prove ",
  FontSize->16],
 StyleBox["Universe(s) of  masses  \[PlusMinus]M are created in pairs!",
  FontSize->16,
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["\n",
  FontSize->36,
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 "K is used to track spin coefficients; K == 1;  set K\[Rule]1 to employ \
[total] covariant derivative of spinors; put K\[Rule]0 to ignore"
}], "Text",
