              RowBox[{"ginv", ".", "Rie\[CapitalGamma]"}], "]"}], " ", ",", 
             "ass"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"G", "=", 
           RowBox[{"ParallelTable", "[", 
            RowBox[{
