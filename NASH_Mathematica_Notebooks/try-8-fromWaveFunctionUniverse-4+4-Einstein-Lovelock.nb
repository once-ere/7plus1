Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "spinCoefficients", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"spinCoefficients", "[", "eI\[Nu]_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"e\[Nu]I", ",", "w", ",", "r", ",", "s"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Dimensions", "[", "eI\[Nu]", "]"}], "!=", 
        RowBox[{"{", 
         RowBox[{"8", ",", "8"}], "}"}]}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Det", "[", "eI\[Nu]", "]"}], "==", "0"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"e\[Nu]I", "=", 
      RowBox[{
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{"Inverse", "[", "eI\[Nu]", "]"}], ",", "constraintVars"}], 
        "]"}], 
       StyleBox["/.",
        Background->RGBColor[1., 1., 0.04139772640573739]], 
       StyleBox["subsDefects",
        Background->RGBColor[1., 1., 0.04139772640573739]]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"w", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"FullSimplify", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"D", "[", 
                   RowBox[{
                    RowBox[{"eI\[Nu]", "[", 
                    RowBox[{"[", 
                    RowBox[{"I1", ",", "\[Nu]1"}], "]"}], "]"}], ",", 
                    RowBox[{"X", "[", 
                    RowBox[{"[", "\[Mu]1", "]"}], "]"}]}], "]"}], "*", 
                  RowBox[{"e\[Nu]I", "[", 
                   RowBox[{"[", 
                    RowBox[{"\[Nu]1", ",", "Jprime"}], "]"}], "]"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"\[Nu]1", ",", "1", ",", 
                   RowBox[{"Length", "[", "e\[Nu]I", "]"}]}], "}"}]}], "]"}], 
               "-", 
               RowBox[{"Sum", "[", "   ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"eI\[Nu]", "[", 
                   RowBox[{"[", 
                    RowBox[{"I1", ",", "\[Rho]"}], "]"}], "]"}], "*", 
                  RowBox[{"\[CapitalGamma]", "[", 
                   RowBox[{"[", 
                    RowBox[{"\[Rho]", ",", "\[Mu]1", ",", "\[Nu]1"}], "]"}], 
                   "]"}], "*", 
                  RowBox[{"e\[Nu]I", "[", 
                   RowBox[{"[", 
                    RowBox[{"\[Nu]1", ",", "Jprime"}], "]"}], "]"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"\[Nu]1", ",", "1", ",", 
                   RowBox[{"Length", "[", "e\[Nu]I", "]"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"\[Rho]", ",", "1", ",", 
                   RowBox[{"Length", "[", "X", "]"}]}], "}"}]}], "]"}]}], ",",
               "constraintVars"}], "]"}], "/.", "subsDefects"}], ",", 
           RowBox[{"{", 
            RowBox[{"I1", ",", "1", ",", 
             RowBox[{"Length", "[", "eI\[Nu]", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"Jprime", ",", "1", ",", 
             RowBox[{"Length", "[", "e\[Nu]I", "]"}]}], "}"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Mu]1", ",", "1", ",", 
          RowBox[{"Length", "[", "X", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Assert", "[", 
      RowBox[{
       RowBox[{"Dimensions", "[", "w", "]"}], "==", 
       RowBox[{"{", 
        RowBox[{"8", ",", "8", ",", "8"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "w", "]"}], ";"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.9732452841676693`*^9, 3.973245481619093*^9}, {
