Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "con", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"con", "[", 
   RowBox[{"g_", ",", 
    RowBox[{"ass_", ":", 
     RowBox[{"{", "}"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t", ",", "\[CapitalGamma]\[CapitalGamma]", ",", "ginv"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ginv", "=", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"Inverse", "[", "g", "]"}], ",", "ass"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[CapitalGamma]\[CapitalGamma]", "=", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}], "*", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"ginv", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "s"}], "]"}], "]"}], ")"}], "*", 
              "\[IndentingNewLine]", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"s", ",", "j"}], "]"}], "]"}], ",", 
                  RowBox[{"X", "[", 
                   RowBox[{"[", "k", "]"}], "]"}]}], " ", "]"}], "+", 
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"s", ",", "k"}], "]"}], "]"}], ",", 
                  RowBox[{"X", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], " ", "]"}], "-", 
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"g", "[", 
                   RowBox[{"[", 
                    RowBox[{"j", ",", "k"}], "]"}], "]"}], ",", 
                  RowBox[{"X", "[", 
                   RowBox[{"[", "s", "]"}], "]"}]}], " ", "]"}]}], ")"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"s", ",", "1", ",", "DIM8"}], "}"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "DIM8"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "DIM8"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", "DIM8"}], "}"}]}], "]"}], " ", ",", 
        "ass"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"{", 
       RowBox[{"ginv", ",", "\[CapitalGamma]\[CapitalGamma]"}], "}"}], 
      "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.5839347487763696`*^9, 3.5839348090080757`*^9}, {
