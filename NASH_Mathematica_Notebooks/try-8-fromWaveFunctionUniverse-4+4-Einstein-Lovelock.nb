Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MatrixForm", "[", "#", "]"}], "&"}], "/@", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"eA\[Alpha]", ",", "e\[Alpha]A", ",", 
      RowBox[{"(*", 
       RowBox[{"ginv", ",", "\[CapitalGamma]", ",", "gg", ","}], "*)"}], 
      "colVecs", ",", "rowVecs", ",", "ab", ",", "ba", ",", "r"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"gg", "=", 
       RowBox[{
        StyleBox["g4488",
         Background->RGBColor[0.7548180361638819, 1., 0.36633859769588767`]], 
        "/.", "sg"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ginv", ",", "\[CapitalGamma]"}], "}"}], "=", 
       RowBox[{"con", "[", "gg", "]"}]}], ";"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"e\[Alpha]A", "=", 
      RowBox[{
       SubsuperscriptBox["e", 
        RowBox[{"(", "A", ")"}], "\[Alpha]"], "/.", 
       SubsuperscriptBox["sge", 
        RowBox[{"(", "A", ")"}], "\[Alpha]"]}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"eA\[Alpha]", "=", 
      RowBox[{
       SubsuperscriptBox["e", "\[Alpha]", 
        RowBox[{"(", "A", ")"}]], "/.", 
       SubsuperscriptBox["sge", "\[Alpha]", 
        RowBox[{"(", "A", ")"}]]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rowVecs", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        StyleBox[
         RowBox[{"eA\[Alpha]", "[", 
          RowBox[{"[", 
           RowBox[{"b", ",", "All"}], "]"}], "]"}],
         Background->RGBColor[0.95, 0.43, 0.96, 0.33]], ",", 
        RowBox[{"{", 
         RowBox[{"b", ",", "1", ",", 
          RowBox[{"Length", "[", "eA\[Alpha]", "]"}]}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"colVecs", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        StyleBox[
         RowBox[{"e\[Alpha]A", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "b"}], "]"}], "]"}],
         Background->RGBColor[0.95, 0.43, 0.96, 0.33]], ",", 
        RowBox[{"{", 
         RowBox[{"b", ",", "1", ",", 
          RowBox[{"Length", "[", "e\[Alpha]A", "]"}]}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ab", "=", 
      RowBox[{
       RowBox[{"rowVecs", ".", "colVecs"}], "//", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"#", ",", "constraintVars"}], "]"}], "&"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ba", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Transpose", "[", "colVecs", "]"}], ".", 
        RowBox[{"Transpose", "[", "rowVecs", "]"}]}], "//", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"#", ",", "constraintVars"}], "]"}], "&"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"r", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "ab", "}"}], ",", 
          RowBox[{"{", "ba", "}"}]}], "}"}]}], ";"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"{", 
       RowBox[{"ab", ",", "ba"}], "}"}]}], ";", "\[IndentingNewLine]", 
     "r"}]}], "]"}]}]], "Input",
