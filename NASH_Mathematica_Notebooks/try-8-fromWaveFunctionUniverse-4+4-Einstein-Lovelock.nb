              RowBox[{"FullSimplify", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Rie\[CapitalGamma]", "[", 
                  RowBox[{"[", "\[Alpha]", "]"}], "]"}], "-", 
                 RowBox[{
                  FractionBox["1", "2"], 
                  RowBox[{"g", "[", 
                   RowBox[{"[", "\[Alpha]", "]"}], "]"}], " ", "RS"}]}], ",", 
                "ass"}], "]"}],
              CheckAbort[#, 
               Defer[#]]& ], ",", 
             RowBox[{"{", 
