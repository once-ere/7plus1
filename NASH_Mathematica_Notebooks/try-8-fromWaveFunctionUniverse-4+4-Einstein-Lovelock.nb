Cell[TextData[{
 "Some of my calculations employ \
\[OpenCurlyDoubleQuote]http://www.xact.es/download/xAct_1.2.0.tgz\
\[CloseCurlyDoubleQuote] ; also,  see \nCyril Pitrou\nInstitut d\
\[CloseCurlyQuote]Astrophysique de Paris (France)\npitrou@iap.fr\n\
http://www2.iap.fr/users/pitrou/\n\
\[OpenCurlyDoubleQuote]FriedmannLemaitreMetric_CoordinatesApproach_xCoba.nb\
\[CloseCurlyDoubleQuote]\nMyArrayComponents[expr_] := expr //ToBasis[BS] \
//ComponentArray //ToValues //ToValues //Simplify\n",
