 RowBox[{
  StyleBox[
   RowBox[{"(*", 
    RowBox[{"Christoffel", ",", " ", 
     RowBox[{"Einstein", " ", "tensor"}], ",", " ", "..."}], "*)"}], "Text"], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "rt", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
