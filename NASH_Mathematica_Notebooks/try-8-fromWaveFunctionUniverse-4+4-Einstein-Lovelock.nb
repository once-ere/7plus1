Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "makeSubstitution", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"makeSubstitution", "[", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"met", ",", "mat", ",", "t", ",", "f", ",", "p"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"met", "=", 
      RowBox[{
       RowBox[{"Flatten", "[", "g4488", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "0"}], "]"}], "]"}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"mat", "=", 
      RowBox[{"Flatten", "[", "MatrixMetric44", "]"}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"t", "=", 
      RowBox[{"Thread", "[", 
       RowBox[{"met", "\[Rule]", "mat"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"FullForm", "[", 
         RowBox[{
          RowBox[{"t", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"x0", "->", "#1"}], ",", 
            RowBox[{"x4", "->", "#2"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", 
          RowBox[{"Length", "[", "t", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"p", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Block", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"s", ",", "r", ",", "q", ",", "expr"}], "}"}], ",", 
          RowBox[{
           RowBox[{"q", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"f", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"expr", "=", 
            RowBox[{"Inactivate", "[", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", "q", ")"}], "&"}], ")"}], "]"}]}], ";", 
           RowBox[{"s", "=", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"f", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "\[Rule]", "expr"}]}], ";", 
           RowBox[{"r", "=", 
            RowBox[{
             RowBox[{"Activate", "[", 
              RowBox[{"s", "//", "Evaluate"}], "]"}], "//", "Evaluate"}]}], ";",
            "r"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", 
          RowBox[{"Length", "[", "f", "]"}]}], "}"}]}], "]"}]}], ";", 
