Cell[BoxData[
 RowBox[{
  StyleBox["constraintTrig",
   FontSize->16], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Sin", "[", 
     RowBox[{"6", "*", "H", "*", "x0"}], "]"}], ">", "0"}], "&&", 
   RowBox[{
    RowBox[{"Cos", "[", 
     RowBox[{"6", "*", "H", "*", "x0"}], "]"}], ">", "0"}], "&&", 
   RowBox[{
    RowBox[{"Csc", "[", 
     RowBox[{"6", "*", "H", "*", "x0"}], "]"}], ">", "0"}], "&&", 
   RowBox[{
    RowBox[{"Sec", "[", 
     RowBox[{"6", "*", "H", "*", "x0"}], "]"}], ">", "0"}], "&&", 
   RowBox[{
    RowBox[{"Tan", "[", 
     RowBox[{"6", "*", "H", "*", "x0"}], "]"}], ">", "0"}], "&&", 
   RowBox[{
    RowBox[{"Cot", "[", 
     RowBox[{"6", "*", "H", "*", "x0"}], "]"}], ">", "0"}], "&&", 
   RowBox[{
    RowBox[{"Sin", "[", "z", "]"}], ">", "0"}], "&&", 
   RowBox[{
    SqrtBox[
     RowBox[{"Sin", "[", "z", "]"}]], ">", "0"}], "&&", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"Sin", "[", "z", "]"}], 
     RowBox[{"3", "/", "2"}]], ">", "0"}], "&&", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"Sin", "[", "z", "]"}], 
     RowBox[{"1", "/", "2"}]], ">", "0"}], "&&", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"Sin", "[", "z", "]"}], 
     RowBox[{
      RowBox[{"-", "3"}], "/", "2"}]], ">", "0"}], "&&", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"Sin", "[", "z", "]"}], 
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}]], ">", "0"}], "&&", 
   RowBox[{
    RowBox[{"Cot", "[", "z", "]"}], ">", "0"}], "&&", 
   RowBox[{
    SqrtBox[
     RowBox[{"Cot", "[", "z", "]"}]], ">", "0"}], "&&", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"Cot", "[", "z", "]"}], 
     RowBox[{"3", "/", "2"}]], ">", "0"}], "&&", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"Cot", "[", "z", "]"}], 
     RowBox[{"1", "/", "2"}]], ">", "0"}], "&&", 
   RowBox[{
    RowBox[{"Tan", "[", "z", "]"}], ">", "0"}], "&&", 
   RowBox[{
    RowBox[{"Sec", "[", "z", "]"}], ">", "0"}], "&&", 
   RowBox[{
    SqrtBox[
     RowBox[{"Csc", "[", "z", "]"}]], ">", "0"}], "&&", 
   RowBox[{
    RowBox[{"Csc", "[", "z", "]"}], ">", "0"}]}]}]], "Input",
