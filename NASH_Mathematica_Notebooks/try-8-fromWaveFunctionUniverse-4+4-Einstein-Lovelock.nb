Cell[BoxData[
 RowBox[{
  RowBox[{"makeSubstitution", "[", 
   RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t", ",", "f", ",", "p"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"t", "=", 
      RowBox[{"Thread", "[", 
       RowBox[{"a", "\[Rule]", "b"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"FullForm", "[", 
         RowBox[{
          RowBox[{"t", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"x0", "->", "#1"}], ",", 
            RowBox[{"x4", "->", "#2"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", 
          RowBox[{"Length", "[", "t", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"p", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Block", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"s", ",", "r", ",", "q", ",", "expr"}], "}"}], ",", 
          RowBox[{
           RowBox[{"q", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"f", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"expr", "=", 
            RowBox[{"Inactivate", "[", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", "q", ")"}], "&"}], ")"}], "]"}]}], ";", 
           RowBox[{"s", "=", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"f", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "\[Rule]", "expr"}]}], ";", 
           RowBox[{"r", "=", 
            RowBox[{
             RowBox[{"Activate", "[", 
              RowBox[{"s", "//", "Evaluate"}], "]"}], "//", "Evaluate"}]}], ";",
            "r"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", 
          RowBox[{"Length", "[", "f", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "p", "]"}], ";"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
