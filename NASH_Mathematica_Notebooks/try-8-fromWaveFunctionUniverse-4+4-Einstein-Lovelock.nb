       RowBox[{"{", "}"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "t", ",", "\[CapitalGamma]\[CapitalGamma]", ",", 
        "Ricci\[CapitalGamma]", ",", "Rie\[CapitalGamma]", ",", "RS", ",", 
        "G", ",", "ginv"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", "Now", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"t", "=", 
        RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"ginv", "=", 
           RowBox[{"FullSimplify", "[", 
            RowBox[{
             RowBox[{"Inverse", "[", "g", "]"}], ",", "ass"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"\[CapitalGamma]\[CapitalGamma]", "=", 
           RowBox[{"FullSimplify", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
