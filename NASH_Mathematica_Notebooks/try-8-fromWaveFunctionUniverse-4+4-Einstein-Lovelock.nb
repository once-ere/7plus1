               RowBox[{"Length", "[", "Rie\[CapitalGamma]", "]"}]}], "}"}]}], 
            "]"}]}], ";"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "t", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "Now", "]"}], ";", "\[IndentingNewLine]", 
