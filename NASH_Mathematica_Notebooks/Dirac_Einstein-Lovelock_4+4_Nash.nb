 CellChangeTimes->{{4.000190917632208*^9, 4.000190921860876*^9}},
 FontSize->14,ExpressionUUID->"756860d0-66ca-334e-bb3a-e52cf543a074"],

Cell[CellGroupData[{

Cell["origin", "Section",
 CellChangeTimes->{{4.000373893016239*^9, 4.000373893016239*^9}, 
   4.000374161142809*^9},ExpressionUUID->"02c2b57b-ae24-1548-9a55-\
da8193cc15b3"],

Cell[TextData[{
 StyleBox["The origin of this calculation has its roots in \
\[OpenCurlyDoubleQuote]A Remarkable Representation of the 3+2 de Sitter Group\
\[CloseCurlyDoubleQuote] by P.A.M.Dirac, J.Math.Phys.4,901\[Dash]909 (1963),\n\
in which Dirac defines a prurely real irreducible representation of the \
covering of SO(3,2). \nOver the eons we extended this to  real irreducible \
representations of the covering of SO(3,3),\n8 \[Times]8 real irreducible \
representations of the covering of SO(4,4) = Spin(4,4),   and\n16 \[Times]16 \
real irreducible representations of Pin(4,4).\n\nWhy  are there 3 space \
dimensions and  1  time dimension? \n\[OpenCurlyQuote]Hurwitz\
\[CloseCurlyQuote]s theorem\[CloseCurlyQuote]  proves  that  there  are  only \
 4 normed division algebras (\:2016XY\:2016=\:2016X\:2016\:2016Y\:2016) over \
the real numbers, \nwhich, up to isomorphism,  are   the  \n1-dimensional \
(over \[DoubleStruckCapitalR]) real numbers  \[DoubleStruckCapitalR],\nthe   \
2-dim  complex numbers,\nthe   4-dim   quaternions, \nand the  8-dim   \
octonions.\n\nConsider the ",
  FontColor->GrayLevel[0]],
 StyleBox["alternative",
  FontSlant->"Italic",
  FontColor->GrayLevel[0]],
 StyleBox["  8-dim   octonions; \nwe  are curious about crossing  black hole \
horizons without  altering the spacetime signature,  \nso we focus on  the   \
split   octonions,    with   4   space    dimensions   and   4   time   \
dimensions.\n4   time   dimensions is excessive, so we restrict our attention \
to spacetimes in which 3 of the 4  time dimensions\nexponentially deflate at \
the beginning of the universe\n(our claim/hope: this  exponentially deflates \
the influence/effects of closed timelike curves on spacetime events).\n\n\
Below, Dirac\[CloseCurlyQuote]s real  4 \[Times]4  gamma matrices have been \
extended into  this paper\[CloseCurlyQuote]s  \neight + eight  real 8 \
\[Times]8  real  ( \[Tau]  ,  ",
  FontColor->GrayLevel[0]],
 StyleBox[" ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Tau]", "-"], TraditionalForm]],
  FontColor->GrayLevel[0],ExpressionUUID->
  "68021130-9fba-a347-a561-972495344e89"],
 StyleBox["   )  ",
  FontColor->GrayLevel[0]],
 StyleBox["and  ",
  FontColor->GrayLevel[0]],
 StyleBox["\nthe real 16 \[Times]16",
  FontColor->GrayLevel[0]],
 StyleBox["  ",
  FontColor->GrayLevel[0],
  Background->None],
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["T16", "A"], "[", "A1", "]"}]], "Text",
  CellChangeTimes->{{3.5345993006151867`*^9, 3.5345993546224813`*^9}, 
    3.964516827929006*^9, {3.964517159084221*^9, 3.964517161631215*^9}, 
    3.968993300184065*^9, 3.970485561189939*^9},
  FontSize->18,
  FontColor->GrayLevel[0],
  Background->None,ExpressionUUID->"3043c022-9d8d-e946-9cf1-9aa97ac6a9d5"],
 StyleBox[" matrices, \n",
  FontColor->GrayLevel[0],
  Background->None],
 Cell[BoxData[
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["T16", "A"], "[", "A1", "]"}], "=", " ", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{
           OverscriptBox["\[Tau]", "_"], "[", "A1", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Tau]", "[", "A1", "]"}], ",", "0"}], "}"}]}], "}"}], 
      "]"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"A1", ",", "0", ",", " ", "7"}], "}"}]}], " ", "]"}]], "Text",
  CellChangeTimes->{{3.5345993006151867`*^9, 3.5345993546224813`*^9}, 
    3.964516827929006*^9, {3.964517159084221*^9, 3.964517161631215*^9}, 
    3.968993300184065*^9, 3.970485561189939*^9},
  FontSize->18,
  FontColor->GrayLevel[0],
  Background->None,ExpressionUUID->"a7716968-5893-7949-a75f-ba82acfa743c"],
 StyleBox["\n\nin order to simply incorporate and \ncouple the ",
  FontColor->GrayLevel[0]],
 StyleBox["WAVE FUNCTION OF the UNIVERSE",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox[" to Gravity\nvia a term resembling\n     ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Psi]", "\[Dagger]"], TraditionalForm]],
  FontColor->GrayLevel[0],ExpressionUUID->
  "384dabb4-0734-484c-992c-7959597be9d2"],
 StyleBox["  ",
  FontColor->GrayLevel[0]],
 StyleBox[" (mass matrix for universe) \[Psi]  .\n \nHere we use ",
  FontColor->GrayLevel[0]],
 StyleBox["spacetime coordinates",
  FontColor->RGBColor[0.4, 0.6, 1]],
 StyleBox[" that are selected so that we are somewhat consistent with the \n",
  
  FontColor->GrayLevel[0]],
 StyleBox["xact libraries",
  FontColor->RGBColor[0.14, 0.8, 0.14]],
 StyleBox[",\n(which we employ, in other included notebooks, in order to \
calculate the Einstein-Lovelock tensors):\n",
  FontColor->GrayLevel[0]],
 StyleBox["Cartestian coordinates:\n",
  FontColor->RGBColor[0.4, 0.6, 1],
  Background->None],
 StyleBox["  ",
  FontColor->GrayLevel[0]],
 StyleBox["x0",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox[" = hidden space (a small circle); ",
  FontColor->GrayLevel[0]],
 StyleBox["x1, x2, x3",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["  are the usual 3-space coords; \n",
  FontColor->GrayLevel[0]],
 StyleBox["x4",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox[" = time coord, \nand  ",
  FontColor->GrayLevel[0]],
 StyleBox["x5, x6, x7",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["= superluminal ",
  FontColor->GrayLevel[0]],
 StyleBox["deflating",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox[" time coords}.\n\n\nThe split Octonion   algebra   carries   basic \
   8-component   representations of   ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    RowBox[{"SO", 
     RowBox[{"(", 
      RowBox[{"4", ",", 
       RowBox[{"4", ";", " ", "\[DoubleStruckCapitalR]"}]}], ")"}]}], "_"], 
   TraditionalForm]],ExpressionUUID->"68a5377a-e16a-4a6d-89c3-7ef3dc9dd549"],
 StyleBox["  (left-spinor,   right-spinor   and   vector),   which   are   \
equivalent  [Cartan\[CloseCurlyQuote]s   triality].\n\nHere  we  find a \
solution of the Einstein-Lovelock vacuum field equations on a spacetime M8 ,  \
whose tangent bundle has\n ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    RowBox[{"SO", 
     RowBox[{"(", 
      RowBox[{"4", ",", 
       RowBox[{"4", ";", " ", "\[DoubleStruckCapitalR]"}]}], ")"}]}], "_"], 
   TraditionalForm]],ExpressionUUID->"61c45a45-ba0e-4bbf-a329-9e6d8381ea0e"],
 StyleBox[" \[TildeTilde] Spin(4,4;\[DoubleStruckCapitalR])\nas iso group,  \
and in which\n3 of the 4 space dimensions ",
  FontColor->GrayLevel[0]],
 StyleBox["superluminally INFLATE",
  FontColor->RGBColor[0.4, 0.6, 1]],
 StyleBox[",\n3 of the 4 time dimensions ",
  FontColor->GrayLevel[0]],
 StyleBox["superluminally DEFLATE",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox[" (no problems with causality in the surviving time dimension, \
although  I am sure that the 3 deflated time dimensions are interesting),\n\
and the 4th space dim, x0,  curls up into a ring (",
  FontColor->GrayLevel[0]],
 StyleBox["hence a particle whose wave function penetrates  this ring \
acquires a mass contribution",
  FontColor->RGBColor[0.67, 0.54, 0.42]],
 StyleBox[").\n\n\nIn passing we remark that an analogous construction may be \
defined on  an octonion space of ",
  FontColor->GrayLevel[0]],
 StyleBox["one time dimension and seven space dimensions",
  FontColor->RGBColor[0.4, 0.6, 1]],
 StyleBox[", if the reader is allergic to multiple time dimensions (and \
employ the octonions rather than the split-octonions).  \n\n",
  FontColor->GrayLevel[0]],
 StyleBox["Unsolved problem 1",
  FontColor->RGBColor[0.4, 0.6, 1]],
 StyleBox[" (of many): All particles are initially massless in the standard \
model, due to gauge invariance under the symmetry group\nSU(3)  \
\[CircleTimes]   ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"SU", "(", "2", ")"}], "L"], TraditionalForm]],ExpressionUUID->
  "0131c39c-1900-4a74-980b-c8010580ad50"],
 "  \[CircleTimes] ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SubscriptBox[
     RowBox[{"U", "(", "1", ")"}], "Y"]}], TraditionalForm]],ExpressionUUID->
  "838fd744-ca15-4641-a620-0ecf844c91e5"],
 StyleBox[";  \nThe photon should remain massless after the Higgs field \
acquires a vacuum expectation value (spontaneous symmetry breaking).\n\n\n\
This notebook is distributed as free software under the GNU General Public \
License.They are distributed in the hope that they will  be useful,but \
WITHOUT ANY WARRANTY;without even the implied warranty of MERCHANTABILITY or \
FITNESS FOR A PARTICULAR PURPOSE.See the GNU GPL for more details.\n\nPlease  \
cite  this  work  and this web page if you use it.\n",
  FontColor->GrayLevel[0]]
}], "Text",
 CellChangeTimes->{{3.8726702134099073`*^9, 3.872670317841343*^9}, {
   3.872670362491787*^9, 3.8726703645749893`*^9}, {3.872670629792283*^9, 
