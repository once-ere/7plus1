Cell[CellGroupData[{

Cell[TextData[{
 "MyArrayComponents: ",
 StyleBox["Cyril Pitrou\nInstitut d\[CloseCurlyQuote]Astrophysique de Paris \
(France)\npitrou@iap.fr\nhttp://www2.iap.fr/users/pitrou/\n\
\[OpenCurlyDoubleQuote]FriedmannLemaitreMetric_CoordinatesApproach_xCoba.nb\
\[CloseCurlyDoubleQuote]\nMyArrayComponents[expr_] := expr //ToBasis[BS] \
//ComponentArray //ToValues //ToValues //Simplify",
  FontSize->12]
}], "Section",
 CellChangeTimes->{{4.0003745861435585`*^9, 
  4.000374588123377*^9}},ExpressionUUID->"12fb7cb2-f14e-4604-a5e1-\
832461d8df1e"],

Cell["Let us wrap all these steps into one single function", "Text",ExpressionUUID->"212f260b-8be8-4e4b-b965-ff9f543d1aa4"],

Cell[BoxData[
 RowBox[{"Clear", "[", "MyArrayComponents", "]"}]], "Input",
 CellLabel->"In[52]:=",ExpressionUUID->"73f3c4dc-d305-4792-9fee-f203842234ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MyArrayComponents", "[", "expr_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"expr", "//", 
       RowBox[{"ToBasis", "[", "chartM8", "]"}]}], "//", "ComponentArray"}], "//",
      "ToValues"}], "//", "ToValues"}], "//", "Simplify"}]}]], "Input",
 Background->RGBColor[1., 0.7647058823529411, 0.25098039215686274`],
 CellLabel->"In[53]:=",ExpressionUUID->"d2ff44f3-9d0e-4a43-a97a-eab80c112156"],

Cell[BoxData[
 RowBox[{
  RowBox[{"My4ArrayComponents", "[", "expr_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"expr", "//", 
         RowBox[{"ToBasis", "[", "chartM8", "]"}]}], "//", "ComponentArray"}],
        "//", "ToValues"}], "//", "ToValues"}], "//", "ToValues"}], "//", 
    "ToValues"}], "//", "Simplify"}]}]], "Input",
 Background->RGBColor[1., 0.7647058823529411, 0.25098039215686274`],
 CellLabel->"In[54]:=",ExpressionUUID->"a3323212-be44-46e7-9786-d888a259eacd"]
}, Open  ]],

