Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "rawSets", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rawSets", "[", 
   RowBox[{"l_", ",", "f_", ",", 
    RowBox[{"o_", ":", "0"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t", ",", "h"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"t", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Cases", "[", "\n", "   ", 
         RowBox[{
          RowBox[{"l", "[", 
           RowBox[{"[", "j", "]"}], "]"}], ",", " ", "\n", 
          RowBox[{
           RowBox[{
            RowBox[{"h_Symbol", "[", "n_Integer", "]"}], " ", "/;", " ", 
            RowBox[{"StringEndsQ", "[", 
             RowBox[{
              RowBox[{"SymbolName", "[", "h", "]"}], ",", " ", "f"}], "]"}]}],
            "  ", ":>", " ", 
           RowBox[{"n", "+", "o"}]}], ",", " ", "\n", "    ", "Infinity", ",",
           " ", "\n", "    ", 
          RowBox[{"Heads", " ", "->", " ", "True"}]}], "\n", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", 
          RowBox[{"Length", "[", "l", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "t", "]"}], ";"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellChangeTimes->{
  3.978629231673209*^9, 3.978629472199901*^9, {3.9786295386192617`*^9, 
   3.9786295480868473`*^9}, 3.97862979070006*^9, {3.978635574787566*^9, 
   3.9786355797994137`*^9}, {3.978640178822073*^9, 3.978640193838654*^9}, 
