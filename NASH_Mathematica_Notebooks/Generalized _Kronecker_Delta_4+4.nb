                    RowBox[{"xAct`xTensor`Private`manifold", ",", 
                    "xAct`xTensor`Private`dim", ",", 
                    RowBox[{"Append", "[", 
                    
                    RowBox[{"xAct`xTensor`Private`indices", ",", 
                    "xAct`xTensor`Private`ultraindex"}], "]"}], ",", 
                    "xAct`xTensor`Private`options"}], "]"}]}], ")"}]}]}, {
                   " "}, {
                    RowBox[{
                    RowBox[{"DefManifold", "[", 
                    RowBox[{"xAct`xTensor`Private`manifold_", ",", 
                    RowBox[{"{", 
                    
                    RowBox[{"xAct`xTensor`Private`integers___Integer", "?", 
                    "Positive"}], "}"}], ",", 
                    "xAct`xTensor`Private`indices_List", ",", 
                    
                    RowBox[{
                    "xAct`xTensor`Private`options___", "?", "OptionQ"}]}], 
                    "]"}], ":=", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"** DefMainfold (legacy): CNumbers \"", "<>", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"{", "xAct`xTensor`Private`integers", "}"}], 
                    "]"}], "<>", "\" only used to compute dimension.\""}], 
                    "]"}], ";", 
                    RowBox[{"DefManifold", "[", 
                    RowBox[{"xAct`xTensor`Private`manifold", ",", 
                    RowBox[{"Length", "[", 
                    RowBox[{"{", "xAct`xTensor`Private`integers", "}"}], 
                    "]"}], ",", "xAct`xTensor`Private`indices", ",", 
                    "xAct`xTensor`Private`options"}], "]"}]}], ")"}]}]}, {
                   " "}, {
                    RowBox[{
                    RowBox[{"DefManifold", "[", 
                    RowBox[{"xAct`xTensor`Private`supermanifold_", ",", 
                    RowBox[{"xAct`xTensor`Private`submanifolds", ":", 
                    RowBox[{"_List", "|", "_CartesianProduct"}]}], ",", 
                    "xAct`xTensor`Private`indices_List", ",", 
                    
                    RowBox[{
                    "xAct`xTensor`Private`options___", "?", "OptionQ"}]}], 
                    "]"}], ":=", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"DefManifold", "[", 
                    RowBox[{"xAct`xTensor`Private`supermanifold", ",", 
                    RowBox[{"Plus", "@@", 
                    
                    RowBox[{"DimOfManifold", "/@", 
                    "xAct`xTensor`Private`submanifolds"}]}], ",", 
                    "xAct`xTensor`Private`indices", ",", 
                    "xAct`xTensor`Private`options"}], "]"}], ";", 
                    RowBox[{"SplitManifold", "[", 
                    
