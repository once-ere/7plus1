Cell["\<\
\[OpenCurlyDoubleQuote]maple-output.py\[CloseCurlyDoubleQuote]:
import textwrap
filename = \"maple-output.txt\"
maple_long _string = \"paste maple string here\"
# Wraps the text and joins with newlines
with open (filename, \"w\") as f :
     f . write (\"\\n\" . join (textwrap . wrap (maple_long _string, width = \
80)))\
\>", "Text",
