Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"YZ12", "[", 
     RowBox[{"z", ",", "t"}], "]"}], "\[Equal]", 
    RowBox[{"-", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"M", " ", 
        SqrtBox[
         RowBox[{"Sin", "[", "z", "]"}]]}]], 
      RowBox[{"3", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "3"]}], " ", 
          SqrtBox[
           RowBox[{
            RowBox[{"-", "9"}], "-", 
            RowBox[{"36", " ", "C4"}], "+", 
            SuperscriptBox["M", "2"]}]], " ", 
          RowBox[{"(", 
           RowBox[{
