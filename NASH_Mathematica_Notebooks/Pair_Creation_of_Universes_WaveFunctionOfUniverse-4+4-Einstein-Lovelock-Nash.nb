  StyleBox[" ",
   FontSize->36], 
  StyleBox[",",
   FontSize->36], "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"where", "    ", 
     FormBox[
      StyleBox[
       SubscriptBox["\[Omega]", 
        RowBox[{
         RowBox[{"(", "B", ")"}], 
         RowBox[{"(", "A", ")"}], " "}]],
       FontSize->24],
      TraditionalForm]}], " ", "=", " ", 
    RowBox[{"-", 
     FormBox[
      StyleBox[
