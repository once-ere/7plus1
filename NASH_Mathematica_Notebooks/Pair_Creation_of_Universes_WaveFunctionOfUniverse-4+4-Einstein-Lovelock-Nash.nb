Cell[BoxData[{
 StyleBox[
  RowBox[{
   RowBox[{"?", 
    RowBox[{"SOURCE", " ", "terms", " ", 
     SuperscriptBox["TU", "\[Mu]\[Nu]"], " ", "for", "  ", 
     SubscriptBox["g", 
      RowBox[{"\[Alpha]", " ", "\[Beta]"}]], "  ", "come", " ", "from", 
     " ", "\"\<Universes' Wave Function \[CapitalPsi]16 Lagrangian\>\""}]}], 
   " ", "\[IndentingNewLine]"}],
  FontSize->36,
  FontColor->GrayLevel[0]], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{
    FractionBox["1", "\[Kappa]"], 
    SuperscriptBox["TU", "\[Mu]\[Nu]"]}], " ", 
   StyleBox["\[Congruent]",
    FontSize->24], " ", 
   RowBox[{
    FractionBox["1", 
     SqrtBox[
      RowBox[{"Det", "[", 
       SubscriptBox["g", "\[Alpha]\[Beta]"], "]"}]]], " ", 
    RowBox[{
     FractionBox["\[PartialD]", 
      RowBox[{"\[PartialD]", " ", 
       SubscriptBox["g", "\[Mu]\[Nu]"]}]], 
     RowBox[{
      StyleBox["(",
       FontSize->18], "  ", 
      RowBox[{
       SqrtBox[
        RowBox[{"Det", "[", 
         SubscriptBox["g", "\[Alpha]\[Beta]"], "]"}]], " ", 
       "Lagrangian\[CapitalPsi]16"}], 
      StyleBox[")",
       FontSize->24]}]}]}]}],
  FontColor->GrayLevel[0]], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
