Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "spinCoefficients", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"spinCoefficients", "[", "eI\[Nu]_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"e\[Nu]I", ",", "w", ",", "r", ",", "s"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Dimensions", "[", "eI\[Nu]", "]"}], "!=", 
        RowBox[{"{", 
         RowBox[{"8", ",", "8"}], "}"}]}], ",", 
