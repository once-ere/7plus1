Cell[CellGroupData[{

Cell[TextData[{
 "For the split orthogonal group Spin(4,4) and its associated Lie algebra, \
there exist three fundamentally equivalent 8-dimensional representations:\n1. \
The vector representation V\n2. The type-1 spinor representation S+ (or S1), \
positive chirality\n3. The type-2 spinor representation S\[Minus] (or S2), \
negative chirality\nThese representations are related by outer automorphisms \
of Spin(4,4). All three representations have the same dimension: dim(V) = \
dim(S1) = dim(S2) = 8 \nThis is unique to dimension 8 and forms the basis of \
triality: Cartan, E. (1925). La th\.b4eorie des spineurs. Hermann, Paris.\n\n\
metric-preserving transformations;  find  automorphism \[Sigma]g  \
\[LongLeftRightArrow] ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]g", 
    RowBox[{"   ", "A"}], "a"], TraditionalForm]],ExpressionUUID->
  "908e71d1-ca8b-1e4b-be71-87c39afd26ed"],
 "\n\[Sigma].\[Sigma]g == Transpose[",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Sigma]g", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "c6fc288f-f605-5545-8e95-662c7f5f09d8"],
 "].g\n\[Sigma] == Transpose[",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Sigma]g", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "6bc614c0-6710-6544-af08-b23cf910a7ee"],
 "].g.",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Sigma]g", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "61e81057-3a55-4f42-92ee-e634c447c05c"],
 "\n",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    RowBox[{"(", "\[Sigma]g", ")"}], 
    RowBox[{"    ", "A"}], "a"], TraditionalForm]],ExpressionUUID->
  "b54051cd-2e19-9b45-bf4f-6617d4dba52a"],
 "  \[Congruent] ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]g", 
    RowBox[{"   ", "A"}], "a"], TraditionalForm]],ExpressionUUID->
  "4389ec42-7825-564d-bd23-7e08df0d756b"],
 "\n",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    RowBox[{"(", 
     SuperscriptBox["\[Sigma]g", 
      RowBox[{"-", "1"}]], ")"}], 
    RowBox[{"   ", "a"}], "A"], TraditionalForm]],ExpressionUUID->
  "f84f80f9-60e4-0343-b67f-d274459c951c"],
 "  \[Congruent] ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]g", 
    RowBox[{"    ", "a"}], "A"], TraditionalForm]],ExpressionUUID->
  "294525c7-fb49-1e49-a3da-0ae43542f700"],
 "    ;   ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    RowBox[{"(", 
     RowBox[{"Transpose", "[", 
      FormBox[
       SuperscriptBox["\[Sigma]g", 
        RowBox[{"-", "1"}]],
       TraditionalForm], "]"}], ")"}], 
    RowBox[{"   ", "a"}], "A"], TraditionalForm]],ExpressionUUID->
  "9d46773a-7124-ea43-9ec7-b856b4342e12"],
 "  \[Congruent] ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]g", 
    RowBox[{" ", "a"}], 
    RowBox[{"    ", "A"}]], TraditionalForm]],ExpressionUUID->
  "b47582b8-55e8-be4d-968d-115618544192"],
 " \n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "ab"], TraditionalForm]],ExpressionUUID->
  "42d5619a-48ed-2c40-8acc-9c41f22b874e"],
 " ==  ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]g", 
    RowBox[{" ", "a"}], 
    RowBox[{"    ", "A"}]], TraditionalForm]],ExpressionUUID->
  "b3fd9ef8-2f3b-8643-91fc-8d7d41c71562"],
 "  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"AB", " "}]], TraditionalForm]],ExpressionUUID->
  "a770aa78-f81d-4c42-88a2-f6b4dfe97488"],
 " ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]g", 
    RowBox[{"    ", "b"}], "B"], TraditionalForm]],ExpressionUUID->
  "791c700f-1713-3a4a-b3bf-917af5224c3d"],
 "\n\n"
}], "Section",
