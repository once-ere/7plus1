     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"2", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"H", " ", "x0"}], "]"}]}]}], ")"}], 
     RowBox[{"1", "/", "3"}]], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       RowBox[{"2", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"2", " ", "H", " ", "x0"}], "]"}]}]}], ")"}], 
     RowBox[{"1", "/", "3"}]]}], 
   SuperscriptBox[
    RowBox[{"Sin", "[", 
