Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Non", "-", "recursive"}], ",", 
    RowBox[{"single", "-", 
     RowBox[{"expression", " ", "Wigner", " ", "Small"}], "-", 
     RowBox[{
      RowBox[{"d", ".", "Uses"}], " ", "the", " ", "explicit", " ", 
      "summation", " ", "formula", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Wigner", "'"}], "s", " ", "form"}], ")"}], ".", "Valid"}], " ",
       "for", " ", "arbitrary", " ", "complex", " ", "j"}]}], ",", "m", ",", 
    "mp", ",", 
    RowBox[{"beta", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
       "though", " ", "physically", " ", "meaningful", " ", "for", " ", 
        "spin"}], ")"}], ".", 
      RowBox[{"-", 
       RowBox[{"No", "'"}]}]}], 
     RowBox[{"If", "'"}], " ", "statements", " ", 
     RowBox[{"used", ".", 
      RowBox[{"-", "No"}]}], " ", "recursion", " ", 
     RowBox[{"used", ".", 
      RowBox[{"-", "Returns"}]}], " ", "a", " ", "symbolic", " ", "Sum", " ", 
     "expression", " ", "that", " ", "can", " ", "be", " ", 
     RowBox[{"differentiated", ".", 
      RowBox[{"-", "Uses"}]}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{"n", "+", "1"}], "]"}], " ", "instead", " ", "of", " ", 
     RowBox[{"Factorial", "[", "n", "]"}], " ", "for", " ", "analytic", " ", 
     RowBox[{"continuity", "."}]}]}], "*)"}], 
  RowBox[{
   RowBox[{"aiWignerSmallDRefactored", "[", 
    RowBox[{"j_", ",", "mp_", ",", "m_", ",", "beta_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"(*", "k", "*)"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "Prefactor", " ", "with", " ", "Square", " ", "Roots", " ", "of", " ", 
       "Factorials"}], "*)"}], 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"Gamma", "[", 
         RowBox[{"j", "+", "mp", "+", "1"}], "]"}], "*", 
        RowBox[{"Gamma", "[", 
         RowBox[{"j", "-", "mp", "+", "1"}], "]"}], "*", 
        RowBox[{"Gamma", "[", 
         RowBox[{"j", "+", "m", "+", "1"}], "]"}], "*", 
        RowBox[{"Gamma", "[", 
         RowBox[{"j", "-", "m", "+", "1"}], "]"}]}], "]"}], "*", 
      RowBox[{"(*", 
       RowBox[{"The", " ", "Summation", " ", "over", " ", "k"}], "*)"}], 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"(*", 
           RowBox[{
           "Alternating", " ", "sign", " ", "and", " ", "phase", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "^", 
             RowBox[{"(", 
              RowBox[{"k", "+", "mp", "-", "m"}], ")"}]}]}], "*)"}], 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"k", "+", "mp", "-", "m"}], ")"}]}], "*", 
           RowBox[{"(*", 
            RowBox[{"Trigonometric", " ", "terms"}], "*)"}], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Cos", "[", 
              RowBox[{"beta", "/", "2"}], "]"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "*", "j"}], "+", "m", "-", "mp", "-", 
              RowBox[{"2", "*", "k"}]}], ")"}]}], "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Sin", "[", 
              RowBox[{"beta", "/", "2"}], "]"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"mp", "-", "m", "+", 
              RowBox[{"2", "*", "k"}]}], ")"}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"(*", 
           RowBox[{"Denominators", ":", 
            RowBox[{
            "Gamma", " ", "functions", " ", "handle", " ", "the", " ", 
             "truncation", " ", "of", " ", "the", " ", "series"}]}], "*)"}], 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"1", "/", 
             RowBox[{"(", 
              RowBox[{"n", "!"}], ")"}]}], " ", "becomes", " ", 
            RowBox[{"1", "/", 
             RowBox[{"Gamma", "[", 
              RowBox[{"n", "+", "1"}], "]"}]}], " ", "which", " ", "is", " ", 
            "0", " ", "for", " ", "negative", " ", "integers"}], "*)"}], 
          RowBox[{
           RowBox[{"Gamma", "[", 
            RowBox[{"j", "-", "mp", "-", "k", "+", "1"}], "]"}], "*", 
           RowBox[{"Gamma", "[", 
            RowBox[{"j", "+", "m", "-", "k", "+", "1"}], "]"}], "*", 
           RowBox[{"Gamma", "[", 
            RowBox[{"k", "+", "mp", "-", "m", "+", "1"}], "]"}], "*", 
           RowBox[{"Gamma", "[", 
            RowBox[{"k", "+", "1"}], "]"}]}], ")"}]}], ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Sum", " ", "from", " ", "0", " ", "to", " ", 
           RowBox[{"Infinity", ":", 
            RowBox[{
            "Terms", " ", "naturally", " ", "vanish", " ", "when", " ", "k", " ",
              "exceeds", " ", "bounds", " ", "due", " ", "to", " ", 
             RowBox[{"1", "/", "Gamma"}], " ", 
             RowBox[{"poles", ".", "GenerateConditions"}]}]}]}], "->", 
          RowBox[{
          "False", " ", "prevents", " ", "Mathematica", " ", "from", " ", 
           "wrapping", " ", "the", " ", "result", " ", "in", " ", 
           RowBox[{"conditional", "'"}], 
           RowBox[{"If", "'"}], " ", "blocks", " ", "about", " ", 
           RowBox[{"convergence", "."}]}]}], "*)"}], 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", "Infinity"}], "}"}], ",", 
        RowBox[{"GenerateConditions", "->", "False"}]}], "]"}]}]}], 
    "]"}]}]}]], "Input",
