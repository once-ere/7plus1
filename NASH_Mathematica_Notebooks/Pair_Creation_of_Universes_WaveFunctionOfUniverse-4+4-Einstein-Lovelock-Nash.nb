Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "rawSets", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rawSets", "[", 
   RowBox[{"l_", ",", "f_", ",", "o_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t", ",", "h"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"t", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Cases", "[", "\n", "   ", 
         RowBox[{
          RowBox[{"l", "[", 
           RowBox[{"[", "j", "]"}], "]"}], ",", " ", "\n", 
          RowBox[{
           RowBox[{
            RowBox[{"h_Symbol", "[", "n_Integer", "]"}], " ", "/;", " ", 
            RowBox[{"StringEndsQ", "[", 
             RowBox[{
              RowBox[{"SymbolName", "[", "h", "]"}], ",", " ", "f"}], "]"}]}],
            "  ", ":>", " ", 
           RowBox[{"n", "+", "o"}]}], ",", " ", "\n", "    ", "Infinity", ",",
           " ", "\n", "    ", 
          RowBox[{"Heads", " ", "->", " ", "True"}]}], "\n", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", 
