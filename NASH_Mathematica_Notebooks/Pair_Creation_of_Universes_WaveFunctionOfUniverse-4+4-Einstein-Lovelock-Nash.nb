Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"(*", 
    RowBox[{"Christoffel", ",", " ", 
     RowBox[{"Einstein", " ", "tensor"}], ",", " ", "..."}], "*)"}], "Text"], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "rt", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rt", "[", 
     RowBox[{"g_", ",", 
      RowBox[{"ass_", ":", 
       RowBox[{"{", "}"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "t", ",", "\[CapitalGamma]\[CapitalGamma]", ",", 
        "Ricci\[CapitalGamma]", ",", "Rie\[CapitalGamma]", ",", "RS", ",", 
        "G", ",", "ginv"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", "Now", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"t", "=", 
        RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"ginv", "=", 
           RowBox[{"FullSimplify", "[", 
            RowBox[{
             RowBox[{"Inverse", "[", "g", "]"}], ",", "ass"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"\[CapitalGamma]\[CapitalGamma]", "=", 
           RowBox[{"FullSimplify", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "/", "2"}], ")"}], "*", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"ginv", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "s"}], "]"}], "]"}], ")"}], "*", 
                   "\[IndentingNewLine]", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"g", "[", 
                    RowBox[{"[", 
                    RowBox[{"s", ",", "j"}], "]"}], "]"}], ",", 
                    RowBox[{"X", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], " ", "]"}], "+", 
                    RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"g", "[", 
                    RowBox[{"[", 
                    RowBox[{"s", ",", "k"}], "]"}], "]"}], ",", 
                    RowBox[{"X", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], " ", "]"}], "-", 
                    RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"g", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "k"}], "]"}], "]"}], ",", 
                    RowBox[{"X", "[", 
                    RowBox[{"[", "s", "]"}], "]"}]}], " ", "]"}]}], ")"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"s", ",", "1", ",", "DIM8"}], "}"}]}], "]"}]}], ",",
                "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", "DIM8"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", "1", ",", "DIM8"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", "1", ",", "DIM8"}], "}"}]}], "]"}], " ", ",",
              "ass"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Ricci\[CapitalGamma]", "=", 
           RowBox[{"ParallelTable", "[", 
            RowBox[{
             RowBox[{"FullSimplify", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"\[CapitalGamma]\[CapitalGamma]", "[", 
                   RowBox[{"[", 
                    RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Beta]"}], "]"}], 
                   "]"}], ",", 
                  RowBox[{"X", "[", 
                   RowBox[{"[", "\[Alpha]", "]"}], "]"}]}], " ", "]"}], "-", 
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"\[CapitalGamma]\[CapitalGamma]", "[", 
                   RowBox[{"[", 
                    RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]"}], "]"}], 
                   "]"}], ",", 
                  RowBox[{"X", "[", 
                   RowBox[{"[", "\[Beta]", "]"}], "]"}]}], " ", "]"}], "+", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"\[CapitalGamma]\[CapitalGamma]", "[", 
                    RowBox[{"[", 
                    RowBox[{"\[Mu]", ",", "s", ",", "\[Alpha]"}], "]"}], 
                    "]"}], 
                    RowBox[{"\[CapitalGamma]\[CapitalGamma]", "[", 
                    RowBox[{"[", 
                    RowBox[{"s", ",", "\[Nu]", ",", "\[Beta]"}], "]"}], 
                    "]"}]}], "-", 
                   RowBox[{
                    RowBox[{"\[CapitalGamma]\[CapitalGamma]", "[", 
                    RowBox[{"[", 
                    RowBox[{"\[Mu]", ",", "s", ",", "\[Beta]"}], "]"}], "]"}], 
                    RowBox[{"\[CapitalGamma]\[CapitalGamma]", "[", 
                    RowBox[{"[", 
                    RowBox[{"s", ",", "\[Nu]", ",", "\[Alpha]"}], "]"}], 
                    "]"}]}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"s", ",", "1", ",", "DIM8"}], "}"}]}], "]"}]}], ",",
                "ass"}], "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"\[Mu]", ",", "1", ",", "DIM8"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\[Nu]", ",", "1", ",", "DIM8"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\[Alpha]", ",", "1", ",", "DIM8"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\[Beta]", ",", "1", ",", "DIM8"}], "}"}]}], "]"}]}], 
          " ", ";", "\[IndentingNewLine]", 
          RowBox[{"Rie\[CapitalGamma]", "=", 
           RowBox[{"ParallelTable", "[", " ", 
            RowBox[{
             RowBox[{"FullSimplify", "[", 
              RowBox[{
               RowBox[{"Sum", "[", " ", 
                RowBox[{
                 RowBox[{"Ricci\[CapitalGamma]", "[", 
                  RowBox[{"[", 
                   RowBox[{
                   "\[Alpha]", ",", "\[Mu]", ",", "\[Alpha]", ",", "\[Nu]"}], 
                   "]"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"\[Alpha]", ",", "1", ",", "DIM8"}], "}"}]}], "]"}],
                ",", "ass"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"\[Mu]", ",", "1", ",", "DIM8"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\[Nu]", ",", "1", ",", "DIM8"}], "}"}]}], "]"}]}], " ",
           ";", "\[IndentingNewLine]", 
          RowBox[{"RS", "=", 
           RowBox[{"FullSimplify", "[", 
            RowBox[{
             RowBox[{"Tr", "[", " ", 
              RowBox[{"ginv", ".", "Rie\[CapitalGamma]"}], "]"}], " ", ",", 
             "ass"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"G", "=", 
           RowBox[{"ParallelTable", "[", 
            RowBox[{
             TagBox[
              RowBox[{"FullSimplify", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Rie\[CapitalGamma]", "[", 
                  RowBox[{"[", "\[Alpha]", "]"}], "]"}], "-", 
                 RowBox[{
                  FractionBox["1", "2"], 
                  RowBox[{"g", "[", 
                   RowBox[{"[", "\[Alpha]", "]"}], "]"}], " ", "RS"}]}], ",", 
                "ass"}], "]"}],
              CheckAbort[#, 
               Defer[#]]& ], ",", 
             RowBox[{"{", 
              RowBox[{"\[Alpha]", ",", "1", ",", 
               RowBox[{"Length", "[", "Rie\[CapitalGamma]", "]"}]}], "}"}]}], 
            "]"}]}], ";"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "t", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "Now", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{
         "ginv", ",", "\[CapitalGamma]\[CapitalGamma]", ",", 
          "Ricci\[CapitalGamma]", ",", "Rie\[CapitalGamma]", ",", "RS", ",", 
          "G"}], "}"}], "]"}]}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.5839347487763696`*^9, 3.5839348090080757`*^9}, {
   3.5839348538737545`*^9, 3.5839349066018467`*^9}, {3.5839349376927013`*^9, 
   3.5839349395335045`*^9}, {3.5839349776599717`*^9, 3.583935103146592*^9}, {
   3.5846128183791485`*^9, 3.5846128185819488`*^9}, 3.846661989429528*^9, {
   3.8466621613813353`*^9, 3.846662189325622*^9}, {3.8466627366282387`*^9, 
   3.84666275731299*^9}, 3.970075745316403*^9, {3.97047227537578*^9, 
   3.97047231317749*^9}, {3.97332521095751*^9, 3.973325220553337*^9}},
 FontSize->14,
 Background->RGBColor[0.95, 0.43, 0.96, 0.33],
 CellLabel->
  "In[214]:=",ExpressionUUID->"9d33926d-deb8-496b-9ec3-ebe2cfec6bc8"],

