Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "mapleztStringToMathematica", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mapleztStringToMathematica", "[", 
   RowBox[{"input_String", ",", 
    RowBox[{"toExpression_", ":", "False"}], ",", 
    RowBox[{"debug_", ":", "False"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"prepare", ",", "post", ",", "custom", ",", 
      RowBox[{"use", "=", "input"}], ",", 
      RowBox[{"save", "=", "input"}], ",", 
      RowBox[{"linenumber", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"use", "=", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", 
         RowBox[{"TextString", "[", "input", "]"}], "]"}], "]"}]}], ";"}], 
     "*)"}], 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Print", "[", "use", "]"}], ";"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"prepare", "[", "in_String", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s", "=", "in"}], "}"}], ",", 
        RowBox[{
         RowBox[{"linenumber", "++"}], ";", "\[IndentingNewLine]", 
         RowBox[{"s", "=", "in"}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"s", "==", 
              RowBox[{"ToString", "[", 
               RowBox[{"InputForm", "[", 
                RowBox[{"TextString", "[", "s", "]"}], "]"}], "]"}]}], ",", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"##", "&"}], "[", "]"}], "*)"}], 
             RowBox[{"Print", "[", "s", "]"}], ",", 
             RowBox[{"Print", "[", 
              RowBox[{"ToUpperCase", "[", "s", "]"}], "]"}]}], "]"}], ";"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"s", "=", 
            RowBox[{"StringReplace", "[", 
             RowBox[{"s", ",", 
              RowBox[{
               RowBox[{"\"\<diff(Z\>\"", "<>", 
                RowBox[{"ToString", "[", "j", "]"}], 
                "<>", "\"\<(z,t),z,z)\>\""}], "->", 
               RowBox[{"\"\<D[Z[\>\"", "<>", 
                RowBox[{"ToString", "[", "j", "]"}], 
                "<>", "\"\<][z,t],{z,2}]\>\""}]}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", "15"}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"s", "=", 
            RowBox[{"StringReplace", "[", 
             RowBox[{"s", ",", 
              RowBox[{
               RowBox[{"\"\<diff(Z\>\"", "<>", 
                RowBox[{"ToString", "[", "j", "]"}], 
                "<>", "\"\<(z,t),z,t)\>\""}], "->", 
               RowBox[{"\"\<D[D[Z[\>\"", "<>", 
                RowBox[{"ToString", "[", "j", "]"}], 
                "<>", "\"\<][z,t],z],t]\>\""}]}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", "15"}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"s", "=", 
            RowBox[{"StringReplace", "[", 
             RowBox[{"s", ",", 
              RowBox[{
               RowBox[{"\"\<diff(Z\>\"", "<>", 
                RowBox[{"ToString", "[", "j", "]"}], 
                "<>", "\"\<(z,t),t,z)\>\""}], "->", 
               RowBox[{"\"\<D[D[Z[\>\"", "<>", 
                RowBox[{"ToString", "[", "j", "]"}], 
                "<>", "\"\<][z,t],t],z]\>\""}]}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", "15"}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"s", "=", 
            RowBox[{"StringReplace", "[", 
             RowBox[{"s", ",", 
              RowBox[{
               RowBox[{"\"\<diff(Z\>\"", "<>", 
                RowBox[{"ToString", "[", "j", "]"}], 
                "<>", "\"\<(z,t),t,t)\>\""}], "->", 
               RowBox[{"\"\<D[Z[\>\"", "<>", 
                RowBox[{"ToString", "[", "j", "]"}], 
                "<>", "\"\<][z,t],{t,2}]\>\""}]}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", "15"}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"s", "=", 
            RowBox[{"StringReplace", "[", 
             RowBox[{"s", ",", 
              RowBox[{
               RowBox[{"\"\<diff(Z\>\"", "<>", 
                RowBox[{"ToString", "[", "j", "]"}], 
                "<>", "\"\<(z,t),t)\>\""}], "->", 
               RowBox[{"\"\<D[Z[\>\"", "<>", 
                RowBox[{"ToString", "[", "j", "]"}], 
                "<>", "\"\<][z,t],t]\>\""}]}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", "15"}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"s", "=", 
            RowBox[{"StringReplace", "[", 
             RowBox[{"s", ",", 
              RowBox[{
               RowBox[{"\"\<diff(Z\>\"", "<>", 
                RowBox[{"ToString", "[", "j", "]"}], 
                "<>", "\"\<(z,t),z)\>\""}], "->", 
               RowBox[{"\"\<D[Z[\>\"", "<>", 
                RowBox[{"ToString", "[", "j", "]"}], 
