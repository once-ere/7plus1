Cell[BoxData[
 RowBox[{"ConvertMapleToMathematicaV2", 
  "[", "\"\< -x6*cos(H*x0)^(1/3)*(cos(H*x0) - 1)^(1/6)*(cos(H*x0) + \
1)^(1/6)*(2*cos(H*x0) - 1)^(1/3)*(2*cos(H*x0) + 1)^(1/3)*(-1 + \
2*cos(2*H*x0))^(1/3)/sin(6*H*x0)^(1/3), , x5*cos(H*x0)^(1/3)*(cos(H*x0) - \
1)^(1/6)*(cos(H*x0) + 1)^(1/6)*(2*cos(H*x0) - 1)^(1/3)*(2*cos(H*x0) + \
1)^(1/3)*(-1 + 2*cos(2*H*x0))^(1/3)/sin(6*H*x0)^(1/3)\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.977085278794239*^9, 3.977085322014715*^9}, 
