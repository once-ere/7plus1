Cell[CellGroupData[{

Cell["\<\
Mathematica Lexer and Parser for Maple - like Syntax Supports : Basic \
arithmetic, function calls, lists {}, equations =, and specific Maple \
keywords .\
\>", "Section",
 CellChangeTimes->{{3.973919239585927*^9, 3.973919333276555*^9}, {
   3.97391967578034*^9, 3.973919677630157*^9}, {3.9739198168345613`*^9, 
   3.973919818492487*^9}, 3.9742128616352215`*^9},
 FontSize->14,
 FontColor->RGBColor[
  0.93, 0.27, 0.27],ExpressionUUID->"ee76cba9-0a39-cd41-8e5c-f4fd6b078dd0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", 
      RowBox[{"LEXER", "--"}]}]}], "-"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Helper", ":", 
    RowBox[{
    "Check", " ", "if", " ", "character", " ", "is", " ", "a", " ", 
     "digit"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"IsDigit", "[", "char_", "]"}], ":=", 
     RowBox[{"StringMatchQ", "[", 
      RowBox[{"char", ",", 
       RowBox[{"RegularExpression", "[", "\"\<\\\\d\>\"", "]"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Helper", ":", 
     RowBox[{
     "Check", " ", "if", " ", "character", " ", "is", " ", "a", " ", 
      "letter"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"IsAlpha", "[", "char_", "]"}], ":=", 
     RowBox[{"StringMatchQ", "[", 
      RowBox[{"char", ",", 
       RowBox[{"RegularExpression", "[", "\"\<[a-zA-Z_]\>\"", "]"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Helper", ":", 
     RowBox[{
     "Check", " ", "if", " ", "character", " ", "is", " ", "whitespace"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"IsSpace", "[", "char_", "]"}], ":=", 
     RowBox[{"StringMatchQ", "[", 
      RowBox[{"char", ",", 
       RowBox[{"RegularExpression", "[", "\"\<\\\\s\>\"", "]"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Main", " ", "Lexer", " ", "Function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"GetTokens", "[", "str_String", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"chars", ",", "len", ",", "i", ",", "char", ",", 
         RowBox[{"tokens", "=", 
          RowBox[{"{", "}"}]}], ",", "token", ",", "numStr", ",", "idStr"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"chars", "=", 
         RowBox[{"Characters", "[", "str", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"len", "=", 
         RowBox[{"Length", "[", "chars", "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"i", "=", "1"}], ";", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"i", "<=", "len"}], ",", 
          RowBox[{
           RowBox[{"char", "=", 
            RowBox[{"chars", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Which", "[", 
            RowBox[{"(*", 
             RowBox[{"Skip", " ", "Whitespace"}], "*)"}], 
            RowBox[{
             RowBox[{"IsSpace", "[", "char", "]"}], ",", 
             RowBox[{"i", "++"}], ",", 
             RowBox[{"(*", "Numbers", "*)"}], 
             RowBox[{"IsDigit", "[", "char", "]"}], ",", 
             RowBox[{
              RowBox[{"numStr", "=", "char"}], ";", "\[IndentingNewLine]", 
              RowBox[{"i", "++"}], ";", "\[IndentingNewLine]", 
              RowBox[{"While", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"i", "<=", "len"}], "&&", 
                 RowBox[{"IsDigit", "[", 
                  RowBox[{"chars", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
                RowBox[{
                 RowBox[{"numStr", "=", 
                  RowBox[{"numStr", "<>", 
                   RowBox[{"chars", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"i", "++"}], ";"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<NUMBER\>\"", ",", 
                  RowBox[{"ToExpression", "[", "numStr", "]"}]}], "}"}]}], 
               "]"}]}], ",", 
             RowBox[{"(*", 
              RowBox[{"Identifiers", " ", "and", " ", "Keywords"}], "*)"}], 
             RowBox[{"IsAlpha", "[", "char", "]"}], ",", 
             RowBox[{
              RowBox[{"idStr", "=", "char"}], ";", "\[IndentingNewLine]", 
              RowBox[{"i", "++"}], ";", "\[IndentingNewLine]", 
              RowBox[{"While", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"i", "<=", "len"}], "&&", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"IsAlpha", "[", 
                    RowBox[{"chars", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], "||", 
                   RowBox[{"IsDigit", "[", 
                    RowBox[{"chars", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ")"}]}], ",", 
                RowBox[{
                 RowBox[{"idStr", "=", 
                  RowBox[{"idStr", "<>", 
                   RowBox[{"chars", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"i", "++"}], ";"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{
                "Check", " ", "for", " ", "specific", " ", "keywords", " ", 
                 "if", " ", "needed"}], ",", 
                RowBox[{"otherwise", " ", "IDENTIFIER"}]}], "*)"}], 
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<IDENTIFIER\>\"", ",", "idStr"}], "}"}]}], 
               "]"}]}], ",", 
             RowBox[{"(*", 
              RowBox[{"Operators", " ", "and", " ", "Punctuation"}], "*)"}], 
             RowBox[{"char", "==", "\"\<+\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<PLUS\>\"", ",", "\"\<+\>\""}], "}"}]}], "]"}], ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\<-\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<MINUS\>\"", ",", "\"\<-\>\""}], "}"}]}], "]"}], 
              ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\<*\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<STAR\>\"", ",", "\"\<*\>\""}], "}"}]}], "]"}], ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\</\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<SLASH\>\"", ",", "\"\</\>\""}], "}"}]}], "]"}], 
              ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\<^\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<CARET\>\"", ",", "\"\<^\>\""}], "}"}]}], "]"}], 
              ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\<(\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<LPAREN\>\"", ",", "\"\<(\>\""}], "}"}]}], "]"}],
               ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\<)\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<RPAREN\>\"", ",", "\"\<)\>\""}], "}"}]}], "]"}],
               ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\<{\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<LBRACE\>\"", ",", "\"\<{\>\""}], "}"}]}], "]"}],
               ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\<}\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<RBRACE\>\"", ",", "\"\<}\>\""}], "}"}]}], "]"}],
               ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\<=\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<EQUALS\>\"", ",", "\"\<=\>\""}], "}"}]}], "]"}],
               ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\<,\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<COMMA\>\"", ",", "\"\<,\>\""}], "}"}]}], "]"}], 
              ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"char", "==", "\"\<$\>\""}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"tokens", ",", 
                RowBox[{"{", 
                 RowBox[{"\"\<DOLLAR\>\"", ",", "\"\<$\>\""}], "}"}]}], "]"}],
               ";", 
              RowBox[{"i", "++"}]}], ",", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"Ellipsis", "..."}], " ", "or", " ", 
               RowBox[{"Dot", "."}]}], "*)"}], 
             RowBox[{"char", "==", "\"\<.\>\""}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"i", "+", "2"}], "<=", "len"}], "&&", 
                RowBox[{
                 RowBox[{"chars", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", "+", "1"}], "]"}], "]"}], "==", "\"\<.\>\""}],
                 "&&", 
                RowBox[{
                 RowBox[{"chars", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", "+", "2"}], "]"}], "]"}], 
                 "==", "\"\<.\>\""}]}], ",", 
               RowBox[{
                RowBox[{"AppendTo", "[", 
                 RowBox[{"tokens", ",", 
                  RowBox[{"{", 
                   RowBox[{"\"\<ELLIPSIS\>\"", ",", "\"\<...\>\""}], "}"}]}], 
                 "]"}], ";", 
                RowBox[{"i", "+=", "3"}]}], ",", 
               RowBox[{
                RowBox[{"AppendTo", "[", 
                 RowBox[{"tokens", ",", 
                  RowBox[{"{", 
                   RowBox[{"\"\<DOT\>\"", ",", "\"\<.\>\""}], "}"}]}], "]"}], 
                ";", 
                RowBox[{"i", "++"}]}]}], "]"}], ",", "True", ",", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"\"\<Unknown character: \>\"", ",", "char"}], "]"}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"i", "++"}]}]}], "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"tokens", ",", 
          RowBox[{"{", 
