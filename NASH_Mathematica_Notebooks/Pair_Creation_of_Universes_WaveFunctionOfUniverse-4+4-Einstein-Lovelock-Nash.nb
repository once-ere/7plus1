       SqrtBox["2"]], ",", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"a4", "[", 
           RowBox[{"H", " ", "x4"}], "]"}]], " ", "x1", " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", 
           RowBox[{"6", " ", "H", " ", "x0"}], "]"}], 
          RowBox[{"1", "/", "6"}]]}], 
        SqrtBox["2"]]}]}], "}"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"-", 
          RowBox[{"a4", "[", 
           RowBox[{"H", " ", "x4"}], "]"}]}]], " ", "x7", " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", 
          RowBox[{"6", " ", "H", " ", "x0"}], "]"}], 
         RowBox[{"1", "/", "6"}]]}], 
       SqrtBox["2"]], ",", 
      FractionBox["x4", 
       SqrtBox["2"]], ",", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"-", 
           RowBox[{"a4", "[", 
            RowBox[{"H", " ", "x4"}], "]"}]}]], " ", "x5", " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", 
