Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"x6", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       RowBox[{"Cos", "[", 
        RowBox[{"H", " ", "x0"}], "]"}]}], ")"}], 
     RowBox[{"1", "/", "6"}]], " ", 
    SuperscriptBox[
     RowBox[{"Cos", "[", 
      RowBox[{"H", " ", "x0"}], "]"}], 
