        RowBox[{"(", "A", ")"}], "\[Alpha]"], " ", ")"}]}]}], " ", "=", "  ", 
    
    RowBox[{
     RowBox[{
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", " ", 
        SubscriptBox["g", "\[Mu]\[Nu]"]}]], 
      RowBox[{"(", " ", 
       RowBox[{"Inverse", "[", 
        SubsuperscriptBox["e", "\[Alpha]", 
         RowBox[{"(", "A", ")"}]], " ", "]"}], ")"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"-", " ", 
       RowBox[{
        RowBox[{"Inverse", "[", 
         SubsuperscriptBox["e", "\[Alpha]", 
          RowBox[{"(", "A", ")"}]], " ", "]"}], ".", 
        FractionBox[
         RowBox[{"\[PartialD]", 
          SubsuperscriptBox["e", "\[Alpha]", 
           RowBox[{"(", "A", ")"}]]}], 
         RowBox[{"\[PartialD]", " ", 
          SubscriptBox["g", "\[Mu]\[Nu]"]}]], ".", 
        RowBox[{"Inverse", "[", 
         SubsuperscriptBox["e", "\[Alpha]", 
          RowBox[{"(", "A", ")"}]], " ", "]"}]}]}], "=", 
      RowBox[{
       RowBox[{"-", " ", 
        RowBox[{
         SubsuperscriptBox["e", 
          RowBox[{"(", "A", ")"}], "\[Alpha]"], "[", 
         RowBox[{"[", 
          RowBox[{"\[Alpha]1", ",", "A1"}], "]"}], "]"}]}], 
       RowBox[{
        FractionBox[
         RowBox[{"\[PartialD]", 
          RowBox[{
           SubsuperscriptBox["e", "\[Alpha]", 
            RowBox[{"(", "A", ")"}]], "[", 
           RowBox[{"[", 
            RowBox[{"A1", ",", "\[Alpha]2"}], "]"}], "]"}]}], 
         RowBox[{"\[PartialD]", " ", 
          SubscriptBox["g", "\[Mu]\[Nu]"]}]], ".", 
        RowBox[{
         SubsuperscriptBox["e", 
          RowBox[{"(", "A", ")"}], "\[Alpha]"], "[", 
         RowBox[{"[", 
          RowBox[{"\[Alpha]2", ",", "A2"}], "]"}], "]"}]}]}]}]}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Consider", 
     RowBox[{
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", " ", 
        SubscriptBox["g", "\[Mu]\[Nu]"]}]], 
      RowBox[{"(", 
       SubscriptBox["g", 
        RowBox[{"\[Alpha]", " ", "\[Beta]"}]], ")"}]}]}], " ", "=", "  ", 
    RowBox[{
     RowBox[{
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", " ", 
        SubscriptBox["g", "\[Mu]\[Nu]"]}]], 
      RowBox[{"(", " ", 
       RowBox[{
        SubscriptBox["\[Eta]", "AB"], " ", 
        SubsuperscriptBox["e", "\[Alpha]", 
         RowBox[{"(", "A", ")"}]], "  ", 
        SubsuperscriptBox["e", "\[Beta]", "B"]}], ")"}]}], "=", " ", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Eta]", "AB"], "  ", 
       SubsuperscriptBox["e", "\[Beta]", "B"], 
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", " ", 
          SubscriptBox["g", "\[Mu]\[Nu]"]}]], 
        RowBox[{"(", 
         SubsuperscriptBox["e", "\[Alpha]", 
          RowBox[{"(", "A", ")"}]], " ", ")"}]}]}], "+", " ", 
      RowBox[{
       SubscriptBox["\[Eta]", "AB"], " ", 
       SubsuperscriptBox["e", "\[Alpha]", "B"], " ", " ", 
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", " ", 
          SubscriptBox["g", "\[Mu]\[Nu]"]}]], 
        RowBox[{"(", " ", 
         SubsuperscriptBox["e", "\[Beta]", "A"], ")"}]}]}]}]}]}], ";", " ", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["e", "C", "\[Beta]"], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SubscriptBox["g", 
        RowBox[{"\[Alpha]", " ", "\[Beta]"}]]}], 
      RowBox[{"\[PartialD]", " ", 
       SubscriptBox["g", "\[Mu]\[Nu]"]}]]}], "=", "  ", 
    RowBox[{
     RowBox[{
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", " ", 
        SubscriptBox["g", "\[Mu]\[Nu]"]}]], 
      RowBox[{"(", " ", 
       RowBox[{
        SubscriptBox["\[Eta]", "AB"], " ", 
        SubsuperscriptBox["e", "\[Alpha]", 
         RowBox[{"(", "A", ")"}]], "  ", 
        SubsuperscriptBox["e", "\[Beta]", "B"]}], ")"}]}], "=", " ", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Eta]", "AC"], 
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", " ", 
          SubscriptBox["g", "\[Mu]\[Nu]"]}]], 
        RowBox[{"(", 
         SubsuperscriptBox["e", "\[Alpha]", 
          RowBox[{"(", "A", ")"}]], " ", ")"}]}]}], "+", " ", 
      RowBox[{
       SubscriptBox["\[Eta]", "AB"], " ", 
       SubsuperscriptBox["e", "\[Alpha]", "B"], " ", 
       SubsuperscriptBox["e", "C", "\[Beta]"], " ", 
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", " ", 
          SubscriptBox["g", "\[Mu]\[Nu]"]}]], 
        RowBox[{"(", 
         SubsuperscriptBox["e", "\[Beta]", "A"], ")"}]}]}]}]}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"In", "  ", "metric", "  ", "matrix", "  ", "g"}], ",", " ", 
  RowBox[{"we", " ", "must", "  ", "replace", "  ", "element", "  ", 
