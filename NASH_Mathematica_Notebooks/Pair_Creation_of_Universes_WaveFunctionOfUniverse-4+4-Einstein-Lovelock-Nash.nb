Cell[BoxData[
 RowBox[{
  RowBox[{"blockPartition", "[", "mat_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"(*", 
      RowBox[{
      "blocks", ",", "block11", ",", "block12", ",", "block21", ",", 
       "block22", ","}], "*)"}], "ret", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"blocks", "=", 
      RowBox[{"Partition", "[", 
       RowBox[{"mat", ",", 
        RowBox[{"{", 
         RowBox[{"8", ",", "8"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"block11", "=", 
        RowBox[{"blocks", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}]}], " ", ";"}], "*)"}], 
     RowBox[{"(*", 
      RowBox[{"Top", "-", 
       RowBox[{"left", " ", "block"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"block12", "=", 
        RowBox[{"blocks", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}]}], " ", ";"}], "*)"}], 
     RowBox[{"(*", 
      RowBox[{"Top", "-", 
       RowBox[{"right", " ", "block"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"block21", "=", 
        RowBox[{"blocks", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "1"}], "]"}], "]"}]}], " ", ";"}], "*)"}], 
     RowBox[{"(*", 
      RowBox[{"Bottom", "-", 
       RowBox[{"left", " ", "block"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"block22", "=", 
        RowBox[{"blocks", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "2"}], "]"}], "]"}]}], " ", ";"}], "*)"}], 
     RowBox[{"(*", 
      RowBox[{"Bottom", "-", 
       RowBox[{"right", " ", "block"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ret", "=", 
      RowBox[{
       RowBox[{"ArrayFlatten", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"blocks", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"blocks", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"blocks", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"blocks", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "}"}]}], "}"}], "]"}], 
       " ", "===", " ", "mat"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"ret", ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"blocks", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"blocks", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"blocks", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"blocks", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "}"}]}], "}"}], "]"}], 
       ",", 
       RowBox[{
        RowBox[{"##", "&"}], "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"Return", "[", "Null", "]"}], ";"}]}], "]"}]}]], "Input",
