Cell[BoxData[""], "Text",
 CellChangeTimes->{3.975060414112797*^9, 3.975148797849152*^9, 
  3.975148896317442*^9},
 FontSize->14,ExpressionUUID->"06418185-eb53-9b4f-a3c0-13a0e9951ae4"],

Cell[CellGroupData[{

Cell["\<\
Dirac spinor with components  u\.aa, a = 1, 2, 3, 4;  irrep, and  DD\[Xi], ...\
\>", "Section",
 CellChangeTimes->{{3.9749057924765263`*^9, 3.974905803236763*^9}, {
  3.974905928421503*^9, 3.974905969813404*^9}, {3.974970594702177*^9, 
  3.9749706109759483`*^9}, {3.97507913874543*^9, 3.975079161242853*^9}},
 FontSize->14,ExpressionUUID->"a36d722d-0df1-124b-bb4a-5899a8a861e8"],

Cell[TextData[{
 "The Wigner D-function ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["D", 
    RowBox[{
     SubscriptBox["m", "1"], ",", 
     SubscriptBox["m", "2"]}], "j"], TraditionalForm]], "InlineMath",
  ExpressionUUID->"17ba2048-be96-8e42-8b9c-93ec4750ebbd"],
 " gives the matrix element of a rotation operator parametrized by Euler \
angles in a ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", " ", "j"}], "+", "1"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"30a96665-8340-804d-b75f-98ed2ffcb893"],
 "\[Dash]dimensional unitary representation of a rotation group when \
parameters ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]], "InlineMath",ExpressionUUID->
  "9896a2fc-407f-7d46-a031-e858eb318fde"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "1"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "0e0859e7-a86a-d84d-90b5-62b3de031f1a"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "2"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "965cf161-1274-b941-b818-18c0feeb5bd8"],
 " are physical, i.e. all integers or half-integers such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"-", "j"}], "\[LessEqual]", 
     SubscriptBox["m", "1"]}], ",", 
    RowBox[{
     SubscriptBox["m", "2"], "\[LessEqual]", "j"}]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"645c6c71-ec20-2645-8a4d-c695ac053cb4"],
 "."
}], "Notes",
 FontSize->14,
 CellID->101546122,ExpressionUUID->"9b6796de-b9cf-6f4e-bedd-9d83a80585c2"],

Cell[TextData[{
 "For unphysical parameters, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["WignerD"]], "paclet:ref/WignerD"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "79e1aaad-871f-d044-854e-edcefb3c4acd"],
 " is defined by an analytic continuation."
}], "Notes",
 FontSize->14,
 CellID->226333600,ExpressionUUID->"0dfb0027-fa53-874c-86bb-1cb719d06a01"],

Cell[TextData[{
 "The Wolfram Language",
 " uses phase conventions where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"j", 
      SubscriptBox["m", "1"], 
      SubscriptBox["m", "2"], "\[Psi]", "\[Theta]", "\[Phi]"},
     "WignerD"], "\[LongEqual]", 
    RowBox[{
     RowBox[{"exp", "(", 
      RowBox[{
       RowBox[{"\[ImaginaryI]", " ", 
        SubscriptBox["m", "1"], " ", "\[Psi]"}], "+", 
       RowBox[{"\[ImaginaryI]", " ", 
        SubscriptBox["m", "2"], "\[Phi]"}]}], ")"}], " ", 
     TemplateBox[{"j", 
       SubscriptBox["m", "1"], 
       SubscriptBox["m", "2"], "0", "\[Theta]", "0"},
      "WignerD"]}]}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "17bcfbf5-6713-8042-937e-e1f39511aaf9"],
 "."
}], "Notes",
 FontSize->14,
 CellID->287940785,ExpressionUUID->"0d0d0434-bd43-e64a-8ba2-08f195fd001b"],

Cell[BoxData[Cell[TextData[{
  Cell[BoxData[
   RowBox[{
    TemplateBox[{
      Cell[
       TextData["WignerD"]], "paclet:ref/WignerD"},
     "RefLink",
     BaseStyle->{"InlineFormula"}], "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       StyleBox["j", "TI"], ",", 
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["1", "TR"]], ",", 
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["2", "TR"]]}], "}"}], ",", 
     StyleBox["\[Psi]", "TR"], ",", 
     StyleBox["\[Theta]", "TR"], ",", 
     StyleBox["\[Phi]", "TR"]}], "]"}]], "InlineFormula",
   FontFamily->"Source Sans Pro",ExpressionUUID->
   "95d786e4-ea36-804c-aa23-d24bff2f3730"],
  " \[LineSeparator]gives the Wigner D-function ",
  Cell[BoxData[
   FormBox[
    RowBox[{
     SubsuperscriptBox["D", 
      RowBox[{
       SubscriptBox["m", "1"], ",", 
       SubscriptBox["m", "2"]}], "j"], "(", 
     RowBox[{"\[Psi]", ",", "\[Theta]", ",", "\[Phi]"}], ")"}], 
    TraditionalForm]], "InlineMath",ExpressionUUID->
   "047ce80d-5d41-6047-b27f-bb181eba2226"],
  "."
 }],ExpressionUUID->"37d58baa-63a0-034b-88b8-cfbddd9f3317"]], "Text",
 CellChangeTimes->{3.975078475788986*^9},
 FontSize->14,ExpressionUUID->"0f41d4da-ce4c-fa41-a0ff-0edb33c0cb75"],

