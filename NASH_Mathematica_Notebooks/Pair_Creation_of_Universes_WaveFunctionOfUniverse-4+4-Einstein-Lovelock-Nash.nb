            RowBox[{"\"\<tan(z)\>\"", "->", "\"\<Tan[z]\>\""}]}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"s", "=", 
          RowBox[{"StringReplace", "[", 
