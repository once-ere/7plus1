          RowBox[{"(", "b", ")"}]], 
         RowBox[{"(", "a", ")"}]]}],
       TraditionalForm]}]}], "\n", "   ", 
    StyleBox["\n",
     FontSize->36], "  ", 
    RowBox[{"Here", ",", " ", 
     RowBox[{"spin", " ", "connection", " ", "coefficients", " ", "are", "  ", 
      FormBox[
       SubsuperscriptBox["e", "k", 
        RowBox[{"(", "a", ")"}]],
       TraditionalForm], " ", 
      FormBox[
       RowBox[{"(", 
        SubscriptBox["\[Del]", "j"]}],
       TraditionalForm], " ", 
      FormBox[
       SubsuperscriptBox["e", 
        RowBox[{"(", "b", ")"}], "k"],
       TraditionalForm]}]}]}], " ", ")"}], "  "}], "\n", 
 StyleBox["and", "Title",
  FontSize->16], "\n", 
 RowBox[{
  RowBox[{
   StyleBox["S", "Title",
    FontSize->24], 
   StyleBox[" ", "Title",
    FontSize->24], 
   StyleBox["=", "Title",
    FontSize->24], 
   StyleBox[" ", "Title",
    FontSize->24], 
   RowBox[{
    StyleBox["exp", "Title",
     FontSize->24], 
    RowBox[{
     StyleBox["(", "Title"], 
     StyleBox[" ", "Title",
      FontSize->24], 
     RowBox[{
      FormBox[
       FractionBox["1", "2"],
       TraditionalForm], 
      FormBox[
       StyleBox[
        RowBox[{
         SubscriptBox["\[Omega]", 
          RowBox[{
           RowBox[{"(", "A", ")"}], 
           RowBox[{"(", "B", ")"}], " "}]], "(", "x", ")"}],
        FontSize->24],
       TraditionalForm], 
      FormBox[
       RowBox[{" ", 
        StyleBox[
         SuperscriptBox["SAB", 
          RowBox[{
           RowBox[{"(", "A", ")"}], 
