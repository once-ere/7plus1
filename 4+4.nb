Cell["\<\
findComplexStucture[] := Module[{list, filter(*,innerProduct*)},
  (*innerProduct[a_,b_]:=FullSimplify[Transpose[a].\[Sigma]16.b];*)
  (*filter[J_][a_,b_]:=J.J===-ID16&&innerProduct[a,b]===innerProduct[J.a,J.b];\
*)
  filter[J_] := J . J === -ID16 && \[Sigma]16 === Transpose[J] . \[Sigma]16 . \
J;
  Return[list];
  ]\
\>", "Text",
 CellChangeTimes->{{3.976686485954893*^9, 3.976686663966345*^9}, {
   3.976686696067477*^9, 3.97668670785408*^9}, {3.976686798097587*^9, 
