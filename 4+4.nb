Cell[CellGroupData[{

Cell["split  octonions;    evalues, evecs of \[Sigma]", "Section",
 CellChangeTimes->{
  3.4418279338808002`*^9, {3.4424181381004*^9, 3.4424181437008*^9}, {
   3.966661420213066*^9, 3.966661429647944*^9}, {3.9767068950660915`*^9, 
   3.9767069040738792`*^9}},
 FontSize->14,
 FontColor->RGBColor[
  1, 0, 0],ExpressionUUID->"7fd4d841-dd52-7b42-9e17-ba337357e179"],

Cell["\<\
# Type - 1 spinor basis (constructed from Clifford algebra considerations)
# These create a maximal isotropic subspace with respect to the split form
self . type1_spinor _basis _matrix = sqrt2_inv*np . array ([[1, 1, 0, 0, 0, \
0, 0, 0], # s1_ 0[1, -1, 0, 0, 0, 0, 0, 0], # s1_ 1[0, 0, 1, 1, 0, 0, 0, 0], \
# s1_ 2[0, 0, 1, -1, 0, 0, 0, 0], # s1_ 3[0, 0, 0, 0, 1, 1, 0, 0], # s1_ 4[0, \
0, 0, 0, 1, -1, 0, 0], # s1_ 5[0, 0, 0, 0, 0, 0, 1, 1], # s1_ 6[0, 0, 0, 0, \
0, 0, 1, -1], # s1_ 7])

# Type - 2 spinor basis (the complementary spinor representation)
# Related to Type - 1 by another triality automorphism
self . type2_spinor _basis _matrix = sqrt2_inv*np . array ([[1, 0, 1, 0, 0, \
0, 0, 0], # s2_ 0[1, 0, -1, 0, 0, 0, 0, 0], # s2_ 1[0, 1, 0, 1, 0, 0, 0, 0], \
# s2_ 2[0, 1, 0, -1, 0, 0, 0, 0], # s2_ 3[0, 0, 0, 0, 1, 0, 1, 0], # s2_ 4[0, \
0, 0, 0, 1, 0, -1, 0], # s2_ 5[0, 0, 0, 0, 0, 1, 0, 1], # s2_ 6[0, 0, 0, 0, \
0, 1, 0, -1], # s2_ 7])
\
\>", "Text",
 CellChangeTimes->{{3.9773098726878185`*^9, 3.977309881342697*^9}},
 FontSize->14,ExpressionUUID->"35eff96c-b2a1-744f-ac24-25757c602625"],

