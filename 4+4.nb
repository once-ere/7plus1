Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"possibleComplexStructureIndex", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"base16", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Block", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"J", "=", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", 
            RowBox[{"m", "=", 
             RowBox[{"\[Sigma]16", ".", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}]}], "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"J", ".", "J"}], "===", 
            RowBox[{"-", "ID16"}]}], "&&", 
           RowBox[{"\[Sigma]16", "===", 
            RowBox[{
             RowBox[{"Transpose", "[", "J", "]"}], ".", "\[Sigma]16", ".", 
             "J"}]}], "&&", 
           RowBox[{"!", 
            RowBox[{"(", 
             RowBox[{"m", "===", 
              RowBox[{"-", 
               RowBox[{"Transpose", "[", "m", "]"}]}]}], ")"}]}]}]}], " ", 
         "]"}], "&"}], "->", "\"\<Index\>\""}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"possibleComplexStructureMatrix", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"base16", "[", 
        RowBox[{"[", "#", "]"}], "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}], "&"}], "/@", "%"}]}]}], 
  "*)"}]], "Input",
 CellChangeTimes->{{3.9766882936889353`*^9, 3.976688321137802*^9}, {
