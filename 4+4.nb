Cell["\<\
Transpose[a] . \[Sigma]16 . b == Transpose[J . a] . \[Sigma]16 . J . b = a . \
Transpose[J] . \[Sigma]16 . J . b 
want  \[Psi]cc.\[Sigma]16.?.\[CapitalPsi]16  =  \
\[CapitalPsi]16.J.\[Sigma]16.?.\[CapitalPsi]16  \[NotEqual] 0\
\>", "Text",
 CellChangeTimes->{{3.976687960524412*^9, 3.9766880329385757`*^9}, 
   3.9766881155894203`*^9, {3.97670426668087*^9, 3.9767043248441544`*^9}, {
   3.976704622039261*^9, 3.9767046367098255`*^9}, {3.9767060280038204`*^9, 
   3.9767060406738987`*^9}},
 FontSize->14,ExpressionUUID->"61c4ca5b-7a2e-2646-9d08-86ce2e216f40"],

Cell["\<\
need 1 irrep  for {i, u}
need 1 irrep  for {i, u} _perp
1 == x0  or  x4;  u == x4  or x0
x0 has periodic fns;  use x4\
\>", "Text",
 CellChangeTimes->{{3.9767346282710686`*^9, 3.9767347530857143`*^9}},
 FontSize->14,ExpressionUUID->"888533f8-d033-0642-a9c3-fd71915a5e57"],

